/target
/dist
# vendor/<name>/ keeps its build script in git; what it downloads or builds stays out.
/vendor/*/bin/
/vendor/*/work/
/vendor/*/dist/
# The UI fonts, downloaded by scripts/fetch-fonts.sh.
/vendor/fonts/
/lang/*.pot
# msgmerge --update keeps the previous .po beside the new one.
*.po~
.DS_Store
.vscode/
