// Colours of the shell. A placeholder: the design replaces them, and adds its typefaces.
import { Palette } from "std-widgets.slint";
import { AppState } from "state.slint";

export global Theme {
    // Appearance: the settings choice, or the system's when it is "system".
    out property <bool> dark: AppState.appearance == "dark"
        || (AppState.appearance == "system" && Palette.color-scheme == ColorScheme.dark);

    out property <color> bg: dark ? #17191C : #F5F6F8;
    out property <color> fg: dark ? #ECEEF1 : #1B1D21;
    out property <color> muted: dark ? #9AA0A8 : #646A73;
    out property <color> danger: dark ? #F07A6E : #C23B2E;
}
