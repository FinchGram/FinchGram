import { WorkbenchWindow } from "workbench/workbench.slint";
import { BroadsheetWindow } from "broadsheet/broadsheet.slint";
import { TerminalWindow } from "terminal/terminal.slint";
import { SettingsPage } from "pages/settings.slint";
import { MediaViewer } from "viewer.slint";
import { ProfilePage } from "pages/profile.slint";
import { AllowDialog } from "pages/ai-access.slint";
import { DownloadsPage } from "pages/downloads.slint";

// Re-exported so Rust can reach them through slint::include_modules!().
export { ShotWindow, Shot, ShotTool, ShotCursor, ShotBox, ShotPath, ShotText, ShotCell, Screenshot }
export { AppState, PlatformWords, TelegramState, Connection, UpdateState, Theme, Page, SettingsSection, Language,
    NotificationSetting, Chats, Conversation, Account, Accounts, AccountRow, Login, LoginStep, CodeDelivery, Country, PasswordSettings, PasswordStep,
    PasswordChange, ChatRow, Folder, TreeRow, Tab, MessageRow, Media, Sticker, LinkPreview, RowKind, Content, ChatKind, Status, Moment,
    Day, Viewer, ViewerItem, Words, ReplyQuote, Actions, MessageAction, ComposeBar, ActionNotice, DeleteChoice, NotificationScope,
    NotificationScopes, FileCard, FileState, FileType, Attachments, Attachment, AttachKind, AttachProblem, AttachHint, ChatConfirm, Fmt,
    ButtonKind, ChatButton, ButtonRow, BotCommand, Reaction, RoundNote, VoiceNote, TranscriptProblem, ContactCard, TopicRow, Share, ShareKind, ShareRow }
export { AiAccess, AiScope, AiWriting, AiChat, AiApp, AiActivity, AiActivityKind }
export { Search, NewChat, NewDialog, LinkCheck, FoundKind, FoundRow, FoundSection, ComposeWords, BotWords, ExtraWords }
export { Downloads, ServerRow, ServerStatus, Problem, FolderState, FolderEntry, TransferRow, TransferState, TestState, FormError }
export { ChatInfo, InfoWords, InfoRow, InfoRowKind, InfoSection, InfoMember }
export { ChatManage, ManageWords, ManageLook, ManagePage, UsernameCheck, ManageToggle, ManageChip, ManagePerson, ManageLink, ManageChoice }
export { Toolbox, ToolboxWords, ToolRow, ToolSection, NavRow, ProtocolRow }
export { Voice, VoiceWords, VoiceState, VoiceProblem, KeyCheck, VoiceLanguage, VoiceLanguageRow, VoiceVendorRow, VoiceItem, ModelsState, Recorder, RecordStage }

export component MainWindow inherits Window {
    title: Account.name == "" ? "FinchGram" : Account.name + " — FinchGram";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 640px;
    background: Look.bg;
    default-font-family: Look.font;

    // The macOS menu bar. Slint adds the application menu (About, Hide, Quit) by itself; these
    // menus follow it. "Control" in a shortcut is the Command key on macOS.
    MenuBar {
        Menu {
            title: @tr("View");
            MenuItem {
                title: @tr("Search");
                shortcut: @keys(Control + K);
                enabled: root.ready;
                activated => {
                    AppState.show-window();
                    AppState.page = Page.chats;
                    AppState.search-requests += 1;
                }
            }
            MenuItem {
                title: @tr("Search in Chat");
                shortcut: @keys(Control + F);
                enabled: root.ready && Conversation.chat-id != "";
                activated => {
                    AppState.show-window();
                    AppState.page = Page.chats;
                    Conversation.search-open = true;
                    Conversation.search-requests += 1;
                }
            }
            MenuItem {
                title: @tr("Chat Info");
                shortcut: @keys(Control + I);
                enabled: root.ready && Conversation.chat-id != "";
                activated => {
                    AppState.show-window();
                    AppState.page = Page.chats;
                    ChatInfo.toggle();
                }
            }
            MenuItem {
                title: @tr("Toolbox");
                shortcut: @keys(Control + J);
                enabled: root.ready;
                activated => {
                    AppState.show-window();
                    AppState.page = Page.chats;
                    Toolbox.toggle();
                }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Workbench");
                checkable: true;
                checked: AppState.theme == Theme.workbench;
                activated => {
                    AppState.change-theme(Theme.workbench);
                }
            }
            MenuItem {
                title: @tr("Terminal");
                checkable: true;
                checked: AppState.theme == Theme.terminal;
                activated => {
                    AppState.change-theme(Theme.terminal);
                }
            }
            MenuItem {
                title: @tr("Broadsheet");
                checkable: true;
                checked: AppState.theme == Theme.broadsheet;
                activated => {
                    AppState.change-theme(Theme.broadsheet);
                }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Downloads");
                shortcut: @keys(Control + Alt + L);
                activated => {
                    AppState.show-window();
                    AppState.page = Page.downloads;
                }
            }
            MenuItem {
                title: @tr("Settings…");
                shortcut: @keys(Control + Comma);
                activated => {
                    AppState.show-window();
                    AppState.page = Page.settings;
                }
            }
        }
        // The accounts signed in, ⌘1 … ⌘0 by their places (src/telegram/accounts.rs).
        Menu {
            title: @tr("menu" => "Account");
            if Accounts.count > 0: MenuItem { title: Accounts.rows[0].name; shortcut: @keys(Control + Digit1); activated => { Accounts.switch-index(0); } }
            if Accounts.count > 1: MenuItem { title: Accounts.rows[1].name; shortcut: @keys(Control + Digit2); activated => { Accounts.switch-index(1); } }
            if Accounts.count > 2: MenuItem { title: Accounts.rows[2].name; shortcut: @keys(Control + Digit3); activated => { Accounts.switch-index(2); } }
            if Accounts.count > 3: MenuItem { title: Accounts.rows[3].name; shortcut: @keys(Control + Digit4); activated => { Accounts.switch-index(3); } }
            if Accounts.count > 4: MenuItem { title: Accounts.rows[4].name; shortcut: @keys(Control + Digit5); activated => { Accounts.switch-index(4); } }
            if Accounts.count > 5: MenuItem { title: Accounts.rows[5].name; shortcut: @keys(Control + Digit6); activated => { Accounts.switch-index(5); } }
            if Accounts.count > 6: MenuItem { title: Accounts.rows[6].name; shortcut: @keys(Control + Digit7); activated => { Accounts.switch-index(6); } }
            if Accounts.count > 7: MenuItem { title: Accounts.rows[7].name; shortcut: @keys(Control + Digit8); activated => { Accounts.switch-index(7); } }
            if Accounts.count > 8: MenuItem { title: Accounts.rows[8].name; shortcut: @keys(Control + Digit9); activated => { Accounts.switch-index(8); } }
            if Accounts.count > 9: MenuItem { title: Accounts.rows[9].name; shortcut: @keys(Control + Digit0); activated => { Accounts.switch-index(9); } }
            MenuSeparator { }
            MenuItem {
                title: @tr("Add Account…");
                enabled: !Accounts.full && AppState.telegram-state == TelegramState.ready;
                activated => {
                    AppState.show-window();
                    AppState.page = Page.chats;
                    Accounts.add();
                }
            }
        }
        Menu {
            title: @tr("Help");
            MenuItem {
                title: AppState.update-state == UpdateState.available
                    ? @tr("Update to {}…", AppState.update-version)
                    : @tr("Check for Updates…");
                activated => {
                    if AppState.update-state == UpdateState.available {
                        AppState.install-update();
                    } else {
                        AppState.check-for-updates();
                    }
                }
            }
        }
    }

    // Until Telegram is ready, the login pages; then the theme's chat window, or a shared page.
    property <bool> ready: AppState.telegram-state == TelegramState.ready;

    if !root.ready && AppState.page != Page.settings && AppState.page != Page.downloads: LoginPage { }
    if root.ready && AppState.page == Page.chats && AppState.theme == Theme.workbench: WorkbenchWindow { }
    if root.ready && AppState.page == Page.chats && AppState.theme == Theme.broadsheet: BroadsheetWindow { }
    if root.ready && AppState.page == Page.chats && AppState.theme == Theme.terminal: TerminalWindow { }
    if AppState.page == Page.settings: SettingsPage { }
    if root.ready && AppState.page == Page.profile: ProfilePage { }
    if AppState.page == Page.downloads: DownloadsPage { }
    // The media viewer, over everything while it is open: a chat's media, or a downloaded file.
    if ((root.ready && AppState.page == Page.chats) || AppState.page == Page.downloads) && Viewer.open: MediaViewer { }
    // An AI assistant's app is connecting for the first time: the question, over whatever is open.
    if AiAccess.ask-open: AllowDialog { }
}
