    PasswordChange, ChatRow, Folder, TreeRow, Tab, MessageRow, Media, Sticker, LinkPreview, RowKind, Content, ChatKind, Status, Moment,
    Day, Viewer, ViewerItem, Words, ReplyQuote, Actions, MessageAction, ComposeBar, ActionNotice, DeleteChoice, NotificationScope,
    NotificationScopes, FileCard, FileState, FileType, Attachments, Attachment, AttachKind, AttachProblem, AttachHint, ChatConfirm,
    ButtonKind, ChatButton, ButtonRow, BotCommand, Reaction, RoundNote, VoiceNote, TranscriptProblem, ContactCard, TopicRow, Share, ShareKind, ShareRow } from "telegram.slint";
