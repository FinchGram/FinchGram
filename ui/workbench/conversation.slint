// Workbench's main area: the tabs of the open chats, and the chat in front — its header, the
// messages as rows (a letter, the sender and time, the text), and where to write.
import { AppState } from "../state.slint";
import {
    Conversation, MessageRow, RowKind, ChatKind, Content, Account, Viewer, LinkPreview, ReplyQuote, Actions, ComposeBar,
    ActionNotice, Tab, Chats, Attachments,
} from "../telegram.slint";
import { Fmt } from "../format.slint";
import { Icon, Paragraph, Avatar } from "../widgets.slint";
import {
    ChatScroll, ChatIcons, MessageInput, Capped, MediaTiles, StickerPicture, RichText, MessageArea, ActionWords, KeyScope,
    AttachWords, FileCardView,
} from "../chat.slint";
import { WorkbenchPalette as P } from "palette.slint";

component TabItem inherits Rectangle {
    in property <string> id;
    in property <string> title;
    in property <ChatKind> kind;
    callback menu(length, length);          // a right click, where it is in the window
    property <bool> active: id == Conversation.chat-id;
    width: row.preferred-width;
    background: active ? P.tab-active : touch.has-hover ? P.tab-active.transparentize(0.5) : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Conversation.open(root.id);
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    row := HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: ChatIcons.kind(root.kind);
                size: 14px;
                color: root.active ? P.text : P.muted;
            }
        }
        Text {
            text: root.title;
            color: root.active ? P.text : P.muted;
            font-size: 13px;
            vertical-alignment: center;
            max-width: 180px;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 3px;
                background: close.has-hover ? P.line : transparent;
                Icon {
                    name: "x";
                    size: 12px;
                    color: P.faint;
                }
                close := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Conversation.close(root.id);
                    }
                    pointer-event(event) => {
                        if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                            root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                }
            }
        }
    }

    // The front tab: a line of accent on top.
    Rectangle {
        y: 0;
        height: 2px;
        background: root.active ? P.accent : transparent;
    }

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: P.line;
    }
}

export component MenuEntry inherits Rectangle {
    in property <string> icon;                // "": no icon, its place kept (a choice not ticked)
    in property <string> label;
    in property <string> keys;
    in property <bool> danger;                // deleting: in the danger colour
    in property <bool> enabled: true;
    callback activated();
    height: 32px;
    border-radius: 6px;
    background: touch.has-hover && enabled ? P.side : transparent;
    opacity: enabled ? 1 : 0.4;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                if root.icon != "": Icon {
                    name: root.icon;
                    size: 16px;
                    color: root.danger ? P.danger : P.text;
                }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: root.danger ? P.danger : P.text;
            font-size: 13px;
            vertical-alignment: center;
        }
        Text {
            text: root.keys;
            color: P.faint;
            font-family: P.mono;
            font-size: 11px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

component TabBar inherits Rectangle {
    height: 38px;
    background: P.tab;

    // A tab's menu, from a right click on it: muting its chat, and closing it, the others, or all of
    // them.
    property <Tab> menu-tab;
    property <length> menu-x;
    property <length> menu-y;

    function show-tab-menu(tab: Tab, left: length, top: length) {
        root.menu-tab = tab;
        root.menu-x = max(0px, min(left - root.absolute-position.x, root.width - 230px));
        root.menu-y = top - root.absolute-position.y;
        tab-menu.show();
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: P.line;
    }

    HorizontalLayout {
        Flickable {
            horizontal-stretch: 1;
            mouse-drag-pan-enabled: false;
            content-width: tabs.preferred-width;
            tabs := HorizontalLayout {
                alignment: start;
                for tab in Conversation.tabs: TabItem {
                    id: tab.id;
                    title: tab.title;
                    kind: tab.kind;
                    menu(left, top) => {
                        root.show-tab-menu(tab, left, top);
                    }
                }
            }
        }

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 12px;
            // The chat's settings panel is still to come.
            VerticalLayout {
                alignment: center;
                Icon {
                    name: "sidebar-simple";
                    size: 17px;
                    color: P.muted;
                    opacity: 0.4;
                }
            }
            more := VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 4px;
                    background: more-touch.has-hover ? P.line : transparent;
                    Icon {
                        name: "dots-three";
                        size: 17px;
                        color: Conversation.chat-id == "" ? P.faint : P.muted;
                    }
                    more-touch := TouchArea {
                        enabled: Conversation.chat-id != "";
                        mouse-cursor: pointer;
                        clicked => {
                            menu.show();
                        }
                    }
                }
            }
        }
    }

    menu := PopupWindow {
        x: root.width - 244px;
        y: root.height - 4px;
        width: 230px;
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            border-radius: 8px;
            background: P.bg;
            border-width: 1px;
            border-color: P.line;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: P.shadow;

            VerticalLayout {
                padding: 6px;
                Text {
                    height: 26px;
                    x: 10px;
                    text: Conversation.title.to-uppercase();
                    color: P.faint;
                    font-size: 11px;
                    font-weight: 600;
                    letter-spacing: 0.88px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                MenuEntry {
                    icon: Conversation.muted ? "bell" : "bell-slash";
                    label: Conversation.muted ? @tr("Unmute") : @tr("Mute");
                    keys: "⌘⇧M";
                    activated => {
                        Conversation.toggle-mute();
                        menu.close();
                    }
                }
                MenuEntry {
                    icon: "push-pin";
                    label: Conversation.pinned ? @tr("Unpin") : @tr("Pin");
                    activated => {
                        Conversation.toggle-pin();
                        menu.close();
                    }
                }
                MenuEntry {
                    icon: "checks";
                    label: @tr("Mark as read");
                    keys: "⌘⇧R";
                    activated => {
                        Conversation.mark-read();
                        menu.close();
                    }
                }
                Rectangle {
                    height: 9px;
                    Rectangle {
                        height: 1px;
                        background: P.line;
                    }
                }
                MenuEntry {
                    icon: "x-square";
                    label: @tr("Close other tabs");
                    keys: "⌘⌥W";
                    enabled: Conversation.tabs.length > 1;
                    activated => {
                        Conversation.close-others(Conversation.chat-id);
                        menu.close();
                    }
                }
            }
        }
    }

    tab-menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 230px;
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            border-radius: 8px;
            background: P.bg;
            border-width: 1px;
            border-color: P.line;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: P.shadow;

            VerticalLayout {
                padding: 6px;
                Text {
                    height: 26px;
                    x: 10px;
                    text: root.menu-tab.title.to-uppercase();
                    color: P.faint;
                    font-size: 11px;
                    font-weight: 600;
                    letter-spacing: 0.88px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                MenuEntry {
                    icon: root.menu-tab.muted ? "bell" : "bell-slash";
                    label: root.menu-tab.muted ? @tr("Unmute") : @tr("Mute");
                    activated => {
                        Chats.toggle-mute(root.menu-tab.id);
                        tab-menu.close();
                    }
                }
                Rectangle {
                    height: 9px;
                    Rectangle {
                        height: 1px;
                        background: P.line;
                    }
                }
                MenuEntry {
                    icon: "x";
                    label: @tr("Close tab");
                    activated => {
                        Conversation.close(root.menu-tab.id);
                        tab-menu.close();
                    }
                }
                MenuEntry {
                    icon: "x-square";
                    label: @tr("Close other tabs");
                    enabled: Conversation.tabs.length > 1;
                    activated => {
                        Conversation.close-others(root.menu-tab.id);
                        tab-menu.close();
                    }
                }
                MenuEntry {
                    icon: "x-circle";
                    label: @tr("Close all tabs");
                    activated => {
                        Conversation.close-all();
                        tab-menu.close();
                    }
                }
            }
        }
    }
}

// Colours of the letter squares, by kind of chat and sender (the design's avC).
global Avatars {
    public pure function fill(row: MessageRow, kind: ChatKind) -> color {
        if row.outgoing || kind == ChatKind.bot {
            return P.accent-soft;
        }
        if kind == ChatKind.saved {
            return P.teal-soft;
        }
        return P.chrome;
    }

    public pure function ink(row: MessageRow, kind: ChatKind) -> color {
        if row.outgoing || kind == ChatKind.bot {
            return P.accent-ink;
        }
        if kind == ChatKind.saved {
            return P.teal;
        }
        return P.text;
    }
}

component DayRule {
    in property <string> text;

    HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Rectangle {
                height: 1px;
                background: P.line;
            }
        }
        Text {
            text: root.text;
            color: P.faint;
            font-size: 12px;
            vertical-alignment: center;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Rectangle {
                height: 1px;
                background: P.line;
            }
        }
    }
}

// Who first wrote a forwarded message.
component ForwardedFrom inherits HorizontalLayout {
    in property <string> name;
    alignment: start;
    spacing: 5px;
    VerticalLayout {
        alignment: center;
        Icon {
            name: "arrow-bend-up-right";
            size: 13px;
            color: P.teal;
        }
    }
    Text {
        text: @tr("Forwarded from {0}", root.name);
        color: P.teal;
        font-size: 12px;
        overflow: elide;
    }
}

// The message a reply answers, as a pill: who wrote it and its first line; a click goes to it.
component ReplyPill inherits Rectangle {
    in property <ReplyQuote> quote;
    property <bool> reachable: !quote.gone && quote.id != "";
    preferred-width: pill.preferred-width;
    min-width: 96px;
    height: pill.preferred-height;
    border-radius: 6px;
    background: P.side;
    border-width: 1px;
    border-color: P.line;

    pill := HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: "arrow-bend-up-left";
                size: 13px;
                color: P.accent;
            }
        }
        if root.quote.has-picture: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 4px;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.quote.picture;
                    image-fit: cover;
                }
            }
        }
        if root.quote.sender != "": Text {
            text: root.quote.sender;
            color: P.accent-ink;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: ActionWords.quote-line(root.quote);
            color: root.quote.gone ? P.faint : P.muted;
            font-italic: root.quote.gone;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    TouchArea {
        mouse-cursor: root.reachable ? pointer : default;
        clicked => {
            if root.reachable {
                Actions.jump(root.quote.id);
            }
        }
    }
}

// The circle in front of a message while messages are being chosen; ticked when it is chosen.
component Choice inherits Rectangle {
    in property <bool> on;
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background: on ? P.accent : transparent;
    border-width: on ? 0 : 1.5px;
    border-color: P.faint;

    if root.on: Icon {
        name: "check";
        size: 12px;
        color: P.on-accent;
    }
}

// A message's row: its area, and its light (chosen, jumped to, its menu open, under the pointer),
// a little wider than the message, as the design's 1c draws it.
component Row {
    in property <MessageRow> message;
    in property <length> content-height;
    height: content-height + 12px;

    area := MessageArea {
        message: root.message;
        Rectangle {
            x: -8px;
            width: parent.width + 16px;
            border-radius: 6px;
            background: root.message.selected ? P.sel
                : Actions.flash == root.message.id ? P.accent-soft
                : Actions.menu-row == root.message.id || area.has-hover ? P.side : transparent;
            animate background { duration: 250ms; }
        }
        @children
    }
}

// A message in a chat: letter, sender, time, its photos and videos, words.
// A link's preview under a message, as the design's card: the site, the page's title, a line about
// it, and Instant View when Telegram has the page in its reading mode (greyed: not in FinchGram
// yet). A click opens the link.
component PreviewCard inherits Rectangle {
    in property <LinkPreview> preview;
    border-radius: 8px;
    border-width: 1px;
    border-color: P.line;
    background: touch.has-hover ? P.side : transparent;
    height: card.preferred-height;

    card := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.preview.site;
                color: P.faint;
                font-size: 11px;
                overflow: elide;
            }
            Text {
                text: root.preview.title;
                color: P.text;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }
            if root.preview.about != "": Text {
                text: root.preview.about;
                color: P.muted;
                font-size: 12px;
                overflow: elide;
            }
        }
        if root.preview.instant-view: VerticalLayout {
            alignment: center;
            Rectangle {
                width: pill.preferred-width + 20px;
                height: pill.preferred-height + 8px;
                border-radius: 12px;
                background: P.accent-soft;
                opacity: 0.5;
                pill := HorizontalLayout {
                    alignment: center;
                    spacing: 4px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: "lightning";
                            size: 12px;
                            color: P.accent-ink;
                        }
                    }
                    Text {
                        text: @tr("Instant View");
                        color: P.accent-ink;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Conversation.open-link(root.preview.url);
        }
    }
}

component MessageLine {
    in property <MessageRow> message;
    property <bool> has-tiles: message.media.length > 0;
    property <bool> has-media: has-tiles || message.files.length > 0;
    property <bool> has-sticker: message.content == Content.sticker && message.sticker.width > 0;

    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: start;
            Avatar {
                size: 30px;
                radius: 6px;
                fill: Avatars.fill(root.message, Conversation.kind);
                ink: Avatars.ink(root.message, Conversation.kind);
                initial: root.message.sender-initial;
                picture: root.message.sender-picture;
                has-picture: root.message.has-sender-picture;
                font-size: 13px;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                Text {
                    text: root.message.sender;
                    color: P.text;
                    font-size: 14px;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: root.message.edited ? root.message.time + " · " + @tr("edited") : root.message.time;
                    color: P.faint;
                    font-size: 12px;
                    vertical-alignment: bottom;
                }
                if root.message.sending: VerticalLayout {
                    alignment: center;
                    Icon {
                        name: "clock";
                        size: 12px;
                        color: P.faint;
                    }
                }
            }
            if root.message.forwarded-from != "": ForwardedFrom {
                name: root.message.forwarded-from;
            }
            if root.message.reply.shown: HorizontalLayout {
                alignment: start;
                padding-top: 1px;
                padding-bottom: 1px;
                ReplyPill {
                    quote: root.message.reply;
                }
            }
            if root.has-tiles: HorizontalLayout {
                alignment: start;
                padding-top: 3px;
                padding-bottom: 2px;
                MediaTiles {
                    media: root.message.media;
                    width-limit: 360px;
                    badge-font: P.mono;
                    mono-font: P.mono;
                    failed: root.message.failed;
                    open(id) => {
                        Viewer.view(id, true);
                    }
                    cancel(id) => {
                        Conversation.cancel-upload(id);
                    }
                }
            }
            for file in root.message.files: HorizontalLayout {
                alignment: start;
                padding-top: 3px;
                padding-bottom: 2px;
                FileCardView {
                    file: file;
                    font-family: P.font;
                    text: P.text;
                    muted: P.muted;
                    line: P.line;
                    hover: P.side;
                    accent: P.accent;
                    accent-ink: P.accent-ink;
                    on-accent: P.on-accent;
                    soft: P.accent-soft;
                    track: P.track;
                    pdf: P.file-pdf;
                    zip: P.file-zip;
                    picture: P.file-image;
                }
            }
            if root.has-sticker: HorizontalLayout {
                alignment: start;
                padding-top: 3px;
                padding-bottom: 2px;
                StickerPicture {
                    message-id: root.message.id;
                    sticker: root.message.sticker;
                }
            }
            if root.message.rich && !root.has-sticker: RichText {
                text: root.message.rich-text;
                default-color: P.text;
                default-font-size: 14px;
                link-color: P.accent-ink;
            }
            if !root.message.rich && !root.has-sticker && (!root.has-media || root.message.text != ""): Paragraph {
                text: root.has-media ? root.message.text : Fmt.body(root.message.content, root.message.text, root.message.detail);
                color: root.has-media || root.message.content == Content.text ? P.text : P.muted;
                font-size: 14px;
                line-height-factor: P.leading(1.55);
            }
            if root.message.preview.url != "": HorizontalLayout {
                alignment: start;
                padding-top: 4px;
                PreviewCard {
                    preview: root.message.preview;
                    max-width: 460px;
                }
            }
            // Not sent: say so, with Retry and Delete (the design's sixth round).
            if root.message.failed: HorizontalLayout {
                alignment: start;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 4px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: "warning-circle";
                            size: 14px;
                            color: P.danger;
                        }
                    }
                    Text {
                        text: AttachWords.not-sent();
                        color: P.danger;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: retry.preferred-width;
                    retry := Text {
                        text: AttachWords.retry();
                        color: P.accent-ink;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Conversation.retry(root.message.id);
                        }
                    }
                }
                Rectangle {
                    width: discard.preferred-width;
                    discard := Text {
                        text: AttachWords.delete();
                        color: P.danger;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Conversation.discard(root.message.id);
                        }
                    }
                }
            }
        }
    }
}

// A channel's post, set for reading: its photos and videos first.
component PostLine inherits Capped {
    in property <MessageRow> message;
    property <bool> has-media: message.media.length > 0;
    property <bool> has-sticker: message.content == Content.sticker && message.sticker.width > 0;
    spacing: 6px;

    if root.message.forwarded-from != "": ForwardedFrom {
        name: root.message.forwarded-from;
    }
    if root.message.reply.shown: HorizontalLayout {
        alignment: start;
        ReplyPill {
            quote: root.message.reply;
        }
    }
    if root.has-media: HorizontalLayout {
        alignment: start;
        MediaTiles {
            media: root.message.media;
            width-limit: 520px;
            badge-font: P.mono;
            mono-font: P.mono;
            failed: root.message.failed;
            open(id) => {
                Viewer.view(id, true);
            }
            cancel(id) => {
                Conversation.cancel-upload(id);
            }
        }
    }
    if root.has-sticker: HorizontalLayout {
        alignment: start;
        StickerPicture {
            message-id: root.message.id;
            sticker: root.message.sticker;
        }
    }
    if root.message.rich && !root.has-sticker: RichText {
        text: root.message.rich-text;
        default-color: P.text;
        default-font-size: 14px;
        link-color: P.accent-ink;
    }
    if !root.message.rich && !root.has-sticker && (!root.has-media || root.message.text != ""): Paragraph {
        text: root.has-media ? root.message.text : Fmt.body(root.message.content, root.message.text, root.message.detail);
        color: P.text;
        font-size: 14px;
        line-height-factor: P.leading(1.7);
    }
    if root.message.preview.url != "": PreviewCard {
        preview: root.message.preview;
    }
    Text {
        text: root.message.edited ? root.message.time + " · " + @tr("edited") : root.message.time;
        color: P.faint;
        font-size: 12px;
    }
}

// A sponsored message: Telegram's own, shown as it comes, never hidden.
component SponsoredCard inherits Rectangle {
    in property <MessageRow> message;
    height: card.preferred-height;
    border-radius: 8px;
    background: P.side;
    border-width: 1px;
    border-color: P.line;

    card := VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                text: @tr("Sponsored").to-uppercase();
                color: P.faint;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 0.44px;
            }
            Text {
                text: @tr("Premium users can turn these off");
                color: P.accent-ink;
                font-size: 11px;
            }
        }
        Text {
            text: root.message.sender;
            color: P.text;
            font-size: 14px;
            font-weight: 600;
            overflow: elide;
        }
        Paragraph {
            text: root.message.text;
            color: P.muted;
            font-size: 13px;
            line-height-factor: P.leading(1.5);
        }
        if root.message.button != "": HorizontalLayout {
            alignment: start;
            Rectangle {
                height: 28px;
                width: action.preferred-width + 24px;
                border-radius: 6px;
                background: action-touch.has-hover ? P.accent-soft.darker(0.05) : P.accent-soft;
                action := Text {
                    text: root.message.button;
                    color: P.accent-ink;
                    font-size: 13px;
                    font-weight: 600;
                }
                action-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Conversation.open-sponsored(root.message.id);
                    }
                }
            }
        }
        Text {
            text: @tr("Telegram's sponsored message · FinchGram shows it as it is");
            color: P.faint;
            font-size: 11px;
        }
    }
}

component Line {
    in property <MessageRow> message;
    // Conversation.reveal names this row: the list scrolls to it.
    callback reveal(length, length);
    property <bool> wanted: message.id != "" && Conversation.reveal == message.id;
    changed wanted => {
        if self.wanted {
            root.reveal(root.y, root.y + root.height);
        }
    }

    // A message's row has 6px of light above and below it; the other rows have as much room.
    VerticalLayout {
        padding-top: root.message.kind == RowKind.message ? 0 : 6px;
        padding-bottom: root.message.kind == RowKind.message ? 0 : 6px;
        if root.message.kind == RowKind.day: DayRule {
            text: Fmt.day-title(root.message.day);
        }
        if root.message.kind == RowKind.service: Paragraph {
            text: Fmt.service(root.message.content, root.message.outgoing ? @tr("You") : root.message.sender, root.message.detail);
            color: P.faint;
            font-size: 12px;
            horizontal-alignment: center;
        }
        if root.message.kind == RowKind.sponsored: Capped {
            SponsoredCard {
                message: root.message;
            }
        }
        if root.message.kind == RowKind.message: Row {
            message: root.message;
            content-height: body.preferred-height;
            body := HorizontalLayout {
                y: 6px;
                height: self.preferred-height;
                spacing: 12px;
                if Actions.selecting: VerticalLayout {
                    alignment: start;
                    padding-top: Conversation.kind == ChatKind.channel ? 2px : 6px;
                    Choice {
                        on: root.message.selected;
                    }
                }
                if Conversation.kind == ChatKind.channel: PostLine {
                    message: root.message;
                }
                if Conversation.kind != ChatKind.channel: MessageLine {
                    message: root.message;
                }
            }
        }
    }
}

component Chip inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <color> fill;
    in property <color> ink;
    height: 20px;
    width: chip.preferred-width;
    border-radius: 10px;
    background: fill;

    chip := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                size: 12px;
                color: root.ink;
            }
        }
        Text {
            text: root.label;
            color: root.ink;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

// The strip above the composer: replying to a message, editing ours, forwarding messages here.
component ComposeStrip inherits Rectangle {
    height: strip.preferred-height;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: P.line;
    }

    strip := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: Actions.bar == ComposeBar.reply ? "arrow-bend-up-left" : Actions.bar == ComposeBar.edit ? "pencil-simple" : "arrow-bend-up-right";
                size: 18px;
                color: P.accent;
            }
        }
        if Actions.bar-has-picture: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 4px;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: Actions.bar-picture;
                    image-fit: cover;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: ActionWords.bar-title();
                color: P.accent-ink;
                font-size: 12px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: ActionWords.bar-line();
                color: P.muted;
                font-size: 12px;
                overflow: elide;
            }
        }
        if Actions.bar == ComposeBar.forward: VerticalLayout {
            alignment: center;
            Rectangle {
                width: hide.preferred-width + 16px;
                height: hide.preferred-height + 8px;
                border-radius: 6px;
                background: hide-touch.has-hover ? P.side : transparent;
                hide := HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: Actions.hide-sender ? "check-square" : "square";
                            size: 16px;
                            color: Actions.hide-sender ? P.accent : P.faint;
                        }
                    }
                    Text {
                        text: @tr("Hide sender's name");
                        color: P.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
                hide-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Actions.hide-sender = !Actions.hide-sender;
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 23px;
                height: 23px;
                Icon {
                    name: "x";
                    size: 15px;
                    color: P.faint;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Actions.cancel-bar();
                    }
                }
            }
        }
    }
}

// A button of the bar that stands in for the composer while messages are chosen; faded when the
// messages chosen do not all allow it.
component BarButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> danger;
    callback activated();
    width: row.preferred-width + 20px;
    height: 30px;
    border-radius: 6px;
    background: touch.has-hover && root.enabled ? P.side : transparent;
    opacity: root.enabled ? 1 : 0.4;

    row := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                size: 16px;
                color: root.danger ? P.danger : P.text;
            }
        }
        Text {
            text: root.label;
            color: root.danger ? P.danger : P.text;
            font-size: 13px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

// Choosing messages: how many, and what to do with them all (the design's 1c: in place of the
// composer).
component SelectionBar inherits Rectangle {
    height: max(50px, bar.preferred-height);
    border-radius: 8px;
    background: P.bg;
    border-width: 1px;
    border-color: P.line;

    KeyScope {
        width: 0;
        height: 0;
        escape => {
            Actions.cancel-selection();
        }
    }

    bar := HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 2px;
        Text {
            text: ActionWords.selected();
            color: P.text;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            padding-left: 10px;
            padding-right: 10px;
            Text {
                text: @tr("Shift-click to select a range");
                color: P.faint;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            BarButton {
                icon: "arrow-bend-up-right";
                label: @tr("Forward");
                enabled: Actions.can-forward;
                activated => {
                    Actions.forward-selected();
                }
            }
        }
        VerticalLayout {
            alignment: center;
            BarButton {
                icon: "copy";
                label: ActionWords.copy();
                enabled: Actions.can-copy;
                activated => {
                    Actions.copy-selected();
                }
            }
        }
        VerticalLayout {
            alignment: center;
            BarButton {
                icon: "trash";
                label: @tr("Delete");
                enabled: Actions.can-delete;
                danger: true;
                activated => {
                    Actions.delete-selected();
                }
            }
        }
        if Actions.report-offered: VerticalLayout {
            alignment: center;
            BarButton {
                icon: "flag";
                label: @tr("Report");
                enabled: Actions.can-report;
                activated => {
                    Actions.report-selected();
                }
            }
        }
        VerticalLayout {
            alignment: center;
            padding-left: 4px;
            padding-right: 4px;
            Rectangle {
                width: 1px;
                height: 20px;
                background: P.line;
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: cancel.preferred-width + 20px;
                height: 30px;
                border-radius: 6px;
                background: cancel-touch.has-hover ? P.side : transparent;
                cancel := Text {
                    text: @tr("Cancel");
                    color: P.accent-ink;
                    font-size: 13px;
                    font-weight: 600;
                }
                cancel-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Actions.cancel-selection();
                    }
                }
            }
        }
    }
}

component Pane {
    VerticalLayout {
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 10px;
            Text {
                text: Conversation.title;
                color: P.text;
                font-size: 16px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                horizontal-stretch: 1;
                text: Conversation.typing != "" ? @tr("typing…")
                    : Fmt.status(Conversation.status, Conversation.last-seen, Conversation.members, Conversation.online-members);
                color: Conversation.typing != "" ? P.accent-ink : P.faint;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
            if Conversation.kind == ChatKind.channel: VerticalLayout {
                alignment: center;
                Chip {
                    icon: "book-open";
                    label: @tr("Reading mode");
                    fill: P.teal-soft;
                    ink: P.teal;
                }
            }
            // Searching in the chat is still to come.
            VerticalLayout {
                alignment: center;
                Icon {
                    name: "magnifying-glass";
                    size: 17px;
                    color: P.muted;
                    opacity: 0.4;
                }
            }
        }

        scroll := ChatScroll {
            vertical-stretch: 1;
            // 14px between messages, less their rows' light (Line).
            spacing: 2px;
            margin-left: 20px;
            margin-right: 20px;
            margin-top: 4px;
            margin-bottom: 18px;
            for row in Conversation.messages: Line {
                message: row;
                reveal(top, bottom) => {
                    scroll.reveal(top, bottom);
                }
            }
            if Conversation.typing != "": Text {
                text: @tr("{0} is typing…", Conversation.typing);
                color: P.faint;
                font-size: 13px;
            }
        }

        if Conversation.can-write && !Actions.selecting: HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 16px;
            Rectangle {
                border-radius: 8px;
                background: P.bg;
                border-width: 1px;
                border-color: input.has-focus ? P.accent.transparentize(0.4) : P.line;
                height: box.preferred-height;
                // A reply or an edit begins, a menu or dialog closed: the keyboard comes back here.
                property <int> focus-requests: Actions.focus-requests;
                changed focus-requests => {
                    input.focus-text();
                }
                init => {
                    input.focus-text();
                }

                box := VerticalLayout {
                    if Actions.bar != ComposeBar.none: ComposeStrip { }
                    input := MessageInput {
                        text <=> Conversation.draft;
                        allow-empty: Actions.bar == ComposeBar.forward;
                        placeholder: @tr("Send to {0}", Conversation.title);
                        text-color: P.text;
                        placeholder-color: P.faint;
                        selection-color: P.sel;
                        font-family: P.font;
                        font-size: 14px;
                        base-height: 40px;
                        send(words) => {
                            Conversation.send(words);
                        }
                        edited(words) => {
                            Conversation.edited(words);
                        }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 6px;
                        padding-bottom: 8px;
                        spacing: 12px;
                        // The paperclip: photos, videos and files (attachments.slint); quick
                        // replies and scheduling are still to come.
                        VerticalLayout {
                            alignment: center;
                            clip := Rectangle {
                                property <bool> allowed: Conversation.can-send-photos || Conversation.can-send-videos || Conversation.can-send-files;
                                width: 28px;
                                height: 28px;
                                border-radius: 6px;
                                background: Attachments.menu-open || (clip-touch.has-hover && self.allowed) ? P.side : transparent;
                                Icon {
                                    name: "paperclip";
                                    size: 17px;
                                    color: Attachments.menu-open ? P.accent : clip-touch.has-hover && clip.allowed ? P.text : P.faint;
                                    opacity: clip.allowed ? 1 : 0.4;
                                }
                                clip-touch := TouchArea {
                                    mouse-cursor: clip.allowed ? pointer : not-allowed;
                                    clicked => {
                                        if clip.allowed {
                                            Attachments.menu-x = self.absolute-position.x;
                                            Attachments.menu-y = self.absolute-position.y;
                                            Attachments.menu-focus = -1;
                                            Attachments.menu-keyboard = false;
                                            Attachments.menu-open = !Attachments.menu-open;
                                        }
                                    }
                                }
                                if clip-touch.has-hover && !Attachments.menu-open: Rectangle {
                                    x: 0;
                                    y: -self.height - 8px;
                                    width: tip.preferred-width + 20px;
                                    height: tip.preferred-height + 12px;
                                    border-radius: 6px;
                                    background: P.text;
                                    drop-shadow-blur: 20px;
                                    drop-shadow-offset-y: 6px;
                                    drop-shadow-color: #00000033;
                                    tip := Text {
                                        text: clip.allowed ? AttachWords.attach() : AttachWords.cant-send();
                                        color: P.bg;
                                        font-size: 12px;
                                    }
                                }
                            }
                        }
                        for name in ["lightning", "clock"]: VerticalLayout {
                            alignment: center;
                            Icon {
                                name: name;
                                size: 16px;
                                color: P.faint;
                                opacity: 0.45;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if Actions.bar != ComposeBar.none: Text {
                            text: @tr("Esc to cancel");
                            color: P.faint;
                            font-family: P.mono;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: Actions.bar == ComposeBar.edit
                                ? (AppState.send-with-enter ? @tr("⏎ save · ⇧⏎ new line") : @tr("⌘⏎ save · ⏎ new line"))
                                : (AppState.send-with-enter ? @tr("⏎ send · ⇧⏎ new line") : @tr("⌘⏎ send · ⏎ new line"));
                            color: P.faint;
                            font-family: P.mono;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        if Actions.selecting: HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 16px;
            SelectionBar { }
        }

        // A channel one only reads: muting it, in place of the composer.
        if Conversation.kind == ChatKind.channel && !Conversation.can-write && !Actions.selecting: HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 16px;
            Rectangle {
                height: 44px;
                border-radius: 8px;
                border-width: 1px;
                border-color: P.line;
                background: mute-touch.has-hover ? P.side : transparent;
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: "bell-simple-slash";
                            size: 16px;
                            color: P.accent-ink;
                        }
                    }
                    Text {
                        text: Conversation.muted ? @tr("Unmute") : @tr("Mute");
                        color: P.accent-ink;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                mute-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Conversation.toggle-mute();
                    }
                }
            }
        }
    }
}

export component WorkbenchMain inherits Rectangle {
    background: P.bg;

    VerticalLayout {
        TabBar { }
        if Conversation.chat-id != "": Pane {
            vertical-stretch: 1;
        }
        if Conversation.chat-id == "": Rectangle {
            vertical-stretch: 1;
            Text {
                text: @tr("Choose a chat on the left");
                color: P.faint;
                font-size: 14px;
            }
        }
    }

    // What was just done (copied, saved, reported): a floating strip above the composer.
    if Actions.notice != ActionNotice.none: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 96px - self.height;
        width: notice.preferred-width;
        height: notice.preferred-height;
        border-radius: 8px;
        background: P.text;
        drop-shadow-blur: 30px;
        drop-shadow-offset-y: 10px;
        drop-shadow-color: #00000040;
        notice := HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 9px;
            padding-bottom: 9px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Icon {
                    name: "check-circle";
                    size: 16px;
                    color: P.bg;
                }
            }
            Text {
                text: ActionWords.notice(Actions.notice);
                color: P.bg;
                font-size: 13px;
                vertical-alignment: center;
            }
        }
    }
}
