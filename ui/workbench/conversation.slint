// Workbench's main area: the tabs of the open chats, and the chat in front — its header, the
// messages as rows (a letter, the sender and time, the text), and where to write.
import { AppState, Screenshot } from "../state.slint";
import {
    Conversation, MessageRow, RowKind, ChatKind, Content, Account, Viewer, LinkPreview, ReplyQuote, Actions, ComposeBar,
    ActionNotice, Tab, Chats, Attachments,
} from "../telegram.slint";
import { Fmt } from "../format.slint";
import { Icon, Paragraph, Avatar } from "../widgets.slint";
import {
    ChatScroll, ChatIcons, MessageInput, Capped, MediaTiles, StickerPicture, RichText, MessageArea, ActionWords, KeyScope,
    AttachWords, FileCardView, SearchInput, SearchWords, ButtonGrid, BotWords,
} from "../chat.slint";
import { WorkbenchPalette as P } from "palette.slint";
import { ExtraWords, ReactionChips, ReactionPicker, RoundNoteView, ContactCardView, TopicList, AdminPanelView } from "../extras.slint";

component TabItem inherits Rectangle {
    in property <string> id;
    in property <string> title;
    in property <ChatKind> kind;
    callback menu(length, length);          // a right click, where it is in the window
    property <bool> active: id == Conversation.chat-id;
    width: row.preferred-width;
    background: active ? P.tab-active : touch.has-hover ? P.tab-active.transparentize(0.5) : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Conversation.open(root.id);
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    row := HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: ChatIcons.kind(root.kind);
                size: 14px;
                color: root.active ? P.text : P.muted;
            }
        }
        Text {
            text: root.title;
            color: root.active ? P.text : P.muted;
            font-size: 13px;
            vertical-alignment: center;
            max-width: 180px;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 3px;
                background: close.has-hover ? P.line : transparent;
                Icon {
                    name: "x";
                    size: 12px;
                    color: P.faint;
                }
                close := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Conversation.close(root.id);
                    }
                    pointer-event(event) => {
                        if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                            root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                }
            }
        }
    }

    // The front tab: a line of accent on top.
    Rectangle {
        y: 0;
        height: 2px;
        background: root.active ? P.accent : transparent;
    }

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: P.line;
    }
}

export component MenuEntry inherits Rectangle {
    in property <string> icon;                // "": no icon, its place kept (a choice not ticked)
    in property <string> label;
    in property <string> keys;
    in property <bool> danger;                // deleting: in the danger colour
    in property <bool> enabled: true;
    in property <length> indent;              // one of a group's choices, under the group's name
    callback activated();
    height: 32px;
    border-radius: 6px;
    background: touch.has-hover && enabled ? P.side : transparent;
    opacity: enabled ? 1 : 0.4;

    HorizontalLayout {
        padding-left: 10px + root.indent;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                if root.icon != "": Icon {
                    name: root.icon;
                    size: 16px;
                    color: root.danger ? P.danger : P.text;
                }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: root.danger ? P.danger : P.text;
            font-size: 13px;
            vertical-alignment: center;
        }
        Text {
            text: root.keys;
            color: P.faint;
            font-family: P.mono;
            font-size: 11px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

component TabBar inherits Rectangle {
    height: 38px;
    background: P.tab;

    // A tab's menu, from a right click on it: muting its chat, and closing it, the others, or all of
    // them.
    property <Tab> menu-tab;
    property <length> menu-x;
    property <length> menu-y;

    function show-tab-menu(tab: Tab, left: length, top: length) {
        root.menu-tab = tab;
        root.menu-x = max(0px, min(left - root.absolute-position.x, root.width - 230px));
        root.menu-y = top - root.absolute-position.y;
        tab-menu.show();
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: P.line;
    }

    HorizontalLayout {
        Flickable {
            horizontal-stretch: 1;
            mouse-drag-pan-enabled: false;
            content-width: tabs.preferred-width;
            tabs := HorizontalLayout {
                alignment: start;
                for tab in Conversation.tabs: TabItem {
                    id: tab.id;
                    title: tab.title;
                    kind: tab.kind;
                    menu(left, top) => {
                        root.show-tab-menu(tab, left, top);
                    }
                }
            }
        }

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 12px;
            // The chat's settings panel: a group's rules, or its administration (admin.rs).
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 4px;
                    background: Conversation.settings-open ? P.accent-soft : settings-touch.has-hover ? P.line : transparent;
                    Icon {
                        name: "sidebar-simple";
                        size: 17px;
                        color: Conversation.chat-id == "" ? P.faint : Conversation.settings-open ? P.accent-ink : P.muted;
                    }
                    settings-touch := TouchArea {
                        enabled: Conversation.chat-id != "";
                        mouse-cursor: pointer;
                        clicked => {
                            Conversation.toggle-settings();
                        }
                    }
                }
            }
            more := VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 4px;
                    background: more-touch.has-hover ? P.line : transparent;
                    Icon {
                        name: "dots-three";
                        size: 17px;
                        color: Conversation.chat-id == "" ? P.faint : P.muted;
                    }
                    more-touch := TouchArea {
                        enabled: Conversation.chat-id != "";
                        mouse-cursor: pointer;
                        clicked => {
                            menu.show();
                        }
                    }
                }
            }
        }
    }

    menu := PopupWindow {
        x: root.width - 244px;
        y: root.height - 4px;
        width: 230px;
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            border-radius: 8px;
            background: P.bg;
            border-width: 1px;
            border-color: P.line;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: P.shadow;

            VerticalLayout {
                padding: 6px;
                Text {
                    height: 26px;
                    x: 10px;
                    text: Conversation.title.to-uppercase();
                    color: P.faint;
                    font-size: 11px;
                    font-weight: 600;
                    letter-spacing: 0.88px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                MenuEntry {
                    icon: Conversation.muted ? "bell" : "bell-slash";
                    label: Conversation.muted ? @tr("Unmute") : @tr("Mute");
                    keys: "⌘⇧M";
                    activated => {
                        Conversation.toggle-mute();
                        menu.close();
                    }
                }
                MenuEntry {
                    icon: "push-pin";
                    label: Conversation.pinned ? @tr("Unpin") : @tr("Pin");
                    activated => {
                        Conversation.toggle-pin();
                        menu.close();
                    }
                }
                MenuEntry {
                    icon: "copy";
                    label: @tr("Copy ID");
                    activated => {
                        Conversation.copy-id();
                        menu.close();
                    }
                }
                Rectangle {
                    height: 9px;
                    Rectangle {
                        height: 1px;
                        background: P.line;
                    }
                }
                MenuEntry {
                    icon: "x-square";
                    label: @tr("Close other tabs");
                    keys: "⌘⌥W";
                    enabled: Conversation.tabs.length > 1;
                    activated => {
                        Conversation.close-others(Conversation.chat-id);
                        menu.close();
                    }
                }
            }
        }
    }

    tab-menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 230px;
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            border-radius: 8px;
            background: P.bg;
            border-width: 1px;
            border-color: P.line;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: P.shadow;

            VerticalLayout {
                padding: 6px;
                Text {
                    height: 26px;
                    x: 10px;
                    text: root.menu-tab.title.to-uppercase();
                    color: P.faint;
                    font-size: 11px;
                    font-weight: 600;
                    letter-spacing: 0.88px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                MenuEntry {
                    icon: root.menu-tab.muted ? "bell" : "bell-slash";
                    label: root.menu-tab.muted ? @tr("Unmute") : @tr("Mute");
                    activated => {
                        Chats.toggle-mute(root.menu-tab.id);
                        tab-menu.close();
                    }
                }
                Rectangle {
                    height: 9px;
                    Rectangle {
                        height: 1px;
                        background: P.line;
                    }
                }
                MenuEntry {
                    icon: "x";
                    label: @tr("Close tab");
                    activated => {
                        Conversation.close(root.menu-tab.id);
                        tab-menu.close();
                    }
                }
                MenuEntry {
                    icon: "x-square";
                    label: @tr("Close other tabs");
                    enabled: Conversation.tabs.length > 1;
                    activated => {
                        Conversation.close-others(root.menu-tab.id);
                        tab-menu.close();
                    }
                }
                MenuEntry {
                    icon: "x-circle";
                    label: @tr("Close all tabs");
                    activated => {
                        Conversation.close-all();
                        tab-menu.close();
                    }
                }
            }
        }
    }
}

// Colours of the letter squares, by kind of chat and sender (the design's avC).
global Avatars {
    public pure function fill(row: MessageRow, kind: ChatKind) -> color {
        if row.outgoing || kind == ChatKind.bot {
            return P.accent-soft;
        }
        if kind == ChatKind.saved {
            return P.teal-soft;
        }
        return P.chrome;
    }

    public pure function ink(row: MessageRow, kind: ChatKind) -> color {
        if row.outgoing || kind == ChatKind.bot {
            return P.accent-ink;
        }
        if kind == ChatKind.saved {
            return P.teal;
        }
        return P.text;
    }
}

component DayRule {
    in property <string> text;

    HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Rectangle {
                height: 1px;
                background: P.line;
            }
        }
        Text {
            text: root.text;
            color: P.faint;
            font-size: 12px;
            vertical-alignment: center;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Rectangle {
                height: 1px;
                background: P.line;
            }
        }
    }
}

// Who first wrote a forwarded message.
component ForwardedFrom inherits HorizontalLayout {
    in property <string> name;
    alignment: start;
    spacing: 5px;
    VerticalLayout {
        alignment: center;
        Icon {
            name: "arrow-bend-up-right";
            size: 13px;
            color: P.teal;
        }
    }
    Text {
        text: @tr("Forwarded from {0}", root.name);
        color: P.teal;
        font-size: 12px;
        overflow: elide;
    }
}

// The message a reply answers, as a pill: who wrote it and its first line; a click goes to it.
component ReplyPill inherits Rectangle {
    in property <ReplyQuote> quote;
    property <bool> reachable: !quote.gone && quote.id != "";
    preferred-width: pill.preferred-width;
    min-width: 96px;
    height: pill.preferred-height;
    border-radius: 6px;
    background: P.side;
    border-width: 1px;
    border-color: P.line;

    pill := HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: "arrow-bend-up-left";
                size: 13px;
                color: P.accent;
            }
        }
        if root.quote.has-picture: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 4px;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.quote.picture;
                    image-fit: cover;
                }
            }
        }
        if root.quote.sender != "": Text {
            text: root.quote.sender;
            color: P.accent-ink;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: ActionWords.quote-line(root.quote);
            color: root.quote.gone ? P.faint : P.muted;
            font-italic: root.quote.gone;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    TouchArea {
        mouse-cursor: root.reachable ? pointer : default;
        clicked => {
            if root.reachable {
                Actions.jump(root.quote.id);
            }
        }
    }
}

// The circle in front of a message while messages are being chosen; ticked when it is chosen.
component Choice inherits Rectangle {
    in property <bool> on;
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background: on ? P.accent : transparent;
    border-width: on ? 0 : 1.5px;
    border-color: P.faint;

    if root.on: Icon {
        name: "check";
        size: 12px;
        color: P.on-accent;
    }
}

// A message's row: its area, and its light (chosen, jumped to, its menu open, under the pointer),
// a little wider than the message, as the design's 1c draws it.
component Row {
    in property <MessageRow> message;
    in property <length> content-height;
    height: content-height + 12px;

    area := MessageArea {
        message: root.message;
        Rectangle {
            x: -8px;
            width: parent.width + 16px;
            border-radius: 6px;
            background: root.message.selected ? P.sel
                : Actions.flash == root.message.id ? P.accent-soft
                : Actions.menu-row == root.message.id || area.has-hover ? P.side : transparent;
            animate background { duration: 250ms; }
        }
        @children
    }
}

// A message in a chat: letter, sender, time, its photos and videos, words.
// A link's preview under a message, as the design's card: the site, the page's title, a line about
// it, and Instant View when Telegram has the page in its reading mode (greyed: not in FinchGram
// yet). A click opens the link.
component PreviewCard inherits Rectangle {
    in property <LinkPreview> preview;
    border-radius: 8px;
    border-width: 1px;
    border-color: P.line;
    background: touch.has-hover ? P.side : transparent;
    height: card.preferred-height;

    card := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.preview.site;
                color: P.faint;
                font-size: 11px;
                overflow: elide;
            }
            Text {
                text: root.preview.title;
                color: P.text;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }
            if root.preview.about != "": Text {
                text: root.preview.about;
                color: P.muted;
                font-size: 12px;
                overflow: elide;
            }
        }
        if root.preview.instant-view: VerticalLayout {
            alignment: center;
            Rectangle {
                width: pill.preferred-width + 20px;
                height: pill.preferred-height + 8px;
                border-radius: 12px;
                background: P.accent-soft;
                opacity: 0.5;
                pill := HorizontalLayout {
                    alignment: center;
                    spacing: 4px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: "lightning";
                            size: 12px;
                            color: P.accent-ink;
                        }
                    }
                    Text {
                        text: @tr("Instant View");
                        color: P.accent-ink;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Conversation.open-link(root.preview.url);
        }
    }
}

component MessageLine {
    in property <MessageRow> message;
    property <bool> has-tiles: message.media.length > 0;
    property <bool> has-media: has-tiles || message.files.length > 0;
    property <bool> has-sticker: message.content == Content.sticker && message.sticker.width > 0;

    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: start;
            Avatar {
                size: 30px;
                radius: 6px;
                fill: Avatars.fill(root.message, Conversation.kind);
                ink: Avatars.ink(root.message, Conversation.kind);
                initial: root.message.sender-initial;
                picture: root.message.sender-picture;
                has-picture: root.message.has-sender-picture;
                font-size: 13px;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                Text {
                    text: root.message.sender;
                    color: P.text;
                    font-size: 14px;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: root.message.edited ? root.message.time + " · " + @tr("edited") : root.message.time;
                    color: P.faint;
                    font-size: 12px;
                    vertical-alignment: bottom;
                }
                if root.message.sending: VerticalLayout {
                    alignment: center;
                    Icon {
                        name: "clock";
                        size: 12px;
                        color: P.faint;
                    }
                }
                // The smiley opens the reactions' picker (a double click reacts at once).
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 16px;
                        height: 16px;
                        Icon {
                            name: "smiley";
                            size: 14px;
                            color: smile.has-hover || Conversation.reaction-picker == root.message.id ? P.accent : P.faint;
                            opacity: smile.has-hover || Conversation.reaction-picker == root.message.id ? 1 : 0.7;
                        }
                        smile := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if Conversation.reaction-picker == root.message.id {
                                    Conversation.close-reactions();
                                } else {
                                    Conversation.open-reactions(root.message.id);
                                }
                            }
                        }
                    }
                }
            }
            if root.message.forwarded-from != "": ForwardedFrom {
                name: root.message.forwarded-from;
            }
            if root.message.reply.shown: HorizontalLayout {
                alignment: start;
                padding-top: 1px;
                padding-bottom: 1px;
                ReplyPill {
                    quote: root.message.reply;
                }
            }
            if root.has-tiles: HorizontalLayout {
                alignment: start;
                padding-top: 3px;
                padding-bottom: 2px;
                MediaTiles {
                    media: root.message.media;
                    width-limit: 360px;
                    badge-font: P.mono;
                    mono-font: P.mono;
                    failed: root.message.failed;
                    open(id) => {
                        Viewer.view(id, true);
                    }
                    cancel(id) => {
                        Conversation.cancel-upload(id);
                    }
                }
            }
            for file in root.message.files: HorizontalLayout {
                alignment: start;
                padding-top: 3px;
                padding-bottom: 2px;
                FileCardView {
                    file: file;
                    font-family: P.font;
                    text: P.text;
                    muted: P.muted;
                    line: P.line;
                    hover: P.side;
                    accent: P.accent;
                    accent-ink: P.accent-ink;
                    on-accent: P.on-accent;
                    soft: P.accent-soft;
                    track: P.track;
                    pdf: P.file-pdf;
                    zip: P.file-zip;
                    picture: P.file-image;
                }
            }
            if root.has-sticker: HorizontalLayout {
                alignment: start;
                padding-top: 3px;
                padding-bottom: 2px;
                StickerPicture {
                    message-id: root.message.id;
                    sticker: root.message.sticker;
                }
            }
            if root.message.rich && !root.has-sticker: RichText {
                text: root.message.rich-text;
                default-color: P.text;
                default-font-size: 14px;
                link-color: P.accent-ink;
            }
            if !root.message.rich && !root.has-sticker && !root.message.round.shown && !root.message.contact.shown && (!root.has-media || root.message.text != ""): Paragraph {
                text: root.has-media ? root.message.text : Fmt.body(root.message.content, root.message.text, root.message.detail);
                color: root.has-media || root.message.content == Content.text ? P.text : P.muted;
                font-size: 14px;
                line-height-factor: P.leading(1.55);
            }
            if root.message.preview.url != "": HorizontalLayout {
                alignment: start;
                padding-top: 4px;
                PreviewCard {
                    preview: root.message.preview;
                    max-width: 460px;
                }
            }
            // A bot's buttons under it (chat.slint's ButtonGrid; src/telegram/bots.rs).
            if root.message.buttons.length > 0: VerticalLayout {
                padding-top: 4px;
                ButtonGrid {
                    max-width: 460px;
                    rows: root.message.buttons;
                    busy-prefix: root.message.id + ":";
                    fill: P.accent-soft;
                    ink: P.accent-ink;
                    radius: 6px;
                    font-family: P.font;
                    pressed(row, column) => {
                        Actions.press(root.message.id, row, column);
                    }
                }
            }
            // The design's fifth round: a round video message, a contact card, the reactions and
            // their picker (extras.slint).
            if root.message.round.shown: RoundNoteView {
                note: root.message.round;
                line: P.line;
                accent: P.accent;
                side: P.side;
                faint: P.faint;
                mono: P.mono;
                font-family: P.font;
                clicked => {
                    Conversation.play-round(root.message.id);
                }
            }
            if root.message.contact.shown: HorizontalLayout {
                alignment: start;
                padding-top: 2px;
                ContactCardView {
                    card: root.message.contact;
                    bg: P.bg;
                    line: P.line;
                    soft: P.accent-soft;
                    soft-ink: P.accent-ink;
                    accent: P.accent-ink;
                    text-color: P.text;
                    muted: P.muted;
                    faint: P.faint;
                    radius: 8px;
                    av-radius: 6px;
                    font-family: P.font;
                    message => {
                        Conversation.contact-message(root.message.id);
                    }
                    invite => {
                        Conversation.contact-invite(root.message.id);
                    }
                    add => {
                        Conversation.contact-add(root.message.id);
                    }
                    share => {
                        Conversation.contact-share(root.message.id);
                    }
                }
            }
            if root.message.reactions.length > 0: ReactionChips {
                reactions: root.message.reactions;
                fill: P.side;
                ink: P.muted;
                chosen-fill: P.accent-soft;
                chosen-ink: P.accent-ink;
                ring: P.accent;
                font-family: P.font;
                react(emoji) => {
                    Conversation.react(root.message.id, emoji);
                }
            }
            if Conversation.reaction-picker == root.message.id: HorizontalLayout {
                alignment: start;
                ReactionPicker {
                    choices: Conversation.reaction-choices;
                    max: Conversation.reaction-max;
                    bg: P.bg;
                    line: P.line;
                    soft: P.accent-soft;
                    note-color: P.faint;
                    shadow: P.shadow;
                    font-family: P.font;
                    pick(emoji) => {
                        Conversation.react(root.message.id, emoji);
                    }
                }
            }
            // Not sent: say so, with Retry and Delete (the design's sixth round).
            if root.message.failed: HorizontalLayout {
                alignment: start;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 4px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: "warning-circle";
                            size: 14px;
                            color: P.danger;
                        }
                    }
                    Text {
                        text: AttachWords.not-sent();
                        color: P.danger;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: retry.preferred-width;
                    retry := Text {
                        text: AttachWords.retry();
                        color: P.accent-ink;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Conversation.retry(root.message.id);
                        }
                    }
                }
                Rectangle {
                    width: discard.preferred-width;
                    discard := Text {
                        text: AttachWords.delete();
                        color: P.danger;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Conversation.discard(root.message.id);
                        }
                    }
                }
            }
        }
    }
}

// A channel's post, set for reading: its photos and videos first.
component PostLine inherits Capped {
    in property <MessageRow> message;
    property <bool> has-media: message.media.length > 0;
    property <bool> has-sticker: message.content == Content.sticker && message.sticker.width > 0;
    spacing: 6px;

    if root.message.forwarded-from != "": ForwardedFrom {
        name: root.message.forwarded-from;
    }
    if root.message.reply.shown: HorizontalLayout {
        alignment: start;
        ReplyPill {
            quote: root.message.reply;
        }
    }
    if root.has-media: HorizontalLayout {
        alignment: start;
        MediaTiles {
            media: root.message.media;
            width-limit: 520px;
            badge-font: P.mono;
            mono-font: P.mono;
            failed: root.message.failed;
            open(id) => {
                Viewer.view(id, true);
            }
            cancel(id) => {
                Conversation.cancel-upload(id);
            }
        }
    }
    if root.has-sticker: HorizontalLayout {
        alignment: start;
        StickerPicture {
            message-id: root.message.id;
            sticker: root.message.sticker;
        }
    }
    if root.message.rich && !root.has-sticker: RichText {
        text: root.message.rich-text;
        default-color: P.text;
        default-font-size: 14px;
        link-color: P.accent-ink;
    }
    if !root.message.rich && !root.has-sticker && !root.message.round.shown && !root.message.contact.shown && (!root.has-media || root.message.text != ""): Paragraph {
        text: root.has-media ? root.message.text : Fmt.body(root.message.content, root.message.text, root.message.detail);
        color: P.text;
        font-size: 14px;
        line-height-factor: P.leading(1.7);
    }
    if root.message.preview.url != "": PreviewCard {
        preview: root.message.preview;
    }
    if root.message.buttons.length > 0: ButtonGrid {
        rows: root.message.buttons;
        busy-prefix: root.message.id + ":";
        fill: P.accent-soft;
        ink: P.accent-ink;
        radius: 6px;
        font-family: P.font;
        pressed(row, column) => {
            Actions.press(root.message.id, row, column);
        }
    }
    if root.message.reactions.length > 0: ReactionChips {
        reactions: root.message.reactions;
        fill: P.side;
        ink: P.muted;
        chosen-fill: P.accent-soft;
        chosen-ink: P.accent-ink;
        ring: P.accent;
        font-family: P.font;
        react(emoji) => {
            Conversation.react(root.message.id, emoji);
        }
    }
    if Conversation.reaction-picker == root.message.id: HorizontalLayout {
        alignment: start;
        ReactionPicker {
            choices: Conversation.reaction-choices;
            max: Conversation.reaction-max;
            bg: P.bg;
            line: P.line;
            soft: P.accent-soft;
            note-color: P.faint;
            shadow: P.shadow;
            font-family: P.font;
            pick(emoji) => {
                Conversation.react(root.message.id, emoji);
            }
        }
    }
    // The time, the smiley for a reaction, and Share for a post (src/telegram/share.rs).
    HorizontalLayout {
        alignment: start;
        spacing: 10px;
        Text {
            text: root.message.edited ? root.message.time + " · " + @tr("edited") : root.message.time;
            color: P.faint;
            font-size: 12px;
            vertical-alignment: center;
        }
        Rectangle {
            width: 16px;
            height: 16px;
            Icon {
                name: "smiley";
                size: 14px;
                color: smile.has-hover || Conversation.reaction-picker == root.message.id ? P.accent : P.faint;
                opacity: smile.has-hover || Conversation.reaction-picker == root.message.id ? 1 : 0.7;
            }
            smile := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if Conversation.reaction-picker == root.message.id {
                        Conversation.close-reactions();
                    } else {
                        Conversation.open-reactions(root.message.id);
                    }
                }
            }
        }
        if root.message.can-share: Rectangle {
            width: share-words.preferred-width;
            height: 16px;
            share-words := HorizontalLayout {
                spacing: 5px;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        name: "share-fat";
                        size: 13px;
                        color: share-touch.has-hover ? P.accent : P.muted;
                    }
                }
                Text {
                    text: ExtraWords.share();
                    color: share-touch.has-hover ? P.accent : P.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
            share-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Conversation.share-message(root.message.id);
                }
            }
        }
    }
}

// A sponsored message: Telegram's own, shown as it comes, never hidden.
component SponsoredCard inherits Rectangle {
    in property <MessageRow> message;
    height: card.preferred-height;
    border-radius: 8px;
    background: P.side;
    border-width: 1px;
    border-color: P.line;

    card := VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                text: @tr("Sponsored").to-uppercase();
                color: P.faint;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 0.44px;
            }
            Text {
                text: @tr("Premium users can turn these off");
                color: P.accent-ink;
                font-size: 11px;
            }
        }
        Text {
            text: root.message.sender;
            color: P.text;
            font-size: 14px;
            font-weight: 600;
            overflow: elide;
        }
        Paragraph {
            text: root.message.text;
            color: P.muted;
            font-size: 13px;
            line-height-factor: P.leading(1.5);
        }
        if root.message.button != "": HorizontalLayout {
            alignment: start;
            Rectangle {
                height: 28px;
                width: action.preferred-width + 24px;
                border-radius: 6px;
                background: action-touch.has-hover ? P.accent-soft.darker(0.05) : P.accent-soft;
                action := Text {
                    text: root.message.button;
                    color: P.accent-ink;
                    font-size: 13px;
                    font-weight: 600;
                }
                action-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Conversation.open-sponsored(root.message.id);
                    }
                }
            }
        }
        Text {
            text: @tr("Telegram's sponsored message · FinchGram shows it as it is");
            color: P.faint;
            font-size: 11px;
        }
    }
}

component Line {
    in property <MessageRow> message;
    // Conversation.reveal names this row: the list scrolls to it.
    callback reveal(length, length);
    property <bool> wanted: message.id != "" && Conversation.reveal == message.id;
    changed wanted => {
        if self.wanted {
            root.reveal(root.y, root.y + root.height);
        }
    }

    // A message's row has 6px of light above and below it; the other rows have as much room.
    VerticalLayout {
        padding-top: root.message.kind == RowKind.message ? 0 : 6px;
        padding-bottom: root.message.kind == RowKind.message ? 0 : 6px;
        if root.message.kind == RowKind.day: DayRule {
            text: Fmt.day-title(root.message.day);
        }
        if root.message.kind == RowKind.service: Paragraph {
            text: Fmt.service(root.message.content, root.message.outgoing ? @tr("You") : root.message.sender, root.message.detail);
            color: P.faint;
            font-size: 12px;
            horizontal-alignment: center;
        }
        if root.message.kind == RowKind.sponsored: Capped {
            SponsoredCard {
                message: root.message;
            }
        }
        if root.message.kind == RowKind.message: Row {
            message: root.message;
            content-height: body.preferred-height;
            body := HorizontalLayout {
                y: 6px;
                height: self.preferred-height;
                spacing: 12px;
                if Actions.selecting: VerticalLayout {
                    alignment: start;
                    padding-top: Conversation.kind == ChatKind.channel ? 2px : 6px;
                    Choice {
                        on: root.message.selected;
                    }
                }
                if Conversation.kind == ChatKind.channel: PostLine {
                    message: root.message;
                }
                if Conversation.kind != ChatKind.channel: MessageLine {
                    message: root.message;
                }
            }
        }
    }
}

component Chip inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <color> fill;
    in property <color> ink;
    height: 20px;
    width: chip.preferred-width;
    border-radius: 10px;
    background: fill;

    chip := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                size: 12px;
                color: root.ink;
            }
        }
        Text {
            text: root.label;
            color: root.ink;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

// The strip above the composer: replying to a message, editing ours, forwarding messages here.
component ComposeStrip inherits Rectangle {
    height: strip.preferred-height;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: P.line;
    }

    strip := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: Actions.bar == ComposeBar.reply ? "arrow-bend-up-left" : Actions.bar == ComposeBar.edit ? "pencil-simple" : "arrow-bend-up-right";
                size: 18px;
                color: P.accent;
            }
        }
        if Actions.bar-has-picture: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 4px;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: Actions.bar-picture;
                    image-fit: cover;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: ActionWords.bar-title();
                color: P.accent-ink;
                font-size: 12px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: ActionWords.bar-line();
                color: P.muted;
                font-size: 12px;
                overflow: elide;
            }
        }
        if Actions.bar == ComposeBar.forward: VerticalLayout {
            alignment: center;
            Rectangle {
                width: hide.preferred-width + 16px;
                height: hide.preferred-height + 8px;
                border-radius: 6px;
                background: hide-touch.has-hover ? P.side : transparent;
                hide := HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: Actions.hide-sender ? "check-square" : "square";
                            size: 16px;
                            color: Actions.hide-sender ? P.accent : P.faint;
                        }
                    }
                    Text {
                        text: @tr("Hide sender's name");
                        color: P.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
                hide-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Actions.hide-sender = !Actions.hide-sender;
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 23px;
                height: 23px;
                Icon {
                    name: "x";
                    size: 15px;
                    color: P.faint;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Actions.cancel-bar();
                    }
                }
            }
        }
    }
}

// A button of the bar that stands in for the composer while messages are chosen; faded when the
// messages chosen do not all allow it.
component BarButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> danger;
    callback activated();
    width: row.preferred-width + 20px;
    height: 30px;
    border-radius: 6px;
    background: touch.has-hover && root.enabled ? P.side : transparent;
    opacity: root.enabled ? 1 : 0.4;

    row := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                size: 16px;
                color: root.danger ? P.danger : P.text;
            }
        }
        Text {
            text: root.label;
            color: root.danger ? P.danger : P.text;
            font-size: 13px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

// An icon that does something on the search line: the arrows, the cross.
component SearchButton inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    callback activated();
    width: 30px;
    height: 30px;
    border-radius: 6px;
    background: touch.has-hover && root.enabled ? P.side : transparent;
    opacity: root.enabled ? 1 : 0.4;

    Icon {
        name: root.icon;
        size: 16px;
        color: P.text;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

// Searching in the chat: the line under the header, with the words, where the view is among the
// matches and the arrows to the next one up or down (src/telegram/search.rs). ⏎ goes up, ⇧⏎ down,
// Esc closes it.
component SearchLine inherits Rectangle {
    height: line.preferred-height;
    property <int> requests: Conversation.search-requests;
    changed requests => {
        input.focus-text();
    }

    line := HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-bottom: 10px;
        spacing: 4px;
        Rectangle {
            horizontal-stretch: 1;
            height: 30px;
            border-radius: 6px;
            background: P.bg;
            border-width: 1px;
            border-color: input.has-focus ? P.accent.transparentize(0.4) : P.line;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        name: "magnifying-glass";
                        size: 14px;
                        color: P.faint;
                    }
                }
                input := SearchInput {
                    horizontal-stretch: 1;
                    placeholder: SearchWords.placeholder;
                    text-color: P.text;
                    placeholder-color: P.faint;
                    selection-color: P.input-sel;
                    font-family: P.font;
                    font-size: 13px;
                    edited(words) => {
                        Conversation.search(words);
                    }
                    accepted => {
                        Conversation.search-step(true);
                    }
                    back => {
                        Conversation.search-step(false);
                    }
                    escape => {
                        Conversation.close-search();
                    }
                }
                Text {
                    text: SearchWords.position;
                    color: P.faint;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }
        SearchButton {
            icon: "caret-up";
            enabled: SearchWords.can-go-up;
            activated => {
                Conversation.search-step(true);
            }
        }
        SearchButton {
            icon: "caret-down";
            enabled: SearchWords.can-go-down;
            activated => {
                Conversation.search-step(false);
            }
        }
        SearchButton {
            icon: "x";
            activated => {
                Conversation.close-search();
            }
        }
    }
}

// Choosing messages: how many, and what to do with them all (the design's 1c: in place of the
// composer).
component SelectionBar inherits Rectangle {
    height: max(50px, bar.preferred-height);
    border-radius: 8px;
    background: P.bg;
    border-width: 1px;
    border-color: P.line;

    KeyScope {
        width: 0;
        height: 0;
        escape => {
            Actions.cancel-selection();
        }
    }

    bar := HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 2px;
        Text {
            text: ActionWords.selected();
            color: P.text;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            padding-left: 10px;
            padding-right: 10px;
            Text {
                text: @tr("Shift-click to select a range");
                color: P.faint;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            BarButton {
                icon: "arrow-bend-up-right";
                label: @tr("Forward");
                enabled: Actions.can-forward;
                activated => {
                    Actions.forward-selected();
                }
            }
        }
        VerticalLayout {
            alignment: center;
            BarButton {
                icon: "copy";
                label: ActionWords.copy();
                enabled: Actions.can-copy;
                activated => {
                    Actions.copy-selected();
                }
            }
        }
        VerticalLayout {
            alignment: center;
            BarButton {
                icon: "trash";
                label: @tr("Delete");
                enabled: Actions.can-delete;
                danger: true;
                activated => {
                    Actions.delete-selected();
                }
            }
        }
        if Actions.report-offered: VerticalLayout {
            alignment: center;
            BarButton {
                icon: "flag";
                label: @tr("Report");
                enabled: Actions.can-report;
                activated => {
                    Actions.report-selected();
                }
            }
        }
        VerticalLayout {
            alignment: center;
            padding-left: 4px;
            padding-right: 4px;
            Rectangle {
                width: 1px;
                height: 20px;
                background: P.line;
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: cancel.preferred-width + 20px;
                height: 30px;
                border-radius: 6px;
                background: cancel-touch.has-hover ? P.side : transparent;
                cancel := Text {
                    text: @tr("Cancel");
                    color: P.accent-ink;
                    font-size: 13px;
                    font-weight: 600;
                }
                cancel-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Actions.cancel-selection();
                    }
                }
            }
        }
    }
}

// The chat's newest pinned message, under the header: a click goes to it (bots.rs).
component PinnedBar inherits Rectangle {
    height: 46px;
    background: P.bg;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: P.line;
    }
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 2px;
                height: 30px;
                border-radius: 1px;
                background: P.accent;
            }
        }
        if Conversation.pinned-message.has-picture: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 4px;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: Conversation.pinned-message.picture;
                    image-fit: cover;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: BotWords.pinned();
                color: P.accent-ink;
                font-size: 12px;
                font-weight: 600;
            }
            Text {
                text: (Conversation.pinned-message.sender == "" ? "" : Conversation.pinned-message.sender + ": ") + ActionWords.quote-line(Conversation.pinned-message);
                color: P.muted;
                font-size: 13px;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Icon {
                name: "push-pin";
                size: 15px;
                color: P.faint;
            }
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Conversation.open-pinned();
        }
    }
}

// A bot's commands that start with what is typed after "/": a click sends one (bots.rs).
component CommandList inherits Rectangle {
    height: min(300px, list.preferred-height);
    border-radius: 8px;
    background: P.bg;
    border-width: 1px;
    border-color: P.line;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: P.shadow;
    clip: true;

    Flickable {
        width: parent.width;
        height: parent.height;
        mouse-drag-pan-enabled: false;
        content-width: self.width;
        content-height: list.preferred-height;
        list := VerticalLayout {
            width: parent.width;
            alignment: start;
            padding: 6px;
            for command in Conversation.commands: Rectangle {
                height: 32px;
                border-radius: 6px;
                background: command-touch.has-hover ? P.side : transparent;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;
                    Text {
                        text: command.command;
                        color: P.accent-ink;
                        font-family: P.mono;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: command.description;
                        color: P.muted;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                command-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Conversation.send-command(command.command);
                    }
                }
            }
        }
    }
}

// A topic open in a group with topics: the way back to the list, and the topic's name.
component TopicBar inherits Rectangle {
    height: 36px;
    background: P.bg;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: P.line;
    }
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 8px;
        Rectangle {
            width: back.preferred-width;
            back := HorizontalLayout {
                spacing: 4px;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        name: "caret-left";
                        size: 13px;
                        color: P.accent-ink;
                    }
                }
                Text {
                    text: ExtraWords.all-topics();
                    color: P.accent-ink;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Conversation.back-to-topics();
                }
            }
        }
        Text {
            text: "/";
            color: P.faint;
            font-size: 13px;
            vertical-alignment: center;
        }
        if Conversation.topic-icon != "": Text {
            text: Conversation.topic-icon;
            font-size: 14px;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: Conversation.topic-title;
            color: P.text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        if Conversation.topic-closed: VerticalLayout {
            alignment: center;
            Icon {
                name: "lock-simple";
                size: 13px;
                color: P.faint;
            }
        }
    }
}

// A closed topic, in place of the composer.
component ClosedTopicNote inherits HorizontalLayout {
    padding-left: 20px;
    padding-right: 20px;
    padding-bottom: 16px;
    Rectangle {
        height: note.preferred-height + 16px;
        border-radius: 8px;
        background: P.side;
        note := HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Icon {
                    name: "lock-simple";
                    size: 14px;
                    color: P.muted;
                }
            }
            Text {
                horizontal-stretch: 1;
                text: ExtraWords.topic-closed();
                color: P.muted;
                font-size: 12px;
                wrap: word-wrap;
                vertical-alignment: center;
            }
        }
    }
}

// The chat's settings panel, over the right of the pane: a group's rules, or what its
// administrators may change (admin.rs); nothing yet for other chats.
component SettingsPanel inherits Rectangle {
    background: P.bg;

    // Clicks on the panel stay on it: the messages lie under it.
    TouchArea { }
    Rectangle {
        x: 0;
        width: 1px;
        background: P.line;
    }
    VerticalLayout {
        HorizontalLayout {
            padding-left: 18px;
            padding-right: 14px;
            padding-top: 14px;
            padding-bottom: 10px;
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                text: ExtraWords.settings().to-uppercase();
                color: P.faint;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 0.9px;
                vertical-alignment: center;
            }
            Rectangle {
                width: 22px;
                height: 22px;
                Icon {
                    name: "x";
                    size: 15px;
                    color: P.faint;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Conversation.toggle-settings();
                    }
                }
            }
        }
        Flickable {
            vertical-stretch: 1;
            content-height: body.preferred-height;
            body := VerticalLayout {
                width: parent.width;
                alignment: start;
                padding-left: 18px;
                padding-right: 18px;
                padding-bottom: 18px;
                if Conversation.admin.shown: AdminPanelView {
                    side: P.side;
                    accent: P.accent;
                    on-accent: P.on-accent;
                    text-color: P.text;
                    muted: P.muted;
                    faint: P.faint;
                    off: P.line;
                    danger: P.danger;
                    font-family: P.font;
                }
                if !Conversation.admin.shown: Text {
                    text: ExtraWords.nothing-here();
                    color: P.faint;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }
    }
}

component Pane {
    VerticalLayout {
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 10px;
            Text {
                text: Conversation.title;
                color: P.text;
                font-size: 16px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                horizontal-stretch: 1;
                text: Conversation.typing != "" ? @tr("typing…")
                    : Fmt.status(Conversation.status, Conversation.last-seen, Conversation.members, Conversation.online-members);
                color: Conversation.typing != "" ? P.accent-ink : P.faint;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
            if Conversation.kind == ChatKind.channel: VerticalLayout {
                alignment: center;
                Chip {
                    icon: "book-open";
                    label: @tr("Reading mode");
                    fill: P.teal-soft;
                    ink: P.teal;
                }
            }
            // Searching in the chat: the line under the header (SearchLine).
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 6px;
                    background: search-touch.has-hover ? P.side : transparent;
                    Icon {
                        name: "magnifying-glass";
                        size: 17px;
                        color: Conversation.search-open ? P.accent : P.muted;
                    }
                    search-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if Conversation.search-open {
                                Conversation.close-search();
                            } else {
                                Conversation.search-open = true;
                                Conversation.search-requests += 1;
                            }
                        }
                    }
                }
            }
        }
        if Conversation.search-open: SearchLine { }
        if Conversation.pinned-message.shown: PinnedBar { }
        if Conversation.topic-id != "": TopicBar { }

        scroll := ChatScroll {
            vertical-stretch: 1;
            from-top: Conversation.showing-topics;
            // 14px between messages, less their rows' light (Line).
            spacing: 2px;
            margin-left: 20px;
            margin-right: 20px;
            margin-top: 4px;
            margin-bottom: 18px;
            // A group with topics opens on them (src/telegram/topics.rs).
            if Conversation.showing-topics: TopicList {
                bg: P.bg;
                side: P.side;
                soft: P.accent-soft;
                soft-ink: P.accent-ink;
                line: P.line;
                accent: P.accent;
                accent-ink: P.accent-ink;
                on-accent: P.on-accent;
                text-color: P.text;
                muted: P.muted;
                faint: P.faint;
                danger: P.danger;
                selection: P.input-sel;
                radius: 6px;
                big-radius: 8px;
                font-family: P.font;
            }
            for row in Conversation.messages: Line {
                message: row;
                reveal(top, bottom) => {
                    scroll.reveal(top, bottom);
                }
            }
            if Conversation.typing != "": Text {
                text: @tr("{0} is typing…", Conversation.typing);
                color: P.faint;
                font-size: 13px;
            }
        }

        // A bot's keyboard, and its commands matching "/…" typed, above the composer (bots.rs).
        if Conversation.can-write && !Actions.selecting && Conversation.keyboard.length > 0 && !Conversation.keyboard-hidden: HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 8px;
            ButtonGrid {
                rows: Conversation.keyboard;
                fill: P.accent-soft;
                ink: P.accent-ink;
                radius: 6px;
                row-height: 36px;
                font-family: P.font;
                pressed(row, column) => {
                    Conversation.press-key(row, column);
                }
            }
        }
        if Conversation.can-write && !Actions.selecting && Conversation.commands.length > 0: HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 8px;
            CommandList { }
        }
        // A closed topic takes no messages; what Telegram refused is said above the composer.
        if Conversation.topic-closed && !Actions.selecting: ClosedTopicNote { }
        if Conversation.send-error != "" && Conversation.can-write && !Actions.selecting && !Conversation.topic-closed: HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 6px;
            Text {
                text: Conversation.send-error;
                color: P.danger;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
        if Conversation.can-write && !Actions.selecting && !Conversation.showing-topics && !Conversation.topic-closed: HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 16px;
            Rectangle {
                border-radius: 8px;
                background: P.bg;
                border-width: 1px;
                border-color: input.has-focus ? P.accent.transparentize(0.4) : P.line;
                height: box.preferred-height;
                // A reply or an edit begins, a menu or dialog closed: the keyboard comes back here.
                property <int> focus-requests: Actions.focus-requests;
                changed focus-requests => {
                    input.focus-text();
                }
                init => {
                    input.focus-text();
                }

                box := VerticalLayout {
                    if Actions.bar != ComposeBar.none: ComposeStrip { }
                    input := MessageInput {
                        text <=> Conversation.draft;
                        allow-empty: Actions.bar == ComposeBar.forward;
                        placeholder: Conversation.slow-wait > 0 ? ExtraWords.slow-wait-placeholder(Conversation.slow-wait)
                            : Conversation.keyboard-placeholder != "" ? Conversation.keyboard-placeholder : @tr("Send to {0}", Conversation.title);
                        text-color: P.text;
                        placeholder-color: P.faint;
                        selection-color: P.input-sel;
                        font-family: P.font;
                        font-size: 14px;
                        base-height: 40px;
                        send(words) => {
                            Conversation.send(words);
                        }
                        edited(words) => {
                            Conversation.edited(words);
                        }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 6px;
                        padding-bottom: 8px;
                        spacing: 12px;
                        // The paperclip: photos, videos and files (attachments.slint); quick
                        // replies and scheduling are still to come.
                        VerticalLayout {
                            alignment: center;
                            clip := Rectangle {
                                property <bool> allowed: Conversation.can-send-photos || Conversation.can-send-videos || Conversation.can-send-files;
                                width: 28px;
                                height: 28px;
                                border-radius: 6px;
                                background: Attachments.menu-open || (clip-touch.has-hover && self.allowed) ? P.side : transparent;
                                Icon {
                                    name: "paperclip";
                                    size: 17px;
                                    color: Attachments.menu-open ? P.accent : clip-touch.has-hover && clip.allowed ? P.text : P.faint;
                                    opacity: clip.allowed ? 1 : 0.4;
                                }
                                clip-touch := TouchArea {
                                    mouse-cursor: clip.allowed ? pointer : not-allowed;
                                    clicked => {
                                        if clip.allowed {
                                            Attachments.menu-x = self.absolute-position.x;
                                            Attachments.menu-y = self.absolute-position.y;
                                            Attachments.menu-focus = -1;
                                            Attachments.menu-keyboard = false;
                                            Attachments.menu-open = !Attachments.menu-open;
                                        }
                                    }
                                }
                                if clip-touch.has-hover && !Attachments.menu-open: Rectangle {
                                    x: 0;
                                    y: -self.height - 8px;
                                    width: tip.preferred-width + 20px;
                                    height: tip.preferred-height + 12px;
                                    border-radius: 6px;
                                    background: P.text;
                                    drop-shadow-blur: 20px;
                                    drop-shadow-offset-y: 6px;
                                    drop-shadow-color: #00000033;
                                    tip := Text {
                                        text: clip.allowed ? AttachWords.attach() : AttachWords.cant-send();
                                        color: P.bg;
                                        font-size: 12px;
                                    }
                                }
                            }
                        }
                        // The scissors: a screenshot into the card (src/screenshot/), as its
                        // shortcut does; greyed where the chat takes no photos.
                        VerticalLayout {
                            alignment: center;
                            scissors := Rectangle {
                                property <bool> allowed: Conversation.can-send-photos;
                                width: 28px;
                                height: 28px;
                                border-radius: 6px;
                                background: scissors-touch.has-hover && self.allowed ? P.side : transparent;
                                Icon {
                                    name: "scissors";
                                    size: 17px;
                                    transform-rotation: -90deg;
                                    color: scissors-touch.has-hover && scissors.allowed ? P.text : P.faint;
                                    opacity: scissors.allowed ? 1 : 0.4;
                                }
                                scissors-touch := TouchArea {
                                    mouse-cursor: scissors.allowed ? pointer : not-allowed;
                                    clicked => {
                                        if scissors.allowed {
                                            Screenshot.start();
                                        }
                                    }
                                }
                                if scissors-touch.has-hover: Rectangle {
                                    x: 0;
                                    y: -self.height - 8px;
                                    width: scissors-tip.preferred-width;
                                    height: scissors-tip.preferred-height;
                                    border-radius: 6px;
                                    background: P.text;
                                    drop-shadow-blur: 20px;
                                    drop-shadow-offset-y: 6px;
                                    drop-shadow-color: #00000033;
                                    scissors-tip := HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        padding-top: 6px;
                                        padding-bottom: 6px;
                                        spacing: 8px;
                                        Text {
                                            text: scissors.allowed ? AttachWords.screenshot() : AttachWords.screenshot-off();
                                            color: P.bg;
                                            font-size: 12px;
                                        }
                                        if scissors.allowed: Text {
                                            text: Screenshot.shortcut-label;
                                            color: P.bg;
                                            font-size: 12px;
                                            opacity: 0.7;
                                        }
                                    }
                                }
                            }
                        }
                        // Quick replies, scheduling and voice messages are still to come.
                        for name in ["lightning", "clock", "microphone"]: VerticalLayout {
                            alignment: center;
                            Icon {
                                name: name;
                                size: 16px;
                                color: P.faint;
                                opacity: 0.45;
                            }
                        }
                        // A bot's menu button (its web app, or its commands), and the fold for
                        // its keyboard (bots.rs).
                        if Conversation.menu-button != "": VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 26px;
                                width: menu-words.preferred-width + 16px;
                                border-radius: 6px;
                                background: menu-touch.has-hover ? P.accent-soft.mix(P.accent-ink, 0.88) : P.accent-soft;
                                menu-words := HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    VerticalLayout {
                                        alignment: center;
                                        Icon {
                                            name: "list-bullets";
                                            size: 14px;
                                            color: P.accent-ink;
                                        }
                                    }
                                    Text {
                                        text: Conversation.menu-button == "/" ? BotWords.menu() : Conversation.menu-button;
                                        color: P.accent-ink;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                                menu-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        Conversation.open-bot-menu();
                                    }
                                }
                            }
                        }
                        if Conversation.keyboard.length > 0: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 6px;
                                background: keyboard-touch.has-hover ? P.side : transparent;
                                Icon {
                                    name: "keyboard";
                                    size: 17px;
                                    color: Conversation.keyboard-hidden ? P.faint : P.accent;
                                }
                                keyboard-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        Conversation.toggle-keyboard();
                                    }
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if Actions.bar != ComposeBar.none: Text {
                            text: @tr("Esc to cancel");
                            color: P.faint;
                            font-family: P.mono;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: Conversation.slow-wait > 0 ? ExtraWords.slow-wait-hint(Conversation.slow-wait)
                                : Conversation.slow-limited ? ExtraWords.slow-hint(Conversation.slow-mode)
                                : Actions.bar == ComposeBar.edit
                                ? (AppState.send-with-enter ? @tr("⏎ save · ⇧⏎ new line") : @tr("⌘⏎ save · ⏎ new line"))
                                : (AppState.send-with-enter ? @tr("⏎ send · ⇧⏎ new line") : @tr("⌘⏎ send · ⏎ new line"));
                            color: Conversation.slow-wait > 0 ? P.warn : P.faint;
                            font-family: P.mono;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        if Actions.selecting: HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 16px;
            SelectionBar { }
        }

        // A channel one only reads: muting it, in place of the composer.
        if Conversation.kind == ChatKind.channel && !Conversation.can-write && !Actions.selecting: HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 16px;
            Rectangle {
                height: 44px;
                border-radius: 8px;
                border-width: 1px;
                border-color: P.line;
                background: mute-touch.has-hover ? P.side : transparent;
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: "bell-simple-slash";
                            size: 16px;
                            color: P.accent-ink;
                        }
                    }
                    Text {
                        text: Conversation.muted ? @tr("Unmute") : @tr("Mute");
                        color: P.accent-ink;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                mute-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Conversation.toggle-mute();
                    }
                }
            }
        }
    }

    if Conversation.settings-open && Conversation.chat-id != "": SettingsPanel {
        x: root.width - self.width;
        y: 0;
        width: min(320px, root.width * 0.4);
        height: root.height;
    }
}

export component WorkbenchMain inherits Rectangle {
    background: P.bg;

    VerticalLayout {
        TabBar { }
        if Conversation.chat-id != "": Pane {
            vertical-stretch: 1;
        }
        if Conversation.chat-id == "": Rectangle {
            vertical-stretch: 1;
            Text {
                text: @tr("Choose a chat on the left");
                color: P.faint;
                font-size: 14px;
            }
        }
    }

    // What was just done (copied, saved, reported): a floating strip above the composer.
    if Actions.notice != ActionNotice.none: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 96px - self.height;
        width: notice.preferred-width;
        height: notice.preferred-height;
        border-radius: 8px;
        background: P.text;
        drop-shadow-blur: 30px;
        drop-shadow-offset-y: 10px;
        drop-shadow-color: #00000040;
        notice := HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 9px;
            padding-bottom: 9px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Icon {
                    name: "check-circle";
                    size: 16px;
                    color: P.bg;
                }
            }
            Text {
                text: ActionWords.notice(Actions.notice);
                color: P.bg;
                font-size: 13px;
                vertical-alignment: center;
            }
        }
    }
}
