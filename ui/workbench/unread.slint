// The Unread page of the Workbench theme (the design's round 2, 2c): the chats with unread
// messages as cards, each with its newest unread messages, one line each. An index, not a reader:
// nothing here is marked read; a line opens the chat at its message. Rust fills the Unread global
// (src/telegram/unread.rs).
import { Fmt } from "../format.slint";
import { Icon, Avatar } from "../widgets.slint";
import { Unread, UnreadGroup, UnreadLine, ChatRow, ChatKind, Content } from "../telegram.slint";
import { ChatIcons } from "../chat.slint";
import { UnreadBadge, MentionBadge, UnreadDot } from "badges.slint";
import { WorkbenchPalette as P } from "palette.slint";

// Letter squares by kind of chat, as the side bar's lists colour them.
global Tints {
    public pure function fill(kind: ChatKind) -> color {
        if kind == ChatKind.channel || kind == ChatKind.bot {
            return P.accent-soft;
        }
        if kind == ChatKind.saved {
            return P.teal-soft;
        }
        return P.chrome;
    }

    public pure function ink(kind: ChatKind) -> color {
        if kind == ChatKind.channel || kind == ChatKind.bot {
            return P.accent-ink;
        }
        if kind == ChatKind.saved {
            return P.teal;
        }
        return P.text;
    }
}

// Words that do something when clicked: "Mark as read".
component LinkText inherits Rectangle {
    in property <string> text;
    in property <length> font-size: 12px;
    callback clicked;
    width: label.preferred-width;
    label := Text {
        text: root.text;
        color: P.accent-ink;
        font-size: root.font-size;
        vertical-alignment: center;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// One of a chat's newest unread messages: who, what, when; a click opens the chat there.
component UnreadRow inherits Rectangle {
    in property <ChatRow> chat;
    in property <UnreadLine> line;
    property <bool> service: Fmt.is-service(line.content);
    property <string> icon: ChatIcons.content(line.content);
    height: 30px;
    background: touch.has-hover ? P.side : transparent;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        Text {
            width: 12px;
            text: root.line.mention ? "@" : "";
            color: P.accent-ink;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            width: 96px;
            text: root.line.sender;
            color: P.text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 5px;
            if !root.service && root.icon != "": VerticalLayout {
                alignment: center;
                Icon {
                    name: root.icon;
                    size: 14px;
                    color: P.muted;
                }
            }
            if !root.service && root.line.content != Content.text: Text {
                text: Fmt.content(root.line.content, root.line.detail);
                color: P.muted;
                font-size: 13px;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                text: root.service ? Fmt.service(root.line.content, root.line.sender, root.line.detail) : root.line.text;
                color: P.text;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        Text {
            width: 40px;
            text: Fmt.clock(root.line.time);
            color: P.faint;
            font-family: P.mono;
            font-size: 11px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Unread.open-message(root.chat.id, root.line.id);
        }
    }
}

// A line's place while the lines are on their way.
component SkeletonRow inherits Rectangle {
    in property <length> words: 180px;
    height: 29px;
    HorizontalLayout {
        padding-left: 32px;
        padding-right: 12px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle { width: 60px; height: 9px; border-radius: 4px; background: P.line; }
        }
        VerticalLayout {
            alignment: center;
            Rectangle { width: root.words; height: 9px; border-radius: 4px; background: P.line; }
        }
        Rectangle { horizontal-stretch: 1; }
        VerticalLayout {
            alignment: center;
            Rectangle { width: 40px; height: 9px; border-radius: 4px; background: P.line; }
        }
    }
}

// A chat: its head, then its lines.
component UnreadCard inherits Rectangle {
    in property <UnreadGroup> group;
    border-radius: 8px;
    border-width: 1px;
    border-color: P.line;
    clip: true;

    VerticalLayout {
        Rectangle {
            background: P.side;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Avatar {
                        size: 24px;
                        radius: 6px;
                        fill: Tints.fill(root.group.chat.kind);
                        ink: Tints.ink(root.group.chat.kind);
                        initial: root.group.chat.initial;
                        picture: root.group.chat.picture;
                        has-picture: root.group.chat.has-picture;
                        font-size: 11px;
                    }
                }
                Text {
                    text: root.group.chat.title;
                    color: P.text;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                    max-width: 360px;
                    overflow: elide;
                }
                if root.group.chat.unread > 0: VerticalLayout {
                    alignment: center;
                    UnreadBadge {
                        count: root.group.chat.unread;
                        muted: root.group.chat.muted;
                    }
                }
                if root.group.chat.mention: VerticalLayout {
                    alignment: center;
                    MentionBadge { }
                }
                if root.group.chat.muted: VerticalLayout {
                    alignment: center;
                    Icon {
                        name: "bell-slash";
                        size: 14px;
                        color: P.faint;
                    }
                }
                if root.group.chat.marked && root.group.chat.unread == 0: VerticalLayout {
                    alignment: center;
                    UnreadDot { }
                }
                Rectangle { horizontal-stretch: 1; }
                if root.group.loading: VerticalLayout {
                    alignment: center;
                    Icon {
                        name: "circle-notch";
                        size: 14px;
                        color: P.faint;
                    }
                }
                if !root.group.loading: LinkText {
                    text: @tr("Mark as read");
                    clicked => {
                        Unread.mark-read(root.group.chat.id);
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: P.line;
            }
        }
        for line in root.group.lines: UnreadRow {
            chat: root.group.chat;
            line: line;
        }
        if root.group.loading: VerticalLayout {
            for words in [200px, 140px, 240px]: SkeletonRow {
                words: words;
            }
        }
        // The chat has more unread messages than the lines: it shows them.
        if root.group.more > 0: Rectangle {
            height: 30px;
            background: more-touch.has-hover ? P.side : transparent;
            Rectangle {
                y: 0;
                height: 1px;
                background: P.line;
            }
            HorizontalLayout {
                padding-left: 32px;
                padding-right: 12px;
                spacing: 6px;
                Text {
                    text: @tr("{n} more — open the chat to see them" | "{n} more — open the chat to see them" % root.group.more);
                    color: P.accent-ink;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Icon {
                        name: "arrow-right";
                        size: 12px;
                        color: P.accent-ink;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            more-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Unread.open-chat(root.group.chat.id);
                }
            }
        }
    }
}

export component WorkbenchUnread inherits Rectangle {
    background: P.bg;

    VerticalLayout {
        // The head: the page's name and count, and marking everything read.
        Rectangle {
            height: 46px;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        name: "tray";
                        size: 17px;
                        color: P.accent;
                    }
                }
                Text {
                    text: @tr("Unread");
                    color: P.text;
                    font-size: 16px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                if Unread.total > 0: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 17px;
                        width: max(17px, total.preferred-width + 14px);
                        border-radius: 8.5px;
                        background: P.accent;
                        total := Text {
                            text: Fmt.count(Unread.total);
                            color: P.on-accent;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                if Unread.total > 0: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: mark.preferred-width;
                        height: 26px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: P.line;
                        background: mark-touch.has-hover ? P.side : transparent;
                        mark := HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    name: "checks";
                                    size: 14px;
                                    color: P.text;
                                }
                            }
                            Text {
                                text: @tr("Mark all as read");
                                color: P.text;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                        mark-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                Unread.mark-all-read();
                            }
                        }
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: P.line;
            }
        }

        if Unread.groups.length > 0: Flickable {
            vertical-stretch: 1;
            mouse-drag-pan-enabled: false;
            VerticalLayout {
                alignment: start;
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 14px;
                padding-bottom: 20px;
                spacing: 12px;
                for group in Unread.groups: UnreadCard {
                    group: group;
                }
            }
        }
        if Unread.groups.length == 0: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 10px;
            HorizontalLayout {
                alignment: center;
                Icon {
                    name: "checks";
                    size: 34px;
                    color: P.faint;
                }
            }
            Text {
                text: @tr("You're all caught up");
                color: P.muted;
                font-size: 15px;
                horizontal-alignment: center;
            }
        }
    }
}
