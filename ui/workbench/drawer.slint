// The drawer, Workbench (the design's sixth round, 1c): slid out from the activity bar's logo over
// the sidebar and the left of the messages, 280px wide, under a scrim; the accounts, the toolbox
// with its pin switches, and the settings and the profile at the foot. The state and the words
// are in ui/drawer.slint; src/drawer.rs fills and acts.
import { Drawer, DrawerWords, ToolRow } from "../drawer.slint";
import { AppState, Page } from "../state.slint";
import { Account } from "../telegram.slint";
import { Downloads } from "../downloads.slint";
import { Icon, Avatar } from "../widgets.slint";
import { WorkbenchPalette as P } from "palette.slint";

// A tool of the toolbox: its icon block (the accent while pinned), its name with what goes on,
// a line about it, and the switch that pins it to the activity bar. The name opens it.
component ToolLine inherits Rectangle {
    in property <ToolRow> tool;
    property <bool> live: !tool.grey;
    property <bool> active: tool.id == "downloads" && Downloads.active-count > 0;
    height: 42px;
    background: open-touch.has-hover && live ? P.side : transparent;
    opacity: live ? 1 : 0.42;

    open-touch := TouchArea {
        enabled: root.live;
        mouse-cursor: pointer;
        clicked => {
            Drawer.open-tool(root.tool.id);
        }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 14px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: root.tool.pinned ? P.accent : P.chrome;
                animate background { duration: 200ms; }
                Icon {
                    name: root.tool.icon;
                    size: 17px;
                    color: root.tool.pinned ? P.on-accent : P.muted;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Text {
                    text: root.tool.name;
                    color: P.text;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                if root.active: HorizontalLayout {
                    spacing: 4px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: P.accent;
                        }
                    }
                    Text {
                        text: DrawerWords.downloading(Downloads.active-count);
                        color: P.accent-ink;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
            Text {
                text: root.tool.line;
                color: P.muted;
                font-size: 12px;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px;
                height: 18px;
                border-radius: 9px;
                background: root.tool.pinned ? P.accent : P.off;
                animate background { duration: 200ms; }
                Rectangle {
                    x: root.tool.pinned ? 16px : 2px;
                    y: 2px;
                    width: 14px;
                    height: 14px;
                    border-radius: 7px;
                    background: #ffffff;
                    drop-shadow-blur: 2px;
                    drop-shadow-offset-y: 1px;
                    drop-shadow-color: #00000033;
                    animate x { duration: 200ms; }
                }
                TouchArea {
                    enabled: root.live;
                    mouse-cursor: pointer;
                    clicked => {
                        Drawer.pin(root.tool.id, !root.tool.pinned);
                    }
                }
            }
        }
    }
}

// One of the three at the foot: the settings, the AI settings (still to come), the profile.
component FootButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> enabled: true;
    callback activated();
    horizontal-stretch: 1;
    height: 34px;
    border-radius: 6px;
    background: touch.has-hover && enabled ? P.side : transparent;
    opacity: enabled ? 1 : 0.42;

    HorizontalLayout {
        alignment: center;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                size: 16px;
                color: P.muted;
            }
        }
        Text {
            text: root.label;
            color: P.text;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

export component WorkbenchDrawer inherits Rectangle {
    property <bool> open: Drawer.open;
    // Drawn while open and while it slides shut.
    visible: Drawer.open || slide.x > -280px;
    changed open => {
        if self.open {
            keys.focus();
        }
    }

    // The scrim over the rest: a click on it shuts the drawer.
    Rectangle {
        background: P.dark ? #00000073 : #1b1f242e;
        opacity: Drawer.open ? 1 : 0;
        animate opacity { duration: 200ms; }
        TouchArea {
            clicked => {
                Drawer.close();
            }
        }
    }

    slide := Rectangle {
        x: Drawer.open ? 0px : -280px;
        y: 0;
        width: 280px;
        height: parent.height;
        background: P.bg;
        drop-shadow-blur: 24px;
        drop-shadow-offset-x: 8px;
        drop-shadow-color: P.shadow;
        animate x { duration: 240ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

        // Clicks on the drawer stay on it; Esc shuts it.
        TouchArea { }
        keys := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape {
                    Drawer.close();
                    return accept;
                }
                return reject;
            }
        }
        Rectangle {
            x: parent.width - 1px;
            width: 1px;
            background: P.line;
        }

        VerticalLayout {
            Flickable {
                vertical-stretch: 1;
                content-height: body.preferred-height;
                body := VerticalLayout {
                    width: parent.width;
                    alignment: start;
                    padding-bottom: 6px;
                    // The accounts: the one in front as a card; adding another is still to come.
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 14px;
                        padding-top: 10px;
                        padding-bottom: 6px;
                        spacing: 6px;
                        Text {
                            text: DrawerWords.accounts().to-uppercase();
                            color: P.faint;
                            font-size: 11px;
                            font-weight: 600;
                            letter-spacing: 0.9px;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: "1/10";
                            color: P.faint;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: esc.preferred-width + 12px;
                            height: esc.preferred-height + 2px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: P.line;
                            esc := Text {
                                text: "esc";
                                color: P.faint;
                                font-family: P.mono;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    Drawer.close();
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 2px;
                        padding-bottom: 4px;
                        Rectangle {
                            border-radius: 8px;
                            background: P.side;
                            border-width: 1px;
                            border-color: P.line;
                            height: card.preferred-height;
                            card := HorizontalLayout {
                                padding: 8px;
                                spacing: 10px;
                                VerticalLayout {
                                    alignment: center;
                                    Avatar {
                                        size: 34px;
                                        radius: 8px;
                                        fill: P.accent;
                                        ink: P.on-accent;
                                        initial: Account.initial;
                                        picture: Account.picture;
                                        has-picture: Account.has-picture;
                                        font-size: 14px;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 1px;
                                    Text {
                                        text: Account.name;
                                        color: P.text;
                                        font-size: 14px;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: Account.phone != "" ? Account.phone : "@" + Account.username;
                                        color: P.muted;
                                        font-size: 12px;
                                        overflow: elide;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        name: "check";
                                        size: 15px;
                                        color: P.accent;
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        height: 28px;
                        padding-left: 16px;
                        padding-right: 14px;
                        spacing: 10px;
                        opacity: 0.42;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 20px;
                                height: 20px;
                                border-radius: 5px;
                                border-width: 1px;
                                border-color: P.line;
                                Icon {
                                    name: "plus";
                                    size: 12px;
                                    color: P.text;
                                }
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: DrawerWords.add-account();
                            color: P.text;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: DrawerWords.not-yet();
                            color: P.faint;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 6px;
                        Rectangle {
                            height: 1px;
                            background: P.line;
                        }
                    }
                    // The toolbox.
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 14px;
                        padding-top: 10px;
                        padding-bottom: 4px;
                        spacing: 6px;
                        Text {
                            text: DrawerWords.toolbox().to-uppercase();
                            color: P.faint;
                            font-size: 11px;
                            font-weight: 600;
                            letter-spacing: 0.9px;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: DrawerWords.pinned-count(Drawer.pinned.length);
                            color: P.faint;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: DrawerWords.pin-to-bar();
                            color: P.faint;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                    for tool in Drawer.tools: ToolLine {
                        tool: tool;
                    }
                }
            }
            // The foot: the settings, the AI settings (still to come), the profile.
            Rectangle {
                height: foot.preferred-height;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: P.line;
                }
                foot := HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    padding-top: 6px;
                    padding-bottom: 8px;
                    spacing: 2px;
                    FootButton {
                        icon: "gear-six";
                        label: DrawerWords.settings();
                        activated => {
                            Drawer.close();
                            AppState.page = Page.settings;
                        }
                    }
                    FootButton {
                        icon: "sparkle";
                        label: DrawerWords.ai-settings();
                        enabled: false;
                    }
                    FootButton {
                        icon: "user-circle";
                        label: DrawerWords.profile();
                        activated => {
                            Drawer.close();
                            AppState.page = Page.profile;
                        }
                    }
                }
            }
        }
    }
}
