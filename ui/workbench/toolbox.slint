// The toolbox, Workbench (the design's seventh round, 7c): a panel 780px wide slid out from the
// activity bar's logo over the list and the messages, under a scrim: the search box, the
// categories at the left, the sections at the right (the accounts as tiles, the tools as cards,
// the protocols under Downloads), the foot. The state and the words are in ui/toolbox.slint;
// src/toolbox.rs fills and acts.
import { Toolbox, ToolboxWords, ToolRow, ToolSection, NavRow, ProtocolRow } from "../toolbox.slint";
import { AppState, Page } from "../state.slint";
import { Accounts, AccountRow } from "../telegram.slint";
import { AccountColors, Look } from "../look.slint";
import { Downloads } from "../downloads.slint";
import { Icon, Avatar } from "../widgets.slint";
import { WorkbenchPalette as P } from "palette.slint";

// The grids are laid out by hand (Slint has no auto-fill grid): a card is at least 250px wide and
// 58px high, a family's 184px with its protocols; an account's tile at least 172px wide, 44px high.
global Grid {
    out property <length> card-min: 250px;
    out property <length> gap: 8px;
    out property <length> card: 58px;
    out property <length> family: 184px;
    out property <length> tile-min: 172px;
    out property <length> tile-gap: 6px;
    out property <length> tile: 44px;
}

// A row of the column at the left: All, or a category, with how many tools it has (hits while
// searching; the accounts: how many of ten).
component NavLine inherits Rectangle {
    in property <NavRow> nav;
    property <bool> on: (Toolbox.searching ? "all" : Toolbox.category) == nav.id;
    height: 32px;
    border-radius: 6px;
    background: on ? P.sel : touch.has-hover ? P.chrome : transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.nav.icon;
                size: 16px;
                color: root.on ? P.accent-ink : P.muted;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.nav.label;
            color: root.on ? P.accent-ink : P.text;
            font-size: 13px;
            font-weight: root.on ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.nav.accounts && !Toolbox.searching ? root.nav.count + "/10" : "" + root.nav.count;
            color: P.faint;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Toolbox.choose(root.nav.id);
        }
    }
}

// An account's tile: its picture, name and number, its unread messages, its key. The one in
// front is tinted; a click brings another to the front.
component AccountTile inherits Rectangle {
    in property <AccountRow> account;
    height: Grid.tile;
    border-radius: 8px;
    background: account.current ? P.accent-soft : touch.has-hover ? P.side : transparent;
    border-width: 1px;
    border-color: account.current ? P.accent : P.line;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Avatar {
                size: 26px;
                radius: 6px;
                fill: AccountColors.accent(root.account.index, P.dark);
                ink: #ffffff;
                initial: root.account.initial;
                picture: root.account.picture;
                has-picture: root.account.has-picture;
                font-size: 12px;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.account.name;
                color: root.account.current ? P.accent-ink : P.text;
                font-size: 13px;
                font-weight: root.account.current ? 600 : 400;
                overflow: elide;
            }
            Text {
                text: root.account.sub;
                color: P.faint;
                font-size: 11px;
                overflow: elide;
            }
        }
        if root.account.unread > 0 && !root.account.current: VerticalLayout {
            alignment: center;
            Rectangle {
                width: max(18px, unread.preferred-width + 10px);
                height: 16px;
                border-radius: 8px;
                background: P.chrome;
                unread := Text {
                    text: root.account.unread > 99 ? "99+" : "" + root.account.unread;
                    color: P.text;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: AccountColors.key(root.account.index);
            color: P.faint;
            font-family: P.mono;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if !root.account.current {
                Toolbox.close();
                Accounts.switch(root.account.slot);
            }
        }
    }
}

// The tile after the accounts: adding one; greyed with ten.
component AddTile inherits Rectangle {
    height: Grid.tile;
    border-radius: 8px;
    border-width: 1px;
    border-color: P.line;
    background: touch.has-hover && !Accounts.full ? P.side : transparent;
    opacity: Accounts.full ? 0.42 : 1;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: "plus";
                size: 14px;
                color: Accounts.full ? P.faint : P.accent-ink;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: ToolboxWords.add-account();
            color: Accounts.full ? P.faint : P.accent-ink;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
        if Accounts.full: Text {
            text: ToolboxWords.limit-reached();
            color: P.faint;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: Accounts.full ? MouseCursor.default : MouseCursor.pointer;
        clicked => {
            if !Accounts.full {
                Toolbox.close();
                Accounts.add();
            }
        }
    }
}

// The accounts as tiles, as many to a row as fit, the add tile last.
component AccountGrid inherits Rectangle {
    property <int> columns: max(1, Math.floor((self.width + Grid.tile-gap) / (Grid.tile-min + Grid.tile-gap)));
    property <length> tile-width: (self.width - (columns - 1) * Grid.tile-gap) / columns;
    property <int> count: Toolbox.accounts.length + 1;
    height: Math.ceil(count * 1.0 / columns) * (Grid.tile + Grid.tile-gap) - Grid.tile-gap;

    for row[i] in Toolbox.accounts: AccountTile {
        account: row;
        x: Math.mod(i, root.columns) * (root.tile-width + Grid.tile-gap);
        y: Math.floor(i * 1.0 / root.columns) * (Grid.tile + Grid.tile-gap);
        width: root.tile-width;
    }
    AddTile {
        x: Math.mod(root.count - 1, root.columns) * (root.tile-width + Grid.tile-gap);
        y: Math.floor((root.count - 1) * 1.0 / root.columns) * (Grid.tile + Grid.tile-gap);
        width: root.tile-width;
    }
}

// A protocol under Downloads: its name, its default port, a line about it, and how many servers
// speak it, or that this version does not.
component ProtocolLine inherits Rectangle {
    in property <ProtocolRow> protocol;
    height: 24px;
    border-radius: 6px;
    background: touch.has-hover && !protocol.grey ? P.side : transparent;
    opacity: protocol.grey ? 0.42 : 1;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 10px;
        Text {
            width: 54px;
            text: root.protocol.name;
            color: P.text;
            font-family: P.mono;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            width: 62px;
            text: root.protocol.port;
            color: P.faint;
            font-family: P.mono;
            font-size: 11px;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.protocol.line;
            color: P.muted;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.protocol.grey ? ToolboxWords.not-yet() : ToolboxWords.servers(root.protocol.count);
            color: P.faint;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: !root.protocol.grey;
        mouse-cursor: pointer;
        clicked => {
            Toolbox.open-tool("downloads");
        }
    }
}

// A tool's card: its icon block (the accent while pinned), its name with what goes on, a line
// about it, and the switch that pins it to the activity bar. The card opens it; a family lists
// its protocols underneath.
component ToolCard inherits Rectangle {
    in property <ToolRow> tool;
    property <bool> live: !tool.grey;
    property <bool> active: tool.id == "downloads" && Downloads.active-count > 0;
    border-radius: 8px;
    background: touch.has-hover && live ? P.side : P.bg;
    border-width: 1px;
    border-color: P.line;

    touch := TouchArea {
        enabled: root.live;
        mouse-cursor: pointer;
        clicked => {
            Toolbox.open-tool(root.tool.id);
        }
    }
    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 8px;
        alignment: start;
        Rectangle {
            height: 38px;
            opacity: root.live ? 1 : 0.42;
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 8px;
                        background: root.tool.pinned ? P.accent-soft : P.chrome;
                        animate background { duration: 200ms; }
                        Icon {
                            name: root.tool.icon;
                            size: 17px;
                            color: root.tool.pinned ? P.accent-ink : P.muted;
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 1px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.tool.name;
                            color: P.text;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        if root.active: HorizontalLayout {
                            horizontal-stretch: 0;
                            spacing: 4px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: P.accent;
                                }
                            }
                            Text {
                                text: ToolboxWords.downloading(Downloads.active-count);
                                color: P.accent-ink;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.tool.grey ? ToolboxWords.not-yet() : root.tool.pinned ? ToolboxWords.pinned-to(ToolboxWords.activity-bar()) : "";
                            color: P.faint;
                            font-size: 11px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    Text {
                        text: root.tool.line;
                        color: P.muted;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 32px;
                        height: 18px;
                        border-radius: 9px;
                        background: root.tool.pinned ? P.accent : P.off;
                        animate background { duration: 200ms; }
                        Rectangle {
                            x: root.tool.pinned ? 16px : 2px;
                            y: 2px;
                            width: 14px;
                            height: 14px;
                            border-radius: 7px;
                            background: #ffffff;
                            drop-shadow-blur: 2px;
                            drop-shadow-offset-y: 1px;
                            drop-shadow-color: #00000033;
                            animate x { duration: 200ms; }
                        }
                        TouchArea {
                            enabled: root.live;
                            mouse-cursor: pointer;
                            clicked => {
                                Toolbox.pin(root.tool.id, !root.tool.pinned);
                            }
                        }
                    }
                }
            }
        }
        // The protocols, under a family.
        if root.tool.family: HorizontalLayout {
            padding-left: 42px;
            Rectangle {
                width: 1px;
                background: P.line;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                padding-left: 10px;
                spacing: 1px;
                alignment: start;
                Text {
                    text: ToolboxWords.protocols();
                    color: P.faint;
                    font-size: 11px;
                }
                Rectangle { height: 2px; }
                for protocol in Toolbox.protocols: ProtocolLine {
                    protocol: protocol;
                }
            }
        }
    }
}

// A section's tools: a family full width first, then the cards, as many to a row as fit.
component ToolGrid inherits Rectangle {
    in property <ToolSection> section;
    property <int> columns: max(1, Math.floor((self.width + Grid.gap) / (Grid.card-min + Grid.gap)));
    property <length> card-width: (self.width - (columns - 1) * Grid.gap) / columns;
    property <length> top: section.families * (Grid.family + Grid.gap);
    height: top + (section.others > 0 ? Math.ceil(section.others * 1.0 / columns) * (Grid.card + Grid.gap) : 0px) - Grid.gap;

    for tool in section.tools: Rectangle {
        x: tool.family ? 0px : Math.mod(tool.slot, root.columns) * (root.card-width + Grid.gap);
        y: tool.family ? 0px : root.top + Math.floor(tool.slot * 1.0 / root.columns) * (Grid.card + Grid.gap);
        width: tool.family ? root.width : root.card-width;
        height: tool.family ? Grid.family : Grid.card;
        ToolCard {
            tool: tool;
        }
    }
}

// One of the three at the foot: the settings, the AI settings (still to come), the profile.
component FootButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> enabled: true;
    callback activated();
    width: content.preferred-width;
    height: 32px;
    border-radius: 6px;
    background: touch.has-hover && enabled ? P.side : transparent;

    content := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                size: 16px;
                color: P.muted;
                opacity: root.enabled ? 1 : 0.42;
            }
        }
        Text {
            text: root.label;
            color: P.text;
            font-size: 13px;
            vertical-alignment: center;
            opacity: root.enabled ? 1 : 0.42;
        }
        if !root.enabled: Text {
            text: ToolboxWords.not-yet();
            color: P.faint;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

export component WorkbenchToolbox inherits Rectangle {
    property <bool> open: Toolbox.open;
    // Drawn while open and while it slides shut.
    visible: Toolbox.open || slide.x > -slide.width;
    changed open => {
        if self.open {
            search-box.focus();
        }
    }

    // The scrim over the rest: a click on it shuts the toolbox.
    Rectangle {
        background: P.dark ? #00000073 : #1b1f242e;
        opacity: Toolbox.open ? 1 : 0;
        animate opacity { duration: 200ms; }
        TouchArea {
            clicked => {
                Toolbox.close();
            }
        }
    }

    slide := Rectangle {
        x: Toolbox.open ? 0px : -self.width;
        y: 0;
        width: min(780px, parent.width);
        height: parent.height;
        background: P.bg;
        drop-shadow-blur: 30px;
        drop-shadow-offset-x: 10px;
        drop-shadow-color: P.shadow;
        animate x { duration: 240ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

        // Clicks on the panel stay on it; Esc shuts it.
        TouchArea { }
        keys := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape {
                    Toolbox.close();
                    return accept;
                }
                return reject;
            }

            VerticalLayout {
                // The head: the title, the search box, esc.
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 12px;
                    Text {
                        text: ToolboxWords.title();
                        color: P.text;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        max-width: 460px;
                        height: 32px;
                        border-radius: 6px;
                        background: P.side;
                        border-width: 1px;
                        border-color: P.line;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    name: "magnifying-glass";
                                    size: 15px;
                                    color: P.faint;
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                if Toolbox.query == "": Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: ToolboxWords.search();
                                    color: P.faint;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                search-box := TextInput {
                                    width: parent.width;
                                    height: parent.height;
                                    text <=> Toolbox.query;
                                    single-line: true;
                                    color: P.text;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    selection-background-color: P.input-sel;
                                    selection-foreground-color: P.text;
                                    text-cursor-width: Look.cursor-width;
                                    edited => {
                                        Toolbox.search(self.text);
                                    }
                                    accepted => {
                                        Toolbox.open-first();
                                    }
                                }
                            }
                            if Toolbox.searching: Text {
                                text: ToolboxWords.hits(Toolbox.hits);
                                color: P.faint;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            if Toolbox.searching: Text {
                                text: "×";
                                color: P.muted;
                                font-size: 15px;
                                vertical-alignment: center;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        Toolbox.search("");
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: esc.preferred-width + 12px;
                            height: esc.preferred-height + 2px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: P.line;
                            esc := Text {
                                text: "esc";
                                color: P.faint;
                                font-family: P.mono;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    Toolbox.close();
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: P.line;
                }
                HorizontalLayout {
                    vertical-stretch: 1;
                    // The column: All, then the categories.
                    Rectangle {
                        width: 184px;
                        background: P.side;
                        Rectangle {
                            x: parent.width - 1px;
                            width: 1px;
                            background: P.line;
                        }
                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 9px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 2px;
                            alignment: start;
                            for nav in Toolbox.nav: NavLine {
                                nav: nav;
                            }
                        }
                    }
                    // The sections.
                    Flickable {
                        horizontal-stretch: 1;
                        content-height: body.preferred-height;
                        body := VerticalLayout {
                            width: parent.width;
                            alignment: start;
                            padding-left: 18px;
                            padding-right: 18px;
                            padding-top: 14px;
                            padding-bottom: 18px;
                            spacing: 20px;
                            for section in Toolbox.sections: VerticalLayout {
                                spacing: 8px;
                                HorizontalLayout {
                                    padding-left: 2px;
                                    padding-right: 2px;
                                    spacing: 10px;
                                    Text {
                                        text: section.label;
                                        color: P.faint;
                                        font-size: 11px;
                                        font-weight: 600;
                                        letter-spacing: 0.9px;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    if section.accounts: Text {
                                        text: "⌘1–⌘0";
                                        color: P.faint;
                                        font-family: P.mono;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                                if section.accounts: AccountGrid { }
                                if !section.accounts: ToolGrid {
                                    section: section;
                                }
                            }
                            if Toolbox.no-hits: VerticalLayout {
                                padding-top: 28px;
                                padding-bottom: 28px;
                                Text {
                                    text: ToolboxWords.nothing(Toolbox.query);
                                    color: P.faint;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }
                // The foot: the settings, the AI settings (still to come), the profile; the keys.
                Rectangle {
                    height: foot.preferred-height;
                    Rectangle {
                        y: 0;
                        height: 1px;
                        background: P.line;
                    }
                    foot := HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 14px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 2px;
                        FootButton {
                            icon: "gear-six";
                            label: ToolboxWords.settings();
                            activated => {
                                Toolbox.close();
                                AppState.page = Page.settings;
                            }
                        }
                        FootButton {
                            icon: "sparkle";
                            label: ToolboxWords.ai-settings();
                            enabled: false;
                        }
                        FootButton {
                            icon: "user-circle";
                            label: ToolboxWords.profile();
                            activated => {
                                Toolbox.close();
                                AppState.page = Page.profile;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: ToolboxWords.hint("⌘J");
                            color: P.faint;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
