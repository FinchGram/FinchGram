// Workbench's message actions over the window (the design's fourth round, 1c): a message's menu,
// where it was right-clicked, and the dialogs for forwarding, reporting and deleting.
import { Actions, MessageAction, ChatRow, ChatKind, Status, DeleteChoice, Moment, Chats, ChatConfirm } from "../telegram.slint";
import { Fmt } from "../format.slint";
import { Icon, Spinner, Avatar } from "../widgets.slint";
import { ActionWords, AttachWords, ChatMenuWords, MenuPlace, KeyScope, SearchInput, CommentInput } from "../chat.slint";
import { Screenshot } from "../state.slint";
import { MenuEntry } from "conversation.slint";
import { WorkbenchPalette as P } from "palette.slint";

// What a chat to forward to says under its name: its members, its subscribers, online.
global PickerLine {
    property <Moment> never;
    public pure function of(chat: ChatRow) -> string {
        if chat.kind == ChatKind.group && chat.members > 0 {
            return Fmt.status(Status.members, never, chat.members, 0);
        }
        if chat.kind == ChatKind.channel && chat.members > 0 {
            return Fmt.status(Status.subscribers, never, chat.members, 0);
        }
        return chat.online ? Fmt.status(Status.online, never, 0, 0) : "";
    }
}

// A dialog's box over the darkened window; a click beside it closes it.
component Dialog inherits Rectangle {
    in property <length> box-width;
    in property <length> box-height;
    callback close();
    background: #00000059;

    TouchArea {
        clicked => {
            root.close();
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.box-width;
        height: root.box-height;
        border-radius: 10px;
        background: P.bg;
        border-width: 1px;
        border-color: P.line;
        drop-shadow-blur: 60px;
        drop-shadow-offset-y: 24px;
        drop-shadow-color: #0000004d;
        clip: true;

        // Clicks inside stay inside.
        TouchArea { }
        @children
    }
}

// The ✕ at the corner of a dialog.
component CloseButton inherits Rectangle {
    callback clicked();
    width: 22px;
    height: 22px;
    Icon {
        name: "x";
        size: 17px;
        color: P.faint;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A line of a dialog's list, lit under the pointer.
component ListLine inherits Rectangle {
    callback clicked();
    border-radius: 6px;
    background: touch.has-hover ? P.side : transparent;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    @children
}

// A text button of a dialog: plain, or filled (the dialog's main action).
component DialogButton inherits Rectangle {
    in property <string> label;
    in property <bool> filled;
    in property <color> fill: P.accent;
    in property <bool> enabled: true;
    callback clicked();
    width: words.preferred-width + 28px;
    height: words.preferred-height + 14px;
    border-radius: 6px;
    background: root.filled ? root.fill : touch.has-hover ? P.side : transparent;
    opacity: root.enabled ? 1 : 0.45;
    words := Text {
        text: root.label;
        color: root.filled ? (root.fill == P.accent ? P.on-accent : #ffffff) : P.accent-ink;
        font-size: 13px;
        font-weight: 600;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Forwarding: Saved Messages, then the chats to send to, with a search above them.
component ForwardPicker inherits Dialog {
    box-width: 380px;
    box-height: 520px;
    close => {
        Actions.close-picker();
    }

    VerticalLayout {
        HorizontalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 16px;
            padding-bottom: 10px;
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                text: @tr("Choose recipient…");
                color: P.text;
                font-size: 16px;
                font-weight: 600;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                CloseButton {
                    clicked => {
                        Actions.close-picker();
                    }
                }
            }
        }
        HorizontalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-bottom: 8px;
            Rectangle {
                height: 34px;
                border-radius: 6px;
                border-width: 1px;
                border-color: P.line;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: "magnifying-glass";
                            size: 15px;
                            color: P.faint;
                        }
                    }
                    SearchInput {
                        horizontal-stretch: 1;
                        placeholder: @tr("Search");
                        text-color: P.text;
                        placeholder-color: P.faint;
                        selection-color: P.input-sel;
                        font-family: P.font;
                        font-size: 14px;
                        edited(words) => {
                            Actions.search-picker(words);
                        }
                        accepted => {
                            Actions.pick-first();
                        }
                        escape => {
                            Actions.close-picker();
                        }
                    }
                }
            }
        }
        Flickable {
            vertical-stretch: 1;
            mouse-drag-pan-enabled: false;
            content-width: self.width;
            content-height: chats.preferred-height;
            chats := VerticalLayout {
                width: parent.width;
                alignment: start;
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 4px;
                padding-bottom: 12px;
                if Actions.picker-saved: ListLine {
                    height: 52px;
                    clicked => {
                        Actions.pick("saved");
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 36px;
                                height: 36px;
                                border-radius: 8px;
                                background: P.accent;
                                Icon {
                                    name: "bookmark-simple";
                                    size: 18px;
                                    color: P.on-accent;
                                }
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: @tr("Saved Messages");
                            color: P.text;
                            font-size: 14px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
                if Actions.picker-chats.length > 0: HorizontalLayout {
                    padding-left: 10px;
                    padding-top: 10px;
                    padding-bottom: 4px;
                    Text {
                        text: @tr("Recent");
                        color: P.faint;
                        font-size: 11px;
                        font-weight: 600;
                        letter-spacing: 0.88px;
                    }
                }
                for chat in Actions.picker-chats: ListLine {
                    height: 52px;
                    clicked => {
                        Actions.pick(chat.id);
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Avatar {
                                size: 36px;
                                radius: 8px;
                                fill: P.chrome;
                                ink: P.muted;
                                initial: chat.initial;
                                picture: chat.picture;
                                has-picture: chat.has-picture;
                                font-size: 14px;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 1px;
                            Text {
                                text: chat.title;
                                color: P.text;
                                font-size: 14px;
                                font-weight: 600;
                                overflow: elide;
                            }
                            if PickerLine.of(chat) != "": Text {
                                text: PickerLine.of(chat);
                                color: P.faint;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }
                    }
                }
                if !Actions.picker-saved && Actions.picker-chats.length == 0: HorizontalLayout {
                    padding-left: 10px;
                    padding-top: 16px;
                    padding-bottom: 16px;
                    Text {
                        text: @tr("No chats found");
                        color: P.faint;
                        font-size: 13px;
                    }
                }
            }
        }
    }
}

// Reporting: the reasons Telegram's servers offer, step by step, then maybe words to add.
component ReportDialog inherits Dialog {
    box-width: 400px;
    box-height: min(560px, body.preferred-height);
    close => {
        Actions.close-report();
    }

    if !Actions.report-comment: KeyScope {
        width: 0;
        height: 0;
        escape => {
            Actions.close-report();
        }
    }

    body := VerticalLayout {
        HorizontalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 16px;
            padding-bottom: 10px;
            spacing: 10px;
            if !Actions.report-first: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 20px;
                    height: 20px;
                    Icon {
                        name: "arrow-left";
                        size: 18px;
                        color: P.accent;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Actions.report-back();
                        }
                    }
                }
            }
            if Actions.report-first: VerticalLayout {
                alignment: center;
                Icon {
                    name: "flag";
                    size: 18px;
                    color: P.muted;
                }
            }
            Text {
                horizontal-stretch: 1;
                text: ActionWords.report-title();
                color: P.text;
                font-size: 16px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
            VerticalLayout {
                alignment: center;
                CloseButton {
                    clicked => {
                        Actions.close-report();
                    }
                }
            }
        }

        if !Actions.report-comment: Flickable {
            height: min(480px, reasons.preferred-height);
            mouse-drag-pan-enabled: false;
            content-width: self.width;
            content-height: reasons.preferred-height;
            reasons := VerticalLayout {
                width: parent.width;
                alignment: start;
                padding-left: 8px;
                padding-right: 8px;
                padding-bottom: 12px;
                if Actions.report-busy && Actions.report-options.length == 0: HorizontalLayout {
                    alignment: center;
                    padding: 16px;
                    Spinner {
                        size: 18px;
                        color: P.faint;
                    }
                }
                for reason[index] in Actions.report-options: ListLine {
                    height: 40px;
                    clicked => {
                        if !Actions.report-busy {
                            Actions.report-choose(index);
                        }
                    }
                    HorizontalLayout {
                        width: parent.width;
                        height: parent.height;
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            horizontal-stretch: 1;
                            text: reason;
                            color: P.text;
                            font-size: 14px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }

        if Actions.report-comment: VerticalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 2px;
            padding-bottom: 18px;
            spacing: 10px;
            Rectangle {
                height: 120px;
                border-radius: 8px;
                border-width: 1px;
                border-color: P.line;
                comment := CommentInput {
                    placeholder: Actions.report-comment-required ? @tr("Add a comment") : @tr("Add a comment (optional)");
                    text-color: P.text;
                    placeholder-color: P.faint;
                    selection-color: P.input-sel;
                    font-family: P.font;
                    font-size: 14px;
                    line-height-factor: P.leading(1.5);
                    submit => {
                        if !Actions.report-busy && (!Actions.report-comment-required || self.text != "") {
                            Actions.report-submit(self.text);
                        }
                    }
                    escape => {
                        Actions.close-report();
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: comment.text.character-count + " / 1024";
                    color: P.faint;
                    font-family: P.mono;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                DialogButton {
                    label: @tr("Cancel");
                    clicked => {
                        Actions.close-report();
                    }
                }
                DialogButton {
                    label: @tr("Report");
                    filled: true;
                    enabled: !Actions.report-busy && (!Actions.report-comment-required || comment.text != "");
                    clicked => {
                        Actions.report-submit(comment.text);
                    }
                }
            }
        }
    }
}

// Deleting: the question, and for whom when there is a choice.
component DeleteDialog inherits Dialog {
    box-width: 360px;
    box-height: body.preferred-height;
    close => {
        Actions.close-delete();
    }

    KeyScope {
        width: 0;
        height: 0;
        escape => {
            Actions.close-delete();
        }
        enter => {
            Actions.confirm-delete();
        }
    }

    body := VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 20px;
        padding-bottom: 16px;
        spacing: 16px;
        Text {
            text: ActionWords.delete-title();
            color: P.text;
            font-size: 16px;
            font-weight: 600;
            wrap: word-wrap;
        }
        if Actions.delete-choice != DeleteChoice.none: Rectangle {
            height: 20px;
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 4px;
                        background: Actions.revoke ? P.accent : transparent;
                        border-width: Actions.revoke ? 0 : 1.5px;
                        border-color: P.faint;
                        if Actions.revoke: Icon {
                            name: "check";
                            size: 12px;
                            color: P.on-accent;
                        }
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: ActionWords.delete-choice();
                    color: P.text;
                    font-size: 14px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Actions.revoke = !Actions.revoke;
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            DialogButton {
                label: @tr("Cancel");
                clicked => {
                    Actions.close-delete();
                }
            }
            DialogButton {
                label: @tr("Delete");
                filled: true;
                fill: P.danger;
                clicked => {
                    Actions.confirm-delete();
                }
            }
        }
    }
}

// The screenshot tool has no leave to see the screen (src/screenshot/): where to give it.
component PermissionCard inherits Dialog {
    box-width: 380px;
    box-height: body.preferred-height;
    close => {
        Screenshot.dismiss-permission();
    }

    KeyScope {
        width: 0;
        height: 0;
        escape => {
            Screenshot.dismiss-permission();
        }
        enter => {
            Screenshot.open-system-settings();
        }
    }

    body := VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 20px;
        padding-bottom: 16px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 34px;
                    height: 34px;
                    border-radius: 6px;
                    background: P.danger-soft;
                    Icon {
                        name: "monitor";
                        size: 18px;
                        color: P.danger;
                    }
                }
            }
            Text {
                horizontal-stretch: 1;
                text: AttachWords.permission-title();
                color: P.text;
                font-size: 16px;
                font-weight: 600;
                wrap: word-wrap;
                vertical-alignment: center;
            }
        }
        Text {
            text: AttachWords.permission-lead();
            color: P.muted;
            font-size: 14px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            DialogButton {
                label: AttachWords.not-now();
                clicked => {
                    Screenshot.dismiss-permission();
                }
            }
            DialogButton {
                label: AttachWords.open-system-settings();
                filled: true;
                clicked => {
                    Screenshot.open-system-settings();
                }
            }
        }
    }
}

// A chat's menu asked before something that cannot be undone: blocking a user, leaving a group or
// channel, deleting a chat (chats.rs).
component ChatQuestion inherits Dialog {
    box-width: 360px;
    box-height: body.preferred-height;
    close => {
        Chats.cancel-confirm();
    }

    KeyScope {
        width: 0;
        height: 0;
        escape => {
            Chats.cancel-confirm();
        }
        enter => {
            Chats.confirm();
        }
    }

    body := VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 20px;
        padding-bottom: 16px;
        spacing: 16px;
        Text {
            text: ChatMenuWords.title(Chats.question, Chats.confirm-kind, Chats.confirm-title);
            color: P.text;
            font-size: 16px;
            font-weight: 600;
            wrap: word-wrap;
        }
        Text {
            text: ChatMenuWords.lead(Chats.question, Chats.confirm-kind);
            color: P.muted;
            font-size: 14px;
            wrap: word-wrap;
        }
        if Chats.confirm-revoke-choice: Rectangle {
            height: 20px;
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 4px;
                        background: Chats.confirm-revoke ? P.accent : transparent;
                        border-width: Chats.confirm-revoke ? 0 : 1.5px;
                        border-color: P.faint;
                        if Chats.confirm-revoke: Icon {
                            name: "check";
                            size: 12px;
                            color: P.on-accent;
                        }
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: ChatMenuWords.revoke(Chats.confirm-title);
                    color: P.text;
                    font-size: 14px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Chats.confirm-revoke = !Chats.confirm-revoke;
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            DialogButton {
                label: @tr("Cancel");
                clicked => {
                    Chats.cancel-confirm();
                }
            }
            DialogButton {
                label: ChatMenuWords.action(Chats.question);
                filled: true;
                fill: P.danger;
                clicked => {
                    Chats.confirm();
                }
            }
        }
    }
}

export component WorkbenchActions inherits Rectangle {
    // A message's menu, where it was clicked; a click anywhere else closes it.
    if Actions.menu-open: TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                Actions.close-menu();
            }
        }
    }
    if Actions.menu-open: Rectangle {
        x: MenuPlace.x(Actions.menu-x, self.width, root.width);
        y: MenuPlace.y(Actions.menu-y, self.height, root.height);
        width: 220px;
        height: entries.preferred-height;
        border-radius: 8px;
        background: P.bg;
        border-width: 1px;
        border-color: P.line;
        drop-shadow-blur: 32px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: P.shadow;

        KeyScope {
            width: 0;
            height: 0;
            escape => {
                Actions.close-menu();
            }
        }
        entries := VerticalLayout {
            padding: 6px;
            for item in Actions.menu-items: MenuEntry {
                icon: ActionWords.icon(item);
                label: ActionWords.label(item);
                danger: item == MessageAction.delete;
                activated => {
                    Actions.choose(item);
                }
            }
        }
    }

    if Actions.picker-open: ForwardPicker { }
    if Actions.report-open: ReportDialog { }
    if Actions.delete-open: DeleteDialog { }
    if Screenshot.permission-card: PermissionCard { }
    if Chats.question != ChatConfirm.none: ChatQuestion { }
}
