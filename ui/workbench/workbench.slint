// Workbench (the design's "1c 工作台", the default theme): an editor's layout. A title bar with the
// account and a search box, an activity bar, the side bar with the chat tree, the chats as tabs,
// and a status bar.
import { AppState, Page, Connection } from "../state.slint";
import { Toolbox, ToolboxWords } from "../toolbox.slint";
import { WorkbenchToolbox } from "toolbox.slint";
import { Downloads } from "../downloads.slint";
import { ChatInfo } from "../chat-info.slint";
import { Chats, Conversation, Account, Accounts } from "../telegram.slint";
import { Fmt } from "../format.slint";
import { Icon, Logo, WindowButtonsSpace, WindowMover, Avatar } from "../widgets.slint";
import { WorkbenchPalette as P } from "palette.slint";
import { Look, AccountColors } from "../look.slint";
import { Downloads } from "../downloads.slint";
import { WorkbenchSidebar, WorkbenchView } from "sidebar.slint";
import { WorkbenchMain } from "conversation.slint";
import { WorkbenchActions } from "actions.slint";
import { WorkbenchAttachments } from "attachments.slint";
import { WorkbenchCompose } from "compose.slint";
import { Search, ComposeWords } from "../compose.slint";

// The search box in the title bar: a click, or ⌘K, opens the search over everything (compose.slint).
component SearchBox inherits Rectangle {
    width: 420px;
    height: 26px;
    border-radius: 6px;
    background: P.bg;
    border-width: 1px;
    border-color: touch.has-hover ? P.accent.transparentize(0.4) : P.line;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: "magnifying-glass";
                size: 14px;
                color: P.faint;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: ComposeWords.box-placeholder();
            color: P.faint;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: "⌘K";
            color: P.faint;
            font-family: P.mono;
            font-size: 11px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: text;
        clicked => {
            Search.show();
        }
    }

    property <int> search-requests: AppState.search-requests;
    changed search-requests => {
        Search.show();
    }
}

component TitleBar inherits Rectangle {
    height: 40px;
    background: P.chrome;

    WindowMover { }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: P.line;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        WindowButtonsSpace { }
        HorizontalLayout {
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 2px;
                    background: P.accent;
                }
            }
            Text {
                text: "FinchGram — " + Account.name;
                color: P.text;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: center;
            VerticalLayout {
                alignment: center;
                SearchBox { }
            }
        }
        Rectangle {
            HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        name: P.dark ? "sun" : "moon";
                        size: 15px;
                        color: P.muted;
                    }
                }
                Text {
                    text: P.dark ? @tr("Light") : @tr("Dark");
                    color: P.muted;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    AppState.change-appearance(P.dark ? "light" : "dark");
                }
            }
        }
    }

}

component ActivityButton inherits Rectangle {
    in property <string> icon;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <bool> dot;
    in property <int> count;        // a number at the corner, for downloads on their way
    callback activated();
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: active ? P.accent-soft : touch.has-hover && enabled ? P.line.transparentize(0.3) : transparent;
    opacity: enabled ? 1 : 0.4;

    Icon {
        name: root.icon;
        size: 21px;
        color: root.active ? P.accent : P.faint;
    }

    if root.count > 0: Rectangle {
        x: parent.width - self.width - 2px;
        y: 3px;
        width: max(15px, count-label.preferred-width + 8px);
        height: 15px;
        border-radius: 8px;
        background: P.accent;
        border-width: 2px;
        border-color: P.chrome;
        count-label := Text {
            text: root.count > 99 ? "99+" : "" + root.count;
            color: P.on-accent;
            font-size: 10px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if root.dot: Rectangle {
        x: parent.width - 7px - 7px;
        y: 7px;
        width: 7px;
        height: 7px;
        border-radius: 3.5px;
        background: P.accent;
        border-width: 2px;
        border-color: P.chrome;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

// The account menu, from the letter at the foot of the activity bar: every account, the one in
// front ticked, each with its colour and its key; adding one (greyed with ten); managing them.
component AccountMenu inherits Rectangle {
    width: 300px;
    height: list.preferred-height;
    border-radius: 10px;
    background: P.bg;
    border-width: 1px;
    border-color: P.line;
    drop-shadow-blur: 32px;
    drop-shadow-offset-y: 12px;
    drop-shadow-color: P.shadow;
    callback done();

    list := VerticalLayout {
        padding: 6px;
        Text {
            height: 30px;
            x: 10px;
            text: (@tr("Accounts") + " · " + Accounts.count + "/10").to-uppercase();
            color: P.faint;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.88px;
            vertical-alignment: center;
        }
        for row in Accounts.rows: Rectangle {
            height: 42px;
            border-radius: 6px;
            background: row.current || row-touch.has-hover ? P.side : transparent;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Avatar {
                        size: 26px;
                        radius: 6px;
                        fill: AccountColors.accent(row.index, P.dark);
                        ink: #ffffff;
                        initial: row.initial;
                        picture: row.picture;
                        has-picture: row.has-picture;
                        font-size: 12px;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: row.name;
                        color: P.text;
                        font-size: 13px;
                        font-weight: row.current ? 600 : 400;
                        overflow: elide;
                    }
                    Text {
                        text: row.sub;
                        color: P.faint;
                        font-size: 11px;
                        overflow: elide;
                    }
                }
                if row.unread > 0 && !row.current: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: AccountColors.accent(row.index, P.dark);
                    }
                }
                if row.current: VerticalLayout {
                    alignment: center;
                    Icon {
                        name: "check";
                        size: 15px;
                        color: P.accent;
                    }
                }
                Text {
                    width: 24px;
                    text: AccountColors.key(row.index);
                    color: P.faint;
                    font-family: P.mono;
                    font-size: 11px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
            row-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if !row.current {
                        Accounts.switch(row.slot);
                    }
                    root.done();
                }
            }
        }
        Rectangle {
            height: 9px;
            Rectangle {
                height: 1px;
                x: 6px;
                width: parent.width - 12px;
                background: P.line;
            }
        }
        Rectangle {
            height: 32px;
            border-radius: 6px;
            background: add-touch.has-hover && !Accounts.full ? P.side : transparent;
            opacity: Accounts.full ? 0.45 : 1;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        name: "plus";
                        size: 15px;
                        color: P.muted;
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: @tr("Add account");
                    color: P.text;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                if Accounts.full: Text {
                    text: ToolboxWords.limit-reached();
                    color: P.faint;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
            add-touch := TouchArea {
                mouse-cursor: Accounts.full ? MouseCursor.default : MouseCursor.pointer;
                clicked => {
                    if !Accounts.full {
                        Accounts.add();
                        root.done();
                    }
                }
            }
        }
        Rectangle {
            height: 32px;
            border-radius: 6px;
            background: manage.has-hover ? P.side : transparent;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        name: "sliders-horizontal";
                        size: 15px;
                        color: P.muted;
                    }
                }
                Text {
                    text: @tr("Manage accounts");
                    color: P.muted;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
            manage := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    AppState.page = Page.profile;
                    root.done();
                }
            }
        }
    }
}

component ActivityBar inherits Rectangle {
    in-out property <WorkbenchView> view;
    width: 52px;
    background: P.chrome;

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: P.line;
    }

    VerticalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 6px;
        alignment: start;

        // The logo opens the toolbox (toolbox.slint): ringed while it is open, with a dot while an
        // unpinned tool has something going on.
        HorizontalLayout {
            alignment: center;
            padding-bottom: 8px;
            Rectangle {
                width: 32px;
                height: 32px;
                Rectangle {
                    x: -2px;
                    y: -2px;
                    width: 36px;
                    height: 36px;
                    border-radius: 10px;
                    border-width: 2px;
                    border-color: Toolbox.open ? P.accent : transparent;
                }
                Logo {
                    size: 32px;
                    radius: 8px;
                }
                if Toolbox.logo-dot: Rectangle {
                    x: parent.width - 6px;
                    y: -3px;
                    width: 9px;
                    height: 9px;
                    border-radius: 4.5px;
                    background: P.warn;
                    border-width: 2px;
                    border-color: P.chrome;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Toolbox.toggle();
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            ActivityButton {
                icon: "chats";
                active: root.view == WorkbenchView.chats;
                activated => {
                    Toolbox.close();
                    root.view = WorkbenchView.chats;
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            ActivityButton {
                icon: "megaphone";
                active: root.view == WorkbenchView.channels;
                dot: root.view != WorkbenchView.channels && Chats.unread-channels > 0;
                activated => {
                    Toolbox.close();
                    root.view = WorkbenchView.channels;
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            ActivityButton {
                icon: "robot";
                active: root.view == WorkbenchView.bots;
                activated => {
                    Toolbox.close();
                    root.view = WorkbenchView.bots;
                }
            }
        }
    }

    VerticalLayout {
        padding-bottom: 10px;
        spacing: 6px;
        alignment: end;
        // The tools pinned in the toolbox (toolbox.slint), in its order; downloads carry the number
        // on their way.
        for tool in Toolbox.pinned: HorizontalLayout {
            alignment: center;
            ActivityButton {
                icon: tool.icon;
                count: tool.id == "downloads" ? Downloads.active-count : 0;
                activated => {
                    Toolbox.open-tool(tool.id);
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            avatar := Rectangle {
                width: 32px;
                height: 32px;
                Avatar {
                    size: 32px;
                    radius: 8px;
                    fill: P.accent;
                    ink: P.on-accent;
                    initial: Account.initial;
                    picture: Account.picture;
                    has-picture: Account.has-picture;
                    font-size: 13px;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Toolbox.close();
                        menu.show();
                    }
                }
                menu := PopupWindow {
                    x: 48px;
                    // The menu grows upwards with the accounts: 42px a row, its foot where it was.
                    y: parent.height - 148px - Accounts.count * 42px;
                    close-policy: PopupClosePolicy.close-on-click-outside;
                    AccountMenu {
                        done => {
                            menu.close();
                        }
                    }
                }
            }
        }
    }
}

component StatusBar inherits Rectangle {
    height: 24px;
    background: P.chrome;

    Rectangle {
        height: 1px;
        y: 0;
        background: P.line;
    }

    HorizontalLayout {
        padding-left: 12px;
        spacing: 16px;
        Text {
            text: "FinchGram";
            color: P.text;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
        HorizontalLayout {
            spacing: 5px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: AppState.connection == Connection.ready ? P.teal
                        : AppState.connection == Connection.waiting-for-network ? P.warn : P.faint;
                }
            }
            Text {
                text: Fmt.connection(AppState.connection);
                color: P.muted;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        Rectangle {
            width: chip.preferred-width;
            background: P.accent-soft;
            chip := HorizontalLayout {
                padding-left: 6px;
                padding-right: 12px;
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 2px;
                        background: P.accent;
                    }
                }
                Text {
                    text: Account.phone == "" ? Account.name : Account.name + " · " + Account.phone;
                    color: P.accent-ink;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component WorkbenchWindow inherits Rectangle {
    property <WorkbenchView> view: WorkbenchView.chats;
    background: P.bg;

    VerticalLayout {
        TitleBar { }
        HorizontalLayout {
            vertical-stretch: 1;
            ActivityBar {
                view <=> root.view;
            }
            WorkbenchSidebar {
                view: root.view;
                room: root.width - 52px - 388px - (Conversation.chat-id != "" && ChatInfo.open ? 300px : 0px);
            }
            Rectangle {
                width: 1px;
                background: P.line;
            }
            WorkbenchMain {
                horizontal-stretch: 1;
            }
        }
        StatusBar { }
    }

    // The toolbox, over the sidebar and the messages, under the title bar and above the status bar.
    WorkbenchToolbox {
        x: 52px;
        y: 40px;
        width: root.width - 52px;
        height: root.height - 40px - 24px;
    }

    // A message's menu and the dialogs of its actions, over everything; the search over everything
    // and the pencil's dialogs.
    WorkbenchActions { }
    WorkbenchAttachments { }
    WorkbenchCompose { }
}
