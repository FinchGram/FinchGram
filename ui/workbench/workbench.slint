// Workbench (the design's "1c 工作台", the default theme): an editor's layout. A title bar with the
// account and a search box, an activity bar, the side bar with the chat tree, the chats as tabs,
// and a status bar.
import { AppState, Page, Connection } from "../state.slint";
import { Chats, Conversation, Account } from "../telegram.slint";
import { Fmt } from "../format.slint";
import { Icon, Logo, WindowButtonsSpace, WindowMover } from "../widgets.slint";
import { WorkbenchPalette as P } from "palette.slint";
import { WorkbenchSidebar, WorkbenchView } from "sidebar.slint";
import { WorkbenchMain } from "conversation.slint";

component SearchBox inherits Rectangle {
    width: 420px;
    height: 26px;
    border-radius: 6px;
    background: P.bg;
    border-width: 1px;
    border-color: input.has-focus ? P.accent.transparentize(0.4) : P.line;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: "magnifying-glass";
                size: 14px;
                color: P.faint;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            Text {
                width: parent.width;
                visible: input.text == "";
                text: @tr("Search chats");
                color: P.faint;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }
            input := TextInput {
                width: parent.width;
                height: parent.height;
                text: Chats.query;
                color: P.text;
                font-size: 13px;
                vertical-alignment: center;
                single-line: true;
                selection-background-color: P.sel;
                edited => {
                    Chats.search(self.text);
                }
                accepted => {
                    if Chats.list.length > 0 {
                        Conversation.open(Chats.list[0].id);
                    }
                }
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        self.text = "";
                        Chats.search("");
                        return accept;
                    }
                    return reject;
                }
            }
        }
        Text {
            text: "⌘K";
            color: P.faint;
            font-family: P.mono;
            font-size: 11px;
            vertical-alignment: center;
        }
    }

    property <int> search-requests: AppState.search-requests;
    changed search-requests => {
        root.focus-search();
    }

    public function focus-search() {
        input.focus();
        input.select-all();
    }
}

component TitleBar inherits Rectangle {
    height: 40px;
    background: P.chrome;

    WindowMover { }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: P.line;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        WindowButtonsSpace { }
        HorizontalLayout {
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 2px;
                    background: P.accent;
                }
            }
            Text {
                text: Account.name;
                color: P.text;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: center;
            VerticalLayout {
                alignment: center;
                search := SearchBox { }
            }
        }
        Rectangle {
            HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        name: P.dark ? "sun" : "moon";
                        size: 15px;
                        color: P.muted;
                    }
                }
                Text {
                    text: P.dark ? @tr("Light") : @tr("Dark");
                    color: P.muted;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    AppState.change-appearance(P.dark ? "light" : "dark");
                }
            }
        }
    }

    public function focus-search() {
        search.focus-search();
    }
}

component ActivityButton inherits Rectangle {
    in property <string> icon;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <bool> dot;
    callback activated();
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: active ? P.accent-soft : touch.has-hover && enabled ? P.line.transparentize(0.3) : transparent;
    opacity: enabled ? 1 : 0.4;

    Icon {
        name: root.icon;
        size: 21px;
        color: root.active ? P.accent : P.faint;
    }

    if root.dot: Rectangle {
        x: parent.width - 7px - 7px;
        y: 7px;
        width: 7px;
        height: 7px;
        border-radius: 3.5px;
        background: P.accent;
        border-width: 2px;
        border-color: P.chrome;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

// The account menu, from the letter at the foot of the activity bar.
component AccountMenu inherits Rectangle {
    width: 300px;
    height: list.preferred-height;
    border-radius: 10px;
    background: P.bg;
    border-width: 1px;
    border-color: P.line;
    drop-shadow-blur: 32px;
    drop-shadow-offset-y: 12px;
    drop-shadow-color: P.shadow;
    callback done();

    list := VerticalLayout {
        padding: 6px;
        Text {
            height: 30px;
            x: 10px;
            text: (@tr("Accounts") + " · 1/10").to-uppercase();
            color: P.faint;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.88px;
            vertical-alignment: center;
        }
        Rectangle {
            height: 42px;
            border-radius: 6px;
            background: P.side;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 6px;
                        background: P.accent;
                        Text {
                            text: Account.initial;
                            color: #ffffff;
                            font-size: 12px;
                            font-weight: 600;
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: Account.name;
                        color: P.text;
                        font-size: 13px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        text: Account.username == "" ? Account.phone : "@" + Account.username + " · " + Account.phone;
                        color: P.faint;
                        font-size: 11px;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Icon {
                        name: "check";
                        size: 15px;
                        color: P.accent;
                    }
                }
                Text {
                    width: 24px;
                    text: "⌘1";
                    color: P.faint;
                    font-family: P.mono;
                    font-size: 11px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle {
            height: 9px;
            Rectangle {
                height: 1px;
                x: 6px;
                width: parent.width - 12px;
                background: P.line;
            }
        }
        // Several accounts are still to come.
        Rectangle {
            height: 32px;
            opacity: 0.45;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        name: "plus";
                        size: 15px;
                        color: P.muted;
                    }
                }
                Text {
                    text: @tr("Add account");
                    color: P.muted;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle {
            height: 32px;
            border-radius: 6px;
            background: manage.has-hover ? P.side : transparent;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        name: "sliders-horizontal";
                        size: 15px;
                        color: P.muted;
                    }
                }
                Text {
                    text: @tr("Manage accounts");
                    color: P.muted;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
            manage := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    AppState.page = Page.profile;
                    root.done();
                }
            }
        }
    }
}

component ActivityBar inherits Rectangle {
    in-out property <WorkbenchView> view;
    width: 52px;
    background: P.chrome;

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: P.line;
    }

    VerticalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 6px;
        alignment: start;

        HorizontalLayout {
            alignment: center;
            padding-bottom: 8px;
            Logo {
                size: 32px;
                radius: 8px;
            }
        }
        HorizontalLayout {
            alignment: center;
            ActivityButton {
                icon: "chats";
                active: root.view == WorkbenchView.chats;
                activated => {
                    root.view = WorkbenchView.chats;
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            ActivityButton {
                icon: "megaphone";
                active: root.view == WorkbenchView.channels;
                dot: root.view != WorkbenchView.channels && Chats.unread-channels > 0;
                activated => {
                    root.view = WorkbenchView.channels;
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            ActivityButton {
                icon: "robot";
                active: root.view == WorkbenchView.bots;
                activated => {
                    root.view = WorkbenchView.bots;
                }
            }
        }
        // Keyword filters and scheduled messages are still to come.
        HorizontalLayout {
            alignment: center;
            ActivityButton {
                icon: "funnel-simple";
                enabled: false;
            }
        }
        HorizontalLayout {
            alignment: center;
            ActivityButton {
                icon: "clock";
                enabled: false;
            }
        }
    }

    VerticalLayout {
        padding-bottom: 10px;
        spacing: 6px;
        alignment: end;
        HorizontalLayout {
            alignment: center;
            ActivityButton {
                icon: "gear-six";
                activated => {
                    AppState.page = Page.settings;
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            avatar := Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: P.accent;
                Text {
                    text: Account.initial;
                    color: P.on-accent;
                    font-size: 13px;
                    font-weight: 600;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        menu.show();
                    }
                }
                menu := PopupWindow {
                    x: 48px;
                    y: parent.height - 190px;
                    close-policy: PopupClosePolicy.close-on-click-outside;
                    AccountMenu {
                        done => {
                            menu.close();
                        }
                    }
                }
            }
        }
    }
}

component StatusBar inherits Rectangle {
    height: 24px;
    background: P.chrome;

    Rectangle {
        height: 1px;
        y: 0;
        background: P.line;
    }

    HorizontalLayout {
        padding-left: 12px;
        spacing: 16px;
        Text {
            text: "FinchGram";
            color: P.text;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
        HorizontalLayout {
            spacing: 5px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: AppState.connection == Connection.ready ? P.teal
                        : AppState.connection == Connection.waiting-for-network ? P.warn : P.faint;
                }
            }
            Text {
                text: Fmt.connection(AppState.connection);
                color: P.muted;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        Rectangle {
            width: chip.preferred-width;
            background: P.accent-soft;
            chip := HorizontalLayout {
                padding-left: 6px;
                padding-right: 12px;
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 2px;
                        background: P.accent;
                    }
                }
                Text {
                    text: Account.phone == "" ? Account.name : Account.name + " · " + Account.phone;
                    color: P.accent-ink;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component WorkbenchWindow inherits Rectangle {
    property <WorkbenchView> view: WorkbenchView.chats;
    background: P.bg;

    // ⌘K, from the menu bar (app.slint).
    public function focus-search() {
        title.focus-search();
    }

    VerticalLayout {
        title := TitleBar { }
        HorizontalLayout {
            vertical-stretch: 1;
            ActivityBar {
                view <=> root.view;
            }
            WorkbenchSidebar {
                view: root.view;
            }
            Rectangle {
                width: 1px;
                background: P.line;
            }
            WorkbenchMain {
                horizontal-stretch: 1;
            }
        }
        StatusBar { }
    }
}
