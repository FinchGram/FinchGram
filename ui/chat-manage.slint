// Managing a group or channel (the design's "管理群组 / 频道" round, ChatManage): the page the
// info panel's Manage row opens in the panel's place, in every theme. The state and the words are
// here; the page is drawn once, with each theme's tokens (ManageLook, set in ui/<theme>/
// chat-info.slint), in chat-manage-panel.slint, as the design draws it; src/telegram/manage.rs
// fills it and acts.

export enum ManagePage { main, rights, crop }

// Where the username typed stands.
export enum UsernameCheck { same, ok, taken, checking, short, chars, start, empty, invalid, too-many }

// A switch: what members may do, a group's or channel's option, an administrator's right.
export struct ManageToggle {
    id: string,
    label: string,
    note: string,            // a line under the label, "" for none
    on: bool,
    enabled: bool,           // we may change it; else faded, with a lock
    lock: string,            // why not, for the lock's tip; "" when we may
}

// A choice among a few: slow mode's delays, a link's expiry and limit, a username to try.
export struct ManageChip {
    id: string,
    label: string,
    on: bool,
}

// A member, an administrator, or a contact to add.
export struct ManagePerson {
    id: string,              // the user id
    name: string,
    initial: string,
    picture: image,
    has-picture: bool,
    you: bool,
    tag: string,             // "Group owner", "Administrator", or ""
    owner: bool,
    admin: bool,
    can-promote: bool,       // the shield: we may make them an administrator
    promote-lock: string,    // why not, for the shield's tip
    can-remove: bool,
    confirming: bool,        // the row asks whether to remove them
    sub: string,             // an administrator's second line: their rights, who made them one
}

export struct ManageLink {
    link: string,
    name: string,
    meta: string,            // "5 days left · no limit · 12 joined"
}

// A group the channel may link as its discussion group.
export struct ManageChoice {
    id: string,
    name: string,
    on: bool,
}

export global ChatManage {
    in-out property <bool> open;             // the page shows in the info panel's place
    in-out property <ManagePage> page;
    in-out property <bool> group;            // a group; else a channel
    in-out property <bool> supergroup;
    in-out property <string> title;          // the head: Manage group, Administrator rights, Change photo
    in-out property <bool> can-save;
    in-out property <bool> saving;
    // The profile.
    in-out property <string> name;
    in-out property <string> description;
    in-out property <string> initial;
    in-out property <image> picture;
    in-out property <bool> has-picture;
    in-out property <string> name-error;
    in-out property <string> profile-error;
    in-out property <bool> can-info;         // we may change the name, photo, description and type
    // The type.
    in-out property <bool> public;
    in-out property <string> username;
    in-out property <UsernameCheck> check;
    in-out property <string> check-text;
    in-out property <[ManageChip]> suggestions;
    in-out property <string> type-error;
    in-out property <bool> can-invite;
    // The invite links, of a private chat.
    in-out property <string> primary-link;
    in-out property <bool> revoking;
    in-out property <[ManageLink]> links;
    in-out property <bool> link-form;
    in-out property <string> link-name;
    in-out property <[ManageChip]> expiries;
    in-out property <[ManageChip]> limits;
    // The members and the administrators.
    in-out property <string> count-line;
    in-out property <string> members-error;
    in-out property <bool> adding;
    in-out property <string> query;
    in-out property <[ManagePerson]> candidates;
    in-out property <[ManagePerson]> members;
    in-out property <[ManagePerson]> admins;
    // The group's settings, or the channel's.
    in-out property <string> group-error;
    in-out property <bool> perms-open;
    in-out property <string> perms-summary;
    in-out property <[ManageToggle]> perms;
    in-out property <[[ManageChip]]> slow-rows;  // slow mode's delays, in two rows
    in-out property <string> slow-note;
    in-out property <[ManageToggle]> options;
    in-out property <string> pending;        // "3 requests await your approval", or ""
    in-out property <string> discussion;     // the linked group's name, or "Not linked"
    in-out property <bool> discussion-linked;
    in-out property <bool> discussion-open;
    in-out property <[ManageChoice]> discussion-options;
    // The rights page.
    in-out property <ManagePerson> who;
    in-out property <string> lock-note;
    in-out property <string> rights-error;
    in-out property <string> custom-title;
    in-out property <bool> title-editable;
    in-out property <[ManageToggle]> rights;
    in-out property <bool> can-dismiss;
    // The crop page: the picture picked, the zoom (1 … 3) and where the frame sits in it (0 … 1).
    in-out property <image> source;
    in-out property <float> zoom: 1.2;
    in-out property <float> offset-x: 0.5;
    in-out property <float> offset-y: 0.5;

    callback back();
    callback save();
    callback dismiss-error(string);          // a section: "profile", "type", "members", "group", "rights"
    callback edit-name(string);
    callback edit-description(string);
    callback change-photo();
    callback set-public(bool);
    callback edit-username(string);
    callback take-suggestion(string);
    callback copy-primary();
    callback revoke-primary();
    callback confirm-revoke();
    callback cancel-revoke();
    callback new-link();
    callback edit-link-name(string);
    callback choose-expiry(string);
    callback choose-limit(string);
    callback create-link();
    callback cancel-link();
    callback copy-link(string);
    callback revoke-link(string);
    callback toggle-adding();
    callback edit-query(string);
    callback add-member(string);
    callback promote(string);
    callback remove(string);
    callback confirm-remove();
    callback cancel-remove();
    callback open-admin(string);
    callback toggle-perms();
    callback toggle-permission(string);
    callback set-slow(string);
    callback toggle-option(string);
    callback toggle-discussion();
    callback choose-discussion(string);
    callback unlink-discussion();
    callback edit-title(string);
    callback toggle-right(string);
    callback dismiss-admin();
    callback use-photo();
    callback cancel-crop();
    callback pick-photo();
}

// How a theme draws the page: the design's tokens (chat-manage.js, `k`), one set per theme.
export struct ManageLook {
    font: string,
    mono: string,
    fs: length,              // the body
    fs-s: length,            // notes, buttons
    fs-xs: length,           // labels, counters
    fs-t: length,            // the head's title
    r: length,               // small corners: inputs, buttons
    rl: length,              // large corners: cards
    av-r: length,            // the photo's corners
    chip-r: length,
    panel: color,
    text: color,
    muted: color,
    faint: color,
    accent: color,
    on-accent: color,
    link: color,             // links and the Back
    hover: color,
    line: color,
    off: color,              // a switch that is off
    ok: color,
    bad: color,
    bad-soft: color,         // an error line's background
    soft: color,             // an administrator's avatar, a chosen chip
    soft-ink: color,
    in-bg: color,            // inputs
    ring: color,             // inputs' ring; transparent for none
    ring-width: length,
    in-h: length,
    card: color,
    card-ring: color,
    sec-fs: length,          // section headers
    sec-weight: int,
    sec-spacing: length,
    sec-upper: bool,
    sec-color: color,
    sec-rule: bool,          // Broadsheet's rule under the header
    head-rule: length,       // the head's rule: 1px, Broadsheet's 2px
    pad: length,             // the page's side padding
    sw-w: length,            // switches
    sw-h: length,
    sw-r: length,
    knob-r: length,
    av-font: length,
    icons: bool,             // Phosphor icons; Terminal draws words and brackets instead
    brackets: bool,          // Terminal: buttons are [words]
    text-switches: bool,     // Terminal: switches are [on ] and [off]
}

