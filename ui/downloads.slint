// Downloads (the design's third round of the shared pages, "FinchGram Desktop 下载"): the
// servers, the folder being looked at, and the queue of files on their way, up or down. Rust fills
// this global (src/downloads/) and does what its callbacks ask; the page (pages/downloads.slint)
// shows it in every theme. FinchGram changes nothing on a server unless the user allows it for
// that server (the ninth round): then it can delete, move, rename and upload there.

// Whether a server answers: asked when the page opens, and whenever the server is looked at. An
// SFTP server's key not trusted yet, or not the trusted one, is a state of its own (the eighth
// round): nothing goes to it until the user has checked the key.
export enum ServerStatus { unknown, checking, connected, password-rejected, not-reachable, key-unchecked, key-changed }

export struct ServerRow {
    name: string,
    host: string,           // "nas.home", out of the address
    protocol: string,       // what it speaks: "WebDAV" (the only one this version does)
    status: ServerStatus,
}

// Why a folder could not be read, a server not reached, or a file not fetched. key-unchecked: the
// SFTP server's key waits for the user's trust; key-changed: it is not the one trusted.
export enum Problem { none, password, forbidden, unreachable, http, unreadable, connection, disk, missing, key-changed, key-unchecked }

// What the middle column shows of the folder: a spinner, its entries (none for an empty folder),
// why it could not be read, or that the server's key waits to be checked (key-wait).
export enum FolderState { loading, listed, error, key-wait }

export struct FolderEntry {
    name: string,
    folder: bool,
    icon: string,           // "folder", "film-strip", "file-image", "file-pdf", "file-zip", "file-text" or "file"
    date: string,           // "Sep 30"; "" when the server did not say
    size: string,           // "4.4 GB"; "" for a folder
    selected: bool,
}

export enum TransferState { active, waiting, done, stopped }

export struct TransferRow {
    id: int,
    name: string,
    icon: string,           // as FolderEntry.icon; "folder" for a whole folder
    upload: bool,           // going up to the server (the ninth round), not coming down
    dest: string,           // an upload's folder on the server: its name, or the server's at the root
    state: TransferState,
    fraction: float,        // 0 … 1, how far it is
    done: string,           // "4.1 GB" so far
    total: string,          // "10.8 GB"
    speed: string,          // "24.3 MB/s" while active; "" until known
    seconds-left: int,      // while active; -1 until known
    minutes-left: int,      // the same, rounded up to minutes
    problem: Problem,       // why it stopped
    detail: string,         // the problem's detail: an HTTP code
    waiting: int,           // the HTTP status a busy server keeps answering (503 …) while active; 0 otherwise
}

// The form's "Test connection".
export enum TestState { none, testing, ok, failed }

// What is wrong with the form when Add, Save or Test connection is pressed: no name, a WebDAV
// address that is not one, no host for the others, a port that is not one.
export enum FormError { none, name, address, host, port }

// Whether a server said it allows changes (the ninth round): WebDAV's OPTIONS answer names the
// methods; FTP and SFTP say nothing, and a change is tried to find out.
export enum ChangesSaid { unknown, allowed, read-only }

// What is wrong with a new name, typed in place or for a new folder: taken here, or with a "/".
export enum RenameError { none, taken, slash }

// An item of the Delete and the Same-name dialogs: its name, its icon, a file's size, and for a
// folder what it holds (-1 while that is counted); the page words "Folder · 12 items inside",
// "Empty folder" and "Already there".
export struct DialogItem {
    name: string,
    icon: string,
    size: string,
    count: int,
}

// A folder of the Move dialog's list.
export struct MoveFolder {
    name: string,
    current: bool,          // the folder the items are in now
    forbidden: bool,        // one of the folders being moved, or under it: a folder cannot move into itself
}

export global Downloads {
    in-out property <[ServerRow]> servers;
    in-out property <int> current: -1;              // the server looked at; -1 for none
    in-out property <[string]> crumbs;              // the server's name, then the path's folders: "Home NAS /Movies/2026"
    in-out property <string> path-label;            // the same in one line, "Home NAS › Movies › 2026": the drop box
    in-out property <string> title;                 // the folder looked at: its name, or the server's at the root
    in-out property <FolderState> folder-state: FolderState.loading;
    in-out property <Problem> problem;              // when folder-state is error
    in-out property <string> problem-detail;        // the host, or an HTTP code
    in-out property <bool> key-wait-changed;        // when folder-state is key-wait: the key changed (else not trusted yet)
    in-out property <[FolderEntry]> entries;        // those the filter lets through, folders first
    in-out property <bool> has-entries;             // the folder is not empty (the filter may hide them all)
    in-out property <string> filter;
    in-out property <int> selected-count;
    in-out property <string> selected-size;         // "10.8 GB"
    in-out property <bool> can-open;                // one photo or video is chosen: it can be fetched and shown
    in-out property <bool> all-selected;            // every file shown is chosen
    in-out property <bool> some-selected;           // some of them are
    in-out property <[TransferRow]> queue;          // active, then waiting, stopped, done
    in-out property <int> active-count;
    in-out property <int> active-uploads;           // of them, going up: the head says "{d} down · {u} up"
    in-out property <int> done-count;               // finished: "Clear finished" shows while there are any
    in-out property <bool> queue-open: true;        // the user's choice (settings.toml); the column shows when the queue is not empty
    in-out property <string> folder-label;          // "~/Documents/FinchGram/webdav"
    in-out property <int> connections;              // per file (settings.toml)

    // Adding or editing a server: the form in the middle column.
    in-out property <bool> form-open;
    in-out property <bool> form-editing;            // Save and Remove instead of Add
    in-out property <string> form-name;
    in-out property <string> form-protocol: "webdav";    // "webdav", "ftp", "ftps", "sftp": the chip chosen
    in-out property <string> form-address;
    in-out property <string> form-port;             // as typed; "" for the protocol's default port
    in-out property <string> form-username;
    in-out property <string> form-password;
    in-out property <FormError> form-error;
    in-out property <TestState> test-state;
    in-out property <int> test-folders;             // what Test connection found at the root
    in-out property <int> test-files;
    in-out property <bool> test-ranges;             // the server does ranges: several connections per file
    in-out property <bool> test-probed;             // there was a file to ask that of
    in-out property <Problem> test-problem;
    in-out property <string> test-detail;
    in-out property <bool> form-allow-changes;      // the switch: delete, move, rename and upload on this server
    in-out property <bool> form-read-only;          // the server said it only allows reading (its row under the switch)
    in-out property <ChangesSaid> test-changes;     // what Test connection learnt about changes
    // An SFTP server's key, in the form: the one trusted, or that none is yet.
    in-out property <bool> form-key-known;
    in-out property <string> form-key-type;         // "ED25519"
    in-out property <string> form-key-fingerprint;  // "SHA256:…"
    in-out property <string> form-key-since;        // "Oct 3, 2026"; "" when the day is not known
    in-out property <bool> form-key-forgotten;      // Forget this key was pressed: the next connection asks again

    // The question about an SFTP server's key (the eighth round), over the page while it is open:
    // the key the server showed, and the one trusted before when it is another.
    in-out property <bool> key-ask-open;
    in-out property <bool> key-ask-changed;         // not the trusted key; else the server's first
    in-out property <string> key-ask-name;          // the server's name
    in-out property <string> key-ask-address;       // "host:port"
    in-out property <string> key-ask-type;          // "ED25519"
    in-out property <string> key-ask-fingerprint;   // "SHA256:…", the key shown now
    in-out property <string> key-ask-old-type;
    in-out property <string> key-ask-old-fingerprint;
    in-out property <string> key-ask-old-since;     // "Oct 3, 2026"; "" when the day is not known
    in-out property <string> key-copied;            // "new" or "old" for a moment after Copy; "" otherwise

    // Changes on the server (the ninth round), where the user allows them for this server.
    in-out property <bool> can-write;               // the server's switch is on and it is reached: the write items show
    in-out property <bool> server-read-only;        // and the server said it only reads: they are greyed, Upload too
    in-out property <string> renaming;              // the entry being renamed in place, by name; "" for none
    in-out property <string> rename-text;           // the new name as typed
    in-out property <int> rename-stem;              // bytes of the name before its extension: what is selected first
    in-out property <RenameError> rename-error;
    in-out property <bool> dropping;                // files dragged over the window: the drop box over the folder
    // A word at the foot of the page for a moment: what was just done.
    in-out property <string> toast;                 // "deleted", "moved", "nothing-moved", "read-only"; "" for none
    in-out property <string> toast-name;            // the one item's name
    in-out property <int> toast-count;
    in-out property <string> toast-dest;            // the folder moved to
    // A change the server did not make, under the folder's title until dismissed.
    in-out property <string> change-failed;         // "delete", "move", "rename", "mkdir"; "" for none
    in-out property <string> change-name;           // the item it was about
    in-out property <int> change-count;             // the items it was about, when several
    in-out property <bool> change-refused;          // the server said no (else it could not be reached, or the like)
    in-out property <Problem> change-problem;
    in-out property <string> change-detail;         // the refusal in the server's words: "403 Forbidden", "Permission denied"
    // The Delete dialog.
    in-out property <bool> delete-open;
    in-out property <[DialogItem]> delete-items;    // the first four
    in-out property <int> delete-count;
    in-out property <bool> delete-folders;          // a folder is among them: everything in it goes too
    // The Move dialog: the folder shown in it, with the way there, its folders, and the way out.
    in-out property <bool> move-open;
    in-out property <int> move-count;
    in-out property <string> move-name;             // the one item's name
    in-out property <[string]> move-crumbs;         // the server's name, then the folders down to the one shown
    in-out property <string> move-path-label;       // the same in one line: "Move to: Home NAS › Media"
    in-out property <[MoveFolder]> move-folders;
    in-out property <bool> move-loading;
    in-out property <Problem> move-problem;         // the folder could not be listed
    in-out property <string> move-problem-detail;
    in-out property <bool> move-here-allowed;       // the folder shown is not the one the items are in
    in-out property <bool> move-creating;           // New folder was pressed: its name is typed at the top of the list
    in-out property <string> move-new-name;
    in-out property <RenameError> move-new-error;
    // The Same-name dialog: items already at the destination, of a move or of an upload.
    in-out property <bool> conflict-open;
    in-out property <bool> conflict-upload;         // an upload; else a move
    in-out property <string> conflict-dest;         // the destination folder's name
    in-out property <[DialogItem]> conflict-items;  // the first four; the one item's name when there is one
    in-out property <int> conflict-count;
    in-out property <int> conflict-rest;            // the other items, which go as usual
    in-out property <bool> conflict-folders;        // a folder is among them: folders are not merged

    callback opened();                              // the page is shown
    callback select-server(int);
    callback add-server();                          // the form, empty
    callback edit-server(int);
    callback remove-server(int);
    callback copy-address(int);
    callback open-folder(string);                   // a folder of the listing, by name
    callback go-to(int);                            // a crumb: 0 is the server's root
    callback refresh();
    callback set-filter(string);
    callback toggle(string);                        // a file chosen, or not any more
    callback toggle-all();                          // every file shown, or none
    callback clear-selection();
    callback download-selected();
    callback open-selected();                       // the one photo or video chosen: fetched, then shown
    callback download-file(string);
    callback download-folder(string);               // with everything in it
    callback open-file(string);                     // fetched, then shown (a photo or video) or shown in the Finder
    callback copy-link(string);                     // the file's address
    callback cancel(int);                           // a transfer, by id
    callback retry(int);
    callback show-in-finder(int);
    callback remove-transfer(int);                  // from the list; done or stopped
    callback clear-finished();                      // every finished download off the list
    callback toggle-queue();
    callback change-folder();                       // where downloads go
    callback test-connection();
    callback submit-form();                         // Add, or Save
    callback cancel-form();
    callback remove-from-form();                    // editing: the server goes
    callback forget-key();                          // the form's Forget this key
    callback check-key();                           // the folder's Check key: the server is asked for its key again
    callback check-key-transfer(int);               // a download's Check key, by id
    callback trust-key();                           // the dialog: the key shown is the server's from now
    callback refuse-key();                          // the dialog: nothing is sent
    callback copy-fingerprint(string);              // the dialog: "new" or "old"
    // Changes on the server (the ninth round).
    callback upload();                              // the toolbar's Upload: the file chooser, into the folder looked at
    callback rename-entry(string);                  // the menu's Rename: the row becomes a field, rename-text its name
    callback commit-rename(bool);                   // ⏎, or (true) a click elsewhere, which lets a bad name go
    callback cancel-rename();                       // Esc
    callback delete-entry(string);                  // the menu's Delete…: the dialog, for the one entry
    callback delete-selected();                     // the menu's or the foot's Delete: the chosen files
    callback confirm-delete();                      // the dialog's Delete
    callback move-entry(string);                    // the menu's Move to…: the dialog
    callback move-selected();
    callback move-go-to(int);                       // a crumb of the dialog: 0 is the server's root
    callback move-open-folder(string);              // a folder of the dialog's list
    callback move-new-folder();                     // New folder: the name is typed into move-new-name
    callback commit-new-folder();                   // ⏎ in that field
    callback cancel-new-folder();                   // Esc in it
    callback move-here();
    callback resolve-conflict(string);              // the Same-name dialog: "replace", "skip" or "keep"
    callback close-dialog();                        // Cancel, or Esc, on the Delete, Move and Same-name dialogs
    callback dismiss-change-failed();
    callback show-upload(int);                      // a finished upload's Show: the folder it went to, the file chosen
}
