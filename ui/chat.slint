// Parts of the chat windows the three themes share.
import { Conversation, ChatKind, Media, Sticker } from "telegram.slint";
import { Fmt } from "format.slint";
import { Icon } from "widgets.slint";

// The open chat's messages, scrolled. New messages are followed while the view is at the end;
// messages loading above do not move what is being read (the distance from the end is kept); near
// the top it asks for older messages. With few messages they sit at the bottom, as in any chat.
export component ChatScroll inherits Flickable {
    in property <length> spacing;
    in property <length> margin-top;
    in property <length> margin-bottom;
    in property <length> margin-left;
    in property <length> margin-right;
    // How far the bottom of the view is above the end of the chat; 0 at the end.
    property <length> from-bottom: 0px;
    mouse-drag-pan-enabled: false;
    content-width: self.width;
    content-height: max(self.height, messages.preferred-height);

    function keep-place() {
        self.content-y = min(0px, max(self.height - self.content-height, self.from-bottom + self.height - self.content-height));
    }

    changed content-height => {
        self.keep-place();
    }
    changed height => {
        self.keep-place();
    }
    property <int> scroll-to-end: Conversation.scroll-to-end;
    changed scroll-to-end => {
        self.from-bottom = 0px;
        self.keep-place();
    }
    // Bring what lies from `top` to `bottom` in the chat into sight, a third down the view: a
    // message the media viewer located.
    public function reveal(top: length, bottom: length) {
        self.content-y = min(0px, max(self.height - self.content-height, -(top - max(0px, (self.height - (bottom - top)) / 3))));
        self.from-bottom = max(0px, self.content-height + self.content-y - self.height);
    }

    flicked => {
        self.from-bottom = max(0px, self.content-height + self.content-y - self.height);
        if self.content-y > -400px && Conversation.has-older && !Conversation.loading {
            Conversation.load-older();
        }
    }

    messages := VerticalLayout {
        width: root.width;
        alignment: end;
        spacing: root.spacing;
        padding-top: root.margin-top;
        padding-bottom: root.margin-bottom;
        padding-left: root.margin-left;
        padding-right: root.margin-right;
        @children
    }
}

// The icon for a kind of chat (Workbench's tree and tabs).
export global ChatIcons {
    public pure function kind(kind: ChatKind) -> string {
        if kind == ChatKind.group {
            return "users-three";
        }
        if kind == ChatKind.channel {
            return "megaphone";
        }
        if kind == ChatKind.saved {
            return "bookmark-simple";
        }
        if kind == ChatKind.bot {
            return "robot";
        }
        return "user";
    }
}

// Where a message is written: Enter sends it, Shift+Enter starts a new line; while an input method
// is still composing, Enter is the input method's. Grows with the text up to `tallest`.
export component MessageInput inherits Rectangle {
    in property <string> placeholder;
    in property <color> text-color;
    in property <color> placeholder-color;
    in property <color> selection-color;
    in property <string> font-family;
    in property <length> font-size: 14px;
    in property <float> line-height-factor: 1;
    in property <length> base-height: 40px;
    in property <length> tallest: 140px;
    in property <length> padding-x: 12px;
    in property <length> padding-y: 10px;
    in property <bool> enabled: true;
    in-out property <string> text <=> input.text;
    out property <bool> has-focus: input.has-focus;
    // The words to send; the box empties itself.
    callback send(string);
    height: clamp(input.preferred-height + 2 * padding-y, base-height, tallest);

    public function focus-text() {
        input.focus();
    }

    public function send-now() {
        if input.text != "" {
            root.send(input.text);
            input.text = "";
        }
    }

    Text {
        x: root.padding-x;
        y: root.padding-y;
        width: parent.width - 2 * root.padding-x;
        visible: input.text == "" && input.preedit-text == "";
        text: root.placeholder;
        color: root.placeholder-color;
        font-family: root.font-family;
        font-size: root.font-size;
        line-height-factor: root.line-height-factor;
        overflow: elide;
    }

    Flickable {
        x: root.padding-x;
        y: root.padding-y;
        width: parent.width - 2 * root.padding-x;
        height: parent.height - 2 * root.padding-y;
        mouse-drag-pan-enabled: false;
        content-height: max(self.height, input.preferred-height);
        // Follow the cursor to the end while typing past the box's height.
        content-y: min(0px, self.height - self.content-height);

        input := TextInput {
            width: parent.width;
            single-line: false;
            wrap: word-wrap;
            enabled: root.enabled;
            color: root.text-color;
            font-family: root.font-family;
            font-size: root.font-size;
            line-height-factor: root.line-height-factor;
            selection-background-color: root.selection-color;
            key-pressed(event) => {
                if event.text == Key.Return && !event.modifiers.shift && !event.modifiers.alt && self.preedit-text == "" {
                    root.send-now();
                    return accept;
                }
                return reject;
            }
        }
    }
}

// Content at most `cap` wide, at the start of a row that takes the whole width: a max-width on a
// message would otherwise narrow the chat and everything around it.
export component Capped {
    in property <length> cap: 560px;
    in property <length> spacing;
    height: content.preferred-height;

    content := VerticalLayout {
        x: 0;
        width: min(root.width, root.cap);
        spacing: root.spacing;
        @children
    }
}

// A message's photos and videos, from the design's media-viewer.js: one in its own shape, within
// width-limit × height-limit; several (an album) as square tiles, two across for two or four, else
// three. A video has a play button and its length. Each asks for its sharp picture once it is
// there (Conversation.load-picture); a click opens the media viewer. The themes set the shapes.
export component MediaTiles {
    in property <[Media]> media;
    in property <length> width-limit: 360px;
    in property <length> height-limit: 280px;
    in property <length> radius: 8px;
    in property <length> gap: 4px;
    in property <length> play-size: 48px;
    in property <length> play-icon-size: 22px;
    in property <length> inset: 8px;
    in property <length> badge-radius: 4px;
    in property <string> badge-font;
    in property <length> badge-font-size: 11px;
    in property <bool> duotone;
    callback open(string);                  // a tile's message

    property <int> count: media.length;
    property <int> columns: count == 2 || count == 4 ? 2 : 3;
    property <int> rows: Math.ceil(count / columns);
    property <length> cell: Math.floor((width-limit - gap * (columns - 1)) / 1px / columns) * 1px;
    // One: its own shape (unknown sizes count as 16:9 for a video, 4:3 for a photo).
    property <float> own-width: count == 1 && media[0].width > 0 ? media[0].width : count == 1 && media[0].video ? 16 : 4;
    property <float> own-height: count == 1 && media[0].height > 0 ? media[0].height : count == 1 && media[0].video ? 9 : 3;
    property <float> scale: min(width-limit / 1px / own-width, height-limit / 1px / own-height);
    width: count == 1 ? Math.round(own-width * scale) * 1px : cell * columns + gap * (columns - 1);
    height: count == 1 ? Math.round(own-height * scale) * 1px : cell * rows + gap * (rows - 1);

    for item[index] in root.media: Rectangle {
        x: root.count == 1 ? 0 : Math.mod(index, root.columns) * (root.cell + root.gap);
        y: root.count == 1 ? 0 : Math.floor(index / root.columns) * (root.cell + root.gap);
        width: root.count == 1 ? root.width : root.cell;
        height: root.count == 1 ? root.height : root.cell;
        border-radius: root.radius;
        clip: true;
        background: #80808033;
        init => {
            Conversation.load-picture(item.id);
        }

        Image {
            width: parent.width;
            height: parent.height;
            source: item.picture;
            image-fit: cover;
        }
        Rectangle {
            background: touch.has-hover ? #ffffff10 : transparent;
        }
        if item.video: Rectangle {
            width: root.play-size;
            height: root.play-size;
            border-radius: self.width / 2;
            background: #00000080;
            Icon {
                name: "play";
                size: root.play-icon-size;
                color: #ffffff;
                duotone: root.duotone;
            }
        }
        if item.video && item.duration > 0: Rectangle {
            x: root.inset;
            y: root.inset;
            width: length.preferred-width + 12px;
            height: length.preferred-height + 2px;
            border-radius: root.badge-radius;
            background: #00000080;
            length := Text {
                text: Fmt.duration(item.duration);
                color: #ffffff;
                font-family: root.badge-font;
                font-size: root.badge-font-size;
            }
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.open(item.id);
            }
        }
    }
}

// A sticker on its own, as stickers are cut out: no frame, no background. Its picture is asked for
// when it is shown.
export component StickerPicture {
    in property <string> message-id;
    in property <Sticker> sticker;
    in property <length> size: 160px;
    property <float> scale: min(root.size / 1px / max(1, root.sticker.width), root.size / 1px / max(1, root.sticker.height));
    width: Math.round(max(1, root.sticker.width) * root.scale) * 1px;
    height: Math.round(max(1, root.sticker.height) * root.scale) * 1px;
    init => {
        Conversation.load-picture(root.message-id);
    }

    Image {
        width: parent.width;
        height: parent.height;
        source: root.sticker.picture;
        image-fit: contain;
    }
}
