// Parts of the chat windows the three themes share.
import { AppState } from "state.slint";
import {
    Conversation, ChatKind, Media, Sticker, MessageRow, RowKind, Actions, MessageAction, ActionNotice, ComposeBar, ReplyQuote,
    DeleteChoice, Attachments, AttachKind, AttachProblem, AttachHint, FileCard, FileState, FileType, ChatConfirm } from "telegram.slint";
import { Fmt } from "format.slint";
import { Icon } from "widgets.slint";
import { Look } from "look.slint";

// The open chat's messages, scrolled. New messages are followed while the view is at the end;
// messages loading above do not move what is being read (the distance from the end is kept); near
// the top it asks for older messages, and back at the end it says so (Rust then shows the newest
// alone again: every row here is laid out and measured at each change). With few messages they sit
// at the bottom, as in any chat.
export component ChatScroll inherits Flickable {
    in property <length> spacing;
    in property <length> margin-top;
    in property <length> margin-bottom;
    in property <length> margin-left;
    in property <length> margin-right;
    // How far the bottom of the view is above the end of the chat; 0 at the end.
    property <length> from-bottom: 0px;
    mouse-drag-pan-enabled: false;
    content-width: self.width;
    content-height: max(self.height, messages.preferred-height);

    function keep-place() {
        self.content-y = min(0px, max(self.height - self.content-height, self.from-bottom + self.height - self.content-height));
    }

    changed from-bottom => {
        if self.from-bottom == 0px {
            Conversation.reached-end();
        }
    }

    changed content-height => {
        self.keep-place();
    }
    changed height => {
        self.keep-place();
    }
    property <int> scroll-to-end: Conversation.scroll-to-end;
    changed scroll-to-end => {
        self.from-bottom = 0px;
        self.keep-place();
    }
    // Bring what lies from `top` to `bottom` in the chat into sight, a third down the view: a
    // message the media viewer located.
    public function reveal(top: length, bottom: length) {
        self.content-y = min(0px, max(self.height - self.content-height, -(top - max(0px, (self.height - (bottom - top)) / 3))));
        self.from-bottom = max(0px, self.content-height + self.content-y - self.height);
    }

    flicked => {
        self.from-bottom = max(0px, self.content-height + self.content-y - self.height);
        if self.content-y > -400px && Conversation.has-older && !Conversation.loading {
            Conversation.load-older();
        }
    }

    messages := VerticalLayout {
        width: root.width;
        alignment: end;
        spacing: root.spacing;
        padding-top: root.margin-top;
        padding-bottom: root.margin-bottom;
        padding-left: root.margin-left;
        padding-right: root.margin-right;
        @children
    }
}

// The icon for a kind of chat (Workbench's tree and tabs).
export global ChatIcons {
    public pure function kind(kind: ChatKind) -> string {
        if kind == ChatKind.group {
            return "users-three";
        }
        if kind == ChatKind.channel {
            return "megaphone";
        }
        if kind == ChatKind.saved {
            return "bookmark-simple";
        }
        if kind == ChatKind.bot {
            return "robot";
        }
        return "user";
    }
}

// Where a message is written: Enter sends it, Shift+Enter starts a new line; while an input method
// is still composing, Enter is the input method's. Grows with the text up to `tallest`. Esc closes
// what is open over it (Actions.escape); ↑ in an empty box edits our last message. Each change the
// user makes is reported (`edited`): the chat sees that we are typing.
export component MessageInput inherits Rectangle {
    in property <string> placeholder;
    in property <color> text-color;
    in property <color> placeholder-color;
    // The selected words' colours. (On macOS Slint paints the text cursor in the selection's
    // background colour with the alpha taken out, so a theme's selection colour is its cursor's
    // too: a translucent accent, P.input-sel, gives a pale selection and a solid cursor.)
    in property <color> selection-color;
    in property <color> selection-text-color: text-color;
    in property <string> font-family;
    in property <length> font-size: 14px;
    in property <float> line-height-factor: 1;
    in property <length> base-height: 40px;
    in property <length> tallest: 140px;
    in property <length> padding-x: 12px;
    in property <length> padding-y: 10px;
    in property <bool> enabled: true;
    // Sending with nothing written: forwarding sends the messages alone.
    in property <bool> allow-empty;
    in-out property <string> text <=> input.text;
    out property <bool> has-focus: input.has-focus;
    // The words to send; the box empties itself.
    callback send(string);
    // The user changed the words (not Rust, not sending).
    callback edited(string);
    height: clamp(input.preferred-height + 2 * padding-y, base-height, tallest);

    public function focus-text() {
        input.focus();
    }

    public function send-now() {
        if input.text != "" || root.allow-empty {
            // Emptied first: sending may put words back (an edit gives back what was written
            // before it).
            let words = input.text;
            input.text = "";
            root.send(words);
        }
    }

    Text {
        x: root.padding-x;
        y: root.padding-y;
        width: parent.width - 2 * root.padding-x;
        visible: input.text == "" && input.preedit-text == "";
        text: root.placeholder;
        color: root.placeholder-color;
        font-family: root.font-family;
        font-size: root.font-size;
        line-height-factor: root.line-height-factor;
        overflow: elide;
    }

    Flickable {
        x: root.padding-x;
        y: root.padding-y;
        width: parent.width - 2 * root.padding-x;
        height: parent.height - 2 * root.padding-y;
        mouse-drag-pan-enabled: false;
        content-height: max(self.height, input.preferred-height);
        // Follow the cursor to the end while typing past the box's height.
        content-y: min(0px, self.height - self.content-height);

        input := TextInput {
            width: parent.width;
            single-line: false;
            wrap: word-wrap;
            enabled: root.enabled;
            color: root.text-color;
            font-family: root.font-family;
            font-size: root.font-size;
            line-height-factor: root.line-height-factor;
            selection-background-color: root.selection-color;
            selection-foreground-color: root.selection-text-color;
            text-cursor-width: Look.cursor-width;
            edited => {
                root.edited(self.text);
            }
            // Enter sends, and with Shift or Option makes a new line; without Send with Enter
            // (Settings → General), ⌘Enter sends and Enter makes a new line. (Slint reports ⌘ as
            // control on macOS.)
            key-pressed(event) => {
                if event.text == Key.Return && !event.modifiers.shift && !event.modifiers.alt && self.preedit-text == ""
                    && event.modifiers.control != AppState.send-with-enter
                {
                    root.send-now();
                    return accept;
                }
                if event.text == Key.Escape && self.preedit-text == "" && Actions.escape() {
                    return accept;
                }
                // ⌘V with a picture or files on the clipboard: they go to the chat, not into the words.
                if (event.text == "v" || event.text == "V") && event.modifiers.control && !event.modifiers.shift && Attachments.paste() {
                    return accept;
                }
                if event.text == Key.UpArrow && self.text == "" && self.preedit-text == "" && Actions.bar == ComposeBar.none {
                    Actions.edit-last();
                    return accept;
                }
                return reject;
            }
        }
    }
}

// Content at most `cap` wide, at the start of a row that takes the whole width: a max-width on a
// message would otherwise narrow the chat and everything around it.
export component Capped {
    in property <length> cap: 560px;
    in property <length> spacing;
    height: content.preferred-height;

    content := VerticalLayout {
        x: 0;
        width: min(root.width, root.cap);
        spacing: root.spacing;
        @children
    }
}

// How far a file has got, as an arc around a circle (the design's progress ring): `progress` of
// it, 0 … 1, in `color` over a `track`.
export component ProgressRing inherits Rectangle {
    in property <float> progress;
    in property <length> size: 40px;
    in property <length> thickness: 3px;
    in property <color> ring-color;
    in property <color> track;
    width: size;
    height: size;
    border-radius: size / 2;
    border-width: thickness;
    border-color: track;

    property <float> angle: clamp(root.progress, 0, 0.9999) * 360;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: root.ring-color;
        stroke-width: root.thickness;
        fill: transparent;
        MoveTo { x: 50; y: 50 - 50 + root.thickness / root.size * 50; }
        ArcTo {
            x: 50 + (50 - root.thickness / root.size * 50) * sin(root.angle * 1deg);
            y: 50 - (50 - root.thickness / root.size * 50) * cos(root.angle * 1deg);
            radius-x: 50 - root.thickness / root.size * 50;
            radius-y: 50 - root.thickness / root.size * 50;
            sweep: true;
            large-arc: root.angle > 180;
        }
    }
}

// What the attachments pages say (the design's sixth round, its copy list).
// A chat's menu in the lists (chats.rs): Telegram's own actions on a chat, and the questions asked
// before those that cannot be undone.
export global ChatMenuWords {
    public pure function block(kind: ChatKind, blocked: bool) -> string {
        if kind == ChatKind.bot { return blocked ? @tr("Unblock bot") : @tr("Block bot"); }
        return blocked ? @tr("Unblock user") : @tr("Block user");
    }
    public pure function report() -> string { return @tr("Report"); }
    public pure function leave(kind: ChatKind) -> string { return kind == ChatKind.channel ? @tr("Leave channel") : @tr("Leave group"); }
    public pure function delete() -> string { return @tr("Delete chat"); }
    public pure function title(what: ChatConfirm, kind: ChatKind, name: string) -> string {
        if what == ChatConfirm.block { return @tr("Block {0}?", name); }
        if what == ChatConfirm.leave { return kind == ChatKind.channel ? @tr("Leave the channel {0}?", name) : @tr("Leave the group {0}?", name); }
        return @tr("Delete the chat with {0}?", name);
    }
    public pure function lead(what: ChatConfirm, kind: ChatKind) -> string {
        if what == ChatConfirm.block { return @tr("They will not be able to send you messages. You can unblock them from this menu."); }
        if what == ChatConfirm.leave { return kind == ChatKind.channel ? @tr("You will stop getting its posts.") : @tr("You will stop getting its messages."); }
        return @tr("The chat and its messages go from your list.");
    }
    public pure function revoke(name: string) -> string { return @tr("Also delete for {0}", name); }
    public pure function action(what: ChatConfirm) -> string {
        if what == ChatConfirm.block { return @tr("Block"); }
        if what == ChatConfirm.leave { return @tr("Leave"); }
        return @tr("Delete");
    }
}

export global AttachWords {
    public pure function attach() -> string { return @tr("Attach"); }
    public pure function photo-or-video() -> string { return @tr("Photo or Video"); }
    public pure function file() -> string { return @tr("File"); }
    public pure function poll() -> string { return @tr("Poll"); }
    public pure function not-available() -> string { return @tr("Not available yet"); }
    public pure function not-allowed() -> string { return @tr("Not allowed in this group"); }
    public pure function cant-send() -> string { return @tr("You can't send messages in this group"); }
    public pure function screenshot() -> string { return @tr("Screenshot"); }
    public pure function screenshot-off() -> string { return @tr("Not allowed in this group"); }
    // The card shown when the system has not let FinchGram see the screen.
    public pure function permission-title() -> string { return @tr("Screen Recording is off for FinchGram"); }
    public pure function permission-lead() -> string { return @tr("Screenshots need Screen Recording in System Settings → Privacy & Security. If FinchGram is already in the list, turn it off and on again."); }
    public pure function open-system-settings() -> string { return @tr("Open System Settings"); }
    public pure function not-now() -> string { return @tr("Not now"); }
    public pure function menu-keys() -> string { return @tr("↑↓ Choose · Return Open · Esc Close"); }

    // The card's title: "Send Photo", "Send 3 Photos", "Send 2 Files", …; "Send Screenshot" for one
    // just taken.
    public pure function title(count: int, videos: int, as-files: bool) -> string {
        if Attachments.screenshot && count == 1 && !as-files {
            return @tr("Send Screenshot");
        }
        if as-files {
            return count == 1 ? @tr("Send File") : @tr("Send {n} Files" | "Send {n} Files" % count);
        }
        if videos == count {
            return count == 1 ? @tr("Send Video") : @tr("Send {n} Videos" | "Send {n} Videos" % count);
        }
        return count == 1 ? @tr("Send Photo") : @tr("Send {n} Photos" | "Send {n} Photos" % count);
    }
    public pure function albums(n: int) -> string { return @tr("Will be sent as {n} albums" | "Will be sent as {n} albums" % n); }
    public pure function album(i: int, n: int) -> string { return @tr("Album {0} · {1}", i, n); }
    public pure function add-more() -> string { return @tr("Add more"); }
    public pure function remove() -> string { return @tr("Remove"); }
    public pure function caption-placeholder() -> string { return @tr("Add a caption…"); }
    public pure function as-photo() -> string { return @tr("Send as photo"); }
    public pure function as-video() -> string { return @tr("Send as video"); }
    public pure function as-file() -> string { return @tr("Send as file"); }
    public pure function group-items() -> string { return @tr("Group items"); }
    public pure function timer() -> string { return @tr("Self-destruct timer"); }
    public pure function timer-sub() -> string { return @tr("Disappears after it's opened."); }
    public pure function timer-label(seconds: int) -> string {
        if seconds == 0 { return @tr("Off"); }
        if seconds < 0 { return @tr("View once"); }
        return @tr("{0} s", seconds);
    }
    public pure function spoiler() -> string { return @tr("Hide with spoiler"); }
    public pure function cancel() -> string { return @tr("Cancel"); }
    public pure function send() -> string { return @tr("Send"); }
    public pure function more-send() -> string { return @tr("More send options"); }
    public pure function silent() -> string { return @tr("Send without sound"); }
    public pure function schedule() -> string { return @tr("Schedule message"); }
    public pure function hint(hint: AttachHint) -> string {
        if hint == AttachHint.keys {
            return AppState.send-with-enter ? @tr("Return to send · Esc to cancel") : @tr("⌘Return to send · Return for a new line · Esc to cancel");
        }
        if hint == AttachHint.remove-marked { return @tr("Remove the marked items to send"); }
        if hint == AttachHint.caption-long { return @tr("Caption is too long"); }
        return "";
    }
    public pure function problem(problem: AttachProblem) -> string {
        if problem == AttachProblem.too-big { return @tr("Files over {0} GB can't be sent", 2); }
        if problem == AttachProblem.too-big-premium { return @tr("Files over {0} GB can't be sent", 4); }
        if problem == AttachProblem.unreadable { return @tr("Can't read this file"); }
        if problem == AttachProblem.not-allowed { return not-allowed(); }
        return "";
    }
    public pure function drop-photos() -> string { return @tr("Drop to send as photos"); }
    public pure function drop-files() -> string { return @tr("Drop to send as files"); }
    public pure function compressed() -> string { return @tr("Compressed"); }
    public pure function original() -> string { return @tr("Original quality"); }
    public pure function cancel-upload() -> string { return @tr("Cancel upload"); }
    public pure function not-sent() -> string { return @tr("Not sent"); }
    public pure function retry() -> string { return @tr("Retry"); }
    public pure function delete() -> string { return @tr("Delete"); }
    public pure function download() -> string { return @tr("Download"); }
    public pure function cancel-download() -> string { return @tr("Cancel download"); }
    public pure function show-in-finder() -> string { return @tr("Show in Finder"); }
    // "0.4 MB of 1.2 MB"
    public pure function progress(moved: string, size: string) -> string { return @tr("{0} of {1}", moved, size); }
    // Terminal's progress bar: "[▓▓▓░░░░░]" at 42 %.
    public pure function bar(progress: float) -> string {
        return ["[░░░░░░░░]", "[▓░░░░░░░]", "[▓▓░░░░░░]", "[▓▓▓░░░░░]", "[▓▓▓▓░░░░]", "[▓▓▓▓▓░░░]", "[▓▓▓▓▓▓░░]", "[▓▓▓▓▓▓▓░]", "[▓▓▓▓▓▓▓▓]"][clamp(Math.round(progress * 8), 0, 8)];
    }
    // Terminal's sign for a file's kind: "[pdf]".
    public pure function file-sign(kind: FileType) -> string {
        if kind == FileType.image { return "img"; }
        if kind == FileType.archive { return "zip"; }
        if kind == FileType.pdf { return "pdf"; }
        return "doc";
    }
    public pure function file-icon(kind: FileType) -> string {
        if kind == FileType.image { return "file-image"; }
        if kind == FileType.archive { return "file-zip"; }
        if kind == FileType.pdf { return "file-pdf"; }
        return "file-text";
    }
    // What a click on a file card does, for its tooltip.
    public pure function file-tip(state: FileState) -> string {
        if state == FileState.remote { return download(); }
        if state == FileState.downloading { return cancel-download(); }
        if state == FileState.uploading { return cancel-upload(); }
        return show-in-finder();
    }
}

// A file in a message, as the design's card: its kind's icon (a ring while it moves, an arrow
// while it is on Telegram's servers only), its name and size; a click does what the file's state
// allows (Conversation.file-action). The themes set the colours and shapes.
export component FileCardView inherits Rectangle {
    in property <FileCard> file;
    in property <length> radius: 8px;
    in property <length> inner-radius: 6px;
    in property <length> padding-x: 12px;
    in property <length> padding-y: 10px;
    in property <length> name-size: 14px;
    in property <string> font-family;
    in property <color> text;
    in property <color> muted;
    in property <color> line;
    in property <color> hover;
    in property <color> accent;
    in property <color> accent-ink;
    in property <color> on-accent;
    in property <color> soft;
    in property <color> track;
    in property <color> pdf;
    in property <color> zip;
    in property <color> picture;
    in property <bool> duotone;
    property <bool> moving: file.state == FileState.uploading || file.state == FileState.downloading;
    width: 300px;
    height: row.preferred-height;
    border-radius: radius;
    border-width: 1px;
    border-color: line;
    background: touch.has-hover ? hover : transparent;

    row := HorizontalLayout {
        padding-left: root.padding-x;
        padding-right: root.padding-x;
        padding-top: root.padding-y;
        padding-bottom: root.padding-y;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: root.moving || root.file.state == FileState.remote ? 20px : root.inner-radius;
                background: root.moving ? root.soft
                    : root.file.state == FileState.remote ? root.accent
                    : root.file.file-type == FileType.pdf ? root.pdf
                    : root.file.file-type == FileType.archive ? root.zip
                    : root.file.file-type == FileType.image ? root.picture : root.accent;
                if root.moving: ProgressRing {
                    progress: root.file.progress;
                    size: 40px;
                    thickness: 3px;
                    ring-color: root.accent;
                    track: root.track;
                }
                Icon {
                    name: root.moving ? "x" : root.file.state == FileState.remote ? "arrow-down" : AttachWords.file-icon(root.file.file-type);
                    size: root.moving ? 16px : root.file.state == FileState.remote ? 18px : 22px;
                    color: root.moving ? root.accent-ink : root.on-accent;
                    duotone: root.duotone && !root.moving && root.file.state != FileState.remote;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: root.file.name;
                color: root.text;
                font-family: root.font-family;
                font-size: root.name-size;
                font-weight: 500;
                overflow: elide;
            }
            Text {
                text: root.moving ? AttachWords.progress(root.file.moved, root.file.size) : root.file.size;
                color: root.muted;
                font-family: root.font-family;
                font-size: 12px;
                overflow: elide;
            }
        }
        if touch.has-hover && root.file.state == FileState.done: VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 4px;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        name: "folder-open";
                        size: 14px;
                        color: root.accent-ink;
                        duotone: root.duotone;
                    }
                }
                Text {
                    text: AttachWords.show-in-finder();
                    color: root.accent-ink;
                    font-family: root.font-family;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Conversation.file-action(root.file.id);
        }
    }
}

// A message's photos and videos, from the design's media-viewer.js: one in its own shape, within
// width-limit × height-limit; several (an album) as square tiles, two across for two or four, else
// three. A video has a play button and its length. Each asks for its sharp picture once it is
// there (Conversation.load-picture); a click opens the media viewer. One sent to self-destruct
// (Media.secret) keeps its blurred preview and says to tap: the viewer opens it once. The themes
// set the shapes.
export component MediaTiles {
    in property <[Media]> media;
    in property <bool> failed;              // the message was not sent: its tiles are dimmed
    in property <string> mono-font;         // the sizes while a tile goes up
    callback cancel(string);                // × on a tile's ring: its message is dropped
    in property <length> width-limit: 360px;
    in property <length> height-limit: 280px;
    in property <length> radius: 8px;
    in property <length> gap: 4px;
    in property <length> play-size: 48px;
    in property <length> play-icon-size: 22px;
    in property <length> inset: 8px;
    in property <length> badge-radius: 4px;
    in property <string> badge-font;
    in property <length> badge-font-size: 11px;
    in property <bool> duotone;
    callback open(string);                  // a tile's message

    property <int> count: media.length;
    property <int> columns: count == 2 || count == 4 ? 2 : 3;
    property <int> rows: Math.ceil(count / columns);
    property <length> cell: Math.floor((width-limit - gap * (columns - 1)) / 1px / columns) * 1px;
    // One: its own shape (unknown sizes count as 16:9 for a video, 4:3 for a photo).
    property <float> own-width: count == 1 && media[0].width > 0 ? media[0].width : count == 1 && media[0].video ? 16 : 4;
    property <float> own-height: count == 1 && media[0].height > 0 ? media[0].height : count == 1 && media[0].video ? 9 : 3;
    property <float> scale: min(width-limit / 1px / own-width, height-limit / 1px / own-height);
    width: count == 1 ? Math.round(own-width * scale) * 1px : cell * columns + gap * (columns - 1);
    height: count == 1 ? Math.round(own-height * scale) * 1px : cell * rows + gap * (rows - 1);

    for item[index] in root.media: Rectangle {
        x: root.count == 1 ? 0 : Math.mod(index, root.columns) * (root.cell + root.gap);
        y: root.count == 1 ? 0 : Math.floor(index / root.columns) * (root.cell + root.gap);
        width: root.count == 1 ? root.width : root.cell;
        height: root.count == 1 ? root.height : root.cell;
        border-radius: root.radius;
        clip: true;
        background: #80808033;
        init => {
            if !item.secret {
                Conversation.load-picture(item.id);
            }
        }

        Image {
            width: parent.width;
            height: parent.height;
            source: item.picture;
            image-fit: cover;
        }
        Rectangle {
            background: touch.has-hover ? #ffffff10 : transparent;
        }
        if item.video && !item.secret && !item.uploading && !root.failed: Rectangle {
            width: root.play-size;
            height: root.play-size;
            border-radius: self.width / 2;
            background: #00000080;
            Icon {
                name: "play";
                size: root.play-icon-size;
                color: #ffffff;
                duotone: root.duotone;
            }
        }
        // Not sent: dimmed, with a warning in the middle.
        if root.failed: Rectangle {
            background: #00000066;
            Icon {
                name: "warning-circle";
                size: 30px;
                color: #ffffff;
                duotone: root.duotone;
            }
        }
        // On its way up: how far, and × to stop it.
        if item.uploading && !root.failed: Rectangle {
            width: 44px;
            height: 44px;
            border-radius: 22px;
            background: #00000080;
            ProgressRing {
                progress: item.progress;
                size: 38px;
                thickness: 3px;
                ring-color: #ffffff;
                track: #ffffff40;
            }
            Icon {
                name: "x";
                size: 18px;
                color: #ffffff;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.cancel(item.id);
                }
            }
        }
        if item.uploading && !root.failed && root.count == 1 && item.size != "": Rectangle {
            x: root.inset;
            y: parent.height - self.height - root.inset;
            width: sent.preferred-width + 12px;
            height: sent.preferred-height + 2px;
            border-radius: root.badge-radius;
            background: #00000080;
            sent := Text {
                text: AttachWords.progress(item.moved, item.size);
                color: #ffffff;
                font-family: root.mono-font;
                font-size: root.badge-font-size;
            }
        }
        if item.video && item.duration > 0: Rectangle {
            x: root.inset;
            y: root.inset;
            width: length.preferred-width + 12px;
            height: length.preferred-height + 2px;
            border-radius: root.badge-radius;
            background: #00000080;
            length := Text {
                text: Fmt.duration(item.duration);
                color: #ffffff;
                font-family: root.badge-font;
                font-size: root.badge-font-size;
            }
        }
        if item.secret: Rectangle {
            background: #00000066;
            Rectangle {
                width: tap.preferred-width;
                height: tap.preferred-height;
                border-radius: self.height / 2;
                background: #000000a0;
                tap := HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: "timer";
                            size: 14px;
                            color: #ffffff;
                            duotone: root.duotone;
                        }
                    }
                    Text {
                        text: @tr("Tap to view");
                        color: #ffffff;
                        font-family: root.badge-font;
                        font-size: root.badge-font-size + 1px;
                        vertical-alignment: center;
                    }
                }
            }
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.open(item.id);
            }
            // A right click on it is for this photo or video (Actions.hovered-media).
            changed has-hover => {
                if self.has-hover {
                    Actions.hovered-media = item.id;
                } else if Actions.hovered-media == item.id {
                    Actions.hovered-media = "";
                }
            }
        }
    }
}

// A sticker on its own, as stickers are cut out: no frame, no background. Its picture is asked for
// when it is shown.
export component StickerPicture {
    in property <string> message-id;
    in property <Sticker> sticker;
    in property <length> size: 160px;
    property <float> scale: min(root.size / 1px / max(1, root.sticker.width), root.size / 1px / max(1, root.sticker.height));
    width: Math.round(max(1, root.sticker.width) * root.scale) * 1px;
    height: Math.round(max(1, root.sticker.height) * root.scale) * 1px;
    init => {
        Conversation.load-picture(root.message-id);
    }

    Image {
        width: parent.width;
        height: parent.height;
        source: root.sticker.picture;
        image-fit: contain;
    }
}

// A message's words with their formatting and links (MessageRow.rich-text); a link opens as
// Conversation.open-link says. Slint's StyledText has no line spacing of its own yet, so messages
// without formatting stay plain text in the design's spacing.
export component RichText inherits StyledText {
    link-clicked(url) => {
        Conversation.open-link(url);
    }
}

// A message row's own area, around everything the row shows. When a right click comes
// (Actions.right-clicks, counted by Rust from the window's own events, since formatted words keep
// clicks to themselves), the row under the pointer asks for its menu there, with the photo or video
// under it. While messages are being chosen, a click on the row chooses it (with shift, every row
// from the one clicked last), whatever is under the pointer.
export component MessageArea inherits TouchArea {
    in property <MessageRow> message;
    property <bool> choosable: message.kind == RowKind.message;
    property <int> right-clicks: Actions.right-clicks;
    changed right-clicks => {
        if self.has-hover && root.choosable && !Actions.selecting && !Actions.menu-open {
            Actions.menu-x = self.absolute-position.x + self.mouse-x;
            Actions.menu-y = self.absolute-position.y + self.mouse-y;
            Actions.ask-menu(root.message.id, Actions.hovered-media);
        }
    }

    @children

    if Actions.selecting && root.choosable: TouchArea {
        property <bool> shift;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                self.shift = event.modifiers.shift;
            }
        }
        clicked => {
            Actions.toggle(root.message.id, self.shift);
        }
    }
}

// The keyboard for a menu or a dialog while it is open: Esc closes it, ⏎ does its main thing.
export component KeyScope inherits FocusScope {
    callback enter();
    callback escape();
    init => {
        self.focus();
    }
    key-pressed(event) => {
        if event.text == Key.Escape {
            root.escape();
            return accept;
        }
        if event.text == Key.Return {
            root.enter();
            return accept;
        }
        return reject;
    }
}

// What the message actions are called, their icons and Terminal's commands; what a notice says
// (the design's message-actions.js).
export global ActionWords {
    public pure function label(action: MessageAction) -> string {
        if action == MessageAction.reply { return @tr("Reply"); }
        if action == MessageAction.edit { return @tr("Edit"); }
        if action == MessageAction.copy-image { return @tr("Copy Image"); }
        if action == MessageAction.save-image { return @tr("Save Image"); }
        if action == MessageAction.save-video { return @tr("Save Video"); }
        if action == MessageAction.copy { return copy(); }
        if action == MessageAction.copy-text { return @tr("words of a photo or video" => "Copy Text"); }
        if action == MessageAction.copy-link { return @tr("Copy Message Link"); }
        if action == MessageAction.forward { return @tr("Forward"); }
        if action == MessageAction.report { return @tr("Report"); }
        if action == MessageAction.delete { return @tr("Delete"); }
        return @tr("Select");
    }

    // Copying a message's words.
    public pure function copy() -> string {
        return @tr("words of a message" => "Copy Text");
    }

    public pure function icon(action: MessageAction) -> string {
        if action == MessageAction.reply { return "arrow-bend-up-left"; }
        if action == MessageAction.edit { return "pencil-simple"; }
        if action == MessageAction.copy-image { return "image"; }
        if action == MessageAction.save-image || action == MessageAction.save-video { return "download-simple"; }
        if action == MessageAction.copy || action == MessageAction.copy-text { return "copy"; }
        if action == MessageAction.copy-link { return "link"; }
        if action == MessageAction.forward { return "arrow-bend-up-right"; }
        if action == MessageAction.report { return "flag"; }
        if action == MessageAction.delete { return "trash"; }
        return "check-circle";
    }

    public pure function command(action: MessageAction) -> string {
        if action == MessageAction.reply { return "/reply"; }
        if action == MessageAction.edit { return "/edit"; }
        if action == MessageAction.copy-image { return "/copyimg"; }
        if action == MessageAction.save-image || action == MessageAction.save-video { return "/save"; }
        if action == MessageAction.copy || action == MessageAction.copy-text { return "/copy"; }
        if action == MessageAction.copy-link { return "/link"; }
        if action == MessageAction.forward { return "/fwd"; }
        if action == MessageAction.report { return "/report"; }
        if action == MessageAction.delete { return "/del"; }
        return "/select";
    }

    public pure function notice(notice: ActionNotice) -> string {
        if notice == ActionNotice.copied { return @tr("Text copied to clipboard."); }
        if notice == ActionNotice.link-copied { return @tr("Link copied to clipboard."); }
        if notice == ActionNotice.image-copied { return @tr("Image copied to clipboard."); }
        if notice == ActionNotice.saved { return Actions.saved-name == "" ? @tr("Saved to Downloads") : @tr("Saved to Downloads · {0}", Actions.saved-name); }
        if notice == ActionNotice.reported { return @tr("Reported"); }
        if notice == ActionNotice.folder-empty { return @tr("A folder must keep at least one chat."); }
        if notice == ActionNotice.failed { return Actions.failure; }
        return "";
    }

    // The strip above the composer: what it does, and to what.
    public pure function bar-title() -> string {
        if Actions.bar == ComposeBar.reply { return @tr("Reply to {0}", Actions.bar-name); }
        if Actions.bar == ComposeBar.edit { return @tr("Edit message"); }
        return @tr("Forward {n} message" | "Forward {n} messages" % Actions.bar-count);
    }

    public pure function bar-line() -> string {
        if Actions.bar == ComposeBar.forward { return @tr("From: {0}", Actions.bar-name); }
        return Fmt.body(Actions.bar-content, Actions.bar-text, Actions.bar-detail);
    }

    // A reply's quote: the first line of the message it answers.
    public pure function quote-line(quote: ReplyQuote) -> string {
        if quote.gone { return @tr("Deleted message"); }
        return Fmt.body(quote.content, quote.text, quote.detail);
    }

    public pure function selected() -> string {
        return @tr("{0} selected", Actions.selected-count);
    }

    public pure function delete-title() -> string {
        if Actions.delete-count == 1 { return @tr("Delete this message?"); }
        return @tr("Delete {0} messages?", Actions.delete-count);
    }

    public pure function delete-choice() -> string {
        if Actions.delete-choice == DeleteChoice.for-them { return @tr("Also delete for {0}", Actions.delete-name); }
        return @tr("Also delete for everyone");
    }

    public pure function report-title() -> string {
        return Actions.report-title == "" ? @tr("Report") : Actions.report-title;
    }
}

// Where a menu w × h opens for a click at x, y in a window of width × height: right of and below the
// click, else to its left and above it (the design's openMenu).
export global MenuPlace {
    public pure function x(click: length, w: length, width: length) -> length {
        return max(8px, min(click + w > width - 8px ? click - w : click, width - w - 8px));
    }

    public pure function y(click: length, h: length, height: length) -> length {
        return click + h > height - 8px ? max(8px, click - h) : click;
    }
}

// A one-line box for searching in a dialog: it takes the keyboard when shown; ⏎ picks the first
// result, Esc closes the dialog.
export component SearchInput inherits Rectangle {
    in property <string> placeholder;
    in property <color> text-color;
    in property <color> placeholder-color;
    in property <color> selection-color;
    in property <color> selection-text-color: text-color;
    in property <string> font-family;
    in property <length> font-size: 14px;
    callback edited(string);
    callback accepted();
    callback escape();

    Text {
        width: parent.width;
        height: parent.height;
        visible: input.text == "" && input.preedit-text == "";
        text: root.placeholder;
        color: root.placeholder-color;
        font-family: root.font-family;
        font-size: root.font-size;
        vertical-alignment: center;
        overflow: elide;
    }

    input := TextInput {
        width: parent.width;
        height: parent.height;
        single-line: true;
        color: root.text-color;
        font-family: root.font-family;
        font-size: root.font-size;
        vertical-alignment: center;
        selection-background-color: root.selection-color;
        selection-foreground-color: root.selection-text-color;
        text-cursor-width: Look.cursor-width;
        init => {
            self.focus();
        }
        edited => {
            root.edited(self.text);
        }
        accepted => {
            root.accepted();
        }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.escape();
                return accept;
            }
            return reject;
        }
    }
}

// Words to add to a report: several lines, at most 1024 characters. ⏎ sends them (⇧⏎ starts a new
// line), Esc closes the dialog.
export component CommentInput inherits Rectangle {
    in property <string> placeholder;
    in property <color> text-color;
    in property <color> placeholder-color;
    in property <color> selection-color;
    in property <color> selection-text-color: text-color;
    in property <string> font-family;
    in property <length> font-size: 14px;
    in property <float> line-height-factor: 1;
    in property <length> padding-x: 12px;
    in property <length> padding-y: 10px;
    out property <string> text: input.text;
    callback submit();
    callback escape();

    Text {
        x: root.padding-x;
        y: root.padding-y;
        width: parent.width - 2 * root.padding-x;
        visible: input.text == "" && input.preedit-text == "";
        text: root.placeholder;
        color: root.placeholder-color;
        font-family: root.font-family;
        font-size: root.font-size;
        line-height-factor: root.line-height-factor;
        wrap: word-wrap;
    }

    Flickable {
        x: root.padding-x;
        y: root.padding-y;
        width: parent.width - 2 * root.padding-x;
        height: parent.height - 2 * root.padding-y;
        mouse-drag-pan-enabled: false;
        content-height: max(self.height, input.preferred-height);
        content-y: min(0px, self.height - self.content-height);

        input := TextInput {
            width: parent.width;
            single-line: false;
            wrap: word-wrap;
            color: root.text-color;
            font-family: root.font-family;
            font-size: root.font-size;
            line-height-factor: root.line-height-factor;
            selection-background-color: root.selection-color;
            selection-foreground-color: root.selection-text-color;
            text-cursor-width: Look.cursor-width;
            init => {
                self.focus();
            }
            edited => {
                if self.text.character-count > 1024 {
                    self.text = root.text-before;
                }
                root.text-before = self.text;
            }
            key-pressed(event) => {
                if event.text == Key.Return && !event.modifiers.shift && self.preedit-text == "" {
                    root.submit();
                    return accept;
                }
                if event.text == Key.Escape {
                    root.escape();
                    return accept;
                }
                return reject;
            }
        }
    }

    property <string> text-before;
}
