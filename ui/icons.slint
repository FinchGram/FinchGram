        if name == "users-three" { return @image-url("icons/duotone/users-three.svg"); }
        if name == "video" { return @image-url("icons/duotone/video.svg"); }
        if name == "warning-circle" { return @image-url("icons/duotone/warning-circle.svg"); }
        if name == "wifi-slash" { return @image-url("icons/duotone/wifi-slash.svg"); }
        if name == "wrench" { return @image-url("icons/duotone/wrench.svg"); }
        if name == "x" { return @image-url("icons/duotone/x.svg"); }
        if name == "x-circle" { return @image-url("icons/duotone/x-circle.svg"); }
        if name == "x-square" { return @image-url("icons/duotone/x-square.svg"); }
        return @image-url("icons/duotone/question.svg");
    }
}
