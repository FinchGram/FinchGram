// The two-step verification password's forms, from the design's auth-2fa.js. Logging in uses them
// for a forgotten password, Settings → Privacy & security → Two-step verification for changing it:
// a heading, the fields, what went wrong, the main button, and quieter links under it.
import { Look } from "../look.slint";
import { Icon, Field, PrimaryButton, Heading, Paragraph } from "../widgets.slint";

export global PasswordText {
    // TDLib's answer, or one of the checks src/telegram/password.rs makes first, in words.
    public pure function error(message: string) -> string {
        if message == "PASSWORD_HASH_INVALID" {
            return @tr("Incorrect password");
        }
        if message == "CODE_INVALID" || message == "CODE_EMPTY" || message == "EMAIL_CODE_INVALID"
            || message == "Invalid recovery code" {
            return @tr("Incorrect code");
        }
        if message == "PASSWORD_RECOVERY_EXPIRED" || message == "CODE_EXPIRED" {
            return @tr("This code has expired. Go back and ask for a new one.");
        }
        if message == "EMAIL_INVALID" {
            return @tr("Invalid email address");
        }
        if message == "NEW_PASSWORD_EMPTY" {
            return @tr("Enter a new password");
        }
        if message == "NEW_PASSWORD_MISMATCH" {
            return @tr("Passwords don't match");
        }
        if message == "NEW_PASSWORD_HINT_SAME" {
            return @tr("The hint can't be the same as the password");
        }
        if message.starts-with("Too Many Requests") || message.starts-with("FLOOD_WAIT") {
            return @tr("Too many tries. Wait a while, then try again.");
        }
        return message;
    }
}

// A step's title and what to do: the page's heading when logging in, a smaller one in Settings.
export component FormHeading {
    in property <string> title;
    in property <string> description;
    in property <length> size: Look.heading-size;

    VerticalLayout {
        spacing: 6px;
        // A long title wraps: its height is that of all its lines.
        Heading {
            label: root.title;
            size: root.size;
            height: self.preferred-height;
        }
        Paragraph {
            visible: root.description != "";
            height: root.description == "" ? 0px : self.preferred-height;
            text: root.description;
            color: Look.muted;
            font-size: 15px;
            line-height-factor: Look.leading(1.55);
        }
    }
}

// What went wrong, in red after a warning sign.
export component FormError {
    in property <string> message;       // TDLib's, or one of our checks

    HorizontalLayout {
        spacing: 6px;
        VerticalLayout {
            alignment: start;
            padding-top: 2px;
            Icon {
                name: "warning-circle";
                size: 15px;
                color: Look.danger;
                duotone: false;
            }
        }
        Paragraph {
            horizontal-stretch: 1;
            text: PasswordText.error(root.message);
            color: Look.danger;
            font-size: 14px;
        }
    }
}

// The small print under the fields.
export component FormNote inherits Paragraph {
    color: Look.faint;
    font-size: 13px;
    line-height-factor: Look.leading(1.5);
}

// The password's hint, under the field that asks for the password.
export component HintLine {
    in property <string> hint;

    HorizontalLayout {
        spacing: 6px;
        VerticalLayout {
            alignment: start;
            padding-top: 1px;
            Icon {
                name: "lightbulb";
                size: 14px;
                color: Look.faint;
                duotone: false;
            }
        }
        Paragraph {
            horizontal-stretch: 1;
            text: @tr("Hint: {0}", root.hint);
            color: Look.faint;
            font-size: 13px;
        }
    }
}

// A code from an email, spaced out. Its length is not always known, so it waits for Enter or the
// button instead of sending itself.
export component EmailCodeField inherits Field {
    height: 60px;
    font-family: Look.mono;
    font-size: 26px;
    letter-spacing: 10px;
    alignment: center;
    padding-x: 18px;
    placeholder: "• • • • • •";
}

// Links in a row under the main button.
export component LinkRow inherits HorizontalLayout {
    alignment: start;
    spacing: 22px;
}

// A new password: twice, and a hint that anyone who knows the phone number can see.
export component NewPasswordForm inherits VerticalLayout {
    in property <string> title;
    in property <string> description;
    in property <length> heading-size: Look.heading-size;
    in property <string> button-label;
    in property <bool> busy;
    in property <string> error;
    callback submitted(string, string, string);     // the password, again, its hint
    spacing: 22px;

    FormHeading {
        title: root.title;
        description: root.description;
        size: root.heading-size;
    }
    VerticalLayout {
        spacing: 10px;
        password := Field {
            height: 48px;
            input-type: InputType.password;
            placeholder: @tr("New password");
            enabled: !root.busy;
            error: root.error != "";
            init => {
                self.focus-text();
            }
            accepted => {
                root.submitted(password.text, again.text, hint.text);
            }
        }
        again := Field {
            height: 48px;
            input-type: InputType.password;
            placeholder: @tr("Re-enter new password");
            enabled: !root.busy;
            error: root.error != "";
            accepted => {
                root.submitted(password.text, again.text, hint.text);
            }
        }
        hint := Field {
            height: 48px;
            placeholder: @tr("Password hint (optional)");
            enabled: !root.busy;
            accepted => {
                root.submitted(password.text, again.text, hint.text);
            }
        }
        if root.error != "": FormError {
            message: root.error;
        }
        FormNote {
            text: @tr("The hint is shown on the sign-in screen to anyone who knows your number. Don't write the password itself.");
        }
    }
    PrimaryButton {
        text: root.button-label;
        busy: root.busy;
        clicked => {
            root.submitted(password.text, again.text, hint.text);
        }
    }
}
