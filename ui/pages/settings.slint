// Settings, from the design's second round ("设置"): the categories on the left, one category on
// the right. The three themes are chosen under Appearance, where the design puts them; the change
// is immediate. Categories without a setting FinchGram has yet are greyed out, and so are such
// settings in the categories that have some.
import { AppState, NotificationSetting, Page, SettingsSection, TelegramState, Theme, UpdateState, Screenshot } from "../state.slint";
import { NotificationScope, NotificationScopes, PasswordSettings, PasswordStep, PasswordChange } from "../telegram.slint";
import { Look } from "../look.slint";
import { Fmt } from "../format.slint";
import { Icon, Logo, Spinner, Switch, Field, PrimaryButton, SectionLabel, Heading, Paragraph, Link } from "../widgets.slint";
import { FormHeading, FormError, HintLine, EmailCodeField, LinkRow, NewPasswordForm } from "password.slint";
import { PageFrame, SideColumn } from "frame.slint";

component Category inherits Rectangle {
    in property <SettingsSection> section;
    in property <string> icon;
    in property <string> label;
    in property <bool> enabled;
    property <bool> active: AppState.settings-section == section;
    height: 40px;
    border-radius: Look.radius;
    background: active ? Look.sel : touch.has-hover && enabled ? Look.sel.transparentize(0.5) : transparent;
    opacity: enabled ? 1 : 0.4;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                size: 19px;
                color: root.active && !Look.broadsheet ? Look.accent-ink : Look.text;
            }
        }
        Text {
            text: root.label;
            color: root.active && !Look.broadsheet ? Look.accent-ink : Look.text;
            font-size: 15px;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            AppState.settings-section = root.section;
            if PasswordSettings.open {
                PasswordSettings.cancel();
                PasswordSettings.open = false;
            }
        }
    }
}

component Categories {
    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 40px;
        padding-bottom: 40px;
        spacing: 2px;
        alignment: start;

        HorizontalLayout {
            padding-left: 12px;
            padding-bottom: 14px;
            spacing: 12px;
            // Back to the chats (or to logging in).
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 26px;
                    height: 26px;
                    border-radius: Look.button-radius;
                    background: back.has-hover ? Look.sel : transparent;
                    Icon {
                        name: "arrow-left";
                        size: 18px;
                        color: Look.accent;
                    }
                    back := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            // A change of the password that is under way is dropped.
                            if PasswordSettings.open {
                                PasswordSettings.cancel();
                            }
                            AppState.page = Page.chats;
                        }
                    }
                }
            }
            Heading {
                label: @tr("Settings");
                size: Look.nav-heading-size;
                vertical-alignment: center;
            }
        }

        Category {
            section: SettingsSection.general;
            icon: "sliders-horizontal";
            label: @tr("General");
            enabled: true;
        }
        Category {
            section: SettingsSection.notifications;
            icon: "bell";
            label: @tr("Notifications & sounds");
            enabled: true;
        }
        Category {
            section: SettingsSection.privacy;
            icon: "lock-key";
            label: @tr("Privacy & security");
            // These settings are the account's, kept by Telegram.
            enabled: AppState.telegram-state == TelegramState.ready;
        }
        Category {
            section: SettingsSection.chats;
            icon: "chat-circle-text";
            label: @tr("Chats");
        }
        Category {
            section: SettingsSection.folders;
            icon: "folders";
            label: @tr("Folders");
        }
        Category {
            section: SettingsSection.finch;
            icon: "bird";
            label: @tr("Finch features");
        }
        Category {
            section: SettingsSection.appearance;
            icon: "paint-brush";
            label: @tr("Appearance");
            enabled: true;
        }
        Category {
            section: SettingsSection.language;
            icon: "globe";
            label: @tr("Language");
            enabled: true;
        }
        Category {
            section: SettingsSection.data;
            icon: "database";
            label: @tr("Data & storage");
        }
        Category {
            section: SettingsSection.advanced;
            icon: "wrench";
            label: @tr("Advanced");
        }
        Category {
            section: SettingsSection.about;
            icon: "info";
            label: @tr("About");
            enabled: true;
        }
    }
}

// A theme to choose, drawn small in its own colours.
component ThemeCard {
    in property <Theme> theme;
    in property <string> label;
    in property <color> bg;
    in property <color> side;
    in property <color> ink;
    in property <color> accent;
    property <bool> active: AppState.theme == theme;

    VerticalLayout {
        spacing: 8px;
        Rectangle {
            width: 160px;
            height: 100px;
            border-radius: Look.radius;
            background: root.bg;
            clip: true;
            HorizontalLayout {
                Rectangle {
                    width: 40px;
                    background: root.side;
                }
                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    alignment: start;
                    Rectangle {
                        width: 67px;
                        height: 8px;
                        border-radius: 2px;
                        background: root.ink;
                    }
                    Rectangle {
                        width: 48px;
                        height: 8px;
                        border-radius: 2px;
                        background: root.ink;
                        opacity: 0.5;
                    }
                    Rectangle {
                        width: 38px;
                        height: 8px;
                        border-radius: 2px;
                        background: root.accent;
                    }
                }
            }
            Rectangle {
                border-radius: Look.radius;
                border-width: root.active ? 2px : 1px;
                border-color: root.active ? Look.accent : Look.line-strong;
            }
        }
        Text {
            text: root.label;
            color: Look.text;
            font-size: 14px;
            font-weight: root.active ? 600 : 400;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            AppState.change-theme(root.theme);
        }
    }
}

// Light or dark, drawn small in the current theme's colours.
component AppearanceCard {
    in property <string> appearance;
    in property <string> label;
    in property <color> bg;
    in property <color> side;
    in property <color> ink;
    in property <color> accent;
    property <bool> active: AppState.appearance == appearance;

    VerticalLayout {
        spacing: 8px;
        Rectangle {
            width: 160px;
            height: 100px;
            border-radius: Look.radius;
            background: root.bg;
            clip: true;
            HorizontalLayout {
                Rectangle {
                    width: 40px;
                    background: root.side;
                }
                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    alignment: start;
                    Rectangle {
                        width: 67px;
                        height: 8px;
                        border-radius: 2px;
                        background: root.ink;
                    }
                    Rectangle {
                        width: 48px;
                        height: 8px;
                        border-radius: 2px;
                        background: root.ink;
                        opacity: 0.5;
                    }
                    Rectangle {
                        width: 38px;
                        height: 8px;
                        border-radius: 2px;
                        background: root.accent;
                    }
                }
            }
            Rectangle {
                border-radius: Look.radius;
                border-width: root.active ? 2px : 1px;
                border-color: root.active ? Look.accent : Look.line-strong;
            }
        }
        Text {
            text: root.label;
            color: Look.text;
            font-size: 14px;
            font-weight: root.active ? 600 : 400;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            AppState.change-appearance(root.appearance);
        }
    }
}

// A group of settings: rows on the field colour, a hairline between them.
component Card inherits Rectangle {
    border-radius: Look.radius;
    background: Look.field;
    border-width: Look.field-border;
    border-color: Look.line;
    height: rows.preferred-height;

    rows := VerticalLayout {
        @children
    }
}

component Separator inherits Rectangle {
    height: 1px;
    background: Look.line;
}

// One setting: an icon, what it is, and a switch.
component SwitchRow {
    in property <string> icon;
    in property <string> title;
    in property <string> description;
    in property <bool> on;
    in property <bool> enabled: true;
    callback toggled();
    opacity: enabled ? 1 : 0.4;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                size: 20px;
                color: Look.accent;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                color: Look.text;
                font-size: 15px;
                font-weight: 500;
            }
            if root.description != "": Paragraph {
                text: root.description;
                color: Look.muted;
                font-size: 13px;
            }
        }
        VerticalLayout {
            alignment: center;
            Switch {
                on: root.on;
                enabled: root.enabled;
                toggled => {
                    root.toggled();
                }
            }
        }
    }
}

// One setting that opens more: an icon, what it is, its value, and a caret. A choice between a few
// values (the caret up and down) takes the next one when clicked.
component NavRow inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> value;
    in property <string> caret: "caret-right";
    in property <bool> enabled: true;
    in property <bool> danger;
    callback clicked();
    background: touch.has-hover && enabled ? Look.sel : transparent;
    opacity: enabled ? 1 : 0.4;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                size: 20px;
                color: root.danger ? Look.danger : Look.accent;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.title;
            color: root.danger ? Look.danger : Look.text;
            font-size: 15px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.value != "": Text {
            text: root.value;
            color: Look.muted;
            font-size: 14px;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.caret;
                size: 14px;
                color: Look.faint;
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component SmallButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();
    height: 32px;
    width: label.preferred-width + 28px;
    border-radius: Look.button-radius;
    background: primary ? (touch.has-hover ? Look.accent.darker(0.1) : Look.accent) : touch.has-hover ? Look.sel : Look.bg;
    border-width: primary ? 0px : 1px;
    border-color: Look.line-strong;
    opacity: enabled ? 1 : 0.5;

    label := Text {
        text: root.text;
        color: root.primary ? Look.on-accent : Look.text;
        font-size: 14px;
        font-weight: 600;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Where the self-updater is, and what to do next (src/update.rs).
component UpdateRow {
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            if AppState.update-state == UpdateState.checking || AppState.update-state == UpdateState.installing: Spinner {
                size: 20px;
                color: Look.accent;
            }
            if AppState.update-state != UpdateState.checking && AppState.update-state != UpdateState.installing: Icon {
                name: AppState.update-state == UpdateState.available ? "sparkle"
                    : AppState.update-state == UpdateState.up-to-date ? "check-circle"
                    : AppState.update-state == UpdateState.failed ? "warning-circle" : "arrows-clockwise";
                size: 20px;
                color: AppState.update-state == UpdateState.failed ? Look.danger : Look.accent;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: AppState.update-state == UpdateState.checking ? @tr("Checking…")
                    : AppState.update-state == UpdateState.available ? @tr("Version {0} available", AppState.update-version)
                    : AppState.update-state == UpdateState.installing ? (AppState.update-progress < 1 ? @tr("Downloading {0}%", Math.round(AppState.update-progress * 100)) : @tr("Installing…"))
                    : AppState.update-state == UpdateState.up-to-date ? @tr("You're up to date")
                    : AppState.update-state == UpdateState.failed ? @tr("The update failed")
                    : @tr("Version {0}", AppState.app-version);
                color: AppState.update-state == UpdateState.failed ? Look.danger : Look.text;
                font-size: 15px;
                font-weight: 500;
            }
            if AppState.update-state == UpdateState.failed: Paragraph {
                text: AppState.update-error;
                color: Look.muted;
                font-size: 13px;
            }
            if AppState.update-state == UpdateState.available && AppState.update-notes != "": Paragraph {
                text: AppState.update-notes;
                color: Look.muted;
                font-size: 13px;
            }
            if AppState.update-state == UpdateState.up-to-date: Text {
                text: @tr("Version {0}", AppState.app-version);
                color: Look.muted;
                font-size: 13px;
            }
        }
        VerticalLayout {
            alignment: center;
            if AppState.update-state == UpdateState.available: SmallButton {
                text: @tr("Install and restart");
                primary: true;
                clicked => {
                    AppState.install-update();
                }
            }
            if AppState.update-state != UpdateState.available && AppState.update-state != UpdateState.installing: SmallButton {
                text: @tr("Check for updates");
                enabled: AppState.update-state != UpdateState.checking;
                clicked => {
                    AppState.check-for-updates();
                }
            }
        }
    }
}

component AppearanceSection {
    VerticalLayout {
        spacing: 26px;
        VerticalLayout {
            spacing: 12px;
            SectionLabel {
                label: @tr("Theme");
            }
            HorizontalLayout {
                spacing: 14px;
                alignment: start;
                ThemeCard {
                    theme: Theme.workbench;
                    label: @tr("Workbench");
                    bg: Look.dark ? #17191d : #ffffff;
                    side: Look.dark ? #1b1e22 : #f3f4f6;
                    ink: Look.dark ? #e2e5e9 : #1b1f24;
                    accent: Look.dark ? #8e9ff0 : #4a5fc1;
                }
                ThemeCard {
                    theme: Theme.broadsheet;
                    label: @tr("Broadsheet");
                    bg: Look.dark ? #1b1a19 : #f3f2f2;
                    side: Look.dark ? #151413 : #eae9e9;
                    ink: Look.dark ? #ecebea : #201e1d;
                    accent: Look.dark ? #62c5ee : #0088b0;
                }
                ThemeCard {
                    theme: Theme.terminal;
                    label: @tr("Terminal");
                    bg: Look.dark ? #0e100f : #f6f7f4;
                    side: Look.dark ? #131614 : #eceee9;
                    ink: Look.dark ? #d6dbd7 : #1a1d1b;
                    accent: Look.dark ? #7ed69b : #1d7a45;
                }
            }
            Paragraph {
                text: @tr("Workbench is an editor's layout, Broadsheet a newspaper's, Terminal a console's. The same chats and settings in all three.");
                color: Look.faint;
                font-size: 13px;
            }
        }
        VerticalLayout {
            spacing: 12px;
            SectionLabel {
                label: @tr("Light and dark");
            }
            HorizontalLayout {
                spacing: 14px;
                alignment: start;
                AppearanceCard {
                    appearance: "light";
                    label: @tr("Light");
                    bg: Look.broadsheet ? #f3f2f2 : Look.terminal ? #f6f7f4 : #ffffff;
                    side: Look.broadsheet ? #eae9e9 : Look.terminal ? #eceee9 : #f7f8fa;
                    ink: Look.broadsheet ? #201e1d : Look.terminal ? #1a1d1b : #1b1f24;
                    accent: Look.broadsheet ? #0088b0 : Look.terminal ? #1d7a45 : #4a5fc1;
                }
                AppearanceCard {
                    appearance: "dark";
                    label: @tr("Dark");
                    bg: Look.broadsheet ? #1b1a19 : Look.terminal ? #0e100f : #17191d;
                    side: Look.broadsheet ? #151413 : Look.terminal ? #131614 : #1b1e22;
                    ink: Look.broadsheet ? #ecebea : Look.terminal ? #d6dbd7 : #e2e5e9;
                    accent: Look.broadsheet ? #62c5ee : Look.terminal ? #7ed69b : #8e9ff0;
                }
            }
            Card {
                SwitchRow {
                    icon: "circle-half";
                    title: @tr("Match system appearance");
                    on: AppState.appearance == "system";
                    toggled => {
                        AppState.change-appearance(AppState.appearance == "system" ? (Look.dark ? "dark" : "light") : "system");
                    }
                }
            }
        }
    }
}

// The screenshot tool's shortcut (src/screenshot/): its keys in a box, which takes new ones when
// clicked (⌘ or ⌃ with a letter or digit; Esc keeps the old), and Reset when it is not ⌘⇧A.
component ShortcutRow {
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: "scissors";
                size: 20px;
                transform-rotation: Look.terminal ? 0deg : -90deg;
                color: Look.accent;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: @tr("Screenshot shortcut");
            color: Look.text;
            font-size: 15px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            keys := Rectangle {
                width: max(76px, key-text.preferred-width + 20px);
                height: key-text.preferred-height + 8px;
                border-radius: Look.button-radius;
                background: Look.field;
                border-width: Screenshot.recording ? 2px : 1px;
                border-color: Screenshot.recording ? Look.accent : Look.line-strong;
                key-text := Text {
                    text: Screenshot.recording ? @tr("Type a new shortcut…") : Screenshot.shortcut-label;
                    color: Screenshot.recording ? Look.faint : Look.text;
                    font-family: Look.mono;
                    font-size: 13px;
                }
                scope := FocusScope {
                    key-pressed(event) => {
                        if !Screenshot.recording {
                            return reject;
                        }
                        if event.text == Key.Escape {
                            Screenshot.recording = false;
                            return accept;
                        }
                        Screenshot.record-shortcut(event.text, event.modifiers.meta, event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
                        return accept;
                    }
                    focus-changed-event => {
                        if !self.has-focus {
                            Screenshot.recording = false;
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Screenshot.recording = !Screenshot.recording;
                            if Screenshot.recording {
                                scope.focus();
                            }
                        }
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            reset := Rectangle {
                width: reset-text.preferred-width + 16px;
                height: reset-text.preferred-height + 8px;
                border-radius: Look.button-radius;
                background: reset-touch.has-hover && Screenshot.custom-shortcut ? Look.sel : transparent;
                opacity: Screenshot.custom-shortcut ? 1 : 0.4;
                reset-text := Text {
                    text: Look.terminal ? "[reset]" : @tr("Reset");
                    color: Look.accent-ink;
                    font-size: 13px;
                    font-weight: 600;
                }
                reset-touch := TouchArea {
                    enabled: Screenshot.custom-shortcut;
                    mouse-cursor: pointer;
                    clicked => {
                        Screenshot.reset-shortcut();
                    }
                }
            }
        }
    }
}

// General, from the design: starting FinchGram and closing its window, typing, shortcuts, and the
// screenshot tool.
component GeneralSection {
    init => {
        AppState.check-launch-at-login();
    }

    VerticalLayout {
        spacing: 26px;
        VerticalLayout {
            spacing: 8px;
            SectionLabel {
                label: @tr("Startup & window");
            }
            Card {
                SwitchRow {
                    icon: "power";
                    title: @tr("Launch at login");
                    on: AppState.launch-at-login;
                    enabled: AppState.launch-at-login-available;
                    toggled => {
                        AppState.change-launch-at-login(!AppState.launch-at-login);
                    }
                }
                Separator { }
                SwitchRow {
                    icon: "app-window";
                    title: @tr("Show in menu bar");
                    on: AppState.show-in-menu-bar;
                    enabled: AppState.menu-bar-available;
                    toggled => {
                        AppState.change-show-in-menu-bar(!AppState.show-in-menu-bar);
                    }
                }
                Separator { }
                NavRow {
                    icon: "x-square";
                    title: @tr("When closing the window");
                    value: AppState.quit-on-close ? @tr("Quit") : @tr("Minimize to tray");
                    caret: "caret-up-down";
                    enabled: AppState.keeps-running-available;
                    clicked => {
                        AppState.change-quit-on-close(!AppState.quit-on-close);
                    }
                }
            }
        }
        VerticalLayout {
            spacing: 8px;
            SectionLabel {
                label: @tr("Input");
            }
            Card {
                SwitchRow {
                    icon: "keyboard";
                    title: @tr("Send with Enter");
                    on: AppState.send-with-enter;
                    toggled => {
                        AppState.change-send-with-enter(!AppState.send-with-enter);
                    }
                }
                Separator { }
                SwitchRow {
                    icon: "text-aa";
                    title: @tr("Spell check");
                    enabled: false;
                }
                Separator { }
                SwitchRow {
                    icon: "smiley";
                    title: @tr("Replace emoji automatically");
                    enabled: false;
                }
            }
        }
        VerticalLayout {
            spacing: 8px;
            SectionLabel {
                label: @tr("Shortcuts");
            }
            Card {
                NavRow {
                    icon: "command";
                    title: @tr("Keyboard shortcuts");
                    value: @tr("shortcuts" => "View");
                    enabled: false;
                }
            }
        }
        VerticalLayout {
            spacing: 8px;
            SectionLabel {
                label: @tr("Screenshots");
            }
            Card {
                ShortcutRow { }
                Separator { }
                SwitchRow {
                    icon: "app-window";
                    title: @tr("Hide the FinchGram window while taking a screenshot");
                    on: Screenshot.hide-own-window;
                    toggled => {
                        Screenshot.set-hide-own-window(!Screenshot.hide-own-window);
                    }
                }
                Separator { }
                SwitchRow {
                    icon: "globe-simple";
                    title: @tr("Also when FinchGram is in the background");
                    on: Screenshot.background;
                    enabled: false;
                }
            }
        }
    }
}

// Notifications & sounds, from the design: what FinchGram does when a message arrives
// (src/telegram/notifications.rs), and whether each kind of chat notifies, which is Telegram's own
// setting for the account. A notification's preview and sound come with the notification, so they
// are greyed out without it; there is only one account, so far.
component NotificationsSection {
    VerticalLayout {
        spacing: 26px;
        VerticalLayout {
            spacing: 8px;
            SectionLabel {
                label: @tr("Desktop notifications");
            }
            Card {
                SwitchRow {
                    icon: "bell-ringing";
                    title: @tr("Desktop notifications");
                    on: AppState.desktop-notifications;
                    toggled => {
                        AppState.change-notification-setting(NotificationSetting.desktop-notifications, !AppState.desktop-notifications);
                    }
                }
                Separator { }
                SwitchRow {
                    icon: "eye";
                    title: @tr("Message previews");
                    on: AppState.message-previews;
                    enabled: AppState.desktop-notifications;
                    toggled => {
                        AppState.change-notification-setting(NotificationSetting.message-previews, !AppState.message-previews);
                    }
                }
                Separator { }
                SwitchRow {
                    icon: "speaker-high";
                    title: @tr("Sounds");
                    on: AppState.notification-sounds;
                    enabled: AppState.desktop-notifications;
                    toggled => {
                        AppState.change-notification-setting(NotificationSetting.notification-sounds, !AppState.notification-sounds);
                    }
                }
                Separator { }
                SwitchRow {
                    icon: "lightning";
                    title: @tr("Flash taskbar");
                    on: AppState.flash-taskbar;
                    toggled => {
                        AppState.change-notification-setting(NotificationSetting.flash-taskbar, !AppState.flash-taskbar);
                    }
                }
                Separator { }
                SwitchRow {
                    icon: "bell-slash";
                    title: @tr("Count muted chats in badge");
                    on: AppState.count-muted-chats;
                    toggled => {
                        AppState.change-notification-setting(NotificationSetting.count-muted-chats, !AppState.count-muted-chats);
                    }
                }
                Separator { }
                SwitchRow {
                    icon: "users";
                    title: @tr("Notifications from other accounts");
                    description: @tr("When off, only the current account notifies you");
                    enabled: false;
                }
            }
        }
        VerticalLayout {
            spacing: 8px;
            SectionLabel {
                label: @tr("By chat type");
            }
            // Telegram's settings: there once TDLib has said them. A click switches the kind on or
            // off, as a choice between values does elsewhere.
            Card {
                NavRow {
                    icon: "user";
                    title: @tr("Private chats");
                    value: !NotificationScopes.loaded ? "" : NotificationScopes.private-chats ? @tr("On") : @tr("Off");
                    caret: "caret-up-down";
                    enabled: NotificationScopes.loaded;
                    clicked => {
                        NotificationScopes.toggle(NotificationScope.private-chats);
                    }
                }
                Separator { }
                NavRow {
                    icon: "users-three";
                    title: @tr("Groups");
                    value: !NotificationScopes.loaded ? "" : NotificationScopes.groups ? @tr("On") : @tr("Off");
                    caret: "caret-up-down";
                    enabled: NotificationScopes.loaded;
                    clicked => {
                        NotificationScopes.toggle(NotificationScope.groups);
                    }
                }
                Separator { }
                NavRow {
                    icon: "megaphone";
                    title: @tr("Channels");
                    value: !NotificationScopes.loaded ? "" : NotificationScopes.channels ? @tr("On") : @tr("Off");
                    caret: "caret-up-down";
                    enabled: NotificationScopes.loaded;
                    clicked => {
                        NotificationScopes.toggle(NotificationScope.channels);
                    }
                }
            }
        }
    }
}

component LanguageSection {
    VerticalLayout {
        spacing: 16px;
        Paragraph {
            text: @tr("Changes the interface only — messages aren't translated");
            color: Look.muted;
            font-size: 14px;
        }
        VerticalLayout {
            spacing: 4px;
            for language in AppState.languages: Rectangle {
                height: 56px;
                border-radius: Look.radius;
                background: language.code == AppState.language ? Look.sel : entry.has-hover ? Look.sel.transparentize(0.5) : transparent;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: language.native;
                            color: Look.text;
                            font-size: 16px;
                            font-weight: language.code == AppState.language ? 600 : 400;
                        }
                        Text {
                            text: language.english;
                            color: Look.faint;
                            font-size: 12px;
                        }
                    }
                    if language.code == AppState.language: VerticalLayout {
                        alignment: center;
                        Icon {
                            name: "check";
                            size: 18px;
                            color: Look.accent;
                        }
                    }
                }
                entry := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        AppState.change-language(language.code);
                    }
                }
            }
        }
    }
}

component AboutSection {
    VerticalLayout {
        spacing: 26px;
        HorizontalLayout {
            spacing: 16px;
            alignment: start;
            Logo {
                size: 64px;
                radius: Look.logo-radius;
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: Look.wordmark;
                    color: Look.text;
                    font-size: 20px;
                    font-weight: 600;
                }
                Text {
                    text: AppState.tdlib-version == "" ? @tr("Version {0}", AppState.app-version)
                        : @tr("Version {0}", AppState.app-version) + " · TDLib " + AppState.tdlib-version;
                    color: Look.muted;
                    font-size: 14px;
                }
            }
        }
        VerticalLayout {
            spacing: 8px;
            SectionLabel {
                label: @tr("Updates");
            }
            Card {
                UpdateRow { }
                Separator { }
                SwitchRow {
                    icon: "clock-clockwise";
                    title: @tr("Check for updates automatically");
                    on: AppState.check-for-updates-daily;
                    toggled => {
                        AppState.change-check-for-updates-daily(!AppState.check-for-updates-daily);
                    }
                }
            }
            Paragraph {
                text: @tr("Updates come from GitHub Releases and are signature-checked before install.");
                color: Look.faint;
                font-size: 12px;
            }
        }
        HorizontalLayout {
            alignment: start;
            Rectangle {
                border-radius: Look.radius;
                background: source.has-hover ? Look.sel : Look.field;
                border-width: Look.field-border;
                border-color: Look.line;
                height: link.preferred-height;
                width: link.preferred-width;
                link := HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: "github-logo";
                            size: 22px;
                            color: Look.text;
                            duotone: false;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: @tr("Fully open source — read the code");
                            color: Look.text;
                            font-size: 14px;
                            font-weight: 600;
                        }
                        Text {
                            text: "https://github.com/FinchGram/FinchGram";
                            color: Look.accent-ink;
                            font-size: 13px;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: "arrow-square-out";
                            size: 16px;
                            color: Look.faint;
                        }
                    }
                }
                source := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        AppState.open-url("https://github.com/FinchGram/FinchGram");
                    }
                }
            }
        }
        Paragraph {
            text: @tr("FinchGram is an unofficial client built on the Telegram API. It is not made by Telegram.");
            color: Look.muted;
            font-size: 14px;
            line-height-factor: Look.leading(1.6);
        }
    }
}

// Privacy & security. Who can see what, and the security settings besides two-step verification,
// are not in FinchGram yet.
component PrivacySection {
    init => {
        PasswordSettings.load();
    }

    VerticalLayout {
        spacing: 26px;
        VerticalLayout {
            spacing: 8px;
            SectionLabel {
                label: @tr("Who can see");
            }
            Card {
                NavRow {
                    icon: "phone";
                    title: @tr("Phone number");
                    enabled: false;
                }
                Separator { }
                NavRow {
                    icon: "clock";
                    title: @tr("Last seen");
                    enabled: false;
                }
                Separator { }
                NavRow {
                    icon: "user-circle";
                    title: @tr("Profile photos");
                    enabled: false;
                }
                Separator { }
                NavRow {
                    icon: "share-fat";
                    title: @tr("Forwarded messages");
                    enabled: false;
                }
                Separator { }
                NavRow {
                    icon: "phone-call";
                    title: @tr("Calls");
                    enabled: false;
                }
                Separator { }
                NavRow {
                    icon: "user-plus";
                    title: @tr("Invites to groups");
                    enabled: false;
                }
            }
            Paragraph {
                text: @tr("Stored on Telegram servers and synced across all your apps.");
                color: Look.faint;
                font-size: 12px;
            }
        }
        VerticalLayout {
            spacing: 8px;
            SectionLabel {
                label: @tr("Security");
            }
            Card {
                NavRow {
                    icon: "shield-check";
                    title: @tr("Two-step verification");
                    value: !PasswordSettings.loaded ? "" : PasswordSettings.has-password ? @tr("On") : @tr("Off");
                    clicked => {
                        PasswordSettings.error = "";
                        PasswordSettings.done = PasswordChange.nothing;
                        PasswordSettings.step = PasswordStep.overview;
                        PasswordSettings.open = true;
                        PasswordSettings.load();
                    }
                }
                Separator { }
                NavRow {
                    icon: "lock-simple";
                    title: @tr("Local passcode");
                    enabled: false;
                }
                Separator { }
                NavRow {
                    icon: "devices";
                    title: @tr("Active sessions");
                    enabled: false;
                }
                Separator { }
                NavRow {
                    icon: "prohibit";
                    title: @tr("Blocked users");
                    enabled: false;
                }
                Separator { }
                NavRow {
                    icon: "timer";
                    title: @tr("Delete my account");
                    enabled: false;
                }
            }
        }
    }
}

// Two-step verification as it is: on or off, a reset on its way, and what can be changed.
component PasswordOverview {
    VerticalLayout {
        spacing: 26px;
        HorizontalLayout {
            spacing: 16px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 52px;
                    height: 52px;
                    border-radius: Look.avatar-radius;
                    background: Look.soft;
                    Icon {
                        name: PasswordSettings.has-password ? "shield-check" : "shield-slash";
                        size: 28px;
                        color: PasswordSettings.has-password ? Look.accent : Look.faint;
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 3px;
                Text {
                    text: PasswordSettings.has-password ? @tr("Two-step verification is on") : @tr("Two-step verification is off");
                    color: Look.text;
                    font-size: 17px;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                Paragraph {
                    text: PasswordSettings.has-password ? @tr("When you sign in on a new device, you'll need this password in addition to the code.")
                        : @tr("Turn it on to require an extra password when signing in on a new device.");
                    color: Look.muted;
                    font-size: 14px;
                    line-height-factor: Look.leading(1.5);
                }
            }
        }
        if PasswordSettings.has-password && PasswordSettings.reset-pending: Rectangle {
            border-radius: Look.radius;
            background: Look.soft;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 14px;
                padding-bottom: 14px;
                spacing: 12px;
                VerticalLayout {
                    alignment: start;
                    padding-top: 1px;
                    Icon {
                        name: "clock-countdown";
                        size: 20px;
                        color: Look.soft-ink;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 3px;
                    Paragraph {
                        text: @tr("Password will reset on {0}", Fmt.date-time(PasswordSettings.reset-date));
                        color: Look.soft-ink;
                        font-size: 15px;
                        font-weight: 600;
                    }
                    Paragraph {
                        text: @tr("Come back then to set a new password. If this wasn't you, cancel now.");
                        color: Look.soft-ink;
                        font-size: 13px;
                        line-height-factor: Look.leading(1.5);
                    }
                }
                VerticalLayout {
                    alignment: start;
                    SmallButton {
                        text: @tr("Cancel reset");
                        enabled: !PasswordSettings.busy;
                        clicked => {
                            PasswordSettings.cancel-reset();
                        }
                    }
                }
            }
        }
        if PasswordSettings.has-password: Card {
            NavRow {
                icon: "key";
                title: @tr("Change password");
                clicked => {
                    PasswordSettings.choose(PasswordStep.new-password);
                }
            }
            Separator { }
            NavRow {
                icon: "lightbulb";
                title: @tr("Password hint");
                value: PasswordSettings.hint;
                clicked => {
                    PasswordSettings.choose(PasswordStep.hint);
                }
            }
            Separator { }
            NavRow {
                icon: "envelope-simple";
                title: @tr("Recovery email");
                value: PasswordSettings.has-recovery-email ? PasswordSettings.recovery-email : "";
                clicked => {
                    PasswordSettings.choose(PasswordStep.recovery-email);
                }
            }
            Separator { }
            NavRow {
                icon: "shield-slash";
                title: @tr("Turn off two-step verification");
                danger: true;
                clicked => {
                    PasswordSettings.choose(PasswordStep.turn-off);
                }
            }
        }
        if !PasswordSettings.has-password: HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: @tr("Set password");
                height: 42px;
                font-size: 15px;
                clicked => {
                    PasswordSettings.choose(PasswordStep.new-password);
                }
            }
        }
    }
}

// The steps of a change, each a small form: the design's settings form is at most 420px wide.
component PasswordForm inherits VerticalLayout {
    max-width: 420px;
    spacing: 18px;
    alignment: start;
}

component CancelLink inherits Link {
    text: @tr("Cancel");
    enabled: !PasswordSettings.busy;
    clicked => {
        PasswordSettings.cancel();
    }
}

component VerifyForm inherits PasswordForm {
    FormHeading {
        title: @tr("Enter your current password");
        description: @tr("Confirm it's you before changing two-step verification settings.");
        size: 20px;
    }
    VerticalLayout {
        spacing: 10px;
        password := Field {
            height: 48px;
            input-type: InputType.password;
            placeholder: @tr("Password");
            enabled: !PasswordSettings.busy;
            error: PasswordSettings.error != "";
            init => {
                self.focus-text();
            }
            accepted(value) => {
                PasswordSettings.verify(value);
            }
        }
        if PasswordSettings.hint != "": HintLine {
            hint: PasswordSettings.hint;
        }
        if PasswordSettings.error != "": FormError {
            message: PasswordSettings.error;
        }
    }
    PrimaryButton {
        text: @tr("Next");
        busy: PasswordSettings.busy;
        clicked => {
            PasswordSettings.verify(password.text);
        }
    }
    LinkRow {
        Link {
            text: @tr("Forgot password?");
            enabled: !PasswordSettings.busy;
            clicked => {
                PasswordSettings.forgot();
            }
        }
        CancelLink { }
    }
}

component NewPasswordStepForm inherits PasswordForm {
    NewPasswordForm {
        title: PasswordSettings.has-password ? @tr("Set a new password") : @tr("Set password");
        description: @tr("You'll need this password when signing in on a new device.");
        heading-size: 20px;
        spacing: 18px;
        button-label: @tr("Save");
        busy: PasswordSettings.busy;
        error: PasswordSettings.error;
        submitted(password, again, hint) => {
            PasswordSettings.submit-new-password(password, again, hint);
        }
    }
    LinkRow {
        CancelLink { }
    }
}

component HintForm inherits PasswordForm {
    FormHeading {
        title: @tr("Change password hint");
        description: @tr("The hint is shown on the sign-in screen to anyone who knows your number. Don't write the password itself.");
        size: 20px;
    }
    VerticalLayout {
        spacing: 10px;
        hint := Field {
            height: 48px;
            text: PasswordSettings.hint;
            placeholder: @tr("Password hint (optional)");
            enabled: !PasswordSettings.busy;
            error: PasswordSettings.error != "";
            init => {
                self.focus-text();
            }
            accepted(value) => {
                PasswordSettings.submit-hint(value);
            }
        }
        if PasswordSettings.error != "": FormError {
            message: PasswordSettings.error;
        }
    }
    PrimaryButton {
        text: @tr("Save");
        busy: PasswordSettings.busy;
        clicked => {
            PasswordSettings.submit-hint(hint.text);
        }
    }
    LinkRow {
        CancelLink { }
    }
}

component RecoveryEmailForm inherits PasswordForm {
    FormHeading {
        title: @tr("Change recovery email");
        description: @tr("If you forget your password, a recovery code will be sent to this address.");
        size: 20px;
    }
    VerticalLayout {
        spacing: 10px;
        email := Field {
            height: 48px;
            text: PasswordSettings.code-sent-to;
            placeholder: @tr("Email address");
            enabled: !PasswordSettings.busy;
            error: PasswordSettings.error != "";
            init => {
                self.focus-text();
            }
            accepted(value) => {
                PasswordSettings.submit-recovery-email(value);
            }
        }
        if PasswordSettings.error != "": FormError {
            message: PasswordSettings.error;
        }
    }
    PrimaryButton {
        text: @tr("Send code");
        busy: PasswordSettings.busy;
        clicked => {
            PasswordSettings.submit-recovery-email(email.text);
        }
    }
    LinkRow {
        CancelLink { }
    }
}

component RecoveryEmailCodeForm inherits PasswordForm {
    FormHeading {
        title: @tr("Enter the email code");
        description: @tr("Code sent to {0}", PasswordSettings.code-sent-to);
        size: 20px;
    }
    VerticalLayout {
        spacing: 10px;
        code := EmailCodeField {
            enabled: !PasswordSettings.busy;
            error: PasswordSettings.error != "";
            init => {
                self.focus-text();
            }
            accepted(value) => {
                PasswordSettings.submit-recovery-email-code(value);
            }
        }
        if PasswordSettings.error != "": FormError {
            message: PasswordSettings.error;
        }
    }
    PrimaryButton {
        text: @tr("Next");
        busy: PasswordSettings.busy;
        clicked => {
            PasswordSettings.submit-recovery-email-code(code.text);
        }
    }
    LinkRow {
        Link {
            text: @tr("Back");
            enabled: !PasswordSettings.busy;
            clicked => {
                PasswordSettings.error = "";
                PasswordSettings.step = PasswordStep.recovery-email;
            }
        }
        CancelLink { }
    }
}

component TurnOffForm inherits PasswordForm {
    FormHeading {
        title: @tr("Turn off two-step verification?");
        description: @tr("Anyone who gets your sign-in code will be able to access your account.");
        size: 20px;
    }
    if PasswordSettings.error != "": FormError {
        message: PasswordSettings.error;
    }
    PrimaryButton {
        text: @tr("Turn off");
        fill: Look.danger;
        busy: PasswordSettings.busy;
        clicked => {
            PasswordSettings.turn-off();
        }
    }
    LinkRow {
        CancelLink { }
    }
}

component RecoveryCodeForm inherits PasswordForm {
    FormHeading {
        title: @tr("Recover via email");
        description: @tr("A recovery code was sent to {0}. Enter it to set a new password.", PasswordSettings.code-sent-to);
        size: 20px;
    }
    VerticalLayout {
        spacing: 10px;
        code := EmailCodeField {
            enabled: !PasswordSettings.busy;
            error: PasswordSettings.error != "";
            init => {
                self.focus-text();
            }
            accepted(value) => {
                PasswordSettings.submit-recovery-code(value);
            }
        }
        if PasswordSettings.error != "": FormError {
            message: PasswordSettings.error;
        }
    }
    PrimaryButton {
        text: @tr("Next");
        busy: PasswordSettings.busy;
        clicked => {
            PasswordSettings.submit-recovery-code(code.text);
        }
    }
    LinkRow {
        Link {
            text: @tr("Can't access this email?");
            enabled: !PasswordSettings.busy;
            clicked => {
                PasswordSettings.error = "";
                PasswordSettings.step = PasswordStep.reset;
            }
        }
        Link {
            text: @tr("Back");
            enabled: !PasswordSettings.busy;
            clicked => {
                PasswordSettings.error = "";
                PasswordSettings.step = PasswordStep.verify;
            }
        }
    }
}

component ResetForm inherits PasswordForm {
    FormHeading {
        title: @tr("Request password reset");
        description: @tr("If you can't get the recovery email, you can request a reset. To protect your account it takes 7 days, and you can cancel any time before then.");
        size: 20px;
    }
    if PasswordSettings.error != "": FormError {
        message: PasswordSettings.error;
    }
    PrimaryButton {
        text: @tr("Request reset");
        fill: Look.danger;
        busy: PasswordSettings.busy;
        clicked => {
            PasswordSettings.request-reset();
        }
    }
    LinkRow {
        Link {
            text: @tr("Back");
            enabled: !PasswordSettings.busy;
            clicked => {
                PasswordSettings.error = "";
                PasswordSettings.step = PasswordSettings.code-sent-to != "" ? PasswordStep.recovery-code : PasswordStep.verify;
            }
        }
    }
}

// Settings → Privacy & security → Two-step verification (src/telegram/password.rs).
component PasswordSection {
    VerticalLayout {
        alignment: start;
        if PasswordSettings.step == PasswordStep.overview && PasswordSettings.loaded: PasswordOverview { }
        if PasswordSettings.step == PasswordStep.verify: VerifyForm { }
        if PasswordSettings.step == PasswordStep.new-password: NewPasswordStepForm { }
        if PasswordSettings.step == PasswordStep.hint: HintForm { }
        if PasswordSettings.step == PasswordStep.recovery-email: RecoveryEmailForm { }
        if PasswordSettings.step == PasswordStep.recovery-email-code: RecoveryEmailCodeForm { }
        if PasswordSettings.step == PasswordStep.turn-off: TurnOffForm { }
        if PasswordSettings.step == PasswordStep.recovery-code: RecoveryCodeForm { }
        if PasswordSettings.step == PasswordStep.reset: ResetForm { }
    }
}

export component SettingsPage inherits PageFrame {
    property <bool> two-step: AppState.settings-section == SettingsSection.privacy && PasswordSettings.open;
    title: @tr("Settings");

    SideColumn {
        Categories {
            width: parent.width;
            height: parent.height;
        }
    }

    Flickable {
        horizontal-stretch: 1;
        mouse-drag-pan-enabled: false;
        content-height: max(self.height, page.preferred-height);

        page := HorizontalLayout {
            width: parent.width;
            padding-left: 56px;
            padding-right: 56px;
            padding-top: 40px;
            padding-bottom: 40px;
            alignment: start;
            // As wide as the design's column (600px), where the window has room for it.
            VerticalLayout {
                preferred-width: 600px;
                max-width: 600px;
                spacing: 26px;
                alignment: start;
                // Two-step verification is a page within Privacy & security: the way back is above
                // its heading, and what was just changed is said below it.
                VerticalLayout {
                    spacing: 12px;
                    if root.two-step: Link {
                        text: @tr("Privacy & security");
                        icon: "caret-left";
                        clicked => {
                            PasswordSettings.cancel();
                            PasswordSettings.open = false;
                        }
                    }
                    Heading {
                        label: root.two-step ? @tr("Two-step verification")
                            : AppState.settings-section == SettingsSection.general ? @tr("General")
                            : AppState.settings-section == SettingsSection.notifications ? @tr("Notifications & sounds")
                            : AppState.settings-section == SettingsSection.language ? @tr("Language")
                            : AppState.settings-section == SettingsSection.privacy ? @tr("Privacy & security")
                            : AppState.settings-section == SettingsSection.about ? @tr("About") : @tr("Appearance");
                    }
                    if root.two-step && PasswordSettings.step == PasswordStep.overview && PasswordSettings.done != PasswordChange.nothing: HorizontalLayout {
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "check-circle";
                                size: 17px;
                                color: Look.ok;
                                duotone: false;
                            }
                        }
                        Text {
                            text: PasswordSettings.done == PasswordChange.password ? @tr("Password updated")
                                : PasswordSettings.done == PasswordChange.hint ? @tr("Password hint updated") : @tr("Recovery email updated");
                            color: Look.ok;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                    }
                }
                if AppState.settings-section == SettingsSection.general: GeneralSection { }
                if AppState.settings-section == SettingsSection.notifications: NotificationsSection { }
                if AppState.settings-section == SettingsSection.appearance: AppearanceSection { }
                if AppState.settings-section == SettingsSection.language: LanguageSection { }
                if AppState.settings-section == SettingsSection.privacy && !root.two-step: PrivacySection { }
                if root.two-step: PasswordSection { }
                if AppState.settings-section == SettingsSection.about: AboutSection { }
            }
        }
    }
}
