// The profile, from the design's second round ("个人资料"): who is logged in and the accounts on
// the left, the profile to edit on the right. Telegram keeps a first and a last name, so the one
// "Name" field of the design is two here.
import { AppState, Page } from "../state.slint";
import { Account } from "../telegram.slint";
import { Look } from "../look.slint";
import { Icon, Field, Heading, SectionLabel, Paragraph, Link, Spinner, Avatar } from "../widgets.slint";
import { PageFrame, SideColumn } from "frame.slint";

component Label inherits Text {
    color: Look.muted;
    font-size: 13px;
}

component Summary {
    VerticalLayout {
        padding-left: 36px;
        padding-right: 36px;
        padding-top: 40px;
        padding-bottom: 40px;
        spacing: 30px;

        HorizontalLayout {
            alignment: start;
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: Look.button-radius;
                background: back.has-hover ? Look.sel : transparent;
                Icon {
                    name: "arrow-left";
                    size: 18px;
                    color: Look.accent;
                }
                back := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        AppState.page = Page.chats;
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 14px;
            HorizontalLayout {
                alignment: start;
                Avatar {
                    size: 104px;
                    initial: Account.initial;
                    picture: Account.large-picture;
                    has-picture: Account.has-picture;
                    font-size: 44px;
                }
            }
            VerticalLayout {
                spacing: 4px;
                Heading {
                    label: Account.name;
                }
                Text {
                    text: Account.username == "" ? Account.phone : "@" + Account.username + " · " + Account.phone;
                    color: Look.muted;
                    font-size: 14px;
                }
            }
        }

        VerticalLayout {
            spacing: 12px;
            SectionLabel {
                label: @tr("Accounts");
            }
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Avatar {
                        size: 36px;
                        initial: Account.initial;
                        picture: Account.picture;
                        has-picture: Account.has-picture;
                        font-size: 15px;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: Account.name;
                        color: Look.text;
                        font-size: 15px;
                        font-weight: 600;
                    }
                    Text {
                        text: Account.phone;
                        color: Look.faint;
                        font-size: 12px;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 20px;
                        width: current.preferred-width + 16px;
                        border-radius: Look.button-radius;
                        background: Look.soft;
                        current := Text {
                            text: @tr("Current");
                            color: Look.soft-ink;
                            font-size: 12px;
                        }
                    }
                }
            }
            // Several accounts are still to come.
            Link {
                text: @tr("Add account");
                icon: "plus";
                enabled: false;
            }
        }

        Rectangle { vertical-stretch: 1; }

        logout := Link {
            text: @tr("Log out");
            icon: "sign-out";
            color: Look.danger;
            clicked => {
                confirm.show();
            }
        }
    }

    confirm := PopupWindow {
        x: 36px;
        y: root.height - 40px - 170px;
        width: 360px;
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            border-radius: Look.radius;
            background: Look.bg;
            border-width: 1px;
            border-color: Look.line-strong;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: #00000040;
            VerticalLayout {
                padding: 20px;
                spacing: 14px;
                Text {
                    text: @tr("Log out of this account?");
                    color: Look.text;
                    font-size: 16px;
                    font-weight: 600;
                }
                Paragraph {
                    text: @tr("FinchGram forgets this account on this Mac. Your chats stay on Telegram; sign in again to see them.");
                    color: Look.muted;
                    font-size: 14px;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    Rectangle {
                        height: 34px;
                        width: cancel.preferred-width + 28px;
                        border-radius: Look.button-radius;
                        background: cancel-touch.has-hover ? Look.sel : Look.side;
                        cancel := Text {
                            text: @tr("Cancel");
                            color: Look.text;
                            font-size: 14px;
                            font-weight: 600;
                        }
                        cancel-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                confirm.close();
                            }
                        }
                    }
                    Rectangle {
                        height: 34px;
                        width: yes.preferred-width + 28px;
                        border-radius: Look.button-radius;
                        background: Look.danger;
                        yes := Text {
                            text: @tr("Log out");
                            color: #ffffff;
                            font-size: 14px;
                            font-weight: 600;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                confirm.close();
                                Account.log-out();
                            }
                        }
                    }
                }
            }
        }
    }
}

// Several lines of text in a field.
component BioField inherits Rectangle {
    in-out property <string> text <=> input.text;
    height: max(88px, input.preferred-height + 24px);
    border-radius: Look.radius;
    background: Look.field;
    border-width: Look.field-border;
    border-color: Look.line;

    input := TextInput {
        x: 14px;
        y: 12px;
        width: parent.width - 28px;
        single-line: false;
        wrap: word-wrap;
        color: Look.text;
        font-size: 16px;
        line-height-factor: Look.leading(1.5);
        selection-background-color: Look.input-sel;
        selection-foreground-color: Look.text;
        text-cursor-width: Look.cursor-width;
        edited => {
            Account.saved = false;
        }
    }
}

component Editor {
    property <string> first-name: Account.first-name;
    property <string> last-name: Account.last-name;
    property <string> username: Account.username;
    property <string> bio: Account.bio;

    VerticalLayout {
        padding-left: 56px;
        padding-right: 56px;
        padding-top: 40px;
        padding-bottom: 40px;
        alignment: start;
        VerticalLayout {
            max-width: 560px;
            spacing: 22px;
            Heading {
                label: @tr("Edit profile");
            }
            HorizontalLayout {
                spacing: 14px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 6px;
                    Label {
                        text: @tr("First name");
                    }
                    first := Field {
                        text: root.first-name;
                        edited(value) => {
                            root.first-name = value;
                            Account.saved = false;
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 6px;
                    Label {
                        text: @tr("Last name");
                    }
                    Field {
                        text: root.last-name;
                        edited(value) => {
                            root.last-name = value;
                            Account.saved = false;
                        }
                    }
                }
            }
            VerticalLayout {
                spacing: 6px;
                Label {
                    text: @tr("Username");
                }
                Rectangle {
                    height: 44px;
                    border-radius: Look.radius;
                    background: Look.field;
                    border-width: Look.field-border;
                    border-color: Look.line;
                    HorizontalLayout {
                        padding-left: 14px;
                        spacing: 2px;
                        Text {
                            text: "@";
                            color: Look.faint;
                            font-size: 16px;
                            vertical-alignment: center;
                        }
                        Field {
                            horizontal-stretch: 1;
                            height: 42px;
                            padding-x: 0px;
                            fill: transparent;
                            ring-width: 0px;
                            text: root.username;
                            edited(value) => {
                                root.username = value;
                                Account.saved = false;
                            }
                        }
                    }
                }
                Text {
                    text: root.username == "" ? @tr("Without a username, people find you by your phone number.") : "t.me/" + root.username;
                    color: Look.faint;
                    font-size: 12px;
                }
            }
            VerticalLayout {
                spacing: 6px;
                Label {
                    text: @tr("Bio");
                }
                bio := BioField {
                    text: root.bio;
                }
                Text {
                    text: bio.text.character-count + "/70";
                    color: bio.text.character-count > 70 ? Look.danger : Look.faint;
                    font-size: 12px;
                }
            }
            VerticalLayout {
                spacing: 6px;
                Label {
                    text: @tr("Phone number");
                }
                Text {
                    text: Account.phone;
                    color: Look.text;
                    font-size: 16px;
                }
            }
            if Account.save-error != "": Paragraph {
                text: Account.save-error;
                color: Look.danger;
                font-size: 14px;
            }
            HorizontalLayout {
                alignment: start;
                padding-top: 6px;
                Rectangle {
                    height: 42px;
                    width: save.preferred-width;
                    border-radius: Look.button-radius;
                    background: save-touch.has-hover && !Account.saving ? Look.accent.darker(0.1) : Look.accent;
                    opacity: Account.saving ? 0.6 : 1;
                    save := HorizontalLayout {
                        padding-left: 22px;
                        padding-right: 22px;
                        spacing: 8px;
                        if Account.saving: VerticalLayout {
                            alignment: center;
                            Spinner {
                                size: 15px;
                                color: Look.on-accent;
                            }
                        }
                        if Account.saved && !Account.saving: VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "check";
                                size: 15px;
                                color: Look.on-accent;
                            }
                        }
                        Text {
                            text: @tr("Save") + Look.enter-hint;
                            color: Look.on-accent;
                            font-size: 15px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    save-touch := TouchArea {
                        enabled: !Account.saving;
                        mouse-cursor: pointer;
                        clicked => {
                            Account.save(root.first-name, root.last-name, root.username, bio.text);
                        }
                    }
                }
            }
        }
    }
}

export component ProfilePage inherits PageFrame {
    title: @tr("Profile");

    SideColumn {
        Summary {
            width: parent.width;
            height: parent.height;
        }
    }

    Flickable {
        horizontal-stretch: 1;
        mouse-drag-pan-enabled: false;
        content-height: max(self.height, editor.preferred-height);
        editor := Editor {
            width: parent.width;
        }
    }
}
