// Downloads, from the design's third round of the shared pages ("FinchGram Desktop 下载"), the
// protocols of the seventh, the SSH keys of the eighth and the changes of the ninth: the servers
// on the left, the folder being looked at in the middle, the queue of transfers on the right,
// which hides. One page for the three themes, in Look's colours and shapes; Rust fills the
// Downloads global (src/downloads/).
import { AppState, Page } from "../state.slint";
import { Downloads, ServerRow, ServerStatus, Problem, FolderState, FolderEntry, TransferRow, TransferState, TestState, FormError, ChangesSaid, RenameError, DialogItem, MoveFolder } from "../downloads.slint";
import { Look } from "../look.slint";
import { Icon, Spinner, Field, PrimaryButton, Heading, Paragraph, Link, Logo, Switch } from "../widgets.slint";
import { PageFrame } from "frame.slint";
import { SmallButton, Chip } from "rows.slint";
import { KeyScope } from "../chat.slint";

// How the page words a server's state, a problem and a download's progress.
export global DownloadWords {
    public pure function status(status: ServerStatus) -> string {
        if status == ServerStatus.connected { return @tr("Connected"); }
        if status == ServerStatus.checking { return @tr("Checking…"); }
        if status == ServerStatus.password-rejected { return @tr("Password rejected"); }
        if status == ServerStatus.not-reachable { return @tr("Not reachable"); }
        if status == ServerStatus.key-unchecked { return @tr("Key not checked"); }
        if status == ServerStatus.key-changed { return @tr("Key changed"); }
        return "";
    }

    // Why a folder could not be read, as a sentence of its own.
    public pure function problem(problem: Problem, detail: string) -> string {
        if problem == Problem.password { return @tr("The server refused the password (401)"); }
        if problem == Problem.forbidden { return @tr("The server refused access (403)"); }
        if problem == Problem.unreachable { return @tr("Cannot reach {0}", detail); }
        if problem == Problem.http { return @tr("The server answered HTTP {0}", detail); }
        if problem == Problem.unreadable { return @tr("The server did not answer with a WebDAV listing"); }
        if problem == Problem.connection { return @tr("The connection was lost"); }
        if problem == Problem.disk { return @tr("The file could not be written"); }
        if problem == Problem.missing { return @tr("The server has no such file or folder"); }
        if problem == Problem.key-unchecked { return @tr("Not connected: you didn’t trust the server’s key. Your password wasn’t sent."); }
        if problem == Problem.key-changed { return @tr("Not connected. This server’s key has changed."); }
        return "";
    }

    // Why a download stopped, within "Stopped: …".
    public pure function reason(problem: Problem, detail: string) -> string {
        if problem == Problem.password { return @tr("the server refused the password (401)"); }
        if problem == Problem.forbidden { return @tr("the server refused access (403)"); }
        if problem == Problem.http { return @tr("the server answered HTTP {0}", detail); }
        if problem == Problem.unreadable { return @tr("the server did not answer with the file"); }
        if problem == Problem.disk { return @tr("the file could not be written"); }
        if problem == Problem.missing { return @tr("the server has no such file"); }
        if problem == Problem.key-changed { return @tr("the server’s key changed"); }
        return @tr("the server closed the connection");
    }

    public pure function transfer(row: TransferRow) -> string {
        if row.upload { return upload(row); }
        if row.state == TransferState.waiting { return @tr("Waiting · {0}", row.total); }
        if row.state == TransferState.done { return @tr("Done · {0}", row.total); }
        if row.state == TransferState.stopped && row.problem == Problem.key-unchecked { return @tr("Paused until you check the server’s key. {0} of {1} kept.", row.done, row.total); }
        if row.state == TransferState.stopped { return @tr("Stopped: {0}. {1} of {2} kept.", reason(row.problem, row.detail), row.done, row.total); }
        if row.waiting != 0 { return @tr("Server busy (HTTP {0}), trying again…", row.waiting); }
        if row.speed == "" { return @tr("{0} of {1}", row.done, row.total); }
        return @tr("{0} of {1} · {2} · {3}", row.done, row.total, row.speed, left(row.seconds-left, row.minutes-left));
    }

    public pure function left(seconds: int, minutes: int) -> string {
        if seconds < 0 { return @tr("estimating…"); }
        if seconds < 60 { return @tr("{0} s left", seconds); }
        return @tr("{0} min left", minutes);
    }

    // An upload's row (the ninth round): where it goes and how far it is; refused in the server's
    // own words; stopped otherwise, and a retry starts over, since no upload goes on where it was.
    public pure function upload(row: TransferRow) -> string {
        if row.state == TransferState.waiting { return @tr("Waiting · to {0} · {1}", row.dest, row.total); }
        if row.state == TransferState.done { return @tr("Uploaded to {0} · {1}", row.dest, row.total); }
        if row.state == TransferState.stopped && refused(row.problem) { return @tr("The server refused the upload ({0}).", row.detail); }
        if row.state == TransferState.stopped { return @tr("Stopped: {0}. Retry starts over.", reason(row.problem, row.detail)); }
        if row.speed == "" { return @tr("To {0} · {1} of {2}", row.dest, row.done, row.total); }
        return @tr("To {0} · {1} of {2} · {3} · {4}", row.dest, row.done, row.total, row.speed, left(row.seconds-left, row.minutes-left));
    }

    // Whether the server itself said no (else it could not be reached, or the like).
    public pure function refused(problem: Problem) -> bool {
        return problem == Problem.forbidden || problem == Problem.http || problem == Problem.missing || problem == Problem.password;
    }

    // What a change was about, within "The server refused to …".
    public pure function change-what(op: string, name: string, count: int) -> string {
        if op == "delete" && count > 1 { return @tr("delete {0} items", count); }
        if op == "delete" { return @tr("delete “{0}”", name); }
        if op == "move" && count > 1 { return @tr("move {0} items", count); }
        if op == "move" { return @tr("move “{0}”", name); }
        if op == "rename" { return @tr("rename “{0}”", name); }
        return @tr("create the folder “{0}”", name);
    }

    // A change the server did not make: its refusal in its own words, or what went wrong.
    public pure function change-failed() -> string {
        if Downloads.change-refused {
            return @tr("The server refused to {0} ({1}).", change-what(Downloads.change-failed, Downloads.change-name, Downloads.change-count), Downloads.change-detail);
        }
        return @tr("Couldn’t {0}: {1}", change-what(Downloads.change-failed, Downloads.change-name, Downloads.change-count), problem(Downloads.change-problem, Downloads.change-detail));
    }

    // What was just done, at the foot of the page for a moment.
    public pure function toast() -> string {
        if Downloads.toast == "deleted" && Downloads.toast-count > 1 { return @tr("Deleted {0} items", Downloads.toast-count); }
        if Downloads.toast == "deleted" { return @tr("Deleted “{0}”", Downloads.toast-name); }
        if Downloads.toast == "moved" && Downloads.toast-count > 1 { return @tr("Moved {0} items to {1}", Downloads.toast-count, Downloads.toast-dest); }
        if Downloads.toast == "moved" { return @tr("Moved “{0}” to {1}", Downloads.toast-name, Downloads.toast-dest); }
        if Downloads.toast == "nothing-moved" { return @tr("Nothing was moved"); }
        if Downloads.toast == "read-only" { return @tr("The server doesn’t allow changes."); }
        return "";
    }

    // What Test connection learnt about changes.
    public pure function changes-said(said: ChangesSaid) -> string {
        if said == ChangesSaid.allowed { return @tr("Changes: allowed by the server."); }
        if said == ChangesSaid.read-only { return @tr("Changes: the server only allows reading."); }
        return @tr("Changes: the server didn’t say. You’ll know when you try.");
    }

    // What is wrong with a name typed for an entry or a new folder.
    public pure function name-error(error: RenameError, name: string) -> string {
        if error == RenameError.taken { return @tr("There’s already “{0}” here.", name); }
        if error == RenameError.slash { return @tr("Names can’t contain “/”."); }
        return "";
    }

    // Beside an item of the Delete dialog: a file's size, or what a folder holds.
    public pure function item-meta(item: DialogItem) -> string {
        if item.icon != "folder" { return item.size; }
        if item.count < 0 { return @tr("Folder"); }
        if item.count == 0 { return @tr("Empty folder"); }
        return @tr("Folder · {0} items inside", item.count);
    }

    // What Test connection found.
    public pure function test-result() -> string {
        if Downloads.test-state == TestState.failed {
            return problem(Downloads.test-problem, Downloads.test-detail);
        }
        if !Downloads.test-probed {
            return @tr("Reached: {0} folders and {1} files at the root.", Downloads.test-folders, Downloads.test-files);
        }
        if Downloads.test-ranges {
            return @tr("Reached: {0} folders and {1} files at the root. Ranges supported, so downloads can use several connections.", Downloads.test-folders, Downloads.test-files);
        }
        return @tr("Reached: {0} folders and {1} files at the root. No ranges, so each file comes over one connection.", Downloads.test-folders, Downloads.test-files);
    }

    public pure function form-error(error: FormError) -> string {
        if error == FormError.name { return @tr("Give the server a name."); }
        if error == FormError.address { return @tr("The address needs to start with http:// or https://."); }
        if error == FormError.host { return @tr("Give the server's host name or IP."); }
        if error == FormError.port { return @tr("The port needs to be a number from 1 to 65535."); }
        return "";
    }

    // The protocols a server can speak (the seventh round): their names, their default ports, the
    // address field's words for each. Only WebDAV works in this version.
    public pure function protocol-name(id: string) -> string {
        if id == "ftp" { return "FTP"; }
        if id == "ftps" { return "FTPS"; }
        if id == "sftp" { return "SFTP"; }
        return "WebDAV";
    }

    public pure function protocol-port(id: string, address: string) -> string {
        if id == "ftp" { return "21"; }
        if id == "ftps" { return "990"; }
        if id == "sftp" { return "22"; }
        return address.to-lowercase().starts-with("http://") ? "80" : "443";
    }

    public pure function address-placeholder(id: string) -> string {
        if id == "ftp" { return "ftp.example.net"; }
        if id == "ftps" { return "ftps.example.net"; }
        if id == "sftp" { return "sb-ams.example.net"; }
        return "https://nas.home:5006/";
    }

    public pure function address-hint(id: string, address: string) -> string {
        if id == "ftp" { return @tr("Host name or IP. A folder may follow after a /.") + " " + default-port(id, address); }
        if id == "ftps" { return @tr("Host name or IP. Implicit TLS on the default port.") + " " + default-port(id, address); }
        if id == "sftp" { return @tr("Host name or IP of the SSH server.") + " " + default-port(id, address); }
        return @tr("http:// or https://. A folder may be part of the address.") + " " + default-port(id, address);
    }

    public pure function default-port(id: string, address: string) -> string {
        return @tr("Default port {}.", protocol-port(id, address));
    }
}

// A 20 px box with a tick, or "[x]" / "[ ]" / "[-]" in Terminal.
component CheckBox {
    in property <bool> on;
    in property <bool> some;        // a few of them, not all
    width: Look.terminal ? 28px : 20px;
    height: 20px;

    if !Look.terminal: Rectangle {
        width: 20px;
        height: 20px;
        border-radius: Look.button-radius;
        background: root.on || root.some ? Look.accent : transparent;
        border-width: root.on || root.some ? 0px : 1.5px;
        border-color: Look.faint;
        if root.on || root.some: Icon {
            name: root.some && !root.on ? "minus" : "check";
            size: 14px;
            color: Look.on-accent;
            duotone: false;
        }
    }
    if Look.terminal: Text {
        text: root.on ? "[x]" : root.some ? "[-]" : "[ ]";
        color: root.on || root.some ? Look.accent : Look.faint;
        font-family: Look.mono;
        font-size: 14px;
        vertical-alignment: center;
        height: parent.height;
    }
}

// An icon, between brackets in Terminal.
component ToolIcon {
    in property <string> name;
    in property <length> size: 18px;
    in property <color> color: Look.muted;

    HorizontalLayout {
        alignment: center;
        if Look.terminal: Text {
            text: "[";
            color: root.color;
            font-family: Look.mono;
            font-size: 13px;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.name;
                size: root.size;
                color: root.color;
            }
        }
        if Look.terminal: Text {
            text: "]";
            color: root.color;
            font-family: Look.mono;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
}

// A 32 px button with an icon: refresh.
component ToolButton inherits Rectangle {
    in property <string> icon;
    callback clicked();
    width: max(32px, inner.preferred-width + 8px);
    height: 32px;
    border-radius: Look.button-radius;
    background: touch.has-hover ? Look.sel : transparent;

    inner := ToolIcon {
        width: parent.width;
        height: parent.height;
        name: root.icon;
        size: 18px;
        color: Look.muted;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A small word button: "Show in Finder", "Retry" and "Clear finished" in the queue.
component TinyButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 26px;
    width: label.preferred-width + 20px;
    border-radius: Look.button-radius;
    background: touch.has-hover ? Look.sel : Look.bg;
    border-width: 1px;
    border-color: Look.line-strong;

    label := Text {
        text: root.text;
        color: Look.text;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A server in the left column: its name, its host and whether it answers.
component ServerItem inherits Rectangle {
    in property <ServerRow> server;
    in property <int> index;
    in property <bool> active;
    callback menu(length, length);
    property <color> ink: active && !Look.broadsheet ? Look.accent-ink : Look.text;
    height: content.preferred-height;
    border-radius: Look.radius;
    background: active || touch.has-hover ? Look.sel : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Downloads.select-server(root.index);
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    content := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 12px;
        VerticalLayout {
            alignment: start;
            padding-top: 1px;
            Icon {
                name: "hard-drives";
                size: 19px;
                color: root.ink;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            alignment: start;
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Text {
                    text: root.server.name;
                    color: root.ink;
                    font-size: 14px;
                    font-weight: root.active ? 600 : 400;
                    overflow: elide;
                }
                // What it speaks, as a small badge.
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 16px;
                        width: badge.preferred-width + 10px;
                        border-radius: Look.button-radius;
                        border-width: 1px;
                        border-color: Look.line-strong;
                        badge := Text {
                            width: parent.width;
                            height: parent.height;
                            text: root.server.protocol;
                            color: Look.muted;
                            font-family: Look.mono;
                            font-size: 10px;
                            font-weight: 500;
                            letter-spacing: 0.3px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 5px;
                alignment: start;
                Text {
                    text: root.server.host + " ·";
                    color: Look.faint;
                    font-size: 12px;
                    line-height-factor: Look.leading(1.45);
                    overflow: elide;
                }
                if root.server.status == ServerStatus.checking: VerticalLayout {
                    alignment: center;
                    Spinner {
                        size: 11px;
                        color: Look.faint;
                    }
                }
                Text {
                    text: DownloadWords.status(root.server.status);
                    color: root.server.status == ServerStatus.password-rejected || root.server.status == ServerStatus.key-changed ? Look.danger : Look.faint;
                    font-size: 12px;
                    line-height-factor: Look.leading(1.45);
                }
            }
        }
    }
}

// The last row of the left column: a new server.
component AddServerRow inherits Rectangle {
    property <bool> active: Downloads.form-open && !Downloads.form-editing;
    property <color> ink: active ? (Look.broadsheet ? Look.text : Look.accent-ink) : Look.muted;
    height: content.preferred-height;
    border-radius: Look.radius;
    background: active || touch.has-hover ? Look.sel : transparent;

    content := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: "plus";
                size: 19px;
                color: root.ink;
            }
        }
        Text {
            text: @tr("Add server");
            color: root.ink;
            font-size: 14px;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Downloads.add-server();
        }
    }
}

// The box that narrows the folder's listing to the names matching what is typed.
component FilterBox inherits Rectangle {
    width: 200px;
    height: 32px;
    border-radius: Look.radius;
    background: Look.field;
    border-width: Look.field-border;
    border-color: Look.line;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: "magnifying-glass";
                size: 15px;
                color: Look.faint;
                duotone: false;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            Text {
                visible: input.text == "";
                text: @tr("Filter this folder");
                color: Look.faint;
                font-size: 14px;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
                overflow: elide;
            }
            input := TextInput {
                width: parent.width;
                height: parent.height;
                text <=> Downloads.filter;
                single-line: true;
                color: Look.text;
                font-size: 14px;
                vertical-alignment: center;
                selection-background-color: Look.input-sel;
                selection-foreground-color: Look.text;
                text-cursor-width: Look.cursor-width;
                edited => {
                    Downloads.set-filter(self.text);
                }
            }
        }
    }
}

// The button that shows or hides the queue: "Transfers", with how many are on their way.
component QueueButton inherits Rectangle {
    property <bool> shown: Downloads.queue-open && Downloads.queue.length > 0;
    property <bool> usable: Downloads.queue.length > 0;
    property <color> ink: shown ? (Look.broadsheet ? Look.text : Look.accent-ink) : Look.text;
    height: 32px;
    width: content.preferred-width;
    border-radius: Look.button-radius;
    background: shown ? Look.sel : Look.bg;
    border-width: shown ? 0px : 1px;
    border-color: Look.line-strong;
    opacity: usable ? 1 : 0.5;

    content := HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 7px;
        if Look.terminal: Text {
            text: "[";
            color: root.ink;
            font-family: Look.mono;
            font-size: 13px;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Icon {
                name: "arrows-down-up";
                size: 17px;
                color: root.ink;
            }
        }
        Text {
            text: @tr("Transfers");
            color: root.ink;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }
        if Downloads.active-count > 0: VerticalLayout {
            alignment: center;
            Rectangle {
                height: 18px;
                width: max(18px, count.preferred-width + 10px);
                border-radius: 9px;
                background: Look.accent;
                count := Text {
                    text: "" + Downloads.active-count;
                    color: Look.on-accent;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.shown ? "caret-right" : "caret-left";
                size: 13px;
                color: root.ink;
                opacity: 0.7;
                duotone: false;
            }
        }
        if Look.terminal: Text {
            text: "]";
            color: root.ink;
            font-family: Look.mono;
            font-size: 13px;
            vertical-alignment: center;
        }
    }

    TouchArea {
        enabled: root.usable;
        mouse-cursor: pointer;
        clicked => {
            Downloads.toggle-queue();
        }
    }
}

// The toolbar's Upload (the ninth round), beside Transfers while the server takes changes;
// greyed when the server said it only reads. Terminal keeps the icon between its brackets.
component UploadButton inherits Rectangle {
    property <bool> usable: !Downloads.server-read-only;
    height: 32px;
    width: content.preferred-width;
    border-radius: Look.button-radius;
    background: touch.has-hover && usable ? Look.sel : Look.bg;
    border-width: 1px;
    border-color: Look.line-strong;
    opacity: usable ? 1 : 0.42;

    content := HorizontalLayout {
        padding-left: 10px;
        padding-right: Look.terminal ? 10px : 12px;
        spacing: 7px;
        if Look.terminal: Text {
            text: "[";
            color: Look.text;
            font-family: Look.mono;
            font-size: 13px;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Icon {
                name: "upload-simple";
                size: 17px;
                color: Look.text;
            }
        }
        if !Look.terminal: Text {
            text: @tr("Upload");
            color: Look.text;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }
        if Look.terminal: Text {
            text: "]";
            color: Look.text;
            font-family: Look.mono;
            font-size: 13px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.usable;
        mouse-cursor: pointer;
        clicked => {
            Downloads.upload();
        }
    }
}

// Move… and Delete at the foot of the listing, beside Clear and Download: an icon and a word,
// greyed when the server said it only reads.
component FootAction inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <color> ink: Look.text;
    callback clicked();
    property <bool> usable: !Downloads.server-read-only;
    height: 32px;
    width: content.preferred-width;
    border-radius: Look.button-radius;
    background: touch.has-hover && usable ? Look.bg : transparent;
    opacity: usable ? 1 : 0.42;

    content := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                size: 16px;
                color: root.ink;
            }
        }
        Text {
            text: root.text;
            color: root.ink;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.usable;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// The drop box over the folder while files are dragged over the window and the server takes
// changes: where they will go; or that the server said it only reads. (The design's border is
// dashed; Slint draws a solid one.)
component DropBox inherits Rectangle {
    property <bool> allowed: !Downloads.server-read-only;
    border-radius: Look.radius;
    border-width: 2px;
    border-color: allowed ? Look.accent : Look.line-strong;
    background: allowed ? Look.soft : Look.side;

    VerticalLayout {
        alignment: center;
        spacing: 8px;
        padding: 24px;
        HorizontalLayout {
            alignment: center;
            Icon {
                name: root.allowed ? "upload-simple" : "prohibit";
                size: 34px;
                color: root.allowed ? Look.accent : Look.line-strong;
            }
        }
        Paragraph {
            text: root.allowed ? @tr("Drop to upload to {0}", Downloads.title) : @tr("The server doesn’t allow changes");
            color: root.allowed ? Look.soft-ink : Look.text;
            font-size: 17px;
            font-weight: 600;
            horizontal-alignment: center;
        }
        Paragraph {
            text: root.allowed ? Downloads.path-label : @tr("{0} only allows reading.", Downloads.crumbs[0]);
            color: root.allowed ? Look.soft-ink : Look.muted;
            font-size: 13px;
            horizontal-alignment: center;
        }
    }
}

// The heading of a column of the listing: "NAME", "name".
component ColumnLabel inherits Text {
    in property <string> label;
    text: Look.workbench ? label.to-uppercase() : Look.terminal ? label.to-lowercase() : label;
    font-size: Look.section-size;
    font-weight: Look.section-weight;
    letter-spacing: AppState.language == "ar" ? 0px : Look.section-spacing;
    color: Look.faint;
    vertical-alignment: center;
}

// A folder or a file of the listing; its name becomes a field while it is renamed in place.
component EntryRow inherits Rectangle {
    in property <FolderEntry> entry;
    callback menu(length, length);
    property <bool> renaming: Downloads.renaming != "" && Downloads.renaming == entry.name;
    height: content.preferred-height;
    background: entry.selected || touch.has-hover ? Look.sel : transparent;

    Rectangle {
        y: 0;
        height: 1px;
        width: parent.width;
        background: Look.line;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if root.entry.folder {
                Downloads.open-folder(root.entry.name);
            } else {
                Downloads.toggle(root.entry.name);
            }
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    content := HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: root.renaming ? 6px : 11px;
        padding-bottom: root.renaming ? 6px : 11px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: Look.terminal ? 28px : 20px;
                height: 20px;
                if root.entry.folder: Icon {
                    x: (parent.width - self.width) / 2;
                    y: 3px;
                    name: "caret-right";
                    size: 14px;
                    color: Look.faint;
                    duotone: false;
                }
                if !root.entry.folder: CheckBox {
                    on: root.entry.selected;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.entry.icon;
                size: 20px;
                color: Look.accent;
            }
        }
        if !root.renaming: Text {
            horizontal-stretch: 1;
            text: root.entry.name;
            color: Look.text;
            font-size: 14px;
            font-weight: root.entry.folder ? 500 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
        // The name typed in place (the ninth round): all of it but the extension chosen first,
        // ⏎ keeps it, Esc lets it go; a name taken here, or with a "/", is said under it.
        if root.renaming: VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;
            alignment: center;
            FocusScope {
                height: 30px;
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        Downloads.cancel-rename();
                        return accept;
                    }
                    return reject;
                }
                Field {
                    width: parent.width;
                    height: 30px;
                    text <=> Downloads.rename-text;
                    font-size: 14px;
                    padding-x: 8px;
                    border-radius: Look.button-radius;
                    fill: Look.bg;
                    ring: Look.accent;
                    ring-width: 1.5px;
                    error: Downloads.rename-error != RenameError.none;
                    init => {
                        self.focus-text();
                        self.select-range(0, Downloads.rename-stem);
                    }
                    accepted => {
                        Downloads.commit-rename(false);
                    }
                    edited => {
                        Downloads.rename-error = RenameError.none;
                    }
                }
            }
            if Downloads.rename-error != RenameError.none: Text {
                text: DownloadWords.name-error(Downloads.rename-error, Downloads.rename-text);
                color: Look.danger;
                font-size: 12px;
            }
        }
        Text {
            width: 96px;
            text: root.entry.date;
            color: Look.muted;
            font-size: 13px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Text {
            width: 84px;
            text: root.entry.folder ? "—" : root.entry.size;
            color: Look.muted;
            font-size: 13px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

// A transfer in the queue, down or up: on its way, waiting, done or stopped.
component TransferItem inherits Rectangle {
    in property <TransferRow> item;
    callback menu(length, length);
    property <bool> live: item.state == TransferState.active || item.state == TransferState.waiting;
    // Paused for the server's key to be checked (the eighth round): Check key instead of Retry.
    property <bool> key-stopped: item.state == TransferState.stopped && (item.problem == Problem.key-unchecked || item.problem == Problem.key-changed);
    // Downloads in the accent, uploads in their own colour (the ninth round), the arrow on the
    // icon saying which way.
    property <color> way: item.upload ? Look.up : Look.accent;
    height: content.preferred-height;
    border-radius: Look.radius;
    background: touch.has-hover ? Look.sel : transparent;

    touch := TouchArea {
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    content := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: start;
            padding-top: 1px;
            Rectangle {
                width: 20px;
                height: 22px;
                Icon {
                    x: 0;
                    y: 0;
                    name: root.item.icon;
                    size: 20px;
                    color: root.way;
                }
                Rectangle {
                    x: parent.width - 8px;
                    y: parent.height - 13px;
                    width: 14px;
                    height: 14px;
                    border-radius: 7px;
                    background: root.way;
                    border-width: 2px;
                    border-color: Look.side;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.item.upload ? "↑" : "↓";
                        color: Look.bg;
                        font-size: 9px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 5px;
            alignment: start;
            Text {
                text: root.item.name;
                color: Look.text;
                font-size: 13px;
                font-weight: 500;
                overflow: elide;
            }
            if root.item.state == TransferState.active: Rectangle {
                height: 4px;
                border-radius: 2px;
                background: Look.off;
                Rectangle {
                    x: 0;
                    width: parent.width * root.item.fraction;
                    height: parent.height;
                    border-radius: 2px;
                    background: root.way;
                }
            }
            Paragraph {
                text: DownloadWords.transfer(root.item);
                color: root.item.state == TransferState.stopped ? (root.item.problem == Problem.key-unchecked ? Look.accent-ink : Look.danger) : Look.muted;
                font-size: 12px;
                line-height-factor: Look.leading(1.45);
            }
        }
        if root.live || root.key-stopped: VerticalLayout {
            alignment: start;
            Rectangle {
                width: max(24px, cross.preferred-width + 4px);
                height: 24px;
                border-radius: Look.button-radius;
                cross := ToolIcon {
                    width: parent.width;
                    height: parent.height;
                    name: "x";
                    size: 15px;
                    color: cancel.has-hover ? Look.text : Look.muted;
                }
                cancel := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if root.key-stopped {
                            Downloads.remove-transfer(root.item.id);
                        } else {
                            Downloads.cancel(root.item.id);
                        }
                    }
                }
            }
        }
        if root.item.state == TransferState.done && !root.item.upload: VerticalLayout {
            alignment: start;
            TinyButton {
                text: @tr("Show in Finder");
                clicked => {
                    Downloads.show-in-finder(root.item.id);
                }
            }
        }
        // An upload that is done: Show goes to its folder on the server, the file chosen.
        if root.item.state == TransferState.done && root.item.upload: VerticalLayout {
            alignment: start;
            TinyButton {
                text: @tr("Show");
                clicked => {
                    Downloads.show-upload(root.item.id);
                }
            }
        }
        if root.item.state == TransferState.stopped && !root.key-stopped: VerticalLayout {
            alignment: start;
            TinyButton {
                text: @tr("Retry");
                clicked => {
                    Downloads.retry(root.item.id);
                }
            }
        }
        if root.key-stopped: VerticalLayout {
            alignment: start;
            TinyButton {
                text: @tr("Check key");
                clicked => {
                    Downloads.check-key-transfer(root.item.id);
                }
            }
        }
    }
}

// One entry of a context menu.
component MenuEntry inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> danger;
    callback chosen();
    height: 34px;
    border-radius: Look.button-radius;
    background: touch.has-hover && enabled ? Look.sel : transparent;
    opacity: enabled ? 1 : 0.4;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                size: 17px;
                color: root.danger ? Look.danger : Look.text;
            }
        }
        Text {
            text: root.label;
            color: root.danger ? Look.danger : Look.text;
            font-size: 14px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.chosen();
        }
    }
}

// A field of the form: its label above, a hint below.
component FormField {
    in property <string> label;
    in property <string> hint;
    in property <string> placeholder;
    in-out property <string> text;
    in property <InputType> input-type: InputType.text;
    callback accepted();

    VerticalLayout {
        spacing: 6px;
        Text {
            text: root.label;
            color: Look.muted;
            font-size: 13px;
        }
        Field {
            text <=> root.text;
            placeholder: root.placeholder;
            input-type: root.input-type;
            accepted => {
                root.accepted();
            }
        }
        if root.hint != "": Paragraph {
            text: root.hint;
            color: Look.faint;
            font-size: 12px;
        }
    }
}

// The answers of the dialogs: the safe one is filled; an unsafe one (Trust new key, Replace) is
// an outline in the danger colour; Delete, which the dialog is for, is filled in it. One that
// cannot be taken now (Move here, in the folder the items are in) is faded.
component AnswerButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> danger-filled;
    in property <bool> enabled: true;
    callback clicked();
    height: 38px;
    width: label.preferred-width + 36px;
    border-radius: Look.button-radius;
    background: danger-filled ? (touch.has-hover ? Look.danger.mix(Look.text, 0.88) : Look.danger)
        : primary ? (touch.has-hover ? Look.accent.mix(Look.text, 0.88) : Look.accent)
        : touch.has-hover ? Look.sel : danger ? transparent : Look.field;
    border-width: primary || danger-filled ? 0px : 1px;
    border-color: danger ? Look.danger : Look.line-strong;
    opacity: enabled ? 1 : 0.45;

    label := Text {
        text: root.text;
        color: root.primary ? Look.on-accent : root.danger-filled ? Look.bg : root.danger ? Look.danger : Look.text;
        font-size: 15px;
        font-weight: 600;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A key's fingerprint in the dialog, with what it is and a Copy link: the one shown now, or the
// one trusted before; the new one, when the key changed, is outlined in the danger colour.
component FingerprintBox inherits VerticalLayout {
    in property <string> label;
    in property <string> fingerprint;
    in property <bool> warn;
    in property <string> which;             // "new" or "old": what Copy copies (Downloads.key-copied)
    spacing: 6px;
    HorizontalLayout {
        spacing: 8px;
        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: root.warn ? Look.danger : Look.muted;
            font-size: 13px;
            overflow: elide;
            vertical-alignment: center;
        }
        Link {
            text: Downloads.key-copied == root.which ? @tr("Copied") : @tr("Copy");
            font-size: 13px;
            font-weight: 500;
            clicked => {
                Downloads.copy-fingerprint(root.which);
            }
        }
    }
    Rectangle {
        border-radius: Look.radius;
        background: Look.side;
        border-width: root.warn ? 1.5px : Look.field-border;
        border-color: root.warn ? Look.danger : Look.line;
        VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 10px;
            padding-bottom: 10px;
            Paragraph {
                text: root.fingerprint;
                color: Look.text;
                font-family: Look.mono;
                font-size: 13px;
                line-height-factor: Look.leading(1.5);
                wrap: char-wrap;
            }
        }
    }
}

// An SFTP server's key, to trust or not (the design's eighth round): FinchGram and the server,
// the question, the key's fingerprint (and the one trusted before, when it changed), a word on
// what has been sent (nothing), and the two answers, the safe one filled. ⏎ is the filled one,
// Esc the other; the page behind is dimmed and keeps its clicks. It follows the AI access dialog.
component KeyDialog inherits Rectangle {
    property <bool> changed: Downloads.key-ask-changed;
    background: #00000059;

    // Clicks on the backdrop stay there.
    TouchArea { }

    KeyScope {
        enter => {
            if root.changed {
                Downloads.refuse-key();
            } else {
                Downloads.trust-key();
            }
        }
        escape => {
            Downloads.refuse-key();
        }
    }

    box := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(480px, parent.width - 48px);
        height: body.preferred-height;
        border-radius: Look.dialog-radius;
        background: Look.bg;
        border-width: 1px;
        border-color: Look.line-strong;
        drop-shadow-blur: 80px;
        drop-shadow-offset-y: 30px;
        drop-shadow-color: #00000057;

        TouchArea { }

        body := VerticalLayout {
            padding-left: 26px;
            padding-right: 26px;
            padding-top: 26px;
            padding-bottom: 20px;
            spacing: 18px;
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                Logo {
                    size: 44px;
                    radius: Look.logo-radius;
                }
                VerticalLayout {
                    alignment: center;
                    Icon {
                        name: root.changed ? "warning" : "arrows-left-right";
                        size: 18px;
                        color: root.changed ? Look.danger : Look.faint;
                    }
                }
                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: Look.radius;
                    background: root.changed ? transparent : Look.soft;
                    border-width: root.changed ? 1.5px : 0px;
                    border-color: Look.danger;
                    Icon {
                        name: "hard-drives";
                        size: 22px;
                        color: root.changed ? Look.danger : Look.soft-ink;
                    }
                }
            }
            VerticalLayout {
                spacing: 6px;
                Paragraph {
                    text: Look.heading-prefix + (root.changed ? @tr("This server’s key has changed") : @tr("Trust this server’s key?"));
                    color: Look.text;
                    font-size: 18px;
                    font-weight: 600;
                    letter-spacing: Look.heading-tracking * 18px;
                    line-height-factor: Look.leading(1.35);
                }
                Paragraph {
                    text: root.changed ? @tr("It isn’t the server you connected to before, or someone is between you and it.")
                        : @tr("This is the first time you connect to this server. Compare the fingerprint with the one its owner gave you. If you can’t, don’t continue.");
                    color: root.changed ? Look.danger : Look.muted;
                    font-size: 14px;
                    line-height-factor: Look.leading(1.5);
                }
            }
            HorizontalLayout {
                spacing: 12px;
                Text {
                    width: 64px;
                    text: @tr("Server");
                    color: Look.muted;
                    font-size: 14px;
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 1px;
                    alignment: start;
                    Text {
                        text: Downloads.key-ask-name;
                        color: Look.text;
                        font-size: 14px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Paragraph {
                        text: Downloads.key-ask-address;
                        color: Look.muted;
                        font-family: Look.mono;
                        font-size: 13px;
                        wrap: char-wrap;
                    }
                }
            }
            if root.changed: FingerprintBox {
                label: Downloads.key-ask-old-since == "" ? @tr("Trusted earlier · {0}", Downloads.key-ask-old-type)
                    : @tr("Trusted since {0} · {1}", Downloads.key-ask-old-since, Downloads.key-ask-old-type);
                fingerprint: Downloads.key-ask-old-fingerprint;
                which: "old";
            }
            FingerprintBox {
                label: root.changed ? @tr("Shown now · {0}", Downloads.key-ask-type) : @tr("{0} key · SHA256 fingerprint", Downloads.key-ask-type);
                fingerprint: Downloads.key-ask-fingerprint;
                warn: root.changed;
                which: "new";
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                VerticalLayout {
                    alignment: start;
                    padding-top: 1px;
                    Icon {
                        name: root.changed ? "info" : "lock-simple";
                        size: 15px;
                        color: Look.muted;
                    }
                }
                Paragraph {
                    text: root.changed ? @tr("Nothing has been sent. If the owner says the key changed, check the new fingerprint with them first.")
                        : @tr("Your password isn’t sent until you trust the key.");
                    color: Look.muted;
                    font-size: 13px;
                    line-height-factor: Look.leading(1.5);
                }
            }
            VerticalLayout {
                spacing: 8px;
                padding-top: 2px;
                // Terminal says what Esc does, as its other dialogs do.
                if Look.terminal: Text {
                    text: root.changed ? @tr("esc  don’t connect") : @tr("esc  cancel");
                    color: Look.faint;
                    font-family: Look.mono;
                    font-size: 12px;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    if !root.changed: AnswerButton {
                        text: @tr("Cancel");
                        clicked => {
                            Downloads.refuse-key();
                        }
                    }
                    if root.changed: AnswerButton {
                        text: @tr("Trust new key");
                        danger: true;
                        clicked => {
                            Downloads.trust-key();
                        }
                    }
                    AnswerButton {
                        text: (root.changed ? @tr("Don’t connect") : @tr("Trust and continue")) + Look.enter-hint;
                        primary: true;
                        clicked => {
                            if root.changed {
                                Downloads.refuse-key();
                            } else {
                                Downloads.trust-key();
                            }
                        }
                    }
                }
            }
        }
    }
}

// A dialog over the page for a change on the server (the ninth round), built as the key dialog
// is: an icon in a square, the question and a line under it, then what each dialog puts in the
// middle and its answers. The page behind is dimmed and keeps its clicks; Esc is the caller's.
component WriteDialog inherits Rectangle {
    in property <length> box-width: 460px;
    in property <string> icon;
    in property <bool> danger;              // the icon outlined in the danger colour: Delete
    in property <string> title;
    in property <string> description;
    callback enter();
    callback escape();
    background: #00000059;

    TouchArea { }

    KeyScope {
        enter => {
            root.enter();
        }
        escape => {
            root.escape();
        }
    }

    box := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(root.box-width, parent.width - 48px);
        height: body.preferred-height;
        border-radius: Look.dialog-radius;
        background: Look.bg;
        border-width: 1px;
        border-color: Look.line-strong;
        drop-shadow-blur: 80px;
        drop-shadow-offset-y: 30px;
        drop-shadow-color: #00000057;

        TouchArea { }

        body := VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 24px;
            padding-bottom: 20px;
            spacing: 16px;
            HorizontalLayout {
                spacing: 14px;
                VerticalLayout {
                    alignment: start;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: Look.radius;
                        background: root.danger ? transparent : Look.soft;
                        border-width: root.danger ? 1.5px : 0px;
                        border-color: Look.danger;
                        Icon {
                            name: root.icon;
                            size: 20px;
                            color: root.danger ? Look.danger : Look.soft-ink;
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 5px;
                    padding-top: 1px;
                    alignment: start;
                    Paragraph {
                        text: Look.heading-prefix + root.title;
                        color: Look.text;
                        font-size: 18px;
                        font-weight: 600;
                        letter-spacing: Look.heading-tracking * 18px;
                        line-height-factor: Look.leading(1.35);
                    }
                    Paragraph {
                        text: root.description;
                        color: Look.muted;
                        font-size: 14px;
                        line-height-factor: Look.leading(1.5);
                    }
                }
            }
            @children
        }
    }
}

// The items a dialog is about, four at most, with a word beside each: a file's size or what a
// folder holds, or "Already there" in the Same-name dialog.
component ItemList inherits Rectangle {
    in property <[DialogItem]> items;
    in property <int> more;                 // beyond the four shown
    in property <bool> there;               // the Same-name dialog
    height: rows.preferred-height;
    border-radius: Look.radius;
    background: Look.side;
    border-width: Look.field-border;
    border-color: Look.line;

    rows := VerticalLayout {
        padding-top: 4px;
        padding-bottom: 4px;
        for item in root.items: HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 7px;
            padding-bottom: 7px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Icon {
                    name: item.icon;
                    size: 18px;
                    color: Look.muted;
                }
            }
            Text {
                horizontal-stretch: 1;
                text: item.name;
                color: Look.text;
                font-size: 14px;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: root.there ? @tr("Already there") : DownloadWords.item-meta(item);
                color: Look.faint;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
        if root.more > 0: HorizontalLayout {
            padding-left: 40px;
            padding-right: 12px;
            padding-top: 3px;
            padding-bottom: 6px;
            Text {
                text: @tr("and {0} more", root.more);
                color: Look.faint;
                font-size: 13px;
            }
        }
    }
}

// A line of small print in a dialog, with an icon before it.
component NoteLine inherits HorizontalLayout {
    in property <string> icon: "info";
    in property <string> text;
    spacing: 8px;
    VerticalLayout {
        alignment: start;
        padding-top: 1px;
        Icon {
            name: root.icon;
            size: 15px;
            color: Look.muted;
        }
    }
    Paragraph {
        text: root.text;
        color: Look.muted;
        font-size: 13px;
        line-height-factor: Look.leading(1.5);
    }
}

// Terminal says what Esc does under a dialog's middle, as its other dialogs do.
component EscapeHint inherits Text {
    in property <string> hint: @tr("esc  cancel");
    text: hint;
    color: Look.faint;
    font-family: Look.mono;
    font-size: 12px;
}

// A folder of the Move dialog's list: into it on a click; the folder the items are in is marked,
// and a folder that is moving (or under one) cannot take them.
component MoveRow inherits Rectangle {
    in property <MoveFolder> folder;
    height: 32px;
    border-radius: Look.button-radius;
    background: touch.has-hover && !folder.forbidden ? Look.sel : transparent;
    opacity: folder.forbidden ? 0.42 : 1;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: "folder";
                size: 18px;
                color: Look.accent;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.folder.name;
            color: Look.text;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.folder.forbidden ? @tr("Can’t move a folder into itself") : root.folder.current ? @tr("Current folder") : "";
            color: Look.faint;
            font-size: 12px;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Icon {
                name: "caret-right";
                size: 13px;
                color: Look.faint;
                duotone: false;
            }
        }
    }

    touch := TouchArea {
        enabled: !root.folder.forbidden;
        mouse-cursor: pointer;
        clicked => {
            Downloads.move-open-folder(root.folder.name);
        }
    }
}

// Delete: what goes, with a word that there is no trash. ⏎ does nothing here, deleting takes a
// click; Esc cancels.
component DeleteDialog inherits WriteDialog {
    icon: "trash";
    danger: true;
    title: Downloads.delete-count == 1 ? @tr("Delete “{0}”?", Downloads.delete-items[0].name) : @tr("Delete {0} items?", Downloads.delete-count);
    description: @tr("Deleted on {0} itself. There’s no trash, and it can’t be undone.", Downloads.crumbs[0]);
    escape => {
        Downloads.close-dialog();
    }

    ItemList {
        items: Downloads.delete-items;
        more: Downloads.delete-count - 4;
    }
    if Downloads.delete-folders: NoteLine {
        text: @tr("Folders are deleted with everything in them.");
    }
    VerticalLayout {
        spacing: 8px;
        padding-top: 2px;
        if Look.terminal: EscapeHint { }
        HorizontalLayout {
            alignment: end;
            spacing: 10px;
            AnswerButton {
                text: @tr("Cancel");
                clicked => {
                    Downloads.close-dialog();
                }
            }
            AnswerButton {
                text: Downloads.delete-count == 1 ? @tr("Delete") : @tr("Delete {0} items", Downloads.delete-count);
                danger-filled: true;
                clicked => {
                    Downloads.confirm-delete();
                }
            }
        }
    }
}

// Move to…: the server's folders, walked from the one above the items', with the way there as
// crumbs, New folder, and Move here (⏎) once another folder is shown.
component MoveDialog inherits WriteDialog {
    box-width: 540px;
    icon: "arrow-bend-up-right";
    title: Downloads.move-count == 1 ? @tr("Move “{0}” to…", Downloads.move-name) : @tr("Move {0} items to…", Downloads.move-count);
    description: @tr("Within {0} only.", Downloads.crumbs[0]);
    escape => {
        Downloads.close-dialog();
    }
    enter => {
        if Downloads.move-here-allowed && !Downloads.move-creating {
            Downloads.move-here();
        }
    }

    VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            for crumb[index] in Downloads.move-crumbs: HorizontalLayout {
                spacing: 6px;
                if index > 0: Text {
                    text: "›";
                    color: Look.faint;
                    font-size: 14px;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: min(crumb-label.preferred-width, 160px);
                    crumb-label := Text {
                        width: parent.width;
                        height: parent.height;
                        text: crumb;
                        color: crumb-touch.has-hover ? Look.accent-ink : Look.text;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    crumb-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Downloads.move-go-to(index);
                        }
                    }
                }
            }
        }
        Rectangle {
            height: 220px;
            border-radius: Look.radius;
            background: Look.field;
            border-width: 1px;
            border-color: Look.line-strong;
            clip: true;
            Flickable {
                width: parent.width;
                height: parent.height;
                mouse-drag-pan-enabled: false;
                content-height: max(self.height, list.preferred-height);
                list := VerticalLayout {
                    width: parent.width;
                    padding: 4px;
                    alignment: start;
                    if Downloads.move-creating: VerticalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        spacing: 3px;
                        HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    name: "folder-plus";
                                    size: 18px;
                                    color: Look.accent;
                                }
                            }
                            FocusScope {
                                horizontal-stretch: 1;
                                height: 30px;
                                key-pressed(event) => {
                                    if event.text == Key.Escape {
                                        Downloads.cancel-new-folder();
                                        return accept;
                                    }
                                    return reject;
                                }
                                Field {
                                    width: parent.width;
                                    height: 30px;
                                    text <=> Downloads.move-new-name;
                                    placeholder: @tr("Folder name");
                                    font-size: 14px;
                                    padding-x: 8px;
                                    border-radius: Look.button-radius;
                                    fill: Look.bg;
                                    ring: Look.accent;
                                    ring-width: 1.5px;
                                    error: Downloads.move-new-error != RenameError.none;
                                    init => {
                                        self.focus-text();
                                    }
                                    accepted => {
                                        Downloads.commit-new-folder();
                                    }
                                    edited => {
                                        Downloads.move-new-error = RenameError.none;
                                    }
                                }
                            }
                        }
                        if Downloads.move-new-error != RenameError.none: HorizontalLayout {
                            padding-left: 28px;
                            Text {
                                text: DownloadWords.name-error(Downloads.move-new-error, Downloads.move-new-name);
                                color: Look.danger;
                                font-size: 12px;
                            }
                        }
                    }
                    for folder in Downloads.move-folders: MoveRow {
                        folder: folder;
                    }
                    if Downloads.move-loading: HorizontalLayout {
                        alignment: center;
                        padding: 14px;
                        Spinner {
                            size: 20px;
                            color: Look.muted;
                        }
                    }
                    if !Downloads.move-loading && Downloads.move-problem != Problem.none: HorizontalLayout {
                        padding: 10px;
                        Paragraph {
                            text: DownloadWords.problem(Downloads.move-problem, Downloads.move-problem-detail);
                            color: Look.danger;
                            font-size: 13px;
                        }
                    }
                    if !Downloads.move-loading && Downloads.move-problem == Problem.none && Downloads.move-folders.length == 0 && !Downloads.move-creating: HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 14px;
                        padding-bottom: 14px;
                        Text {
                            text: @tr("No folders here");
                            color: Look.faint;
                            font-size: 13px;
                        }
                    }
                }
            }
        }
        Paragraph {
            text: Downloads.move-here-allowed ? @tr("Move to: {0}", Downloads.move-path-label) : @tr("Already in this folder.");
            color: Downloads.move-here-allowed ? Look.muted : Look.faint;
            font-size: 13px;
        }
    }
    VerticalLayout {
        spacing: 8px;
        padding-top: 2px;
        if Look.terminal: EscapeHint { }
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                height: 38px;
                width: new-folder.preferred-width;
                border-radius: Look.button-radius;
                background: new-folder-touch.has-hover ? Look.sel : transparent;
                border-width: 1px;
                border-color: Look.line-strong;
                new-folder := HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: "folder-plus";
                            size: 16px;
                            color: Look.text;
                        }
                    }
                    Text {
                        text: @tr("New folder");
                        color: Look.text;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                new-folder-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Downloads.move-new-folder();
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            AnswerButton {
                text: @tr("Cancel");
                clicked => {
                    Downloads.close-dialog();
                }
            }
            AnswerButton {
                text: @tr("Move here") + Look.enter-hint;
                primary: true;
                enabled: Downloads.move-here-allowed;
                clicked => {
                    Downloads.move-here();
                }
            }
        }
    }
}

// The same name at the destination, of a move or of an upload: Replace what is there (an outline
// in red: it deletes), Skip it, or Keep both (⏎), the new one as "name (2).ext". Esc cancels the
// whole move or upload.
component ConflictDialog inherits WriteDialog {
    box-width: 500px;
    icon: "copy";
    property <bool> up: Downloads.conflict-upload;
    property <int> rest: Downloads.conflict-rest;
    title: Downloads.conflict-count == 1 ? @tr("“{0}” is already in {1}", Downloads.conflict-items[0].name, Downloads.conflict-dest) : @tr("{0} items are already in {1}", Downloads.conflict-count, Downloads.conflict-dest);
    description: rest == 0 ? (up ? @tr("Choose before uploading.") : @tr("Choose before moving."))
        : rest == 1 ? (up ? @tr("The other one uploads as usual.") : @tr("The other one moves as usual."))
        : (up ? @tr("The other {0} upload as usual.", rest) : @tr("The other {0} move as usual.", rest));
    escape => {
        Downloads.close-dialog();
    }
    enter => {
        Downloads.resolve-conflict("keep");
    }

    if Downloads.conflict-count > 1: ItemList {
        items: Downloads.conflict-items;
        more: Downloads.conflict-count - 4;
        there: true;
    }
    NoteLine {
        text: @tr("Keep both adds “(2)” to the name. Replace deletes the one that’s there; it can’t be undone.") + (Downloads.conflict-folders ? " " + @tr("Folders aren’t merged.") : "");
    }
    VerticalLayout {
        spacing: 8px;
        padding-top: 2px;
        if Look.terminal: EscapeHint { }
        HorizontalLayout {
            alignment: end;
            spacing: 10px;
            AnswerButton {
                text: @tr("Replace");
                danger: true;
                clicked => {
                    Downloads.resolve-conflict("replace");
                }
            }
            AnswerButton {
                text: @tr("Skip");
                clicked => {
                    Downloads.resolve-conflict("skip");
                }
            }
            AnswerButton {
                text: @tr("Keep both") + Look.enter-hint;
                primary: true;
                clicked => {
                    Downloads.resolve-conflict("keep");
                }
            }
        }
    }
}

export component DownloadsPage inherits Rectangle {
    // The context menu: what it is for, and where.
    property <int> menu-kind;           // 0 none, 1 a server, 2 an entry of the listing, 3 a download
    property <int> menu-index;          // the server
    property <string> menu-name;        // the entry
    property <bool> menu-folder;
    property <bool> menu-selected;      // the entry is among the chosen files: the menu acts on them all
    property <bool> menu-multi: menu-kind == 2 && menu-selected && Downloads.selected-count > 1;
    property <int> menu-id;             // the download
    property <TransferState> menu-state;
    property <length> menu-x;
    property <length> menu-y;
    property <bool> queue-shown: Downloads.queue-open && Downloads.queue.length > 0;
    property <bool> has-head: !Downloads.form-open && Downloads.current >= 0;
    property <bool> listing: has-head && Downloads.folder-state == FolderState.listed && Downloads.has-entries;
    property <bool> empty: has-head && Downloads.folder-state == FolderState.listed && !Downloads.has-entries;
    property <bool> menu-live: menu-state == TransferState.active || menu-state == TransferState.waiting;
    background: Look.bg;

    init => {
        Downloads.opened();
    }

    // The menu at x, y, kept within the page: `rows` of 34px each, with the padding.
    function show-menu(kind: int, x: length, y: length, rows: int) {
        root.menu-kind = kind;
        root.menu-x = max(0px, min(x - root.absolute-position.x, root.width - 216px));
        root.menu-y = max(0px, min(y - root.absolute-position.y, root.height - (rows * 34px + 20px)));
    }

    function close-menu() {
        root.menu-kind = 0;
    }

    PageFrame {
        title: @tr("Downloads");

        // The servers.
        Rectangle {
            width: 260px;
            background: Look.side;

            Flickable {
                width: parent.width;
                height: parent.height;
                mouse-drag-pan-enabled: false;
                content-height: max(self.height, servers.preferred-height);

                servers := VerticalLayout {
                    width: parent.width;
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 10px;
                    padding-bottom: 16px;
                    spacing: 2px;
                    alignment: start;
                    // Back to the chats (or to logging in).
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-bottom: 8px;
                        alignment: start;
                        Link {
                            text: @tr("Chats");
                            icon: "arrow-left";
                            font-size: 13px;
                            clicked => {
                                AppState.page = Page.chats;
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-bottom: 12px;
                        Heading {
                            label: @tr("Servers");
                            size: Look.nav-heading-size;
                        }
                    }
                    for server[index] in Downloads.servers: ServerItem {
                        server: server;
                        index: index;
                        active: Downloads.form-open ? Downloads.form-editing && Downloads.current == index : Downloads.current == index;
                        menu(x, y) => {
                            root.menu-index = index;
                            root.show-menu(1, x, y, 3);
                        }
                    }
                    Rectangle { height: 4px; }
                    AddServerRow { }
                }
            }

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Look.line;
            }
        }

        // The folder being looked at: its listing, or what stands in for it; the drop box over it
        // while files are dragged in.
        Rectangle {
            horizontal-stretch: 1;

            Flickable {
            width: parent.width;
            height: parent.height;
            mouse-drag-pan-enabled: false;
            content-height: max(self.height, middle.preferred-height);

            middle := VerticalLayout {
                width: parent.width;
                padding-left: 32px;
                padding-right: 32px;
                padding-top: 40px;
                padding-bottom: 28px;
                spacing: 20px;
                alignment: start;

                if root.has-head: VerticalLayout {
                    spacing: 6px;
                    // The way here: the server, then the path down to this folder, "/Movies/2026",
                    // each folder of it a step back. The row is as wide as the column and never
                    // wider: a folder above this one is at most 240px, the folder looked at takes
                    // what is left, and a name too long for that is cut short with "…" (a PikPak
                    // folder can be a whole sentence; it used to push the column off the window).
                    Rectangle {
                        // No width of its own (bound to the column's, it would be a binding loop
                        // through the layouts) and constraints of its own, not the row's: the
                        // row's preferred width is the whole path, and the column grew to it.
                        min-width: 0;
                        preferred-width: 0;
                        height: way.preferred-height;
                        clip: true;
                        way := HorizontalLayout {
                            spacing: 0;
                            VerticalLayout {
                                alignment: center;
                                padding-right: 8px;
                                horizontal-stretch: 0;
                                Icon {
                                    name: "hard-drives";
                                    size: 20px;
                                    color: Look.muted;
                                }
                            }
                            for crumb[index] in Downloads.crumbs: HorizontalLayout {
                                property <bool> here: index > 0 && index == Downloads.crumbs.length - 1;
                                spacing: 0;
                                padding-right: index == 0 ? 8px : 0px;
                                horizontal-stretch: 0;
                                if index > 0: Text {
                                    text: "/";
                                    color: Look.faint;
                                    font-size: Look.nav-heading-size;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                // The server, or a folder above this one: a step back.
                                if !here: Rectangle {
                                    width: min(step-label.preferred-width, 240px);
                                    step-label := Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: crumb;
                                        color: step-touch.has-hover ? Look.accent-ink : Look.text;
                                        font-size: Look.nav-heading-size;
                                        font-weight: 600;
                                        letter-spacing: Look.heading-tracking * Look.nav-heading-size;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    step-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            Downloads.go-to(index);
                                        }
                                    }
                                }
                                // The folder looked at: its name, or what is left of the row.
                                if here: Rectangle {
                                    min-width: 0;
                                    preferred-width: here-label.preferred-width;
                                    max-width: here-label.preferred-width;
                                    here-label := Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: crumb;
                                        color: Look.text;
                                        font-size: Look.nav-heading-size;
                                        font-weight: 600;
                                        letter-spacing: Look.heading-tracking * Look.nav-heading-size;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                            // At the root the path is "/".
                            if Downloads.crumbs.length <= 1: Text {
                                text: "/";
                                color: Look.faint;
                                font-size: Look.nav-heading-size;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 0;
                            }
                            // What is left of the row.
                            Rectangle {
                                horizontal-stretch: 1;
                                min-width: 0;
                            }
                        }
                    }
                    // The folder's name, the filter, refresh, and the queue's button.
                    HorizontalLayout {
                        spacing: 8px;
                        // The folder's name, no bigger than the toolbar's words: the path above
                        // already says where we are.
                        Heading {
                            horizontal-stretch: 1;
                            label: Downloads.title;
                            size: 14px;
                            wrap: no-wrap;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            FilterBox { }
                        }
                        VerticalLayout {
                            alignment: center;
                            ToolButton {
                                icon: "arrows-clockwise";
                                clicked => {
                                    Downloads.refresh();
                                }
                            }
                        }
                        if Downloads.can-write: VerticalLayout {
                            alignment: center;
                            UploadButton { }
                        }
                        VerticalLayout {
                            alignment: center;
                            QueueButton { }
                        }
                    }
                }

                // A change the server did not make (the ninth round), until dismissed.
                if root.has-head && Downloads.change-failed != "": HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: start;
                        padding-top: 1px;
                        Icon {
                            name: "warning-circle";
                            size: 17px;
                            color: Look.danger;
                        }
                    }
                    Paragraph {
                        horizontal-stretch: 1;
                        text: DownloadWords.change-failed();
                        color: Look.danger;
                        font-size: 14px;
                        line-height-factor: Look.leading(1.5);
                    }
                    VerticalLayout {
                        alignment: start;
                        Rectangle {
                            width: 20px;
                            height: 20px;
                            Icon {
                                name: "x";
                                size: 15px;
                                color: dismiss.has-hover ? Look.text : Look.muted;
                                duotone: false;
                            }
                            dismiss := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    Downloads.dismiss-change-failed();
                                }
                            }
                        }
                    }
                }

                if root.listing || (root.empty && Downloads.filter != ""): Rectangle {
                    height: card.preferred-height;
                    border-radius: Look.radius;
                    background: Look.field;
                    border-width: Look.field-border;
                    border-color: Look.line;
                    clip: true;

                    card := VerticalLayout {
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: Look.terminal ? 28px : 20px;
                                    height: 20px;
                                    CheckBox {
                                        on: Downloads.all-selected;
                                        some: Downloads.some-selected;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            Downloads.toggle-all();
                                        }
                                    }
                                }
                            }
                            Rectangle { width: 20px; }
                            ColumnLabel {
                                horizontal-stretch: 1;
                                label: @tr("Name");
                            }
                            ColumnLabel {
                                width: 96px;
                                label: @tr("Modified");
                                horizontal-alignment: right;
                            }
                            ColumnLabel {
                                width: 84px;
                                label: @tr("Size");
                                horizontal-alignment: right;
                            }
                        }
                        for entry in Downloads.entries: EntryRow {
                            entry: entry;
                            menu(x, y) => {
                                root.menu-name = entry.name;
                                root.menu-folder = entry.folder;
                                root.menu-selected = entry.selected;
                                root.show-menu(2, x, y, Downloads.can-write ? 8 : 3);
                            }
                        }
                        if Downloads.entries.length == 0: Rectangle {
                            height: no-match.preferred-height + 36px;
                            Rectangle {
                                y: 0;
                                height: 1px;
                                width: parent.width;
                                background: Look.line;
                            }
                            no-match := Paragraph {
                                x: 16px;
                                y: 18px;
                                width: parent.width - 32px;
                                text: @tr("Nothing in this folder matches “{0}”", Downloads.filter);
                                color: Look.faint;
                                font-size: 14px;
                            }
                        }
                        if Downloads.selected-count > 0: Rectangle {
                            height: foot.preferred-height;
                            background: Look.side;
                            Rectangle {
                                y: 0;
                                height: 1px;
                                width: parent.width;
                                background: Look.line;
                            }
                            foot := HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 12px;
                                padding-top: 10px;
                                padding-bottom: 10px;
                                spacing: 8px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: @tr("{0} selected · {1}", Downloads.selected-count, Downloads.selected-size);
                                    color: Look.text;
                                    font-size: 14px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if Downloads.can-write: FootAction {
                                    icon: "arrow-bend-up-right";
                                    text: @tr("Move…");
                                    clicked => {
                                        Downloads.move-selected();
                                    }
                                }
                                if Downloads.can-write: FootAction {
                                    icon: "trash";
                                    text: @tr("Delete");
                                    ink: Look.danger;
                                    clicked => {
                                        Downloads.delete-selected();
                                    }
                                }
                                SmallButton {
                                    text: @tr("Clear");
                                    quiet: true;
                                    clicked => {
                                        Downloads.clear-selection();
                                    }
                                }
                                if Downloads.can-open: SmallButton {
                                    text: @tr("Open");
                                    clicked => {
                                        Downloads.open-selected();
                                    }
                                }
                                SmallButton {
                                    text: @tr("Download");
                                    primary: true;
                                    clicked => {
                                        Downloads.download-selected();
                                    }
                                }
                            }
                        }
                    }
                }

                if root.has-head && Downloads.folder-state == FolderState.loading: VerticalLayout {
                    padding-top: 120px;
                    alignment: start;
                    HorizontalLayout {
                        alignment: center;
                        Spinner {
                            size: 28px;
                            color: Look.muted;
                        }
                    }
                }

                if root.empty && Downloads.filter == "": VerticalLayout {
                    padding-top: 120px;
                    spacing: 12px;
                    alignment: start;
                    HorizontalLayout {
                        alignment: center;
                        Icon {
                            name: "folder-open";
                            size: 32px;
                            color: Look.faint;
                        }
                    }
                    Text {
                        text: @tr("This folder is empty");
                        color: Look.muted;
                        font-size: 15px;
                        horizontal-alignment: center;
                    }
                }

                if root.has-head && Downloads.folder-state == FolderState.error: VerticalLayout {
                    padding-top: 120px;
                    spacing: 14px;
                    alignment: start;
                    HorizontalLayout {
                        alignment: center;
                        Icon {
                            name: "warning-circle";
                            size: 32px;
                            color: Look.danger;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Paragraph {
                            max-width: 360px;
                            text: DownloadWords.problem(Downloads.problem, Downloads.problem-detail);
                            color: Look.text;
                            font-size: 15px;
                            horizontal-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        SmallButton {
                            text: @tr("Retry");
                            clicked => {
                                Downloads.refresh();
                            }
                        }
                    }
                }

                // An SFTP server whose key waits to be checked (the eighth round): nothing is
                // listed until it is trusted; Check key asks again.
                if root.has-head && Downloads.folder-state == FolderState.key-wait: VerticalLayout {
                    padding-top: 120px;
                    spacing: 14px;
                    alignment: start;
                    HorizontalLayout {
                        alignment: center;
                        Icon {
                            name: Downloads.key-wait-changed ? "warning" : "key";
                            size: 32px;
                            color: Downloads.key-wait-changed ? Look.danger : Look.muted;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Paragraph {
                            max-width: 380px;
                            text: Downloads.key-wait-changed ? @tr("Not connected. This server’s key has changed.") : @tr("Not connected yet. Check this server’s key first.");
                            color: Look.text;
                            font-size: 15px;
                            horizontal-alignment: center;
                            line-height-factor: Look.leading(1.5);
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        SmallButton {
                            text: @tr("Check key");
                            clicked => {
                                Downloads.check-key();
                            }
                        }
                    }
                }

                // No server yet: what this page is for.
                if !Downloads.form-open && Downloads.current < 0: HorizontalLayout {
                    alignment: start;
                    VerticalLayout {
                        preferred-width: 520px;
                        max-width: 520px;
                        spacing: 18px;
                        alignment: start;
                        Heading {
                            label: @tr("No servers yet");
                        }
                        Paragraph {
                            text: @tr("Add the WebDAV address of a NAS, a seedbox, PikPak, Alist / OpenList, or a folder you share with vget serve. Then browse it here and pick the files you want.");
                            color: Look.muted;
                            font-size: 15px;
                            line-height-factor: Look.leading(1.6);
                        }
                        Paragraph {
                            text: @tr("Cloud drives without WebDAV can be reached through OpenList. FinchGram changes nothing on a server unless you allow it for that server.");
                            color: Look.muted;
                            font-size: 15px;
                            line-height-factor: Look.leading(1.6);
                        }
                        HorizontalLayout {
                            alignment: start;
                            PrimaryButton {
                                text: @tr("Add server");
                                height: 42px;
                                font-size: 15px;
                                clicked => {
                                    Downloads.add-server();
                                }
                            }
                        }
                        VerticalLayout {
                            padding-top: 6px;
                            spacing: 8px;
                            alignment: start;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                for word in ["Synology · QNAP", "PikPak", "Alist · OpenList"]: Rectangle {
                                    height: 26px;
                                    width: pill.preferred-width + 20px;
                                    border-radius: Look.button-radius;
                                    background: Look.soft;
                                    pill := Text {
                                        text: word;
                                        color: Look.soft-ink;
                                        font-size: 13px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                for word in ["rclone serve webdav", "vget serve", "Nextcloud"]: Rectangle {
                                    height: 26px;
                                    width: pill2.preferred-width + 20px;
                                    border-radius: Look.button-radius;
                                    background: Look.soft;
                                    pill2 := Text {
                                        text: word;
                                        color: Look.soft-ink;
                                        font-size: 13px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                }
                            }
                        }
                    }
                }

                // Adding or editing a server.
                if Downloads.form-open: HorizontalLayout {
                    alignment: start;
                    VerticalLayout {
                        preferred-width: 480px;
                        max-width: 480px;
                        spacing: 20px;
                        alignment: start;
                        VerticalLayout {
                            spacing: 6px;
                            Heading {
                                label: Downloads.form-editing ? @tr("Edit server") : @tr("Add server");
                            }
                            Paragraph {
                                text: @tr("The address of the server, and the account it gave you. The password is kept sealed in FinchGram's database on this Mac.");
                                color: Look.muted;
                                font-size: 15px;
                                line-height-factor: Look.leading(1.55);
                            }
                        }
                        // The protocol: WebDAV, FTP, FTPS or SFTP.
                        VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: @tr("Protocol");
                                color: Look.muted;
                                font-size: 13px;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                for id in ["webdav", "ftp", "ftps", "sftp"]: Chip {
                                    label: DownloadWords.protocol-name(id);
                                    on: Downloads.form-protocol == id;
                                    clicked => {
                                        Downloads.form-protocol = id;
                                        Downloads.form-error = FormError.none;
                                        Downloads.test-state = TestState.none;
                                    }
                                }
                            }
                        }
                        FormField {
                            label: @tr("Name");
                            placeholder: "Home NAS";
                            text <=> Downloads.form-name;
                            accepted => {
                                Downloads.submit-form();
                            }
                        }
                        // The address, and the port beside it: the protocol's default unless the
                        // user gives one.
                        VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 10px;
                                FormField {
                                    horizontal-stretch: 1;
                                    label: @tr("Address");
                                    placeholder: DownloadWords.address-placeholder(Downloads.form-protocol);
                                    text <=> Downloads.form-address;
                                    accepted => {
                                        Downloads.submit-form();
                                    }
                                }
                                FormField {
                                    width: 112px;
                                    label: @tr("Port");
                                    placeholder: DownloadWords.protocol-port(Downloads.form-protocol, Downloads.form-address);
                                    input-type: InputType.number;
                                    text <=> Downloads.form-port;
                                    accepted => {
                                        Downloads.submit-form();
                                    }
                                }
                            }
                            Paragraph {
                                text: DownloadWords.address-hint(Downloads.form-protocol, Downloads.form-address);
                                color: Look.faint;
                                font-size: 12px;
                            }
                        }
                        // An SFTP server's key (the eighth round): the one trusted, with its
                        // fingerprint, since when, and a way to forget it; or that none is yet.
                        if Downloads.form-protocol == "sftp": VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: @tr("Server key");
                                color: Look.muted;
                                font-size: 13px;
                            }
                            if Downloads.form-key-known: Rectangle {
                                border-radius: Look.radius;
                                background: Look.side;
                                border-width: Look.field-border;
                                border-color: Look.line;
                                VerticalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    padding-top: 10px;
                                    padding-bottom: 10px;
                                    spacing: 6px;
                                    Text {
                                        text: Downloads.form-key-fingerprint;
                                        color: Look.text;
                                        font-family: Look.mono;
                                        font-size: 13px;
                                        overflow: elide;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        HorizontalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 4px;
                                            alignment: start;
                                            Text {
                                                text: Downloads.form-key-type;
                                                color: Look.text;
                                                font-size: 12px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                            if Downloads.form-key-since != "": Text {
                                                text: "· " + @tr("First seen {0}", Downloads.form-key-since);
                                                color: Look.faint;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                        Link {
                                            text: @tr("Forget this key");
                                            color: Look.danger;
                                            font-size: 13px;
                                            font-weight: 600;
                                            clicked => {
                                                Downloads.forget-key();
                                            }
                                        }
                                    }
                                }
                            }
                            if !Downloads.form-key-known: Rectangle {
                                border-radius: Look.radius;
                                border-width: 1px;
                                border-color: Look.line-strong;
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    padding-top: 10px;
                                    padding-bottom: 10px;
                                    spacing: 8px;
                                    alignment: start;
                                    VerticalLayout {
                                        alignment: start;
                                        padding-top: 1px;
                                        Icon {
                                            name: "key";
                                            size: 16px;
                                            color: Look.faint;
                                        }
                                    }
                                    Paragraph {
                                        text: Downloads.form-key-forgotten ? @tr("Forgotten. You’ll check it again on the next connection.") : @tr("Not seen yet. You’ll check it the first time you connect.");
                                        color: Look.muted;
                                        font-size: 13px;
                                        line-height-factor: Look.leading(1.5);
                                    }
                                }
                            }
                        }
                        FormField {
                            label: @tr("Username");
                            text <=> Downloads.form-username;
                            accepted => {
                                Downloads.submit-form();
                            }
                        }
                        // SFTP signs in with a password or a key; the key waits for another version.
                        if Downloads.form-protocol == "sftp": VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: @tr("Sign in with");
                                color: Look.muted;
                                font-size: 13px;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Chip {
                                    label: @tr("Password");
                                    on: true;
                                }
                                Chip {
                                    label: @tr("Key");
                                    grey: true;
                                }
                            }
                            Paragraph {
                                text: @tr("Key sign-in isn’t in this version.");
                                color: Look.faint;
                                font-size: 12px;
                            }
                        }
                        FormField {
                            label: @tr("Password");
                            input-type: InputType.password;
                            text <=> Downloads.form-password;
                            accepted => {
                                Downloads.submit-form();
                            }
                        }
                        // Changes on this server (the ninth round): off until the user turns it on;
                        // a server that said it only reads is noted under the words.
                        Rectangle {
                            height: allow.preferred-height;
                            border-radius: Look.radius;
                            background: Look.side;
                            border-width: Look.field-border;
                            border-color: Look.line;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    Downloads.form-allow-changes = !Downloads.form-allow-changes;
                                    Downloads.test-state = TestState.none;
                                }
                            }
                            allow := HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                padding-top: 12px;
                                padding-bottom: 12px;
                                spacing: 14px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    alignment: start;
                                    Text {
                                        text: @tr("Allow changes to files on this server");
                                        color: Look.text;
                                        font-size: 14px;
                                        font-weight: 600;
                                    }
                                    Paragraph {
                                        text: @tr("Delete, move, rename and upload on the server. Deleted files can’t be recovered.");
                                        color: Look.muted;
                                        font-size: 12px;
                                        line-height-factor: Look.leading(1.45);
                                    }
                                    if Downloads.form-read-only: Paragraph {
                                        text: @tr("This server said it only allows reading.");
                                        color: Look.faint;
                                        font-size: 12px;
                                        line-height-factor: Look.leading(1.45);
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Switch {
                                        on: Downloads.form-allow-changes;
                                        track-width: 34px;
                                        track-height: 20px;
                                        knob-size: 14px;
                                        toggled => {
                                            Downloads.form-allow-changes = !Downloads.form-allow-changes;
                                            Downloads.test-state = TestState.none;
                                        }
                                    }
                                }
                            }
                        }
                        // Basic authentication over http, and plain FTP, send the password in the clear
                        // (docs/downloads.md): allowed, for a NAS at home, and said in red.
                        if (Downloads.form-protocol == "webdav" && Downloads.form-address.to-lowercase().starts-with("http://")) || Downloads.form-protocol == "ftp": HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            VerticalLayout {
                                alignment: start;
                                padding-top: 1px;
                                Icon {
                                    name: "warning-circle";
                                    size: 17px;
                                    color: Look.danger;
                                }
                            }
                            Paragraph {
                                text: Downloads.form-protocol == "ftp"
                                    ? @tr("Over FTP the password and the files travel in the clear: use this server only on a network you trust, or FTPS.")
                                    : @tr("Over http the password and the files travel in the clear: use this server only on a network you trust.");
                                color: Look.danger;
                                font-size: 14px;
                                line-height-factor: Look.leading(1.5);
                            }
                        }
                        if Downloads.form-error != FormError.none: HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            VerticalLayout {
                                alignment: start;
                                padding-top: 1px;
                                Icon {
                                    name: "warning-circle";
                                    size: 17px;
                                    color: Look.danger;
                                }
                            }
                            Paragraph {
                                text: DownloadWords.form-error(Downloads.form-error);
                                color: Look.danger;
                                font-size: 14px;
                                line-height-factor: Look.leading(1.5);
                            }
                        }
                        if Downloads.test-state == TestState.testing: HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Spinner {
                                    size: 16px;
                                    color: Look.muted;
                                }
                            }
                            Text {
                                text: @tr("Testing…");
                                color: Look.muted;
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                        }
                        if Downloads.test-state == TestState.ok || Downloads.test-state == TestState.failed: VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: start;
                                    padding-top: 1px;
                                    Icon {
                                        name: Downloads.test-state == TestState.ok ? "check-circle" : "warning-circle";
                                        size: 17px;
                                        color: Downloads.test-state == TestState.ok ? Look.ok : Look.danger;
                                    }
                                }
                                Paragraph {
                                    text: DownloadWords.test-result();
                                    color: Downloads.test-state == TestState.ok ? Look.ok : Look.danger;
                                    font-size: 14px;
                                    line-height-factor: Look.leading(1.5);
                                }
                            }
                            // What the server says about changes, under a test that reached it.
                            if Downloads.test-state == TestState.ok: HorizontalLayout {
                                padding-left: 25px;
                                Paragraph {
                                    text: DownloadWords.changes-said(Downloads.test-changes);
                                    color: Look.muted;
                                    font-size: 13px;
                                    line-height-factor: Look.leading(1.5);
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-top: 4px;
                            spacing: 10px;
                            PrimaryButton {
                                text: Downloads.form-editing ? @tr("Save") : @tr("Add");
                                height: 42px;
                                font-size: 15px;
                                clicked => {
                                    Downloads.submit-form();
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                SmallButton {
                                    text: @tr("Test connection");
                                    enabled: Downloads.test-state != TestState.testing;
                                    clicked => {
                                        Downloads.test-connection();
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                SmallButton {
                                    text: @tr("Cancel");
                                    quiet: true;
                                    clicked => {
                                        Downloads.cancel-form();
                                    }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            if Downloads.form-editing: VerticalLayout {
                                alignment: center;
                                Link {
                                    text: @tr("Remove");
                                    icon: "trash";
                                    color: Look.danger;
                                    font-weight: 600;
                                    clicked => {
                                        Downloads.remove-from-form();
                                    }
                                }
                            }
                        }
                    }
                }
            }
            }

            if Downloads.dropping: DropBox {
                x: 12px;
                y: 12px;
                width: parent.width - 24px;
                height: parent.height - 24px;
            }
        }

        // The queue, when it is not empty and not hidden.
        if root.queue-shown: Rectangle {
            width: 380px;
            background: Look.side;

            Rectangle {
                x: 0;
                width: 1px;
                background: Look.line;
            }

            VerticalLayout {
                padding-top: 40px;
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 14px;
                    padding-bottom: 10px;
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 3px;
                        alignment: start;
                        Heading {
                            label: @tr("Transfers");
                            size: Look.nav-heading-size;
                            wrap: no-wrap;
                            overflow: elide;
                        }
                        if Downloads.active-count > 0: Text {
                            text: Downloads.active-uploads > 0 && Downloads.active-count > Downloads.active-uploads
                                ? @tr("{0} down · {1} up", Downloads.active-count - Downloads.active-uploads, Downloads.active-uploads)
                                : @tr("{0} active", Downloads.active-count);
                            color: Look.muted;
                            font-size: 13px;
                        }
                    }
                    // Clear finished, while there is a finished file, then Hide.
                    VerticalLayout {
                        alignment: start;
                        HorizontalLayout {
                            spacing: 6px;
                            if Downloads.done-count > 0: VerticalLayout {
                                alignment: center;
                                TinyButton {
                                    text: @tr("Clear finished");
                                    clicked => {
                                        Downloads.clear-finished();
                                    }
                                }
                            }
                            Rectangle {
                                height: 28px;
                                width: hide.preferred-width;
                                border-radius: Look.button-radius;
                                background: hide-touch.has-hover ? Look.sel : transparent;
                                hide := HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 5px;
                                    if Look.terminal: Text {
                                        text: "[";
                                        color: hide-touch.has-hover ? Look.text : Look.muted;
                                        font-family: Look.mono;
                                        font-size: Look.nav-heading-size;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: @tr("Hide");
                                        color: hide-touch.has-hover ? Look.text : Look.muted;
                                        font-size: Look.nav-heading-size;
                                        font-weight: 600;
                                        letter-spacing: Look.heading-tracking * Look.nav-heading-size;
                                        vertical-alignment: center;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Icon {
                                            name: "caret-right";
                                            size: 13px;
                                            color: hide-touch.has-hover ? Look.text : Look.muted;
                                            duotone: false;
                                        }
                                    }
                                    if Look.terminal: Text {
                                        text: "]";
                                        color: hide-touch.has-hover ? Look.text : Look.muted;
                                        font-family: Look.mono;
                                        font-size: Look.nav-heading-size;
                                        vertical-alignment: center;
                                    }
                                }
                                hide-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        Downloads.toggle-queue();
                                    }
                                }
                            }
                        }
                    }
                }
                Flickable {
                    vertical-stretch: 1;
                    mouse-drag-pan-enabled: false;
                    content-height: max(self.height, rows.preferred-height);
                    rows := VerticalLayout {
                        width: parent.width;
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: start;
                        for row in Downloads.queue: TransferItem {
                            item: row;
                            menu(x, y) => {
                                root.menu-id = row.id;
                                root.menu-state = row.state;
                                root.show-menu(3, x, y, 4);
                            }
                        }
                    }
                }
                Rectangle {
                    height: footline.preferred-height;
                    Rectangle {
                        y: 0;
                        height: 1px;
                        width: parent.width;
                        background: Look.line;
                    }
                    footline := VerticalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        padding-top: 14px;
                        padding-bottom: 16px;
                        spacing: 2px;
                        Paragraph {
                            text: @tr("{0} connections per file · Downloads go to {1}", Downloads.connections, Downloads.folder-label);
                            color: Look.muted;
                            font-size: 12px;
                            line-height-factor: Look.leading(1.5);
                        }
                        Link {
                            text: @tr("Change");
                            font-size: 12px;
                            font-weight: 500;
                            clicked => {
                                Downloads.change-folder();
                            }
                        }
                    }
                }
            }
        }
    }

    // A name being typed in place: a click anywhere else keeps it (a bad name is let go), and so
    // does a scroll, as the design has it.
    if Downloads.renaming != "": TouchArea {
        clicked => {
            Downloads.commit-rename(true);
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                Downloads.commit-rename(true);
            }
        }
        scroll-event(event) => {
            Downloads.commit-rename(true);
            return accept;
        }
    }

    // What was just done, at the foot for a moment.
    if Downloads.toast != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 24px;
        width: min(520px, toast-text.preferred-width + 32px);
        height: toast-text.preferred-height + 20px;
        border-radius: Look.radius;
        background: Look.text;
        drop-shadow-blur: 30px;
        drop-shadow-offset-y: 10px;
        drop-shadow-color: #00000040;
        toast-text := Text {
            x: 16px;
            width: parent.width - 32px;
            height: parent.height;
            text: DownloadWords.toast();
            color: Look.bg;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // The context menu of a server, an entry or a download, over the page; a click anywhere
    // else closes it, and so does Esc.
    if root.menu-kind != 0: Rectangle {
        KeyScope {
            escape => {
                root.close-menu();
            }
        }
        TouchArea {
            clicked => {
                root.close-menu();
            }
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.close-menu();
                }
            }
        }
        Rectangle {
            x: root.menu-x;
            y: root.menu-y;
            width: 200px;
            height: items.preferred-height;
            border-radius: Look.broadsheet ? 6px : Look.terminal ? 4px : 8px;
            background: Look.bg;
            border-width: 1px;
            border-color: Look.line-strong;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: #00000038;

            items := VerticalLayout {
                padding: 6px;
                if root.menu-kind == 1: MenuEntry {
                    icon: "pencil-simple";
                    label: @tr("Edit");
                    chosen => {
                        Downloads.edit-server(root.menu-index);
                        root.close-menu();
                    }
                }
                if root.menu-kind == 1: MenuEntry {
                    icon: "trash";
                    label: @tr("Remove");
                    danger: true;
                    chosen => {
                        Downloads.remove-server(root.menu-index);
                        root.close-menu();
                    }
                }
                if root.menu-kind == 1: MenuEntry {
                    icon: "copy";
                    label: @tr("Copy address");
                    chosen => {
                        Downloads.copy-address(root.menu-index);
                        root.close-menu();
                    }
                }
                // A right click on one of several chosen files acts on them all.
                if root.menu-multi: MenuEntry {
                    icon: "download-simple";
                    label: @tr("Download {0} items", Downloads.selected-count);
                    chosen => {
                        Downloads.download-selected();
                        root.close-menu();
                    }
                }
                if root.menu-kind == 2 && !root.menu-multi && root.menu-folder: MenuEntry {
                    icon: "folder-open";
                    label: @tr("Open");
                    chosen => {
                        Downloads.open-folder(root.menu-name);
                        root.close-menu();
                    }
                }
                if root.menu-kind == 2 && !root.menu-multi && root.menu-folder: MenuEntry {
                    icon: "download-simple";
                    label: @tr("Download folder");
                    chosen => {
                        Downloads.download-folder(root.menu-name);
                        root.close-menu();
                    }
                }
                if root.menu-kind == 2 && !root.menu-multi && !root.menu-folder: MenuEntry {
                    icon: "download-simple";
                    label: @tr("Download");
                    chosen => {
                        Downloads.download-file(root.menu-name);
                        root.close-menu();
                    }
                }
                if root.menu-kind == 2 && !root.menu-multi && !root.menu-folder: MenuEntry {
                    icon: "arrow-square-out";
                    label: @tr("Open");
                    chosen => {
                        Downloads.open-file(root.menu-name);
                        root.close-menu();
                    }
                }
                if root.menu-kind == 2 && !root.menu-multi: MenuEntry {
                    icon: "link";
                    label: @tr("Copy link");
                    chosen => {
                        Downloads.copy-link(root.menu-name);
                        root.close-menu();
                    }
                }
                // Changes on the server (the ninth round), where the user allows them; greyed, with
                // a word, when the server said it only reads.
                if root.menu-kind == 2 && Downloads.can-write: Rectangle {
                    height: 11px;
                    Rectangle {
                        x: 6px;
                        y: 5px;
                        width: parent.width - 12px;
                        height: 1px;
                        background: Look.line-strong;
                    }
                }
                if root.menu-kind == 2 && Downloads.can-write: MenuEntry {
                    icon: "pencil-simple";
                    label: @tr("Rename");
                    enabled: !Downloads.server-read-only && !root.menu-multi;
                    chosen => {
                        Downloads.rename-entry(root.menu-name);
                        root.close-menu();
                    }
                }
                if root.menu-kind == 2 && Downloads.can-write: MenuEntry {
                    icon: "arrow-bend-up-right";
                    label: root.menu-multi ? @tr("Move {0} items to…", Downloads.selected-count) : @tr("Move to…");
                    enabled: !Downloads.server-read-only;
                    chosen => {
                        if root.menu-multi {
                            Downloads.move-selected();
                        } else {
                            Downloads.move-entry(root.menu-name);
                        }
                        root.close-menu();
                    }
                }
                if root.menu-kind == 2 && Downloads.can-write: MenuEntry {
                    icon: "trash";
                    label: root.menu-multi ? @tr("Delete {0} items…", Downloads.selected-count) : @tr("Delete…");
                    danger: true;
                    enabled: !Downloads.server-read-only;
                    chosen => {
                        if root.menu-multi {
                            Downloads.delete-selected();
                        } else {
                            Downloads.delete-entry(root.menu-name);
                        }
                        root.close-menu();
                    }
                }
                if root.menu-kind == 2 && Downloads.can-write && Downloads.server-read-only: HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 6px;
                    padding-bottom: 4px;
                    Paragraph {
                        text: @tr("The server doesn’t allow changes.");
                        color: Look.muted;
                        font-size: 12px;
                        line-height-factor: Look.leading(1.45);
                    }
                }
                if root.menu-kind == 3: MenuEntry {
                    icon: "x-circle";
                    label: @tr("Cancel");
                    enabled: root.menu-live;
                    chosen => {
                        Downloads.cancel(root.menu-id);
                        root.close-menu();
                    }
                }
                if root.menu-kind == 3: MenuEntry {
                    icon: "arrow-clockwise";
                    label: @tr("Retry");
                    enabled: root.menu-state == TransferState.stopped;
                    chosen => {
                        Downloads.retry(root.menu-id);
                        root.close-menu();
                    }
                }
                if root.menu-kind == 3: MenuEntry {
                    icon: "folder-open";
                    label: @tr("Show in Finder");
                    enabled: root.menu-state == TransferState.done;
                    chosen => {
                        Downloads.show-in-finder(root.menu-id);
                        root.close-menu();
                    }
                }
                if root.menu-kind == 3: MenuEntry {
                    icon: "list-dashes";
                    label: @tr("Remove from list");
                    enabled: !root.menu-live;
                    chosen => {
                        Downloads.remove-transfer(root.menu-id);
                        root.close-menu();
                    }
                }
            }
        }
    }

    // The question about an SFTP server's key, over the page.
    if Downloads.key-ask-open: KeyDialog { }
    // The changes' dialogs (the ninth round).
    if Downloads.delete-open: DeleteDialog { }
    if Downloads.move-open: MoveDialog { }
    if Downloads.conflict-open: ConflictDialog { }
}
