// Live streams, from the canvas "FinchGram Live" of 2026-11-07 (docs/live-streams.md): the list
// that each theme puts in its side column under its own heading (LiveList), and the pane that takes
// the messages' place while the view is open (LivePane): the stream with its comments, the empty
// pane, the form to go live, the host's view. Drawn once, in Look's colours and shapes, for the
// three themes; Rust fills the Live global (src/telegram/live.rs).
import { Look, AccountColors } from "../look.slint";
import { Icon, Spinner, Field, PrimaryButton, Link, Avatar, Switch, Paragraph, Heading, SectionLabel } from "../widgets.slint";
import { SmallButton, Chip } from "rows.slint";
import { Live, LiveWords, LiveRow, LiveKind, LiveState, LiveComment, LiveDonor, LiveTarget } from "../live.slint";

// The mark of a stream that is live: a red "● LIVE", "[LIVE]" in Terminal; grey for one that
// plays only on the phone.
export component LiveMark inherits Rectangle {
    in property <bool> quiet;
    // Over the picture: the pill in every theme, Terminal's brackets would not read there.
    in property <bool> on-picture;
    property <bool> text-only: Look.terminal && !on-picture;
    property <color> fill: quiet ? Look.off : on-picture ? #d92d20 : Look.danger;
    property <color> ink: quiet ? Look.muted : on-picture || !Look.dark ? #ffffff : Look.bg;
    width: text-only ? label.preferred-width : label.preferred-width + 17px;
    height: 16px;
    border-radius: text-only ? 0px : 3px;
    background: text-only ? transparent : fill;

    if !root.text-only: Rectangle {
        x: 6px;
        y: (parent.height - self.height) / 2;
        width: 5px;
        height: 5px;
        border-radius: 2.5px;
        background: root.ink;
    }
    label := Text {
        x: root.text-only ? 0px : 14px;
        text: root.text-only ? "[" + LiveWords.live-mark() + "]" : LiveWords.live-mark();
        color: root.text-only ? (root.quiet ? Look.faint : Look.danger) : root.ink;
        font-family: Look.terminal ? Look.mono : Look.font;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: Look.terminal ? 0px : 0.8px;
        vertical-alignment: center;
    }
}

// The colours of a paid comment's level: the theme's accent, then orange, then red.
global Tier {
    public pure function fill(tier: int) -> color {
        if tier >= 3 { return AccountColors.tint(5, Look.dark); }
        if tier == 2 { return AccountColors.tint(3, Look.dark); }
        return Look.soft;
    }
    public pure function ink(tier: int) -> color {
        if tier >= 3 { return AccountColors.tint-ink(5, Look.dark); }
        if tier == 2 { return AccountColors.tint-ink(3, Look.dark); }
        return Look.soft-ink;
    }
}

// The bar under a chat's header while the chat is live: what it is, how many watch, and Watch,
// which opens it in the live streams' view.
export component LiveBar inherits Rectangle {
    height: 44px;
    background: Look.bg;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Look.line;
    }
    if !Look.terminal: Rectangle {
        x: 0;
        width: 3px;
        background: Look.danger;
    }

    HorizontalLayout {
        padding-left: Look.terminal ? 16px : 18px;
        padding-right: 16px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            LiveMark {
                quiet: !Live.in-chat.playable;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: LiveWords.in-chat(Live.in-chat);
            color: Look.text;
            font-size: 13px;
            font-weight: 500;
            overflow: elide;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            SmallButton {
                text: LiveWords.watch();
                primary: Live.in-chat.playable;
                clicked => {
                    Live.show-requests += 1;
                    Live.watch(Live.in-chat.id);
                }
            }
        }
    }
}

// ---- the list ------------------------------------------------------------------------------------

component ListRow inherits Rectangle {
    in property <LiveRow> entry;
    property <bool> open: entry.id == Live.open-id;
    property <color> ink: open && !Look.broadsheet ? Look.accent-ink : entry.playable ? Look.text : Look.faint;
    height: 58px;
    background: open ? Look.sel : touch.has-hover ? Look.sel.transparentize(0.4) : transparent;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Avatar {
                size: 36px;
                radius: Look.terminal ? 3px : 8px;
                initial: root.entry.initial;
                picture: root.entry.picture;
                has-picture: root.entry.has-picture;
                opacity: root.entry.playable ? 1 : 0.55;
                font-size: 14px;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: root.entry.name;
                    color: root.ink;
                    font-size: 14px;
                    font-weight: root.open ? 600 : 500;
                    overflow: elide;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    LiveMark {
                        quiet: !root.entry.playable;
                    }
                }
            }
            HorizontalLayout {
                spacing: 5px;
                if !root.entry.playable: VerticalLayout {
                    alignment: center;
                    Icon {
                        name: "device-mobile";
                        size: 13px;
                        color: Look.faint;
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: LiveWords.line(root.entry);
                    color: root.entry.playable ? Look.muted : Look.faint;
                    font-size: 12px;
                    overflow: elide;
                }
                if root.entry.playable && root.entry.viewers >= 0: HorizontalLayout {
                    spacing: 4px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: "eye";
                            size: 13px;
                            color: root.open && !Look.broadsheet ? Look.accent-ink : Look.muted;
                        }
                    }
                    Text {
                        text: root.entry.viewers;
                        color: root.open && !Look.broadsheet ? Look.accent-ink : Look.muted;
                        font-size: 12px;
                    }
                }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Live.watch(root.entry.id);
        }
    }
}

component Section {
    in property <string> label;
    in property <int> count;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 4px;
        spacing: 6px;
        SectionLabel {
            label: root.label;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.count;
            color: Look.faint;
            font-size: Look.section-size;
            vertical-alignment: center;
        }
    }
}

// The button that opens the form to go live.
component GoLiveButton inherits Rectangle {
    property <bool> on: Live.going-live;
    height: 28px;
    width: row.preferred-width + 20px;
    border-radius: Look.button-radius;
    background: on ? Look.sel : touch.has-hover ? Look.sel.transparentize(0.4) : transparent;
    border-width: on ? 0px : 1px;
    border-color: Look.line-strong;

    row := HorizontalLayout {
        x: 10px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: "broadcast";
                size: 14px;
                color: Look.accent-ink;
            }
        }
        Text {
            text: Look.terminal ? "[" + LiveWords.go-live() + "]" : LiveWords.go-live();
            color: Look.accent-ink;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Live.open-go-live();
        }
    }
}

// The view's side column, under the theme's heading: going live, who is live, and a link.
export component LiveList {
    property <bool> link-wrong;

    VerticalLayout {
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 6px;
            padding-bottom: 6px;
            alignment: start;
            GoLiveButton { }
        }

        Flickable {
            vertical-stretch: 1;
            mouse-drag-pan-enabled: false;
            VerticalLayout {
                alignment: start;
                if Live.stories.length > 0: Section {
                    label: LiveWords.stories();
                    count: Live.stories.length;
                }
                for row in Live.stories: ListRow {
                    entry: row;
                }
                if Live.chats.length > 0: Section {
                    label: LiveWords.chats();
                    count: Live.chats.length;
                }
                for row in Live.chats: ListRow {
                    entry: row;
                }
                if Live.stories.length == 0 && Live.chats.length == 0: VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 18px;
                    spacing: 8px;
                    Text {
                        text: LiveWords.nobody-live();
                        color: Look.text;
                        font-size: 14px;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    Paragraph {
                        text: LiveWords.nobody-live-line();
                        color: Look.muted;
                        font-size: 13px;
                        line-height-factor: Look.leading(1.5);
                    }
                }
            }
        }

        VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 10px;
            padding-bottom: 12px;
            spacing: 8px;
            Text {
                text: LiveWords.any-public();
                color: Look.faint;
                font-size: 12px;
            }
            HorizontalLayout {
                spacing: 6px;
                link := Field {
                    height: 32px;
                    font-size: 13px;
                    padding-x: 10px;
                    placeholder: LiveWords.link-placeholder();
                    error: root.link-wrong;
                    edited => {
                        root.link-wrong = false;
                    }
                    accepted(text) => {
                        root.link-wrong = !Live.watch-link(text);
                    }
                }
                SmallButton {
                    text: LiveWords.watch();
                    enabled: link.text != "";
                    clicked => {
                        root.link-wrong = !Live.watch-link(link.text);
                    }
                }
            }
            if root.link-wrong: Text {
                text: LiveWords.not-a-link();
                color: Look.danger;
                font-size: 12px;
            }
            Paragraph {
                text: LiveWords.phone-note();
                color: Look.faint;
                font-size: 11px;
                line-height-factor: Look.leading(1.45);
            }
        }
    }
}

// ---- the pane: watching -------------------------------------------------------------------------

// A round button over the picture, or beside it.
component RoundButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <color> ink: Look.muted;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: Look.terminal ? 3px : 16px;
    background: touch.has-hover ? Look.sel : transparent;
    accessible-role: button;
    accessible-label: label;

    Icon {
        name: root.icon;
        size: 18px;
        color: root.ink;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// The picture, or where it is: joining, waiting for the broadcaster, for the phone only, over.
component StreamScreen inherits Rectangle {
    property <bool> shows-picture: Live.state == LiveState.playing && Live.frame.width > 0;
    border-radius: Look.radius;
    background: #101214;
    clip: true;

    if root.shows-picture: Image {
        width: parent.width;
        height: parent.height;
        source: Live.frame;
        image-fit: contain;
    }

    if !root.shows-picture: VerticalLayout {
        alignment: center;
        spacing: 12px;
        padding-left: 40px;
        padding-right: 40px;
        if Live.state == LiveState.joining || Live.state == LiveState.waiting || (Live.state == LiveState.playing && !root.shows-picture): HorizontalLayout {
            alignment: center;
            Spinner {
                size: 22px;
                color: #c9ced6;
            }
        }
        if Live.state == LiveState.phone: HorizontalLayout {
            alignment: center;
            Icon {
                name: "device-mobile";
                size: 28px;
                color: #c9ced6;
            }
        }
        Text {
            text: LiveWords.state(Live.state);
            color: #ffffff;
            font-size: 15px;
            font-weight: 600;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if Live.state == LiveState.phone: Text {
            text: LiveWords.phone-explained();
            color: #c9ced6;
            font-size: 13px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if Live.state == LiveState.failed && Live.problem != "": Text {
            text: Live.problem;
            color: #c9ced6;
            font-size: 13px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    if root.shows-picture && Live.buffering: Rectangle {
        Spinner {
            size: 22px;
            color: #ffffffcc;
        }
    }

    // The mark and the viewers on the picture, as Telegram's own apps show them.
    if Live.state == LiveState.playing || Live.state == LiveState.waiting: HorizontalLayout {
        x: 12px;
        y: 12px;
        height: 18px;
        spacing: 8px;
        LiveMark {
            on-picture: true;
        }
    }
    if Live.state == LiveState.playing || Live.state == LiveState.waiting: Rectangle {
        x: parent.width - self.width - 12px;
        y: 12px;
        height: 20px;
        width: viewers.preferred-width + 14px;
        border-radius: 3px;
        background: #00000073;
        viewers := HorizontalLayout {
            x: 7px;
            spacing: 5px;
            VerticalLayout {
                alignment: center;
                Icon {
                    name: "eye";
                    size: 13px;
                    color: #ffffff;
                }
            }
            Text {
                text: Live.viewers;
                color: #ffffff;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
    }

    // The sound, at the foot of the picture.
    if Live.state == LiveState.playing: Rectangle {
        y: parent.height - self.height;
        height: 48px;
        background: @linear-gradient(180deg, #00000000 0%, #0000008c 100%);
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                RoundButton {
                    icon: Live.muted || Live.volume == 0 ? "speaker-x" : "speaker-high";
                    label: Live.muted ? "Unmute" : "Mute";
                    ink: #ffffff;
                    clicked => {
                        Live.toggle-mute();
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                bar := Rectangle {
                    width: 90px;
                    height: 4px;
                    border-radius: 2px;
                    background: #ffffff59;
                    Rectangle {
                        x: 0;
                        width: parent.width * (Live.muted ? 0 : Live.volume / 100);
                        border-radius: 2px;
                        background: #ffffff;
                    }
                    TouchArea {
                        y: -8px;
                        height: parent.height + 16px;
                        mouse-cursor: pointer;
                        clicked => {
                            Live.set-volume(Math.round(max(0, min(1, self.mouse-x / bar.width)) * 100));
                        }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

// A comment in the column: free (a name and the words), paid (tinted by its level, with its
// Stars), a tip (a paid comment without words), the host's (marked).
component CommentRow inherits Rectangle {
    in property <LiveComment> comment;
    property <bool> paid: comment.stars > 0 && comment.text != "";
    property <bool> tip: comment.stars > 0 && comment.text == "";
    height: box.preferred-height;
    border-radius: Look.radius;
    background: paid ? Tier.fill(comment.tier) : transparent;

    box := HorizontalLayout {
        padding-left: root.paid ? 10px : 0px;
        padding-right: root.paid ? 10px : 0px;
        padding-top: root.paid ? 8px : 6px;
        padding-bottom: root.paid ? 8px : 6px;
        spacing: 10px;
        VerticalLayout {
            alignment: start;
            Avatar {
                size: 26px;
                radius: Look.terminal ? 3px : 6px;
                initial: root.comment.initial;
                fill: root.paid ? (Look.dark ? Look.bg : #ffffff) : Look.soft;
                ink: root.paid ? Tier.ink(root.comment.tier) : Look.soft-ink;
                font-size: 11px;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Text {
                    text: root.comment.name;
                    color: root.paid ? Tier.ink(root.comment.tier) : Look.text;
                    font-size: 13px;
                    font-weight: 600;
                    overflow: elide;
                }
                if root.comment.host: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 15px;
                        width: host.preferred-width + 10px;
                        border-radius: 3px;
                        background: Look.soft;
                        host := Text {
                            width: parent.width;
                            text: LiveWords.host-mark();
                            color: Look.soft-ink;
                            font-size: 10px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.paid: HorizontalLayout {
                    spacing: 3px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: "star";
                            size: 12px;
                            color: Tier.ink(root.comment.tier);
                        }
                    }
                    Text {
                        text: root.comment.stars;
                        color: Tier.ink(root.comment.tier);
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
            if !root.tip: Paragraph {
                text: root.comment.text;
                color: root.paid ? Tier.ink(root.comment.tier) : Look.text;
                font-size: 13px;
                line-height-factor: Look.leading(1.4);
            }
            if root.tip: Text {
                text: LiveWords.tipped(root.comment.stars);
                color: Look.muted;
                font-size: 13px;
            }
        }
        if Live.hosting && root.comment.deletable && touch.has-hover: VerticalLayout {
            alignment: start;
            RoundButton {
                width: 26px;
                height: 26px;
                icon: "trash";
                label: LiveWords.delete-comment();
                ink: Look.danger;
                clicked => {
                    Live.delete-comment(root.comment.id);
                }
            }
        }
    }
    touch := TouchArea {
        // Under the trash button, so that the button gets its click.
        z: -1;
    }
}

// The column of comments, the newest at the foot, the oldest leaving at the top.
component Comments inherits Rectangle {
    width: 340px;
    background: Look.bg;

    Rectangle {
        x: 0;
        width: 1px;
        background: Look.line;
    }

    VerticalLayout {
        padding-left: 1px;
        VerticalLayout {
            vertical-stretch: 0;
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 16px;
            padding-bottom: 10px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: LiveWords.comments();
                    color: Look.text;
                    font-size: 15px;
                    font-weight: 600;
                }
                Text {
                    horizontal-stretch: 1;
                    text: Live.paid-from > 0 ? LiveWords.paid-from(Live.paid-from) : "";
                    color: Look.faint;
                    font-size: 12px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
            if Live.hosting && Live.donors.length > 0: VerticalLayout {
                spacing: 8px;
                SectionLabel {
                    label: LiveWords.top-supporters();
                }
                HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: 8px;
                    alignment: start;
                    for donor in Live.donors: Rectangle {
                        height: 26px;
                        width: chip.preferred-width + 16px;
                        border-radius: Look.terminal ? 3px : 13px;
                        background: Tier.fill(donor.tier);
                        chip := HorizontalLayout {
                            x: 8px;
                            spacing: 5px;
                            Text {
                                text: donor.name;
                                color: Tier.ink(donor.tier);
                                font-size: 12px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    name: "star";
                                    size: 12px;
                                    color: Tier.ink(donor.tier);
                                }
                            }
                            Text {
                                text: donor.stars;
                                color: Tier.ink(donor.tier);
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Look.line;
        }
        // The comments, anchored to the foot: older ones go out at the top.
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            list := VerticalLayout {
                y: parent.height - self.preferred-height;
                height: self.preferred-height;
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 6px;
                spacing: 2px;
                for comment in Live.comments: CommentRow {
                    comment: comment;
                }
            }
            if Live.comments.length == 0: Text {
                text: Live.comments-on ? "" : LiveWords.comments-off();
                color: Look.faint;
                font-size: 13px;
            }
        }
        Rectangle {
            height: 1px;
            background: Look.line;
        }
        VerticalLayout {
            vertical-stretch: 0;
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 10px;
            padding-bottom: 14px;
            spacing: 8px;
            if Live.comments-on && Live.can-comment && (Live.hosting || Live.paid-from == 0): HorizontalLayout {
                spacing: 8px;
                say := Field {
                    height: 34px;
                    font-size: 13px;
                    padding-x: 10px;
                    placeholder: Live.hosting ? LiveWords.reply-as-host() : LiveWords.say();
                    accepted(text) => {
                        if text != "" {
                            Live.send-comment(text);
                            self.text = "";
                        }
                    }
                }
                // Paid comments go from Telegram's own apps for now: the star stays faded.
                RoundButton {
                    icon: "star";
                    label: "★";
                    ink: Look.faint;
                    opacity: 0.45;
                }
                Rectangle {
                    width: 34px;
                    height: 34px;
                    border-radius: Look.button-radius;
                    background: send-touch.has-hover ? Look.accent.darker(0.1) : Look.accent;
                    opacity: say.text != "" ? 1 : 0.5;
                    Icon {
                        name: "paper-plane-tilt";
                        size: 16px;
                        color: Look.on-accent;
                    }
                    send-touch := TouchArea {
                        enabled: say.text != "";
                        mouse-cursor: pointer;
                        clicked => {
                            Live.send-comment(say.text);
                            say.text = "";
                        }
                    }
                }
            }
            Paragraph {
                text: !Live.comments-on ? LiveWords.comments-off()
                    : Live.hosting ? LiveWords.host-note()
                    : Live.paid-from > 0 ? LiveWords.paid-note(Live.paid-from)
                    : LiveWords.free-note();
                color: Look.faint;
                font-size: 11px;
                line-height-factor: Look.leading(1.45);
            }
        }
    }
}

// What the host sees beside their own stream: how many watch, the Stars so far, comments on or
// off, and the end.
component HostBar {
    HorizontalLayout {
        spacing: 28px;
        alignment: start;
        VerticalLayout {
            spacing: 2px;
            Text {
                text: Live.viewers;
                color: Look.text;
                font-family: Look.mono;
                font-size: 18px;
                font-weight: 600;
            }
            SectionLabel {
                label: LiveWords.watching-now();
            }
        }
        VerticalLayout {
            spacing: 2px;
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        name: "star";
                        size: 16px;
                        color: Tier.ink(2);
                    }
                }
                Text {
                    text: Live.stars-total;
                    color: Tier.ink(2);
                    font-family: Look.mono;
                    font-size: 18px;
                    font-weight: 600;
                }
            }
            SectionLabel {
                label: LiveWords.stars-so-far();
            }
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 10px;
                Switch {
                    on: Live.comments-on;
                    toggled => {
                        Live.toggle-comments();
                    }
                }
                Text {
                    text: LiveWords.comments-allowed();
                    color: Look.text;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component Watching inherits Rectangle {
    HorizontalLayout {
        VerticalLayout {
            horizontal-stretch: 1;
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 16px;
            padding-bottom: 16px;
            spacing: 14px;
            // Who is live, since when, how many watch; and closing it.
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Avatar {
                        size: 34px;
                        radius: Look.terminal ? 3px : 8px;
                        initial: Live.open.initial;
                        picture: Live.open.picture;
                        has-picture: Live.open.has-picture;
                        font-size: 14px;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: Live.open.name;
                            color: Look.text;
                            font-size: 16px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        if Live.state == LiveState.playing || Live.state == LiveState.waiting: VerticalLayout {
                            alignment: center;
                            LiveMark { }
                        }
                    }
                    Text {
                        text: LiveWords.started(Live.open.kind, Live.since);
                        color: Look.muted;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
                if Live.hosting: VerticalLayout {
                    alignment: center;
                    SmallButton {
                        text: LiveWords.end(Live.open.kind);
                        clicked => {
                            Live.ask-end(true);
                        }
                    }
                }
                if !Live.hosting && (Live.state == LiveState.playing || Live.state == LiveState.waiting): HorizontalLayout {
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: "eye";
                            size: 16px;
                            color: Look.text;
                        }
                    }
                    Text {
                        text: LiveWords.viewers(Live.viewers);
                        color: Look.text;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    RoundButton {
                        icon: "x";
                        label: LiveWords.cancel();
                        clicked => {
                            Live.close();
                        }
                    }
                }
            }
            screen := StreamScreen {
                // 16:9 as wide as the pane allows, no taller than it leaves.
                height: min(self.width * 9 / 16, root.height - 230px);
            }
            if Live.hosting: HostBar { }
            HorizontalLayout {
                spacing: 10px;
                Text {
                    horizontal-stretch: 1;
                    text: Live.open.title != "" ? Live.open.title : LiveWords.kind(Live.open.kind);
                    color: Look.text;
                    font-size: 15px;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if Live.link != "": SmallButton {
                    text: LiveWords.copy-link();
                    clicked => {
                        Live.copy-link();
                    }
                }
            }
            if Live.state == LiveState.joining || Live.state == LiveState.waiting || Live.state == LiveState.playing: Paragraph {
                text: Live.hosting ? LiveWords.preview-note() : LiveWords.watch-note();
                color: Look.muted;
                font-size: 12px;
                line-height-factor: Look.leading(1.5);
            }
            Rectangle { vertical-stretch: 1; }
        }
        if Live.state != LiveState.phone: Comments { }
    }
}

// ---- the pane: nothing open --------------------------------------------------------------------

component Empty inherits Rectangle {
    VerticalLayout {
        alignment: center;
        spacing: 12px;
        padding-left: 40px;
        padding-right: 40px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 56px;
                height: 56px;
                border-radius: Look.terminal ? 3px : 14px;
                background: Look.side;
                Icon {
                    name: "broadcast";
                    size: 28px;
                    color: Look.muted;
                }
            }
        }
        Text {
            text: LiveWords.empty-title();
            color: Look.text;
            font-size: 16px;
            font-weight: 600;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            Paragraph {
                width: min(380px, root.width - 80px);
                text: LiveWords.empty-line();
                color: Look.muted;
                font-size: 13px;
                horizontal-alignment: center;
                line-height-factor: Look.leading(1.5);
            }
        }
        HorizontalLayout {
            alignment: center;
            padding-top: 6px;
            GoLiveButton { }
        }
    }
}

// ---- the pane: going live -----------------------------------------------------------------------

// A line of the stream's settings for OBS: its name, its value in mono, and its buttons.
component KeyLine {
    in property <string> label;
    in property <string> value;
    in property <bool> secret;
    in property <bool> shown;
    callback copy();
    callback toggle();

    HorizontalLayout {
        spacing: 8px;
        Rectangle {
            horizontal-stretch: 1;
            height: 34px;
            border-radius: Look.radius;
            background: Look.field;
            border-width: Look.field-border;
            border-color: Look.line;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 10px;
                Text {
                    width: 76px;
                    text: root.label;
                    color: Look.faint;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.secret && !root.shown ? (root.value == "" ? "" : "••••••••••••••••••••••") : root.value;
                    color: Look.text;
                    font-family: Look.mono;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        if root.secret: SmallButton {
            text: root.shown ? LiveWords.hide-key() : LiveWords.show-key();
            enabled: root.value != "";
            clicked => {
                root.toggle();
            }
        }
        SmallButton {
            text: LiveWords.copy();
            enabled: root.value != "";
            clicked => {
                root.copy();
            }
        }
    }
}

component GoLive inherits Rectangle {
    property <bool> story: Live.target >= 0 && Live.target < Live.targets.length && Live.targets[Live.target].story;

    HorizontalLayout {
        padding-left: 32px;
        padding-right: 32px;
        padding-top: 22px;
        spacing: 40px;
        Flickable {
            width: min(540px, root.width - 64px);
            mouse-drag-pan-enabled: false;
            VerticalLayout {
                alignment: start;
                spacing: 22px;
                padding-bottom: 24px;
                VerticalLayout {
                    spacing: 6px;
                    Link {
                        text: LiveWords.view();
                        icon: "caret-left";
                        font-size: 13px;
                        clicked => {
                            Live.close-go-live();
                        }
                    }
                    Heading {
                        label: LiveWords.go-live();
                        size: 20px;
                    }
                    Paragraph {
                        text: LiveWords.go-live-line();
                        color: Look.muted;
                        font-size: 13px;
                        line-height-factor: Look.leading(1.5);
                    }
                }
                VerticalLayout {
                    spacing: 8px;
                    SectionLabel {
                        label: LiveWords.where();
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        for target[index] in Live.targets: Chip {
                            label: target.story ? LiveWords.my-story() : LiveWords.channel-stream(target.name);
                            on: index == Live.target;
                            clicked => {
                                Live.choose-target(index);
                            }
                        }
                    }
                }
                if root.story: VerticalLayout {
                    spacing: 8px;
                    SectionLabel {
                        label: LiveWords.who();
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        for index in 3: Chip {
                            label: LiveWords.privacy(index);
                            on: index == Live.privacy;
                            clicked => {
                                Live.privacy = index;
                            }
                        }
                    }
                }
                if !root.story: VerticalLayout {
                    spacing: 8px;
                    SectionLabel {
                        label: LiveWords.stream-title();
                    }
                    Field {
                        width: 320px;
                        height: 34px;
                        font-size: 13px;
                        padding-x: 10px;
                        text <=> Live.stream-title;
                        placeholder: LiveWords.stream-title-placeholder();
                    }
                }
                if root.story: VerticalLayout {
                    spacing: 8px;
                    SectionLabel {
                        label: LiveWords.comments();
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        Switch {
                            on: Live.allow-comments;
                            toggled => {
                                Live.allow-comments = !Live.allow-comments;
                            }
                        }
                        Text {
                            text: LiveWords.viewers-comment();
                            color: Look.text;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }
                    if Live.allow-comments: HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Text {
                            text: LiveWords.paid-minimum();
                            color: Look.text;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Field {
                            width: 90px;
                            height: 34px;
                            font-size: 13px;
                            padding-x: 10px;
                            input-type: InputType.number;
                            text <=> Live.paid-minimum;
                            placeholder: "0";
                        }
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "star";
                                size: 14px;
                                color: Tier.ink(2);
                            }
                        }
                    }
                    if Live.allow-comments: Paragraph {
                        text: LiveWords.paid-minimum-note();
                        color: Look.faint;
                        font-size: 12px;
                    }
                }
                VerticalLayout {
                    spacing: 8px;
                    SectionLabel {
                        label: LiveWords.your-stream();
                    }
                    Paragraph {
                        text: LiveWords.obs-note();
                        color: Look.muted;
                        font-size: 13px;
                        line-height-factor: Look.leading(1.5);
                    }
                    KeyLine {
                        label: LiveWords.server();
                        value: Live.server;
                        copy => {
                            Live.copy-server();
                        }
                    }
                    KeyLine {
                        label: LiveWords.key();
                        value: Live.key;
                        secret: true;
                        shown: Live.key-shown;
                        copy => {
                            Live.copy-key();
                        }
                        toggle => {
                            Live.key-shown = !Live.key-shown;
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Text {
                            text: LiveWords.key-note();
                            color: Look.faint;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Link {
                            text: LiveWords.new-key();
                            font-size: 12px;
                            enabled: Live.key != "";
                            clicked => {
                                Live.new-key();
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 14px;
                    alignment: start;
                    PrimaryButton {
                        height: 38px;
                        font-size: 14px;
                        padding-x: 16px;
                        text: LiveWords.start(root.story);
                        busy: Live.starting;
                        enabled: Live.targets.length > 0;
                        clicked => {
                            Live.start();
                        }
                    }
                    Paragraph {
                        horizontal-stretch: 1;
                        text: LiveWords.start-note();
                        color: Look.muted;
                        font-size: 12px;
                        line-height-factor: Look.leading(1.5);
                    }
                }
                if Live.start-problem != "": Paragraph {
                    text: Live.start-problem;
                    color: Look.danger;
                    font-size: 13px;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 14px;
            alignment: start;
            Rectangle {
                height: self.width * 9 / 16;
                border-radius: Look.radius;
                background: #101214;
                VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    HorizontalLayout {
                        alignment: center;
                        Icon {
                            name: "broadcast";
                            size: 26px;
                            color: #8b929c;
                        }
                    }
                    Text {
                        text: LiveWords.waiting-for-obs();
                        color: #c9ced6;
                        font-size: 13px;
                        horizontal-alignment: center;
                    }
                }
            }
            Rectangle {
                height: good.preferred-height;
                border-radius: Look.radius;
                border-width: 1px;
                border-color: Look.line-strong;
                good := VerticalLayout {
                    padding: 14px;
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 4px;
                    Text {
                        text: LiveWords.good-to-know();
                        color: Look.text;
                        font-size: 13px;
                        font-weight: 600;
                    }
                    Paragraph {
                        text: LiveWords.good-to-know-line();
                        color: Look.muted;
                        font-size: 13px;
                        line-height-factor: Look.leading(1.55);
                    }
                }
            }
        }
    }
}

// ---- the question before ending -----------------------------------------------------------------

component EndQuestion inherits Rectangle {
    background: #00000059;

    TouchArea { }

    Rectangle {
        width: 380px;
        height: card.preferred-height;
        border-radius: Look.dialog-radius;
        background: Look.bg;
        drop-shadow-blur: 32px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: #00000040;
        card := VerticalLayout {
            padding: 22px;
            spacing: 12px;
            Text {
                text: LiveWords.end-question();
                color: Look.text;
                font-size: 17px;
                font-weight: 600;
            }
            Paragraph {
                text: LiveWords.end-line(Live.open.kind);
                color: Look.muted;
                font-size: 13px;
                line-height-factor: Look.leading(1.5);
            }
            HorizontalLayout {
                padding-top: 6px;
                spacing: 10px;
                alignment: end;
                SmallButton {
                    text: LiveWords.cancel();
                    clicked => {
                        Live.ask-end(false);
                    }
                }
                Rectangle {
                    height: 32px;
                    width: end-label.preferred-width + 28px;
                    border-radius: Look.button-radius;
                    background: end-touch.has-hover ? Look.danger.darker(0.1) : Look.danger;
                    end-label := Text {
                        text: LiveWords.end(Live.open.kind);
                        color: Look.dark ? Look.bg : #ffffff;
                        font-size: 14px;
                        font-weight: 600;
                    }
                    end-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Live.end-live();
                        }
                    }
                }
            }
        }
    }
}

// The pane in the messages' place while the view is open.
export component LivePane inherits Rectangle {
    background: Look.bg;

    if Live.going-live: GoLive { }
    if !Live.going-live && Live.open-id == "": Empty { }
    if !Live.going-live && Live.open-id != "": Watching { }
    if Live.ending: EndQuestion { }
}
