// Live streams (docs/live-streams.md; the canvas "FinchGram Desktop 直播", rounds 12 and 13): the
// Live column each theme puts in its side column under its own heading (LiveList), the pane that
// takes the messages' place while the view is open (LivePane: Discover, Following, Broadcast and
// Connections, Watch over them, a short note at its foot, the content setting's question), the
// mini player that keeps a stream going elsewhere (LiveMini), and the bar under a live chat's
// header (LiveBar). Drawn once, in Look's colours and shapes, for the three themes; Rust fills the
// Live global (src/telegram/live.rs) and LiveDirectory (src/live/).
import { Look } from "../look.slint";
import { Icon, Paragraph } from "../widgets.slint";
import { SmallButton } from "rows.slint";
import { Live, LiveWords } from "../live.slint";
import { LiveDirectory, LiveDirectoryWords, LiveSection, LiveChannel, LiveStatus, LiveSource, LiveMode, LiveCategory, LiveToast } from "../live.slint";
import { LiveMark, LiveShape, ChannelAvatar, LiveButton, PictureIcon, PictureWord, LiveViewWords } from "live-parts.slint";
import { DirectoryLook } from "live-cards.slint";
import { LiveDiscover } from "live-discover.slint";
import { FollowingPage } from "live-following.slint";
import { BroadcastPage } from "live-broadcast.slint";
import { ConnectionsPage } from "live-connections.slint";
import { WatchPage, EndQuestion } from "live-watch.slint";

export { LiveMark }

// Leave for a place of the column: a Telegram stream opened outside the directory (a chat's live
// bar, going live) is left first; a stream of the directory goes on in the mini player (Rust).
global LiveGo {
    public function go(section: LiveSection) {
        if !LiveDirectory.watching && Live.open-id != "" && !(LiveDirectory.mini && LiveDirectory.channel.source == LiveSource.telegram) {
            Live.close();
        }
        LiveDirectory.go(section);
    }
}

// The bar under a chat's header while the chat is live: what it is, how many watch, and Watch,
// which opens it in the live streams' view.
export component LiveBar inherits Rectangle {
    height: 44px;
    background: Look.bg;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Look.line;
    }
    if !Look.terminal: Rectangle {
        x: 0;
        width: 3px;
        background: Look.danger;
    }

    HorizontalLayout {
        padding-left: Look.terminal ? 16px : 18px;
        padding-right: 16px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            LiveMark {
                quiet: !Live.in-chat.playable;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: LiveWords.in-chat(Live.in-chat);
            color: Look.text;
            font-size: 13px;
            font-weight: 500;
            overflow: elide;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            SmallButton {
                text: LiveWords.watch();
                primary: Live.in-chat.playable;
                clicked => {
                    Live.show-requests += 1;
                    Live.watch(Live.in-chat.id);
                }
            }
        }
    }
}

// ---- the column ------------------------------------------------------------------------------------

// A place of the column: Workbench's icon and name, Broadsheet's letter and name, with its count.
component NavRow inherits Rectangle {
    in property <LiveSection> section;
    in property <string> icon;
    in property <string> letter;
    in property <string> count;
    in property <bool> hot;
    property <bool> on: LiveDirectory.section == root.section;
    height: Look.broadsheet ? row.preferred-height : 32px;
    border-radius: Look.broadsheet ? 2px : 6px;
    background: root.on ? (Look.broadsheet ? Look.soft : Look.sel) : touch.has-hover ? (Look.broadsheet ? Look.sel.transparentize(0.4) : Look.hover) : transparent;
    accessible-role: button;
    accessible-label: LiveDirectoryWords.section(root.section);

    row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: Look.broadsheet ? 7px : 0px;
        padding-bottom: Look.broadsheet ? 7px : 0px;
        spacing: Look.broadsheet ? 12px : 10px;
        if !Look.broadsheet: VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                size: 17px;
                color: root.on ? Look.accent-ink : Look.muted;
            }
        }
        if Look.broadsheet: Text {
            width: 12px;
            text: root.letter;
            color: Look.faint;
            font-family: Look.mono;
            font-size: 12px;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: LiveDirectoryWords.section(root.section);
            color: root.on ? (Look.broadsheet ? Look.soft-ink : Look.accent-ink) : Look.text;
            font-size: Look.broadsheet ? 16px : 13px;
            font-weight: root.on ? 600 : 400;
            overflow: elide;
            vertical-alignment: center;
        }
        Text {
            text: root.count;
            color: root.hot ? Look.danger : Look.faint;
            font-size: Look.broadsheet ? 13px : 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            LiveGo.go(root.section);
        }
    }
}

// A followed channel in the column: Workbench's square with its live dot; Broadsheet's lines.
component ColumnRow inherits Rectangle {
    in property <LiveChannel> channel;
    property <bool> live: channel.status == LiveStatus.live;
    property <bool> open: LiveDirectory.watching && LiveDirectory.channel.id == channel.id;
    property <string> sub: root.live && root.channel.title != "" ? root.channel.title : LiveViewWords.column-sub(root.channel);
    property <string> right: root.live && root.channel.viewers >= 0 ? root.channel.viewers : "";
    height: body.preferred-height;
    background: Look.broadsheet ? transparent : root.open || touch.has-hover ? Look.sel : transparent;

    body := HorizontalLayout {
        padding-left: Look.broadsheet ? 0px : 14px;
        padding-right: Look.broadsheet ? 0px : 14px;
        padding-top: Look.broadsheet ? 9px : 7px;
        padding-bottom: Look.broadsheet ? 9px : 7px;
        spacing: 10px;
        if !Look.broadsheet: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 30px;
                height: 30px;
                ChannelAvatar {
                    size: 30px;
                    radius: 8px;
                    font-size: 12px;
                    channel: root.channel;
                    opacity: root.live ? 1 : 0.7;
                }
                if root.live: Rectangle {
                    x: parent.width - 7px;
                    y: parent.height - 7px;
                    width: 9px;
                    height: 9px;
                    border-radius: 4.5px;
                    background: Look.danger;
                    border-width: 2px;
                    border-color: Look.side;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Look.broadsheet ? 2px : 1px;
            opacity: root.live ? 1 : 0.7;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: root.channel.name;
                    color: Look.broadsheet && root.open ? Look.accent-ink : Look.text;
                    font-size: Look.broadsheet ? 15px : 13px;
                    font-weight: 600;
                    overflow: elide;
                }
                if Look.broadsheet && root.right != "": Text {
                    text: root.right;
                    color: Look.danger;
                    font-size: 13px;
                    font-weight: 600;
                }
            }
            if root.sub != "": Text {
                text: root.sub;
                color: Look.muted;
                font-size: Look.broadsheet ? 14px : 12px;
                overflow: elide;
            }
        }
        if !Look.broadsheet && root.right != "": Text {
            text: root.right;
            color: Look.faint;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
    if Look.broadsheet: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: DirectoryLook.rule;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            LiveDirectory.open(root.channel.id);
        }
    }
}

// A group's name in the column: "FOLLOWING · LIVE" in Workbench, ruled in Broadsheet.
component GroupLabel inherits Rectangle {
    in property <string> text;
    height: label.preferred-height + (Look.broadsheet ? 6px : 14px);

    label := Text {
        x: Look.broadsheet ? 0px : 14px;
        y: Look.broadsheet ? 0px : 10px;
        text: Look.broadsheet ? root.text : root.text.to-uppercase();
        color: Look.broadsheet ? Look.text : Look.faint;
        font-size: Look.broadsheet ? 17px : 11px;
        font-weight: 600;
        letter-spacing: Look.broadsheet ? 0px : 0.88px;
    }
    if Look.broadsheet: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: DirectoryLook.rule-strong;
    }
}

// Terminal: a tab of the column's line ("DISCOVER", "FOLLOW", "CAST", "CONN").
component TabWord inherits Rectangle {
    in property <string> text;
    in property <LiveSection> section;
    property <bool> on: LiveDirectory.section == root.section;
    width: word.preferred-width;
    height: word.preferred-height;

    word := Text {
        text: root.text;
        color: root.on ? Look.accent : touch.has-hover ? Look.text : Look.faint;
        font-size: 12px;
        font-weight: root.on ? 600 : 400;
        letter-spacing: 0.48px;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            LiveGo.go(root.section);
        }
    }
}

// Terminal: a group's head, "── following ──".
component RuleHead inherits Rectangle {
    in property <string> text;
    height: 26px;

    Text {
        x: 16px;
        y: 8px;
        text: "── " + root.text + " ──";
        color: Look.faint;
        font-size: 12px;
    }
}

// Terminal: a line of a facet, "(•) in finchgram  9125".
component FacetRow inherits Rectangle {
    in property <string> mark;
    in property <string> label;
    in property <int> count: -1;
    in property <bool> on;
    in property <bool> enabled: true;
    callback clicked();
    height: 22px;
    background: touch.has-hover && root.enabled ? Look.sel : transparent;
    opacity: !root.enabled || (root.count == 0 && !root.on) ? 0.5 : 1;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        Text {
            text: root.mark;
            color: root.on ? Look.accent : Look.faint;
            font-size: 13px;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: root.on ? Look.text : Look.muted;
            font-size: 13px;
            overflow: elide;
            vertical-alignment: center;
        }
        if root.count >= 0: Text {
            text: root.count;
            color: Look.faint;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

// Terminal: a facet's name, "# source".
component FacetHead inherits Rectangle {
    in property <string> text;
    height: 24px;

    Text {
        x: 16px;
        y: 8px;
        text: "# " + root.text;
        color: Look.faint;
        font-size: 12px;
    }
}

// Terminal: a row of the column, "▸ ● Keyboard Lab   oc  214".
component TerminalRow inherits Rectangle {
    in property <bool> selected;
    in property <string> dot;
    in property <color> dot-color: Look.faint;
    in property <string> name;
    in property <color> name-color: Look.text;
    in property <string> code;
    in property <string> right;
    in property <color> right-color: Look.faint;
    in property <bool> enabled: true;
    callback clicked();
    height: 26px;
    background: root.selected || (touch.has-hover && root.enabled) ? Look.sel : transparent;
    opacity: root.enabled ? 1 : 0.5;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 16px;
        spacing: 8px;
        Text {
            width: 10px;
            text: root.selected ? "▸" : "";
            color: Look.accent;
            font-size: 11px;
            vertical-alignment: center;
        }
        Text {
            text: root.dot;
            color: root.dot-color;
            font-size: 13px;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.name;
            color: root.name-color;
            font-size: 13px;
            overflow: elide;
            vertical-alignment: center;
        }
        if root.code != "": Text {
            text: root.code;
            color: Look.faint;
            font-size: 13px;
            vertical-alignment: center;
        }
        if root.right != "": Text {
            min-width: 32px;
            text: root.right;
            color: root.right-color;
            font-size: 13px;
            horizontal-alignment: TextHorizontalAlignment.right;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

// Terminal: a followed channel's row, its mark by its status.
component FollowedRow inherits TerminalRow {
    in property <LiveChannel> channel;
    property <bool> live: channel.status == LiveStatus.live;
    property <bool> off: channel.status == LiveStatus.offline;
    selected: LiveDirectory.watching && LiveDirectory.channel.id == channel.id;
    dot: channel.status == LiveStatus.live ? "●" : channel.status == LiveStatus.stale ? "◌" : channel.status == LiveStatus.unknown ? "?" : "○";
    dot-color: root.live ? Look.danger : root.off ? Look.faint : Look.warn;
    name: channel.name;
    name-color: root.live ? Look.text : Look.muted;
    code: LiveDirectoryWords.code(channel.source);
    right: root.live ? (channel.viewers >= 0 ? channel.viewers : "") : root.off ? LiveViewWords.ago-short(channel.last-live-minutes) : LiveViewWords.ago-short(channel.observed-minutes);
    right-color: root.live ? Look.muted : root.off ? Look.faint : Look.warn;
    clicked => {
        LiveDirectory.open(root.channel.id);
    }
}

// Terminal's facets of Discover, in the column (round 12): the mode, the sources, where it plays,
// the status, the category, the language, the content setting.
component Facets inherits VerticalLayout {
    padding-top: 2px;
    padding-bottom: 10px;
    FacetHead {
        text: LiveViewWords.facet-mode();
    }
    for mode[index] in [LiveMode.live, LiveMode.channels, LiveMode.upcoming]: FacetRow {
        mark: LiveDirectory.mode == mode ? "▸" : " ";
        on: LiveDirectory.mode == mode;
        label: (index + 1) + " " + LiveDirectoryWords.mode(mode).to-lowercase();
        count: index < LiveDirectory.mode-counts.length ? LiveDirectory.mode-counts[index] : -1;
        clicked => {
            LiveDirectory.set-mode(mode);
        }
    }
    FacetHead {
        text: LiveViewWords.facet-source();
    }
    for option in LiveDirectory.source-options: FacetRow {
        mark: option.chosen ? "[x]" : "[ ]";
        on: option.chosen;
        label: LiveDirectoryWords.code(option.source) + "  " + LiveDirectoryWords.source(option.source).to-lowercase();
        count: option.count;
        clicked => {
            LiveDirectory.toggle-source(option.source);
        }
    }
    for source in LiveDirectory.sources: FacetRow {
        visible: !source.indexed;
        height: source.indexed ? 0px : 22px;
        mark: "[-]";
        label: LiveDirectoryWords.code(source.source) + "  " + LiveDirectoryWords.source(source.source).to-lowercase() + " · " + LiveViewWords.not-integrated();
        enabled: false;
    }
    FacetHead {
        text: LiveViewWords.facet-plays();
    }
    for label[index] in [LiveViewWords.anywhere(), LiveViewWords.in-finchgram(), LiveViewWords.on-its-site()]: FacetRow {
        mark: LiveDirectory.playback == index ? "(•)" : "( )";
        on: LiveDirectory.playback == index;
        label: label;
        count: index > 0 && index < LiveDirectory.playback-counts.length ? LiveDirectory.playback-counts[index] : -1;
        clicked => {
            LiveDirectory.set-playback(index);
        }
    }
    if LiveDirectory.mode == LiveMode.channels: FacetHead {
        text: LiveViewWords.facet-status();
    }
    if LiveDirectory.mode == LiveMode.channels: FacetRow {
        mark: LiveDirectory.status-any ? "(•)" : "( )";
        on: LiveDirectory.status-any;
        label: LiveViewWords.any();
        clicked => {
            LiveDirectory.set-status(true, LiveStatus.live);
        }
    }
    if LiveDirectory.mode == LiveMode.channels: VerticalLayout {
        for status in [LiveStatus.live, LiveStatus.stale, LiveStatus.offline, LiveStatus.unknown]: FacetRow {
            mark: !LiveDirectory.status-any && LiveDirectory.status-filter == status ? "(•)" : "( )";
            on: !LiveDirectory.status-any && LiveDirectory.status-filter == status;
            label: LiveDirectoryWords.status(status).to-lowercase();
            clicked => {
                LiveDirectory.set-status(false, status);
            }
        }
    }
    FacetHead {
        text: LiveViewWords.facet-category();
    }
    FacetRow {
        mark: LiveDirectory.chosen-category == LiveCategory.none ? "(•)" : "( )";
        on: LiveDirectory.chosen-category == LiveCategory.none;
        label: LiveViewWords.any();
        clicked => {
            LiveDirectory.set-category(LiveCategory.none);
        }
    }
    for option in LiveDirectory.category-options: FacetRow {
        mark: option.chosen ? "(•)" : "( )";
        on: option.chosen;
        label: LiveDirectoryWords.category(option.category).to-lowercase();
        count: option.count;
        clicked => {
            LiveDirectory.set-category(option.category);
        }
    }
    FacetHead {
        text: LiveViewWords.facet-language();
    }
    FacetRow {
        mark: LiveDirectory.chosen-language == "" ? "(•)" : "( )";
        on: LiveDirectory.chosen-language == "";
        label: LiveViewWords.any();
        clicked => {
            LiveDirectory.set-language("");
        }
    }
    for option in LiveDirectory.language-options: FacetRow {
        mark: option.chosen ? "(•)" : "( )";
        on: option.chosen;
        label: option.label;
        count: option.count;
        clicked => {
            LiveDirectory.set-language(option.key);
        }
    }
    FacetHead {
        text: LiveViewWords.facet-content();
    }
    FacetRow {
        mark: LiveDirectory.show-mature ? "[x]" : "[ ]";
        on: LiveDirectory.show-mature;
        label: LiveViewWords.mature-rated();
        count: LiveDirectory.hidden-mature > 0 ? LiveDirectory.hidden-mature : -1;
        clicked => {
            LiveDirectory.content-asking = true;
        }
    }
}

// The view's side column, under the theme's heading: the four places, then the channels followed,
// live ones first. Terminal's has its tabs, Discover's facets and the places' rows. It stays while
// Watch is open, as the canvas keeps it (round 10: the Live column never folds away; round 13 has
// no menu to bring it back), so LiveDirectory.column-open changes nothing here.
export component LiveList {
    property <int> live-count: LiveDirectory.following-live.length;
    property <int> off-count: LiveDirectory.following-off.length;

    VerticalLayout {
        if !Look.terminal: VerticalLayout {
            if Look.broadsheet: HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                Text {
                    text: LiveViewWords.column-line();
                    color: Look.accent-ink;
                    font-size: 13px;
                    overflow: elide;
                }
            }
            VerticalLayout {
                padding-left: Look.broadsheet ? 12px : 8px;
                padding-right: Look.broadsheet ? 12px : 8px;
                padding-top: Look.broadsheet ? 14px : 2px;
                padding-bottom: Look.broadsheet ? 6px : 10px;
                spacing: Look.broadsheet ? 0px : 2px;
                NavRow {
                    section: LiveSection.discover;
                    icon: "compass";
                    letter: "A";
                }
                NavRow {
                    section: LiveSection.following;
                    icon: "star";
                    letter: "B";
                    count: root.live-count > 0 ? LiveViewWords.live-count(root.live-count) : "";
                    hot: root.live-count > 0;
                }
                NavRow {
                    section: LiveSection.broadcast;
                    icon: "video-camera";
                    letter: "C";
                    count: Live.on-air ? LiveViewWords.on-air() : "";
                    hot: Live.on-air;
                }
                NavRow {
                    section: LiveSection.connections;
                    icon: "plugs-connected";
                    letter: "D";
                }
            }
            Flickable {
                vertical-stretch: 1;
                mouse-drag-pan-enabled: false;
                VerticalLayout {
                    alignment: start;
                    padding-left: Look.broadsheet ? 20px : 0px;
                    padding-right: Look.broadsheet ? 20px : 0px;
                    padding-top: Look.broadsheet ? 8px : 0px;
                    padding-bottom: Look.broadsheet ? 12px : 8px;
                    spacing: Look.broadsheet ? 14px : 0px;
                    if root.live-count > 0: VerticalLayout {
                        GroupLabel {
                            text: LiveViewWords.following-live();
                        }
                        for channel in LiveDirectory.following-live: ColumnRow {
                            channel: channel;
                        }
                    }
                    if root.off-count > 0: VerticalLayout {
                        GroupLabel {
                            text: LiveViewWords.not-live-now();
                        }
                        for channel in LiveDirectory.following-off: ColumnRow {
                            channel: channel;
                        }
                    }
                    if root.live-count == 0 && root.off-count == 0: HorizontalLayout {
                        padding-left: Look.broadsheet ? 0px : 14px;
                        padding-right: Look.broadsheet ? 0px : 14px;
                        padding-top: Look.broadsheet ? 0px : 10px;
                        Paragraph {
                            text: LiveViewWords.column-empty();
                            color: Look.faint;
                            font-size: Look.broadsheet ? 14px : 12px;
                            line-height-factor: Look.leading(1.5);
                        }
                    }
                }
            }
        }

        if Look.terminal: VerticalLayout {
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 12px;
                padding-bottom: 8px;
                spacing: 12px;
                alignment: start;
                TabWord {
                    text: LiveViewWords.tab-discover();
                    section: LiveSection.discover;
                }
                TabWord {
                    text: LiveViewWords.tab-following();
                    section: LiveSection.following;
                }
                TabWord {
                    text: LiveViewWords.tab-broadcast();
                    section: LiveSection.broadcast;
                }
                TabWord {
                    text: LiveViewWords.tab-connections();
                    section: LiveSection.connections;
                }
            }
            Flickable {
                vertical-stretch: 1;
                mouse-drag-pan-enabled: false;
                VerticalLayout {
                    alignment: start;
                    if LiveDirectory.section == LiveSection.discover: Facets { }
                    if LiveDirectory.section == LiveSection.following: VerticalLayout {
                        padding-bottom: 6px;
                        if root.live-count + root.off-count == 0: RuleHead {
                            text: LiveViewWords.nothing-followed();
                        }
                        if root.live-count > 0: RuleHead {
                            text: LiveViewWords.live-confirmed();
                        }
                        for channel in LiveDirectory.following-live: FollowedRow {
                            channel: channel;
                        }
                        if root.off-count > 0: RuleHead {
                            text: LiveViewWords.not-confirmed-unknown();
                        }
                        for channel in LiveDirectory.following-off: FollowedRow {
                            visible: channel.status != LiveStatus.offline;
                            height: channel.status != LiveStatus.offline ? 26px : 0px;
                            channel: channel;
                        }
                        if root.off-count > 0: RuleHead {
                            text: LiveViewWords.offline();
                        }
                        for channel in LiveDirectory.following-off: FollowedRow {
                            visible: channel.status == LiveStatus.offline;
                            height: channel.status == LiveStatus.offline ? 26px : 0px;
                            channel: channel;
                        }
                    }
                    if LiveDirectory.section == LiveSection.broadcast: VerticalLayout {
                        padding-bottom: 6px;
                        RuleHead {
                            text: LiveViewWords.send-to();
                        }
                        for target[index] in Live.targets: TerminalRow {
                            selected: index == Live.target;
                            dot: "■";
                            dot-color: Look.ok;
                            name: target.story ? LiveWords.my-story() : target.name;
                            code: "tg";
                            clicked => {
                                Live.choose-target(index);
                            }
                        }
                        RuleHead {
                            text: LiveViewWords.send-with();
                        }
                        TerminalRow {
                            dot: "■";
                            dot-color: Look.faint;
                            name: LiveViewWords.built-in-row();
                            code: "cam+mic";
                            enabled: false;
                        }
                        HorizontalLayout {
                            padding-left: 34px;
                            Text {
                                height: 18px;
                                text: LiveViewWords.not-in-this-version().to-lowercase();
                                color: Look.faint;
                                font-size: 12px;
                            }
                        }
                        TerminalRow {
                            selected: true;
                            dot: "■";
                            dot-color: Look.ok;
                            name: LiveViewWords.obs-row();
                            code: "rtmps";
                        }
                    }
                    if LiveDirectory.section == LiveSection.connections: VerticalLayout {
                        padding-bottom: 6px;
                        RuleHead {
                            text: LiveViewWords.add();
                        }
                        TerminalRow {
                            selected: true;
                            dot: "■";
                            dot-color: Look.ok;
                            name: LiveViewWords.open-a-link-row();
                        }
                        TerminalRow {
                            dot: "■";
                            name: LiveViewWords.submit-row();
                            code: "pub";
                            enabled: false;
                        }
                        RuleHead {
                            text: LiveViewWords.broadcast-to();
                        }
                        TerminalRow {
                            dot: "■";
                            name: LiveViewWords.not-in-this-version().to-lowercase();
                            enabled: false;
                        }
                        RuleHead {
                            text: LiveViewWords.private-servers();
                        }
                        TerminalRow {
                            dot: "■";
                            name: LiveViewWords.not-in-this-version().to-lowercase();
                            enabled: false;
                        }
                    }
                }
            }
        }
    }
}

// ---- the pane ---------------------------------------------------------------------------------------

// A short note at the foot of the view, for a few seconds.
component Toast inherits Rectangle {
    width: words.preferred-width + 28px;
    height: words.preferred-height + 18px;
    border-radius: Look.radius;
    background: Look.text;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #00000033;

    words := Text {
        text: LiveDirectoryWords.toast(LiveDirectory.toast, LiveDirectory.toast-name);
        color: Look.bg;
        font-size: 13px;
    }
}

// A choice of the content setting's question: its ring, its name, what it means.
component Choice inherits Rectangle {
    in property <string> label;
    in property <string> line;
    in property <bool> on;
    callback clicked();
    height: row.preferred-height;

    row := HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            alignment: start;
            padding-top: 2px;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                border-width: root.on ? 5px : 1.5px;
                border-color: root.on ? Look.accent : Look.line-strong;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;
            Text {
                text: root.label;
                color: Look.text;
                font-size: 14px;
                font-weight: 600;
                wrap: word-wrap;
            }
            Paragraph {
                text: root.line;
                color: Look.muted;
                font-size: 13px;
                line-height-factor: Look.leading(1.45);
            }
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// The content setting (Settings › Live, and Discover's notice): whether mature-rated channels show.
// Showing them asks for the self-declaration first.
component ContentQuestion inherits Rectangle {
    property <bool> shown: LiveDirectory.show-mature;
    property <bool> adult;
    property <bool> blocked: root.shown && !LiveDirectory.show-mature && !root.adult;
    background: #00000059;

    TouchArea {
        clicked => {
            LiveDirectory.content-asking = false;
        }
    }

    Rectangle {
        width: min(540px, root.width - 48px);
        height: card.preferred-height;
        border-radius: Look.dialog-radius;
        background: Look.bg;
        drop-shadow-blur: 32px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: #00000040;
        TouchArea { }
        card := VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 22px;
            padding-bottom: 20px;
            spacing: 12px;
            Text {
                text: Look.heading-prefix + LiveContentWords.title();
                color: Look.text;
                font-size: 18px;
                font-weight: 600;
            }
            Paragraph {
                text: LiveContentWords.intro();
                color: Look.muted;
                font-size: 14px;
                line-height-factor: Look.leading(1.55);
            }
            VerticalLayout {
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 8px;
                Choice {
                    label: LiveContentWords.hidden();
                    line: LiveContentWords.hidden-line();
                    on: !root.shown;
                    clicked => {
                        root.shown = false;
                    }
                }
                Choice {
                    label: LiveContentWords.shown();
                    line: LiveContentWords.shown-line();
                    on: root.shown;
                    clicked => {
                        root.shown = true;
                    }
                }
            }
            if root.shown && !LiveDirectory.show-mature: Rectangle {
                height: adult-row.preferred-height;
                adult-row := HorizontalLayout {
                    padding-left: 26px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: start;
                        padding-top: 2px;
                        Rectangle {
                            width: 16px;
                            height: 16px;
                            border-radius: Look.button-radius;
                            border-width: 1.5px;
                            border-color: root.adult ? Look.accent : Look.line-strong;
                            background: root.adult ? Look.accent : transparent;
                            if root.adult: Icon {
                                name: "check";
                                size: 12px;
                                color: Look.on-accent;
                            }
                        }
                    }
                    Paragraph {
                        horizontal-stretch: 1;
                        text: LiveContentWords.adult();
                        color: Look.text;
                        font-size: 14px;
                        line-height-factor: Look.leading(1.45);
                    }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.adult = !root.adult;
                    }
                }
            }
            Rectangle {
                height: rules.preferred-height;
                border-radius: Look.radius;
                background: Look.side;
                rules := VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 6px;
                    for rule[index] in [LiveContentWords.general(), LiveContentWords.mature(), LiveContentWords.explicit(), LiveContentWords.prohibited()]: HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            alignment: start;
                            padding-top: 2px;
                            Icon {
                                name: ["check-circle", "eye-slash", "hourglass", "prohibit"][index];
                                size: 15px;
                                color: Look.faint;
                            }
                        }
                        Paragraph {
                            horizontal-stretch: 1;
                            text: rule;
                            color: Look.muted;
                            font-size: 13px;
                            line-height-factor: Look.leading(1.5);
                        }
                    }
                }
            }
            HorizontalLayout {
                padding-top: 4px;
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: LiveContentWords.where();
                    color: Look.faint;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                LiveButton {
                    height: 34px;
                    text: LiveWords.cancel();
                    clicked => {
                        LiveDirectory.content-asking = false;
                    }
                }
                LiveButton {
                    height: 34px;
                    padding-x: 16px;
                    text: LiveContentWords.save() + Look.enter-hint;
                    primary: true;
                    enabled: !root.blocked;
                    clicked => {
                        LiveDirectory.set-show-mature(root.shown);
                    }
                }
            }
        }
    }
}

// The words of the content setting's question (the canvas's dv.mat).
global LiveContentWords {
    public pure function title() -> string { return @tr("Content in Live"); }
    public pure function intro() -> string {
        return @tr("Live sorts what it lists into four classes. Only the first two can appear in this version; what you can change here is whether mature-rated streams show.");
    }
    public pure function hidden() -> string { return @tr("Mature-rated: hidden"); }
    public pure function hidden-line() -> string { return @tr("Default. They don’t appear in Discover, search or suggestions."); }
    public pure function shown() -> string { return @tr("Mature-rated: shown, marked “Mature”"); }
    public pure function shown-line() -> string { return @tr("They appear with a Mature tag; opening one asks first."); }
    public pure function adult() -> string {
        return @tr("I’m 18 or older — a self-declaration, accepted only where the law doesn’t require verification");
    }
    public pure function general() -> string { return @tr("General — listed and shown by default."); }
    public pure function mature() -> string {
        return @tr("Mature-rated (strong language, violence, gambling, horror — rated by the source) — listed, hidden until shown here.");
    }
    public pure function explicit() -> string {
        return @tr("Sexually explicit — not in the directory in this version. Whether and how to list it is a pending policy decision, not a setting.");
    }
    public pure function prohibited() -> string {
        return @tr("Prohibited (illegal content, including non-consensual or underage material) — never indexed, shown or played.");
    }
    public pure function where() -> string { return @tr("Settings › Live › Content"); }
    public pure function save() -> string { return @tr("Save"); }
}

// The pane in the messages' place while the view is open: the place chosen in the column, or
// Watch over it.
export component LivePane inherits Rectangle {
    // A Telegram stream open outside the directory (a chat's live bar, going live, the user's own
    // as its host); one opened through the directory and left plays in the mini player.
    property <bool> telegram-outside: !LiveDirectory.watching && Live.open-id != "" && !(LiveDirectory.mini && LiveDirectory.channel.source == LiveSource.telegram);
    property <bool> watch: LiveDirectory.watching || root.telegram-outside;
    property <bool> telegram: root.telegram-outside || (LiveDirectory.watching && LiveDirectory.channel.source == LiveSource.telegram && Live.open-id != "");
    background: Look.bg;

    if !root.watch && LiveDirectory.section == LiveSection.discover: LiveDiscover { }
    if !root.watch && LiveDirectory.section == LiveSection.following: FollowingPage { }
    if !root.watch && LiveDirectory.section == LiveSection.broadcast: BroadcastPage { }
    if !root.watch && LiveDirectory.section == LiveSection.connections: ConnectionsPage { }
    if root.watch: WatchPage {
        telegram: root.telegram;
        back => {
            if LiveDirectory.watching {
                LiveDirectory.back();
            } else {
                Live.close();
            }
        }
    }
    if Live.ending: EndQuestion { }
    if LiveDirectory.toast != LiveToast.none: Toast {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 28px;
    }
    if LiveDirectory.content-asking: ContentQuestion { }
}

// ---- the mini player ----------------------------------------------------------------------------

// The stream left playing while the user is elsewhere (the canvas's "chats" scene): its picture,
// pause and sound, back to Watch, the pop-out window, stop. Each theme puts
// it at the foot of its window, over the chats as over the view.
export component LiveMini inherits Rectangle {
    property <LiveChannel> channel: LiveDirectory.channel;
    // Telegram's streams have no pause: they come a second at a time.
    property <bool> telegram: root.channel.source == LiveSource.telegram;
    property <int> viewers: root.telegram ? Live.viewers : root.channel.viewers;
    width: 300px;
    height: box.preferred-height;
    border-radius: Look.workbench ? 10px : Look.broadsheet ? 4px : 3px;
    background: #0b0c0e;
    clip: true;
    drop-shadow-blur: 32px;
    drop-shadow-offset-y: 12px;
    drop-shadow-color: #0000004d;

    // The clicks are the mini player's, not the page's under it.
    TouchArea { }

    box := VerticalLayout {
        Rectangle {
            height: root.width * 9 / 16;
            background: #000000;
            if Live.frame.width > 0: Image {
                width: parent.width;
                height: parent.height;
                source: Live.frame;
                image-fit: contain;
            }
            Rectangle {
                x: 8px;
                y: 8px;
                height: 16px;
                width: mark.preferred-width + 10px;
                border-radius: LiveShape.pill-radius;
                background: LiveShape.live-on-dark;
                mark := Text {
                    text: LiveWords.live-mark();
                    color: #ffffff;
                    font-size: 10px;
                    font-weight: 600;
                    letter-spacing: 0.5px;
                }
            }
            if !Look.terminal: Rectangle {
                y: parent.height - self.height;
                height: 50px;
                background: @linear-gradient(180deg, #00000000 0%, #000000bf 100%);
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    padding-top: 18px;
                    padding-bottom: 4px;
                    spacing: 2px;
                    PictureIcon {
                        width: 28px;
                        height: 28px;
                        icon-size: 15px;
                        icon: LiveDirectory.paused ? "play-filled" : "pause-filled";
                        label: LiveDirectory.paused ? LiveViewWords.play() : LiveViewWords.pause();
                        enabled: !root.telegram;
                        clicked => {
                            LiveDirectory.toggle-pause();
                        }
                    }
                    PictureIcon {
                        width: 28px;
                        height: 28px;
                        icon-size: 15px;
                        icon: Live.muted ? "speaker-x" : "speaker-high";
                        label: Live.muted ? LiveViewWords.unmute() : LiveViewWords.mute();
                        clicked => {
                            Live.toggle-mute();
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    PictureIcon {
                        width: 28px;
                        height: 28px;
                        icon-size: 15px;
                        icon: "arrows-out-simple";
                        label: LiveViewWords.back-to-live();
                        clicked => {
                            Live.show-requests += 1;
                            LiveDirectory.resume();
                        }
                    }
                    // The pop-out window, on top of every app: a directory's stream (Telegram's play here).
                    PictureIcon {
                        width: 28px;
                        height: 28px;
                        icon-size: 15px;
                        icon: "picture-in-picture";
                        label: LiveViewWords.pop-out();
                        enabled: LiveDirectory.channel.source != LiveSource.telegram;
                        clicked => {
                            LiveDirectory.pop-out();
                        }
                    }
                    PictureIcon {
                        width: 28px;
                        height: 28px;
                        icon-size: 15px;
                        icon: "x";
                        label: LiveViewWords.stop();
                        clicked => {
                            LiveDirectory.stop();
                        }
                    }
                }
            }
        }
        Rectangle {
            height: 30px;
            background: #15171a;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: root.channel.name;
                    color: #ffffff;
                    font-size: 12px;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                }
                Text {
                    text: LiveDirectory.paused && !root.telegram ? LiveViewWords.paused()
                        : LiveDirectoryWords.source(root.channel.source) + (root.viewers >= 0 ? " · " + root.viewers : "");
                    color: #ffffff99;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }
        if Look.terminal: Rectangle {
            height: 24px;
            background: #15171a;
            Rectangle {
                y: 0;
                height: 1px;
                background: #ffffff14;
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    PictureWord {
                        text: LiveViewWords.mini-play-word(LiveDirectory.paused);
                        ink: #cfd5d1;
                        font-size: 11px;
                        enabled: !root.telegram;
                        clicked => {
                            LiveDirectory.toggle-pause();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    PictureWord {
                        text: LiveViewWords.mini-mute-word(Live.muted);
                        ink: #cfd5d1;
                        font-size: 11px;
                        clicked => {
                            Live.toggle-mute();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    PictureWord {
                        text: LiveViewWords.mini-live-word();
                        ink: #cfd5d1;
                        font-size: 11px;
                        clicked => {
                            Live.show-requests += 1;
                            LiveDirectory.resume();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    PictureWord {
                        text: LiveViewWords.pop-out-word();
                        ink: #cfd5d1;
                        font-size: 11px;
                        enabled: LiveDirectory.channel.source != LiveSource.telegram;
                        clicked => {
                            LiveDirectory.pop-out();
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    PictureWord {
                        text: "[x]";
                        ink: #cfd5d1;
                        font-size: 11px;
                        clicked => {
                            LiveDirectory.stop();
                        }
                    }
                }
            }
        }
    }
}
