// Voice input's panel in the toolbox, the AI category's second tool (src/speech/,
// docs/voice-input.md): the switch that puts the sparkle in the composer, then, while it is on, the
// connections the user added (each a name, an API format, an address and a key: a vendor's, a
// relay's, a server of the user's own), the main languages the user speaks, and for the one in use
// its abilities, each a connection and a model: the speech recognition and the tidying; last, voice
// messages. No design round draws it: it has the AI access panel's shape (ui/pages/ai-access.slint)
// and the settings' own rows, in every theme.
import { Look } from "../look.slint";
import { Icon, Field, SectionLabel, Heading, Paragraph, Link } from "../widgets.slint";
import { Card, Separator, SwitchRow, SmallButton, Chip } from "rows.slint";
import { Voice, VoiceWords, VoiceChoiceRow } from "../voice.slint";
import { Toolbox, ToolboxWords } from "../toolbox.slint";

// A row's head: an icon, what it is, and a line under it.
component RowHead {
    in property <string> icon;
    in property <string> title;
    in property <string> note;
    HorizontalLayout {
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                size: 20px;
                color: Look.accent;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                color: Look.text;
                font-size: 15px;
                font-weight: 500;
            }
            if root.note != "": Paragraph {
                text: root.note;
                color: Look.muted;
                font-size: 13px;
            }
        }
    }
}

// A line of words under a row, faint, a warning, or a good word.
component Note {
    in property <string> text;
    in property <int> tone;             // 0 faint, 1 a warning, 2 a good word
    HorizontalLayout {
        padding-left: 34px;
        Paragraph {
            text: root.text;
            color: root.tone == 2 ? Look.ok : root.tone == 1 ? Look.danger : Look.muted;
            font-size: 13px;
        }
    }
}

// The main languages set up, as chips (the one in use on), and Add; while adding, the languages
// that can be.
component LanguagesRow {
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 14px;
        spacing: 10px;
        RowHead {
            icon: "translate";
            title: VoiceWords.main-language();
            note: VoiceWords.main-language-note();
        }
        HorizontalLayout {
            padding-left: 34px;
            VerticalLayout {
                spacing: 8px;
                for row[index] in Voice.language-rows: HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    for language in row.languages: Chip {
                        label: VoiceWords.language-label(language.name);
                        on: language.on;
                        clicked => {
                            Voice.choose-language(language.code);
                        }
                    }
                    // Add, after the last chip.
                    if index == Voice.language-rows.length - 1: Chip {
                        label: "+ " + VoiceWords.add-language();
                        on: Voice.adding;
                        clicked => {
                            if Voice.adding {
                                Voice.cancel-adding();
                            } else {
                                Voice.start-adding();
                            }
                        }
                    }
                }
            }
        }
        if Voice.adding: HorizontalLayout {
            padding-left: 34px;
            VerticalLayout {
                spacing: 8px;
                for row in Voice.addable-rows: HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    for language in row.languages: Chip {
                        label: VoiceWords.language-label(language.name);
                        clicked => {
                            Voice.add-language(language.code);
                        }
                    }
                }
            }
        }
    }
}

// A box that keeps what is typed (empty: what is shown faint), what is wrong with it, and a
// callback once the typing is done (⏎, or leaving it).
component TextRow {
    in property <string> icon;
    in property <string> title;
    in property <string> note;
    in property <string> placeholder;
    in property <string> problem;
    in property <string> font-family: Look.mono;
    in-out property <string> text;
    callback edited(string);
    callback done();
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 8px;
        RowHead {
            icon: root.icon;
            title: root.title;
            note: root.note;
        }
        HorizontalLayout {
            padding-left: 34px;
            Field {
                height: 36px;
                text <=> root.text;
                // The page's colour: on the card's own (Broadsheet's cards and fields share one,
                // with no ring) the box would not show.
                fill: Look.bg;
                font-size: 14px;
                font-family: root.font-family;
                placeholder: root.placeholder;
                error: root.problem != "";
                edited(text) => {
                    root.edited(text);
                }
                accepted => {
                    root.done();
                }
                changed has-focus => {
                    if !self.has-focus {
                        root.done();
                    }
                }
            }
        }
        if root.problem != "": Note {
            text: root.problem;
            tone: 1;
        }
    }
}

// A connection in the list: its name, its format and host, its key's letters; a click opens it
// for editing, or closes it.
component ConnectionRow inherits Rectangle {
    in property <string> label;
    in property <string> format;
    in property <string> host;
    in property <bool> has-key;
    in property <string> key-hint;
    in property <bool> open;
    callback clicked();
    background: touch.has-hover ? Look.sel : transparent;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: "plugs-connected";
                size: 20px;
                color: Look.accent;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.label;
                color: Look.text;
                font-size: 15px;
                font-weight: 500;
                overflow: elide;
            }
            Text {
                text: VoiceWords.format-name(root.format) + (root.host != "" ? " · " + root.host : "");
                color: Look.muted;
                font-size: 13px;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.has-key ? root.key-hint : VoiceWords.no-key();
                color: root.has-key ? Look.muted : Look.faint;
                font-family: Look.mono;
                font-size: 13px;
            }
        }
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.open ? "caret-down" : "caret-right";
                size: 14px;
                color: Look.faint;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// The open connection's key: a box to paste it into, or its letters and Remove once it is kept;
// under them, what the last check said, and where the vendor's keys are made.
component KeyRow {
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 14px;
            RowHead {
                horizontal-stretch: 1;
                icon: "key";
                title: VoiceWords.key();
                note: VoiceWords.key-note();
            }
            if Voice.connection-has-key: VerticalLayout {
                alignment: center;
                Text {
                    text: Voice.connection-key-hint;
                    color: Look.muted;
                    font-family: Look.mono;
                    font-size: 13px;
                }
            }
            if Voice.connection-has-key: VerticalLayout {
                alignment: center;
                SmallButton {
                    text: Look.terminal ? "[" + VoiceWords.remove().to-lowercase() + "]" : VoiceWords.remove();
                    quiet: Look.terminal;
                    clicked => {
                        Voice.remove-connection-key();
                    }
                }
            }
        }
        if !Voice.connection-has-key: HorizontalLayout {
            padding-left: 34px;
            spacing: 8px;
            key-field := Field {
                horizontal-stretch: 1;
                height: 36px;
                fill: Look.bg;
                font-size: 14px;
                font-family: Look.mono;
                input-type: InputType.password;
                placeholder: VoiceWords.key-placeholder();
                accepted(text) => {
                    Voice.save-connection-key(text);
                }
            }
            VerticalLayout {
                alignment: center;
                SmallButton {
                    text: Look.terminal ? "[" + VoiceWords.save().to-lowercase() + "]" : VoiceWords.save();
                    primary: !Look.terminal;
                    clicked => {
                        Voice.save-connection-key(key-field.text);
                    }
                }
            }
        }
        if VoiceWords.check-text() != "": Note {
            text: VoiceWords.check-text();
            tone: VoiceWords.check-tone();
        }
        if !Voice.connection-has-key && Voice.connection-official: HorizontalLayout {
            padding-left: 34px;
            Link {
                text: VoiceWords.get-key(VoiceWords.vendor(Voice.connection-format));
                trailing-icon: "arrow-square-out";
                font-size: 13px;
                clicked => {
                    Voice.open-key-page();
                }
            }
        }
    }
}

// The open connection: its name, its format, its address, its key, and its removal.
component ConnectionForm inherits Rectangle {
    height: form.preferred-height;
    background: Look.bg.transparentize(0.6);
    form := VerticalLayout {
        TextRow {
            icon: "pencil-simple";
            title: VoiceWords.name();
            note: VoiceWords.name-note();
            font-family: Look.font;
            text <=> Voice.connection-label;
            edited(text) => {
                Voice.edit-connection-label(text);
            }
        }
        Separator { }
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 12px;
            padding-bottom: 14px;
            spacing: 10px;
            RowHead {
                icon: "plugs";
                title: VoiceWords.api-format();
                note: VoiceWords.format-note(Voice.connection-format);
            }
            HorizontalLayout {
                padding-left: 34px;
                VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        for format in ["openai", "anthropic", "gemini"]: Chip {
                            label: VoiceWords.format-name(format);
                            on: Voice.connection-format == format;
                            clicked => {
                                Voice.set-connection-format(format);
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        for format in ["dashscope", "doubao"]: Chip {
                            label: VoiceWords.format-name(format);
                            on: Voice.connection-format == format;
                            clicked => {
                                Voice.set-connection-format(format);
                            }
                        }
                    }
                }
            }
        }
        Separator { }
        TextRow {
            icon: "globe-simple";
            title: VoiceWords.address();
            note: VoiceWords.address-note();
            placeholder: Voice.connection-url-placeholder;
            problem: VoiceWords.address-problem(Voice.connection-url-problem);
            text <=> Voice.connection-url;
            edited(text) => {
                Voice.edit-connection-url(text);
            }
            done => {
                Voice.check-connection();
            }
        }
        Separator { }
        KeyRow { }
        HorizontalLayout {
            padding-left: 50px;
            padding-bottom: 14px;
            alignment: start;
            Link {
                text: VoiceWords.remove-connection();
                icon: "trash";
                font-size: 13px;
                clicked => {
                    Voice.remove-connection();
                }
            }
        }
    }
}

// The connection an ability takes: the ones that can do it as chips, in lines; or that none can.
component ChoiceRow {
    in property <string> which;
    in property <[VoiceChoiceRow]> rows;
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 14px;
        spacing: 10px;
        RowHead {
            icon: "plugs-connected";
            title: VoiceWords.connection();
            note: root.rows.length == 0 ? VoiceWords.none-can() : "";
        }
        if root.rows.length > 0: HorizontalLayout {
            padding-left: 34px;
            VerticalLayout {
                spacing: 8px;
                for row in root.rows: HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    for choice in row.choices: Chip {
                        label: VoiceWords.choice-label(choice);
                        on: choice.on;
                        clicked => {
                            Voice.choose(root.which, choice.id);
                        }
                    }
                }
            }
        }
    }
}

// How an OpenAI connection hears: as the user speaks, or the recording at the end.
component ModeRow {
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 14px;
        spacing: 10px;
        RowHead {
            icon: "microphone";
            title: VoiceWords.mode();
            note: VoiceWords.mode-note(Voice.speech-mode);
        }
        HorizontalLayout {
            padding-left: 34px;
            alignment: start;
            spacing: 8px;
            Chip {
                label: VoiceWords.mode-realtime();
                on: Voice.speech-mode != "upload";
                clicked => {
                    Voice.set-mode("realtime");
                }
            }
            Chip {
                label: VoiceWords.mode-upload();
                on: Voice.speech-mode == "upload";
                clicked => {
                    Voice.set-mode("upload");
                }
            }
        }
    }
}

export component VoicePanel {
    VerticalLayout {
        max-width: 600px;
        spacing: 26px;
        alignment: start;
        VerticalLayout {
            spacing: 12px;
            // Back to the AI category's cards.
            Link {
                text: ToolboxWords.ai();
                icon: "caret-left";
                clicked => {
                    Toolbox.choose("ai");
                }
            }
            Heading {
                label: VoiceWords.voice-input();
            }
            Paragraph {
                text: VoiceWords.about();
                color: Look.muted;
                font-size: 15px;
                line-height-factor: Look.leading(1.6);
            }
        }
        Card {
            SwitchRow {
                icon: "sparkle";
                title: VoiceWords.switch-title();
                description: VoiceWords.switch-note();
                on: Voice.on;
                toggled => {
                    Voice.set-on(!Voice.on);
                }
            }
        }
        if Voice.on: VerticalLayout {
            spacing: 8px;
            SectionLabel {
                label: VoiceWords.connections();
            }
            Paragraph {
                text: VoiceWords.connections-note();
                color: Look.muted;
                font-size: 13px;
            }
            Card {
                for row[index] in Voice.connections: VerticalLayout {
                    if index > 0: Separator { }
                    ConnectionRow {
                        label: row.label;
                        format: row.format;
                        host: row.host;
                        has-key: row.has-key;
                        key-hint: row.key-hint;
                        open: Voice.open-connection == row.id;
                        clicked => {
                            Voice.toggle-connection(row.id);
                        }
                    }
                    if Voice.open-connection == row.id: Separator { }
                    if Voice.open-connection == row.id: ConnectionForm { }
                }
                if Voice.connections.length > 0: Separator { }
                Rectangle {
                    height: add-row.preferred-height;
                    background: add-touch.has-hover ? Look.sel : transparent;
                    add-row := HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 14px;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "plus";
                                size: 20px;
                                color: Look.accent;
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: VoiceWords.add-connection();
                            color: Look.accent-ink;
                            font-size: 15px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }
                    add-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Voice.add-connection();
                        }
                    }
                }
            }
        }
        if Voice.on: Card {
            LanguagesRow { }
        }
        if Voice.on: VerticalLayout {
            spacing: 8px;
            SectionLabel {
                label: VoiceWords.speech-section(VoiceWords.language-label(Voice.language-name));
            }
            Card {
                ChoiceRow {
                    which: "speech";
                    rows: Voice.speech-choices;
                }
                if Voice.speech-format == "openai": Separator { }
                if Voice.speech-format == "openai": ModeRow { }
                if Voice.speech-format != "": Separator { }
                if Voice.speech-format != "": TextRow {
                    icon: "robot";
                    title: VoiceWords.model();
                    note: VoiceWords.model-note(Voice.speech-format);
                    placeholder: Voice.speech-model-placeholder;
                    text <=> Voice.speech-model;
                    edited(text) => {
                        Voice.edit-model("speech", text);
                    }
                }
                if Voice.speech-format != "": Separator { }
                if Voice.speech-format != "": TextRow {
                    icon: "book-open";
                    title: VoiceWords.keywords();
                    note: VoiceWords.keywords-note();
                    placeholder: VoiceWords.keywords-placeholder();
                    font-family: Look.font;
                    text <=> Voice.keywords;
                    edited(text) => {
                        Voice.edit-keywords(text);
                    }
                }
            }
        }
        if Voice.on: VerticalLayout {
            spacing: 8px;
            SectionLabel {
                label: VoiceWords.tidy-section(VoiceWords.language-label(Voice.language-name));
            }
            Card {
                SwitchRow {
                    icon: "broom";
                    title: VoiceWords.tidy();
                    description: VoiceWords.tidy-note();
                    on: Voice.tidy;
                    toggled => {
                        Voice.set-tidy(!Voice.tidy);
                    }
                }
                if Voice.tidy: Separator { }
                if Voice.tidy: ChoiceRow {
                    which: "tidy";
                    rows: Voice.tidy-choices;
                }
                if Voice.tidy && Voice.tidy-model-placeholder != "": Separator { }
                if Voice.tidy && Voice.tidy-model-placeholder != "": TextRow {
                    icon: "robot";
                    title: VoiceWords.model();
                    note: VoiceWords.model-note("");
                    placeholder: Voice.tidy-model-placeholder;
                    text <=> Voice.tidy-model;
                    edited(text) => {
                        Voice.edit-model("tidy", text);
                    }
                }
            }
            if Voice.can-remove: HorizontalLayout {
                alignment: start;
                padding-top: 4px;
                Link {
                    text: VoiceWords.remove-language(VoiceWords.language-label(Voice.language-name));
                    icon: "trash";
                    font-size: 13px;
                    clicked => {
                        Voice.remove-language();
                    }
                }
            }
        }
        if Voice.on: VerticalLayout {
            spacing: 8px;
            SectionLabel {
                label: VoiceWords.messages-section();
            }
            Card {
                SwitchRow {
                    icon: "chat-circle-text";
                    title: VoiceWords.transcribe-messages();
                    description: VoiceWords.transcribe-messages-note();
                    on: Voice.transcribe-messages;
                    toggled => {
                        Voice.set-transcribe-messages(!Voice.transcribe-messages);
                    }
                }
                if Voice.transcribe-messages: Separator { }
                if Voice.transcribe-messages: ChoiceRow {
                    which: "messages";
                    rows: Voice.message-choices;
                }
                if Voice.transcribe-messages && Voice.messages-model-placeholder != "": Separator { }
                if Voice.transcribe-messages && Voice.messages-model-placeholder != "": TextRow {
                    icon: "robot";
                    title: VoiceWords.model();
                    note: VoiceWords.model-note("");
                    placeholder: Voice.messages-model-placeholder;
                    text <=> Voice.messages-model;
                    edited(text) => {
                        Voice.edit-model("messages", text);
                    }
                }
            }
        }
    }
}
