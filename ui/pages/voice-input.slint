// Voice input's panel in the toolbox, the AI category's second tool (src/speech/,
// docs/voice-input.md): the AI vendors the user added (each a name, an API format, an address and
// a key: a vendor's, a relay's, a server of the user's own), then three AI features, each with its
// own switch, its AI vendor and its model chosen from lists, nothing chosen until the user chooses
// (the maintainer's word of 2026-10-26): voice input (with the main languages, which only tell the
// vendor what is spoken), tidying its words, transcribing voice messages. No design round draws it:
// it has the AI access panel's shape (ui/pages/ai-access.slint) and the settings' own rows, and its
// lists are drawn as the login page's list of countries, in every theme.
import { ListView } from "std-widgets.slint";
import { Look } from "../look.slint";
import { Icon, Field, SectionLabel, Heading, Paragraph, Link } from "../widgets.slint";
import { Card, Separator, SwitchRow, SmallButton, Chip } from "rows.slint";
import { Voice, VoiceWords, VoiceItem } from "../voice.slint";
import { Toolbox, ToolboxWords } from "../toolbox.slint";

// A row's head: an icon, what it is, and a line under it.
component RowHead {
    in property <string> icon;
    in property <string> title;
    in property <string> note;
    HorizontalLayout {
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                size: 20px;
                color: Look.accent;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                color: Look.text;
                font-size: 15px;
                font-weight: 500;
            }
            if root.note != "": Paragraph {
                text: root.note;
                color: Look.muted;
                font-size: 13px;
            }
        }
    }
}

// A line of words under a row, faint, a warning, or a good word.
component Note {
    in property <string> text;
    in property <int> tone;             // 0 faint, 1 a warning, 2 a good word
    HorizontalLayout {
        padding-left: 34px;
        Paragraph {
            text: root.text;
            color: root.tone == 2 ? Look.ok : root.tone == 1 ? Look.danger : Look.muted;
            font-size: 13px;
        }
    }
}

// The main languages set up, as chips (the one in use on), and Add; while adding, the languages
// that can be; the one in use can be removed while there are others.
component LanguagesRow {
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 14px;
        spacing: 10px;
        RowHead {
            icon: "translate";
            title: VoiceWords.main-language();
            note: VoiceWords.main-language-note();
        }
        HorizontalLayout {
            padding-left: 34px;
            VerticalLayout {
                spacing: 8px;
                for row[index] in Voice.language-rows: HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    for language in row.languages: Chip {
                        label: VoiceWords.language-label(language.name);
                        on: language.on;
                        clicked => {
                            Voice.choose-language(language.code);
                        }
                    }
                    // Add, after the last chip.
                    if index == Voice.language-rows.length - 1: Chip {
                        label: "+ " + VoiceWords.add-language();
                        on: Voice.adding;
                        clicked => {
                            if Voice.adding {
                                Voice.cancel-adding();
                            } else {
                                Voice.start-adding();
                            }
                        }
                    }
                }
            }
        }
        if Voice.adding: HorizontalLayout {
            padding-left: 34px;
            VerticalLayout {
                spacing: 8px;
                for row in Voice.addable-rows: HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    for language in row.languages: Chip {
                        label: VoiceWords.language-label(language.name);
                        clicked => {
                            Voice.add-language(language.code);
                        }
                    }
                }
            }
        }
        if Voice.can-remove && !Voice.adding: HorizontalLayout {
            padding-left: 34px;
            alignment: start;
            Link {
                text: VoiceWords.remove-language(VoiceWords.language-label(Voice.language-name));
                icon: "trash";
                font-size: 13px;
                clicked => {
                    Voice.remove-language();
                }
            }
        }
    }
}

// A box that keeps what is typed (empty: what is shown faint), what is wrong with it, and a
// callback once the typing is done (⏎, or leaving it).
component TextRow {
    in property <string> icon;
    in property <string> title;
    in property <string> note;
    in property <string> placeholder;
    in property <string> problem;
    in property <string> font-family: Look.mono;
    in-out property <string> text;
    callback edited(string);
    callback done();
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 8px;
        RowHead {
            icon: root.icon;
            title: root.title;
            note: root.note;
        }
        HorizontalLayout {
            padding-left: 34px;
            Field {
                height: 36px;
                text <=> root.text;
                // The page's colour: on the card's own (Broadsheet's cards and fields share one,
                // with no ring) the box would not show.
                fill: Look.bg;
                font-size: 14px;
                font-family: root.font-family;
                placeholder: root.placeholder;
                error: root.problem != "";
                edited(text) => {
                    root.edited(text);
                }
                accepted => {
                    root.done();
                }
                changed has-focus => {
                    if !self.has-focus {
                        root.done();
                    }
                }
            }
        }
        if root.problem != "": Note {
            text: root.problem;
            tone: 1;
        }
    }
}

// A box that shows what is chosen, or faint what to choose, and the list to choose from below it;
// a long list has a search box over it. Drawn as the login page's list of countries.
component Dropdown {
    in property <string> chosen;            // what the box shows; "" for nothing chosen
    in property <string> placeholder;
    in property <[VoiceItem]> items;
    in property <bool> searchable;
    in property <bool> enabled: true;
    in property <string> font-family: Look.font;
    callback picked(VoiceItem);
    callback search(string);
    min-height: 36px;
    box := Rectangle {
        height: 36px;
        border-radius: Look.radius;
        background: Look.bg;
        border-width: 1px;
        border-color: touch.has-hover && root.enabled ? Look.line-strong : Look.line;
        opacity: root.enabled ? 1 : 0.5;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                text: root.chosen != "" ? root.chosen : root.placeholder;
                color: root.chosen != "" ? Look.text : Look.faint;
                font-size: 14px;
                font-family: root.chosen != "" ? root.font-family : Look.font;
                vertical-alignment: center;
                overflow: elide;
            }
            VerticalLayout {
                alignment: center;
                Icon {
                    name: "caret-down";
                    size: 14px;
                    color: Look.faint;
                }
            }
        }
        touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => {
                root.search("");
                list.show();
            }
        }
    }
    list := PopupWindow {
        x: box.x;
        y: box.y + box.height + 6px;
        width: box.width;
        height: min(320px, (root.searchable ? 42px : 0px) + 16px + max(1, root.items.length) * 34px);
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            border-radius: Look.radius;
            background: Look.bg;
            border-width: 1px;
            border-color: Look.line-strong;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #0000002e;
            clip: true;

            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                if root.searchable: Field {
                    height: 36px;
                    font-size: 14px;
                    padding-x: 10px;
                    placeholder: VoiceWords.search();
                    init => {
                        self.focus-text();
                    }
                    edited(words) => {
                        root.search(words);
                    }
                    accepted => {
                        if root.items.length > 0 {
                            root.picked(root.items[0]);
                            list.close();
                        }
                    }
                }
                if root.items.length == 0: Text {
                    height: 34px;
                    text: VoiceWords.nothing-matches();
                    color: Look.faint;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                ListView {
                    vertical-stretch: 1;
                    vertical-scrollbar-policy: always-off;
                    horizontal-scrollbar-policy: always-off;
                    for item in root.items: Rectangle {
                        height: 34px;
                        border-radius: Look.radius / 2;
                        background: row.has-hover ? Look.sel : item.label == root.chosen ? Look.side : transparent;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                horizontal-stretch: 1;
                                text: item.label;
                                color: Look.text;
                                font-size: 14px;
                                font-family: root.font-family;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        row := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.picked(item);
                                list.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

// A feature's choice from a list: an icon, what it is, the box, and a line under it.
component DropdownRow {
    in property <string> icon;
    in property <string> title;
    in property <string> note;
    in property <string> chosen;
    in property <string> placeholder;
    in property <[VoiceItem]> items;
    in property <bool> searchable;
    in property <bool> enabled: true;
    in property <string> font-family: Look.font;
    in property <string> message;
    in property <int> tone;
    callback picked(VoiceItem);
    callback search(string);
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 8px;
        RowHead {
            icon: root.icon;
            title: root.title;
            note: root.note;
        }
        HorizontalLayout {
            padding-left: 34px;
            Dropdown {
                horizontal-stretch: 1;
                chosen: root.chosen;
                placeholder: root.placeholder;
                items: root.items;
                searchable: root.searchable;
                enabled: root.enabled;
                font-family: root.font-family;
                picked(item) => {
                    root.picked(item);
                }
                search(text) => {
                    root.search(text);
                }
            }
        }
        if root.message != "": Note {
            text: root.message;
            tone: root.tone;
        }
    }
}

// An AI vendor in the list: its name, its format and host, its key's letters; a click opens it
// for editing, or closes it.
component VendorRow inherits Rectangle {
    in property <string> label;
    in property <string> format;
    in property <string> host;
    in property <bool> has-key;
    in property <string> key-hint;
    in property <bool> open;
    callback clicked();
    background: touch.has-hover ? Look.sel : transparent;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: "plugs-connected";
                size: 20px;
                color: Look.accent;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.label != "" ? root.label : VoiceWords.new-vendor();
                color: root.label != "" ? Look.text : Look.muted;
                font-size: 15px;
                font-weight: 500;
                overflow: elide;
            }
            Text {
                text: (root.format != "" ? VoiceWords.format-name(root.format) : VoiceWords.no-format()) + (root.host != "" ? " · " + root.host : "");
                color: Look.muted;
                font-size: 13px;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.has-key ? root.key-hint : VoiceWords.no-key();
                color: root.has-key ? Look.muted : Look.faint;
                font-family: Look.mono;
                font-size: 13px;
            }
        }
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.open ? "caret-down" : "caret-right";
                size: 14px;
                color: Look.faint;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// The open vendor's key: a box to paste it into, or its letters and Remove once it is kept; under
// them, what the last check said, and where the vendor's keys are made.
component KeyRow {
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 14px;
            RowHead {
                horizontal-stretch: 1;
                icon: "key";
                title: VoiceWords.key();
                note: VoiceWords.key-note();
            }
            if Voice.vendor-has-key: VerticalLayout {
                alignment: center;
                Text {
                    text: Voice.vendor-key-hint;
                    color: Look.muted;
                    font-family: Look.mono;
                    font-size: 13px;
                }
            }
            if Voice.vendor-has-key: VerticalLayout {
                alignment: center;
                SmallButton {
                    text: Look.terminal ? "[" + VoiceWords.remove().to-lowercase() + "]" : VoiceWords.remove();
                    quiet: Look.terminal;
                    clicked => {
                        Voice.remove-vendor-key();
                    }
                }
            }
        }
        if !Voice.vendor-has-key: HorizontalLayout {
            padding-left: 34px;
            spacing: 8px;
            key-field := Field {
                horizontal-stretch: 1;
                height: 36px;
                fill: Look.bg;
                font-size: 14px;
                font-family: Look.mono;
                input-type: InputType.password;
                placeholder: VoiceWords.key-placeholder();
                accepted(text) => {
                    Voice.save-vendor-key(text);
                }
            }
            VerticalLayout {
                alignment: center;
                SmallButton {
                    text: Look.terminal ? "[" + VoiceWords.save().to-lowercase() + "]" : VoiceWords.save();
                    primary: !Look.terminal;
                    clicked => {
                        Voice.save-vendor-key(key-field.text);
                    }
                }
            }
        }
        if VoiceWords.check-text() != "": Note {
            text: VoiceWords.check-text();
            tone: VoiceWords.check-tone();
        }
        if !Voice.vendor-has-key && Voice.vendor-official: HorizontalLayout {
            padding-left: 34px;
            Link {
                text: VoiceWords.get-key(VoiceWords.vendor(Voice.vendor-format));
                trailing-icon: "arrow-square-out";
                font-size: 13px;
                clicked => {
                    Voice.open-key-page();
                }
            }
        }
    }
}

// The open vendor: its name, its format, its address, its key, and its removal.
component VendorForm inherits Rectangle {
    height: form.preferred-height;
    background: Look.bg.transparentize(0.6);
    form := VerticalLayout {
        TextRow {
            icon: "pencil-simple";
            title: VoiceWords.name();
            note: VoiceWords.name-note();
            font-family: Look.font;
            text <=> Voice.vendor-label;
            edited(text) => {
                Voice.edit-vendor-label(text);
            }
        }
        Separator { }
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 12px;
            padding-bottom: 14px;
            spacing: 10px;
            RowHead {
                icon: "plugs";
                title: VoiceWords.api-format();
                note: VoiceWords.format-note(Voice.vendor-format);
            }
            HorizontalLayout {
                padding-left: 34px;
                VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        for format in ["openai", "anthropic", "gemini"]: Chip {
                            label: VoiceWords.format-name(format);
                            on: Voice.vendor-format == format;
                            clicked => {
                                Voice.set-vendor-format(format);
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        for format in ["dashscope", "doubao"]: Chip {
                            label: VoiceWords.format-name(format);
                            on: Voice.vendor-format == format;
                            clicked => {
                                Voice.set-vendor-format(format);
                            }
                        }
                    }
                }
            }
        }
        Separator { }
        TextRow {
            icon: "globe-simple";
            title: VoiceWords.address();
            note: VoiceWords.address-note();
            placeholder: Voice.vendor-url-placeholder;
            problem: VoiceWords.address-problem(Voice.vendor-url-problem);
            text <=> Voice.vendor-url;
            edited(text) => {
                Voice.edit-vendor-url(text);
            }
            done => {
                Voice.check-vendor();
            }
        }
        Separator { }
        KeyRow { }
        HorizontalLayout {
            padding-left: 50px;
            padding-bottom: 14px;
            alignment: start;
            Link {
                text: VoiceWords.remove-vendor();
                icon: "trash";
                font-size: 13px;
                clicked => {
                    Voice.remove-vendor();
                }
            }
        }
    }
}

// How an OpenAI-compatible vendor hears: as the user speaks, or the recording at the end; neither
// until the user chooses.
component ModeRow {
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 14px;
        spacing: 10px;
        RowHead {
            icon: "microphone";
            title: VoiceWords.mode();
            note: VoiceWords.mode-note(Voice.speech-mode);
        }
        HorizontalLayout {
            padding-left: 34px;
            alignment: start;
            spacing: 8px;
            Chip {
                label: VoiceWords.mode-realtime();
                on: Voice.speech-mode == "realtime";
                clicked => {
                    Voice.set-mode("realtime");
                }
            }
            Chip {
                label: VoiceWords.mode-upload();
                on: Voice.speech-mode == "upload";
                clicked => {
                    Voice.set-mode("upload");
                }
            }
        }
    }
}

export component VoicePanel {
    VerticalLayout {
        max-width: 600px;
        spacing: 26px;
        alignment: start;
        VerticalLayout {
            spacing: 12px;
            // Back to the AI category's cards.
            Link {
                text: ToolboxWords.ai();
                icon: "caret-left";
                clicked => {
                    Toolbox.choose("ai");
                }
            }
            Heading {
                label: VoiceWords.voice-input();
            }
            Paragraph {
                text: VoiceWords.about();
                color: Look.muted;
                font-size: 15px;
                line-height-factor: Look.leading(1.6);
            }
        }
        // The AI vendors.
        VerticalLayout {
            spacing: 8px;
            SectionLabel {
                label: VoiceWords.vendors();
            }
            Paragraph {
                text: VoiceWords.vendors-note();
                color: Look.muted;
                font-size: 13px;
            }
            Card {
                for row[index] in Voice.vendors: VerticalLayout {
                    if index > 0: Separator { }
                    VendorRow {
                        label: row.label;
                        format: row.format;
                        host: row.host;
                        has-key: row.has-key;
                        key-hint: row.key-hint;
                        open: Voice.open-vendor == row.id;
                        clicked => {
                            Voice.toggle-vendor(row.id);
                        }
                    }
                    if Voice.open-vendor == row.id: Separator { }
                    if Voice.open-vendor == row.id: VendorForm { }
                }
                if Voice.vendors.length > 0: Separator { }
                Rectangle {
                    height: add-row.preferred-height;
                    background: add-touch.has-hover ? Look.sel : transparent;
                    add-row := HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 14px;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "plus";
                                size: 20px;
                                color: Look.accent;
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: VoiceWords.add-vendor();
                            color: Look.accent-ink;
                            font-size: 15px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }
                    add-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Voice.add-vendor();
                        }
                    }
                }
            }
        }
        // Voice input: its switch is the tool's.
        VerticalLayout {
            spacing: 8px;
            SectionLabel {
                label: VoiceWords.voice-input();
            }
            Card {
                SwitchRow {
                    icon: "sparkle";
                    title: VoiceWords.switch-title();
                    description: VoiceWords.switch-note();
                    on: Voice.on;
                    toggled => {
                        Voice.set-on(!Voice.on);
                    }
                }
                if Voice.on: Separator { }
                if Voice.on: LanguagesRow { }
                if Voice.on: Separator { }
                if Voice.on: DropdownRow {
                    icon: "plugs-connected";
                    title: VoiceWords.ai-vendor();
                    chosen: Voice.speech-vendor-label;
                    placeholder: VoiceWords.choose-vendor();
                    items: Voice.speech-vendors;
                    enabled: Voice.speech-vendors.length > 0;
                    message: Voice.speech-vendors.length == 0 ? VoiceWords.none-can() : "";
                    picked(item) => {
                        Voice.choose-vendor("speech", item.id);
                    }
                }
                if Voice.on && Voice.speech-format == "openai": Separator { }
                if Voice.on && Voice.speech-format == "openai": ModeRow { }
                if Voice.on && Voice.speech-vendor != "": Separator { }
                if Voice.on && Voice.speech-vendor != "": DropdownRow {
                    icon: "robot";
                    title: VoiceWords.model();
                    note: VoiceWords.model-note(Voice.speech-format);
                    chosen: Voice.speech-model;
                    placeholder: VoiceWords.choose-model();
                    items: Voice.speech-models;
                    searchable: true;
                    font-family: Look.mono;
                    message: VoiceWords.models-note(Voice.speech-models-state, Voice.speech-vendor-label, Voice.speech-models-detail);
                    tone: VoiceWords.models-tone(Voice.speech-models-state);
                    picked(item) => {
                        Voice.choose-model("speech", item.id);
                    }
                    search(text) => {
                        Voice.search-models("speech", text);
                    }
                }
                if Voice.on: Separator { }
                if Voice.on: TextRow {
                    icon: "book-open";
                    title: VoiceWords.keywords();
                    note: VoiceWords.keywords-note();
                    placeholder: VoiceWords.keywords-placeholder();
                    font-family: Look.font;
                    text <=> Voice.keywords;
                    edited(text) => {
                        Voice.edit-keywords(text);
                    }
                }
            }
        }
        // Tidying what voice input heard.
        VerticalLayout {
            spacing: 8px;
            SectionLabel {
                label: VoiceWords.tidy-section();
            }
            Card {
                SwitchRow {
                    icon: "broom";
                    title: VoiceWords.tidy();
                    description: VoiceWords.tidy-note();
                    on: Voice.tidy;
                    toggled => {
                        Voice.set-tidy(!Voice.tidy);
                    }
                }
                if Voice.tidy: Separator { }
                if Voice.tidy: DropdownRow {
                    icon: "plugs-connected";
                    title: VoiceWords.ai-vendor();
                    chosen: Voice.tidy-vendor-label;
                    placeholder: VoiceWords.choose-vendor();
                    items: Voice.tidy-vendors;
                    enabled: Voice.tidy-vendors.length > 0;
                    message: Voice.tidy-vendors.length == 0 ? VoiceWords.none-can() : "";
                    picked(item) => {
                        Voice.choose-vendor("tidy", item.id);
                    }
                }
                if Voice.tidy && Voice.tidy-vendor != "": Separator { }
                if Voice.tidy && Voice.tidy-vendor != "": DropdownRow {
                    icon: "robot";
                    title: VoiceWords.model();
                    chosen: Voice.tidy-model;
                    placeholder: VoiceWords.choose-model();
                    items: Voice.tidy-models;
                    searchable: true;
                    font-family: Look.mono;
                    message: VoiceWords.models-note(Voice.tidy-models-state, Voice.tidy-vendor-label, Voice.tidy-models-detail);
                    tone: VoiceWords.models-tone(Voice.tidy-models-state);
                    picked(item) => {
                        Voice.choose-model("tidy", item.id);
                    }
                    search(text) => {
                        Voice.search-models("tidy", text);
                    }
                }
            }
        }
        // Transcribing voice messages.
        VerticalLayout {
            spacing: 8px;
            SectionLabel {
                label: VoiceWords.messages-section();
            }
            Card {
                SwitchRow {
                    icon: "chat-circle-text";
                    title: VoiceWords.transcribe-messages();
                    description: VoiceWords.transcribe-messages-note();
                    on: Voice.transcribe-messages;
                    toggled => {
                        Voice.set-transcribe-messages(!Voice.transcribe-messages);
                    }
                }
                if Voice.transcribe-messages: Separator { }
                if Voice.transcribe-messages: DropdownRow {
                    icon: "plugs-connected";
                    title: VoiceWords.ai-vendor();
                    chosen: Voice.messages-vendor-label;
                    placeholder: VoiceWords.choose-vendor();
                    items: Voice.messages-vendors;
                    enabled: Voice.messages-vendors.length > 0;
                    message: Voice.messages-vendors.length == 0 ? VoiceWords.none-can() : "";
                    picked(item) => {
                        Voice.choose-vendor("messages", item.id);
                    }
                }
                if Voice.transcribe-messages && Voice.messages-vendor != "": Separator { }
                if Voice.transcribe-messages && Voice.messages-vendor != "": DropdownRow {
                    icon: "robot";
                    title: VoiceWords.model();
                    chosen: Voice.messages-model;
                    placeholder: VoiceWords.choose-model();
                    items: Voice.messages-models;
                    searchable: true;
                    font-family: Look.mono;
                    message: VoiceWords.models-note(Voice.messages-models-state, Voice.messages-vendor-label, Voice.messages-models-detail);
                    tone: VoiceWords.models-tone(Voice.messages-models-state);
                    picked(item) => {
                        Voice.choose-model("messages", item.id);
                    }
                    search(text) => {
                        Voice.search-models("messages", text);
                    }
                }
            }
        }
    }
}
