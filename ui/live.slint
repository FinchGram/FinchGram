// Live streams (docs/live-streams.md; the maintainer's word of 2026-11-07, drawn on the canvas
// "FinchGram Live"): Telegram's own, the live stories of contacts and channels and the live
// streams and video chats of chats, a fourth view on the left beside chats, channels and bots.
// FinchGram has no WebRTC: it plays what Telegram serves as a stream (an RTMP stream, from OBS and
// the like), and lists the rest as for the phone. Going live gives the address and key OBS needs.
// Rust fills this global (src/telegram/live.rs); the list and the pane (pages/live.slint) are drawn
// in every theme's look.
import { Moment, ChatKind } from "telegram.slint";

// What a live stream is: a person's or a channel's live story, a channel's live stream, a group's
// video chat.
export enum LiveKind { story, stream, video-chat }

// One live stream in the list.
export struct LiveRow {
    id: string,             // what Live.watch takes
    chat-id: string,
    kind: LiveKind,
    name: string,           // who is live: the person, the channel, the group
    title: string,          // the stream's own title, if it has one
    initial: string,
    picture: image,
    has-picture: bool,
    chat-kind: ChatKind,    // the avatar's colours
    viewers: int,           // -1 while unknown
    playable: bool,         // Telegram serves it as a stream; false: only over WebRTC (the phone)
    mine: bool,             // the user's own: opened as its host
}

// Where the stream open is.
//   idle: none open. joining: joining it and waiting for its first second. waiting: joined, and
//   nothing comes yet (the broadcaster's OBS is not sending). playing. phone: sent over WebRTC
//   only. ended: it is over. failed: it could not be joined (Live.problem says why).
export enum LiveState { idle, joining, waiting, playing, phone, ended, failed }

// A comment in the stream's column.
export struct LiveComment {
    id: int,
    name: string,
    initial: string,
    text: string,
    stars: int,             // paid with so many Stars; 0: free
    tier: int,              // 0 free, 1 … 3 the paid levels' colours, the highest 3
    host: bool,             // from the broadcaster
    mine: bool,
    deletable: bool,
}

// One of the top supporters of a live story, for its host.
export struct LiveDonor {
    name: string,
    stars: int,
    tier: int,
}

// Where the user can go live: their own story, or a channel they manage.
export struct LiveTarget {
    chat-id: string,
    name: string,
    initial: string,
    picture: image,
    has-picture: bool,
    story: bool,            // their own live story; false: the channel's live stream
}

export global Live {
    // The list: live stories, and the chats' live streams and video chats.
    in-out property <[LiveRow]> stories;
    in-out property <[LiveRow]> chats;
    in-out property <int> count;                // live now, for the entry's dot
    in-out property <bool> on-air;              // the user's own stream is live (a row of theirs, mine): the Live column's "On air"
    in-out property <bool> shown;               // the view is open: covers the open chat
    callback show(bool);                        // the view opens or closes (it loads the stories when it opens)
    in-out property <int> show-requests;        // each step: the theme opens the view (the toolbox's Live, /live)
    in-out property <LiveRow> in-chat;          // the open chat's own live stream, for the bar under its header; id "" for none

    // The stream open.
    in-out property <string> open-id;
    in-out property <LiveRow> open;
    in-out property <LiveState> state;
    in-out property <string> problem;
    in-out property <image> frame;              // its picture while it plays (src/player/live.rs)
    in-out property <bool> buffering;
    in-out property <bool> playing;
    in-out property <int> viewers;
    in-out property <string> since;             // "14:02", when it started
    in-out property <int> volume: 100;
    in-out property <bool> muted;
    in-out property <[LiveComment]> comments;
    in-out property <bool> comments-on;         // the stream allows comments
    in-out property <bool> can-comment;         // and the user may write one
    in-out property <int> paid-from;            // the Stars each comment costs (the host's are free); 0: free
    in-out property <string> link;              // t.me/…/s/live, when it has one
    callback watch(string);                     // a row's id
    callback watch-link(string) -> bool;        // a link pasted: false when it is not one
    callback close();
    callback toggle-mute();
    callback set-volume(int);
    callback send-comment(string);
    callback copy-link();

    // The user's own stream, open as its host.
    in-out property <bool> hosting;
    in-out property <int> stars-total;
    in-out property <[LiveDonor]> donors;
    in-out property <bool> ending;              // asked whether to end it
    callback delete-comment(int);
    callback toggle-comments();
    callback end-live();                        // after the question
    callback ask-end(bool);

    // Going live: the form.
    in-out property <bool> going-live;
    in-out property <[LiveTarget]> targets;
    in-out property <int> target;               // index into targets
    in-out property <int> privacy;              // 0 everyone, 1 contacts, 2 close friends
    in-out property <bool> allow-comments: true;
    in-out property <string> paid-minimum;      // the field: Stars each comment costs; "" or 0: free
    in-out property <string> stream-title;      // a channel's live stream; "" the channel's name
    in-out property <string> server;            // the RTMP address OBS sends to
    in-out property <string> key;               // and its key
    in-out property <bool> key-shown;
    in-out property <bool> starting;
    in-out property <string> start-problem;
    callback open-go-live();
    callback close-go-live();
    callback choose-target(int);
    callback start();
    callback copy-server();
    callback copy-key();
    callback new-key();
}

// The words every theme shows of live streams.
export global LiveWords {
    public pure function view() -> string { return @tr("Live"); }
    public pure function stories() -> string { return @tr("Live stories"); }
    public pure function chats() -> string { return @tr("Channels and groups"); }
    public pure function live-mark() -> string { return @tr("LIVE"); }
    public pure function host-mark() -> string { return @tr("HOST"); }
    public pure function go-live() -> string { return @tr("Go live"); }
    public pure function kind(what: LiveKind) -> string {
        if what == LiveKind.story { return @tr("Live story"); }
        if what == LiveKind.stream { return @tr("Live stream"); }
        return @tr("Video chat");
    }
    // The row's second line: the stream's title, or what it is.
    public pure function line(row: LiveRow) -> string {
        if !row.playable { return @tr("Watch on your phone"); }
        return row.title != "" ? row.title : kind(row.kind);
    }
    public pure function viewers(count: int) -> string { return @tr("{n} watching" | "{n} watching" % count); }
    public pure function nobody-live() -> string { return @tr("Nobody you follow is live"); }
    public pure function nobody-live-line() -> string {
        return @tr("Live stories of your contacts and of the channels you follow, and live streams in your chats, show up here while they are on.");
    }
    public pure function any-public() -> string { return @tr("Any public live story"); }
    public pure function link-placeholder() -> string { return "t.me/username/s/live"; }
    public pure function watch() -> string { return @tr("Watch"); }
    public pure function not-a-link() -> string { return @tr("Not a link to a live story"); }
    public pure function phone-note() -> string {
        return @tr("Streams from a phone's camera play here once Telegram serves them as a stream; until then they are listed for the phone.");
    }
    public pure function empty-title() -> string { return @tr("Live streams open here"); }
    public pure function empty-line() -> string {
        return @tr("Pick one on the left when somebody is live, paste a link to a public live story, or go live yourself: FinchGram gives you the address and key for OBS.");
    }
    public pure function started(what: LiveKind, since: string) -> string {
        return since == "" ? kind(what) : @tr("{} · started {}", kind(what), since);
    }
    public pure function state(state: LiveState) -> string {
        if state == LiveState.joining { return @tr("Joining…"); }
        if state == LiveState.waiting { return @tr("Waiting for the stream"); }
        if state == LiveState.ended { return @tr("The live stream has ended"); }
        if state == LiveState.phone { return @tr("Watch this one on your phone"); }
        if state == LiveState.failed { return @tr("Could not join"); }
        return "";
    }
    public pure function phone-explained() -> string {
        return @tr("Telegram sends this live stream over WebRTC, which FinchGram does not have. Streams from OBS, and live streams with a large audience, play here.");
    }
    public pure function watch-note() -> string {
        return @tr("Streamed through Telegram, a few seconds behind. Watching joins as a viewer: the host sees you among them, as in Telegram's own apps.");
    }
    public pure function copy-link() -> string { return @tr("Copy link"); }
    public pure function link-copied() -> string { return @tr("Link copied"); }
    public pure function comments() -> string { return @tr("Comments"); }
    public pure function paid-from(stars: int) -> string { return @tr("Paid from ★ {}", stars); }
    public pure function comments-off() -> string { return @tr("Comments are off"); }
    public pure function say() -> string { return @tr("Say something…"); }
    public pure function reply-as-host() -> string { return @tr("Reply as the host…"); }
    public pure function free-note() -> string { return @tr("Free comments show for 10 seconds. Paid ones stay pinned for longer."); }
    public pure function paid-note(stars: int) -> string {
        return @tr("Comments here cost ★ {} each. Paid comments are sent from Telegram's own apps for now.", stars);
    }
    public pure function host-note() -> string { return @tr("Your comments are free. Deleting one removes it for everyone."); }
    public pure function tipped(stars: int) -> string { return @tr("tipped ★ {}", stars); }
    public pure function delete-comment() -> string { return @tr("Delete this comment"); }

    // The host.
    public pure function end(what: LiveKind) -> string {
        return what == LiveKind.story ? @tr("End live story") : @tr("End live stream");
    }
    public pure function end-question() -> string { return @tr("End it for everyone?"); }
    public pure function end-line(what: LiveKind) -> string {
        return what == LiveKind.story ? @tr("The viewers are told it has ended, and the recording stays as a story.")
            : @tr("The viewers are told it has ended.");
    }
    public pure function cancel() -> string { return @tr("Cancel"); }
    public pure function watching-now() -> string { return @tr("Watching now"); }
    public pure function stars-so-far() -> string { return @tr("Stars so far"); }
    public pure function top-supporters() -> string { return @tr("Top supporters"); }
    public pure function comments-allowed() -> string { return @tr("Comments on"); }
    public pure function preview-note() -> string { return @tr("What the viewers see, a few seconds late"); }

    // Going live.
    public pure function go-live-line() -> string {
        return @tr("A live stream on Telegram, sent from OBS or any app that streams over RTMP. Your contacts see a live story in their story list; a channel's live stream shows in the channel.");
    }
    public pure function where() -> string { return @tr("Where"); }
    public pure function my-story() -> string { return @tr("My live story"); }
    public pure function channel-stream(name: string) -> string { return @tr("{} · live stream", name); }
    public pure function who() -> string { return @tr("Who can see it"); }
    public pure function privacy(index: int) -> string {
        if index == 1 { return @tr("Contacts"); }
        if index == 2 { return @tr("Close friends"); }
        return @tr("Everyone");
    }
    public pure function stream-title() -> string { return @tr("Title"); }
    public pure function stream-title-placeholder() -> string { return @tr("The channel's name, if left empty"); }
    public pure function viewers-comment() -> string { return @tr("Viewers can comment"); }
    public pure function paid-minimum() -> string { return @tr("Paid comments from"); }
    public pure function paid-minimum-note() -> string { return @tr("0 or empty: every comment is free. Yours are always free."); }
    public pure function your-stream() -> string { return @tr("Your stream"); }
    public pure function obs-note() -> string {
        return @tr("FinchGram does not use your camera or screen. Put these two lines into OBS (Settings › Stream › Service: Custom), then start streaming there.");
    }
    public pure function server() -> string { return @tr("Server"); }
    public pure function key() -> string { return @tr("Stream key"); }
    public pure function copy() -> string { return @tr("Copy"); }
    public pure function show-key() -> string { return @tr("Show"); }
    public pure function hide-key() -> string { return @tr("Hide"); }
    public pure function new-key() -> string { return @tr("Get a new key"); }
    public pure function key-note() -> string { return @tr("Anyone with the key can stream in your name."); }
    public pure function start(story: bool) -> string { return story ? @tr("Start live story") : @tr("Start live stream"); }
    public pure function start-note() -> string {
        return @tr("It starts at once; viewers wait for the picture until OBS connects. One live story at a time.");
    }
    public pure function good-to-know() -> string { return @tr("Good to know"); }
    public pure function good-to-know-line() -> string {
        return @tr("Telegram recommends software encoding (x264 in OBS). Viewers are a few seconds behind. Paid comments arrive as Stars on your account, Telegram keeping its share.");
    }
    public pure function waiting-for-obs() -> string { return @tr("Your stream shows here once OBS is sending"); }
    public pure function in-chat(row: LiveRow) -> string {
        return row.viewers >= 0 ? @tr("{} · {}", line(row), viewers(row.viewers)) : line(row);
    }

    // Why a live story could not start, why a link led nowhere.
    public pure function premium-needed() -> string { return @tr("Live stories need Telegram Premium on this account."); }
    public pure function boost-needed() -> string { return @tr("This channel needs more boosts before it can post stories."); }
    public pure function story-limit() -> string { return @tr("Telegram allows no more stories from this account for now."); }
    public pure function not-live-now() -> string { return @tr("No live story there right now."); }
}

// ---- The live directory (the canvas "FinchGram Desktop 直播", rounds 12 and 13) ---------------
// Discover, Following, Watch and Connections: channels from every source, the directory's
// (services.finchgram.com/live/api/v1, docs/live-directory.md) and Telegram's own. Rust fills
// LiveDirectory (src/live/); the pages are drawn once, in Look's colours and shapes, for the
// three themes (pages/live-*.slint).

// Where a channel is from.
export enum LiveSource { owncast, peertube, icecast, hls, telegram, twitch, youtube, kick, bilibili }

// Whether it is live (round 12): live, confirmed by an observation still valid; stale, live when
// last observed but not confirmed now; offline; unknown, nothing reliable.
export enum LiveStatus { live, stale, offline, unknown }

// The one action a channel has (round 12's six labels): Watch here, Listen here, Try opening,
// Sign in to watch, Open on <source> (its own site), Unavailable.
export enum LivePlay { watch, listen, try-opening, sign-in, elsewhere, unavailable }

// Why it is not simply "Watch here": the reason line under the action.
//   offline: not live now. unknown: its source is not answering. not-confirmed: live when last
//   observed. webrtc: Telegram sends it over WebRTC (the phone). sign-in: it needs an account at
//   its source. own-site: it plays on its source's site. official-player: only its source's own
//   player may play it. format: sent in a format the app does not play.
export enum LiveWhy { none, offline, unknown, not-confirmed, webrtc, sign-in, own-site, official-player, format }

// The directory's categories (none: the source gave none).
export enum LiveCategory { none, music, gaming, talk, technology, creative, irl, education, events, news, sports, other }

// Discover's three modes: what is on now, every channel, what is announced.
export enum LiveMode { live, channels, upcoming }

// How results are ordered: Recommended browsing, Relevance with words; the rest are chosen.
export enum LiveSort { recommended, relevance, viewers, recent, added }

// The Live column's four places; watching is a state over them (LiveDirectory.watching).
export enum LiveSection { discover, following, broadcast, connections }

// A source's last sync (GET /sources).
export enum LiveSync { ok, degraded, rate-limited, failed, none }

// A channel, wherever it is from: a card in Discover, a row in Following or in the column.
export struct LiveChannel {
    id: string,                 // the directory's (fg_ch_…), or Telegram's own row id (story:…, chat:…)
    source: LiveSource,
    name: string,               // the channel
    title: string,              // its session's title; "" none
    initial: string,
    hue: int,                   // the avatar's colour, 0 … 359, from the id
    picture: image,             // Telegram's chat photo, when it has one
    has-picture: bool,
    thumbnail: image,           // the source's picture of the stream
    has-thumbnail: bool,        // false: "No thumbnail from <source>"
    status: LiveStatus,
    observed-minutes: int,      // since its source last answered; -1 unknown
    started-minutes: int,       // live for so long; -1 unknown
    last-live-minutes: int,     // since it was last live; -1 never seen live
    viewers: int,               // the source's own count; -1 none
    self-reported: bool,        // the count is the server's own (Owncast)
    audio: bool,                // sound only (Icecast): "listening"
    category: LiveCategory,
    language: string,           // the language's own name; "" not given
    language-code: string,      // "en", "zh": Terminal's narrow column
    mature: bool,
    play: LivePlay,
    why: LiveWhy,
    following: bool,
    on-telegram: bool,          // followed on Telegram: unfollowed there, not here
    host: string,               // its site, for "Opened … in your browser"
    upcoming-title: string,     // an announced session; "" none
    upcoming-minutes: int,      // starts in so long; -1 none
}

// A source in the sources panel (Discover's "Sources", from GET /sources).
export struct LiveSourceRow {
    source: LiveSource,
    indexed: bool,              // false: not integrated yet
    sync: LiveSync,
    live: int,                  // live now from it
    synced-minutes: int,        // since its last good sync; -1 never
    viewer-counts: int,         // 0 none, 1 exact, 2 the server's own, 3 listeners
    thumbnails: bool,
    plays-here: bool,
}

// One option of a filter's menu, with the results it would give.
export struct LiveOption {
    key: string,                // a source's or a category's name in the enum, a language code
    label: string,              // a language's own name; the others are named by LiveWords
    source: LiveSource,
    category: LiveCategory,
    count: int,
    chosen: bool,
}

// One line of the search box's suggestions.
//   kind 0: a recent search. 1: a word to search for. 2: a channel. 3: a source to filter by.
//   4: a category to filter by. 5: the text is a link: open it.
export struct LiveSuggestion {
    kind: int,
    text: string,
    source: LiveSource,
    category: LiveCategory,
    id: string,                 // a channel's
}

// Connections › Open a link: where a pasted link has got to.
//   empty. recognized: the app knows what it is (source set). probing: asking its server.
//   found: a directory channel (link-channel). playable: a stream the app plays. elsewhere: it
//   plays on its own site. private: a stream key or a token, not for here. not-stream: nothing to
//   play there. failed: the server did not answer (link-problem).
export enum LiveLinkState { empty, recognized, probing, found, playable, elsewhere, private, not-stream, failed }

// Watching a channel of the directory (Telegram's own play as before, through Live.state).
//   resolving: asking its source for the stream. playing. network: the connection stalled, mpv
//   retries. offline: not live. expired: the stream's address ran out; asking again. elsewhere: it
//   plays on its own site. sign-in: it needs an account there. mature: asks before playing.
//   phone: Telegram sends it over WebRTC. failed: it could not be played (LiveDirectory.problem).
export enum LiveWatch { resolving, playing, network, offline, expired, elsewhere, sign-in, mature, phone, failed }

// The short notes at the bottom of the view.
export enum LiveToast { none, following, unfollowed, followed-on-telegram, opened-in-browser }

export global LiveDirectory {
    // Where the view is.
    in-out property <LiveSection> section;
    in-out property <bool> watching;            // Watch is open over the section
    in-out property <bool> column-open: true;   // the Live column (hidden while watching, the menu brings it)
    callback go(LiveSection);
    callback back();                            // from Watch to where it was opened

    // Discover.
    in-out property <string> query;
    in-out property <bool> query-is-link;       // the box holds a link, not words
    in-out property <LiveMode> mode;
    in-out property <[int]> mode-counts;        // by LiveMode's order; -1 unknown
    in-out property <LiveSort> sort;
    in-out property <bool> list-layout;         // the compact list instead of cards (Terminal: always)
    in-out property <[LiveOption]> source-options;
    in-out property <[LiveOption]> category-options;
    in-out property <[LiveOption]> language-options;
    // The category and the language filtered by, for Terminal's column, whose facets mark "any"
    // when none is chosen (round 12's facets): none / "" for any.
    in-out property <LiveCategory> chosen-category;
    in-out property <string> chosen-language;
    in-out property <int> playback;             // 0 any, 1 plays in FinchGram, 2 opens elsewhere
    in-out property <[int]> playback-counts;    // by that order
    in-out property <LiveStatus> status-filter;
    in-out property <bool> status-any: true;    // mode channels: no status filter
    in-out property <bool> filtered;            // a filter is set
    in-out property <bool> home;                // nothing typed, filtered or chosen: the home groups
    in-out property <[LiveChannel]> home-here;  // confirmed live, plays in FinchGram
    in-out property <int> home-here-count;
    in-out property <[LiveChannel]> results;    // in order; confirmed live first, then the rest
    in-out property <int> total;
    in-out property <int> total-relation;       // 0 exactly, 1 at least (a source lags), 2 unknown
    in-out property <bool> loading;             // a new search is on its way
    in-out property <bool> more-loading;
    in-out property <bool> has-more;
    in-out property <bool> page-failed;         // the next page did not come
    in-out property <bool> partial;             // a source is behind
    in-out property <[LiveSourceRow]> sources;
    in-out property <bool> sources-open;
    in-out property <int> unknown-live;         // live when last seen, status unknown: not in Live now
    in-out property <int> hidden-mature;        // results left out by the content setting
    in-out property <bool> failed;              // the directory did not answer
    in-out property <[LiveSuggestion]> suggestions;
    in-out property <bool> suggestions-open;
    callback search(string);                    // Enter, or a suggestion
    callback typed(string);                     // each keystroke: the suggestions follow
    callback choose-suggestion(int);
    callback set-mode(LiveMode);
    callback set-sort(LiveSort);
    callback set-list-layout(bool);
    callback toggle-source(LiveSource);
    callback set-category(LiveCategory);
    callback set-language(string);              // "" any
    callback set-playback(int);
    callback set-status(bool, LiveStatus);      // any, or this one
    callback clear-filters();
    callback more();
    callback retry();
    callback toggle-sources();
    // The Language filter's value: the chosen language's own name ("Deutsch"); "" any. (The options
    // can be many, the chosen anywhere among them.)
    in-out property <string> language-chosen;
    // Each step: Discover's search box takes the focus (⌘K in the Live view; Terminal's / is Discover's own).
    in-out property <int> search-focus-requests;

    // A channel's own actions.
    callback open(string);                      // its one action: watch it, or open it elsewhere
    callback follow(string, bool);
    callback open-page(string);                 // its own page (its host), in the browser: Terminal's [o page]

    // Following: the channels the user follows here, and the live ones they follow on Telegram.
    in-out property <[LiveChannel]> following-live;
    in-out property <[LiveChannel]> following-off;
    in-out property <bool> following-partial;   // a source is behind: some statuses are not confirmed

    // Connections › Open a link.
    in-out property <string> link;
    in-out property <LiveLinkState> link-state;
    in-out property <LiveSource> link-source;
    in-out property <LiveChannel> link-channel;
    in-out property <string> link-problem;
    callback type-link(string);
    callback open-link();

    // The content setting (Settings › Live, and Discover's notice): mature-rated channels.
    in-out property <bool> show-mature;
    in-out property <bool> content-asking;      // the dialog is open
    callback set-show-mature(bool);
    // Settings › Live › Languages: what Recommended puts first; none chosen until the user does.
    in-out property <[LiveOption]> preferred-languages;
    callback toggle-preferred-language(string);

    // Watching a directory channel.
    in-out property <LiveChannel> channel;
    in-out property <LiveWatch> watch-state;
    in-out property <string> problem;
    in-out property <string> tech;              // "HLS · 1080p · 6.0 Mbps", what plays
    in-out property <[string]> qualities;       // "Auto" first, then the stream's variants
    in-out property <int> quality;
    in-out property <bool> paused;
    in-out property <int> behind;               // seconds behind the live edge (paused, or a seek)
    in-out property <bool> chat;                // the source has a chat here (Owncast; Telegram's comments)
    // Owncast's chat beside the picture (round 12: "Chat from Owncast · read and send"; Telegram's
    // comments stay Live.comments). FinchGram joins as an anonymous chat user under the name the
    // server gives, which the user may change; nothing of it is kept.
    in-out property <[LiveComment]> chat-messages;
    in-out property <string> chat-name;         // the name chatted under; "" while joining
    in-out property <bool> chat-joined;         // messages can be sent
    in-out property <string> chat-problem;      // why the chat could not be joined
    callback send-chat(string);
    callback rename-chat(string);
    callback set-quality(int);
    callback toggle-pause();
    callback live-edge();
    callback confirm-mature();                  // "Watch anyway" (asks the content setting once)
    callback open-elsewhere();                  // the stream's own site, in the browser
    callback stop();

    // The stream left playing while the user is elsewhere: the mini player, the pop-out window.
    in-out property <bool> mini;
    in-out property <bool> popped-out;
    callback resume();                          // back to Watch
    callback pop-out();
    callback pop-in();

    // A short note at the bottom of the view ("Following Keyboard Lab"), for a few seconds.
    in-out property <LiveToast> toast;
    in-out property <string> toast-name;
}

// The words of the live directory every theme shows (the canvas's, rounds 12 and 13).
export global LiveDirectoryWords {
    public pure function source(what: LiveSource) -> string {
        if what == LiveSource.owncast { return "Owncast"; }
        if what == LiveSource.peertube { return "PeerTube"; }
        if what == LiveSource.icecast { return "Icecast"; }
        if what == LiveSource.hls { return @tr("Submitted streams"); }
        if what == LiveSource.telegram { return "Telegram"; }
        if what == LiveSource.twitch { return "Twitch"; }
        if what == LiveSource.youtube { return "YouTube"; }
        if what == LiveSource.kick { return "Kick"; }
        return "Bilibili";
    }
    // Terminal's two-letter source code.
    public pure function code(what: LiveSource) -> string {
        if what == LiveSource.owncast { return "oc"; }
        if what == LiveSource.peertube { return "pt"; }
        if what == LiveSource.icecast { return "ic"; }
        if what == LiveSource.hls { return "hl"; }
        if what == LiveSource.telegram { return "tg"; }
        if what == LiveSource.twitch { return "tw"; }
        if what == LiveSource.youtube { return "yt"; }
        if what == LiveSource.kick { return "kk"; }
        return "bl";
    }
    public pure function section(what: LiveSection) -> string {
        if what == LiveSection.following { return @tr("Following"); }
        if what == LiveSection.broadcast { return @tr("Broadcast"); }
        if what == LiveSection.connections { return @tr("Connections"); }
        return @tr("Discover");
    }
    public pure function mode(what: LiveMode) -> string {
        if what == LiveMode.channels { return @tr("All channels"); }
        if what == LiveMode.upcoming { return @tr("Upcoming"); }
        return @tr("Live now");
    }
    public pure function sort(what: LiveSort) -> string {
        if what == LiveSort.relevance { return @tr("Relevance"); }
        if what == LiveSort.viewers { return @tr("Most viewers"); }
        if what == LiveSort.recent { return @tr("Recently started"); }
        if what == LiveSort.added { return @tr("Recently added"); }
        return @tr("Recommended");
    }
    public pure function category(what: LiveCategory) -> string {
        if what == LiveCategory.music { return @tr("Music"); }
        if what == LiveCategory.gaming { return @tr("Gaming"); }
        if what == LiveCategory.talk { return @tr("Talk"); }
        if what == LiveCategory.technology { return @tr("Technology"); }
        if what == LiveCategory.creative { return @tr("Creative"); }
        if what == LiveCategory.irl { return @tr("IRL"); }
        if what == LiveCategory.education { return @tr("Education"); }
        if what == LiveCategory.events { return @tr("Events"); }
        if what == LiveCategory.news { return @tr("News"); }
        if what == LiveCategory.sports { return @tr("Sports"); }
        if what == LiveCategory.other { return @tr("Other"); }
        return @tr("Uncategorized");
    }
    public pure function language(name: string) -> string { return name != "" ? name : @tr("Language not given"); }

    // The status, as a badge over a picture and in words.
    public pure function badge(what: LiveStatus) -> string {
        if what == LiveStatus.live { return @tr("LIVE"); }
        if what == LiveStatus.stale { return @tr("NOT CONFIRMED"); }
        if what == LiveStatus.offline { return @tr("OFFLINE"); }
        return @tr("STATUS UNKNOWN");
    }
    public pure function status(what: LiveStatus) -> string {
        if what == LiveStatus.live { return @tr("On air"); }
        if what == LiveStatus.stale { return @tr("Not confirmed"); }
        if what == LiveStatus.offline { return @tr("Off air"); }
        return @tr("Status unknown");
    }
    // "2 h 5 min", "40 min".
    public pure function duration(minutes: int) -> string {
        if minutes < 60 { return @tr("{} min", minutes); }
        if mod(minutes, 60) == 0 { return @tr("{} h", floor(minutes / 60)); }
        return @tr("{} h {} min", floor(minutes / 60), mod(minutes, 60));
    }
    // How long ago a source last answered: "just now", "3 min ago", "2 h ago".
    public pure function ago(minutes: int) -> string {
        if minutes < 1 { return @tr("just now"); }
        if minutes < 60 { return @tr("{} min ago", minutes); }
        if minutes < 48 * 60 { return @tr("{} h ago", round(minutes / 60)); }
        return @tr("{} days ago", round(minutes / 1440));
    }
    public pure function viewers(channel: LiveChannel) -> string {
        if channel.viewers < 0 { return ""; }
        if channel.audio { return @tr("{n} listening" | "{n} listening" % channel.viewers); }
        return @tr("{n} watching" | "{n} watching" % channel.viewers);
    }
    // The line that says where a channel is now (Following, All channels).
    public pure function status-line(channel: LiveChannel) -> string {
        if channel.status == LiveStatus.live {
            if channel.started-minutes < 0 { return viewers(channel) != "" ? viewers(channel) : status(channel.status); }
            return viewers(channel) != "" ? @tr("Live for {} · {}", duration(channel.started-minutes), viewers(channel))
                : @tr("Live for {}", duration(channel.started-minutes));
        }
        if channel.status == LiveStatus.stale { return @tr("Not confirmed · last confirmed live {}", ago(channel.observed-minutes)); }
        if channel.status == LiveStatus.unknown {
            return channel.observed-minutes >= 0 ? @tr("Status unknown · last confirmed live {}", ago(channel.observed-minutes))
                : @tr("Status unknown · no recent answer from {}", source(channel.source));
        }
        return channel.last-live-minutes >= 0 ? @tr("Offline · last live {}", ago(channel.last-live-minutes)) : @tr("Not seen live yet");
    }

    // The one action, and why it is that one.
    public pure function play(channel: LiveChannel) -> string {
        if channel.play == LivePlay.watch { return @tr("Watch here"); }
        if channel.play == LivePlay.listen { return @tr("Listen here"); }
        if channel.play == LivePlay.try-opening { return @tr("Try opening"); }
        if channel.play == LivePlay.sign-in { return @tr("Sign in to watch"); }
        if channel.play == LivePlay.elsewhere { return @tr("Open on {}", source(channel.source)); }
        if channel.why == LiveWhy.offline { return @tr("Offline"); }
        if channel.why == LiveWhy.unknown { return @tr("Status unknown"); }
        return @tr("Unavailable");
    }
    public pure function reason(channel: LiveChannel) -> string {
        if channel.why == LiveWhy.offline { return @tr("Not live right now"); }
        if channel.why == LiveWhy.unknown { return @tr("{} isn't answering", source(channel.source)); }
        if channel.why == LiveWhy.not-confirmed { return @tr("Live status isn't confirmed — the stream may have ended"); }
        if channel.why == LiveWhy.webrtc { return @tr("Telegram sends this one over WebRTC — watch it on your phone"); }
        if channel.why == LiveWhy.sign-in { return @tr("{} needs an account for this stream", source(channel.source)); }
        if channel.why == LiveWhy.own-site { return @tr("Plays on {}'s site, in your browser", source(channel.source)); }
        if channel.why == LiveWhy.official-player { return @tr("{} allows only its own player, so it opens in your browser", source(channel.source)); }
        if channel.why == LiveWhy.format { return @tr("FinchGram can't play this kind of stream yet"); }
        if channel.play == LivePlay.listen { return @tr("Plays in FinchGram, sound only"); }
        return @tr("Plays in FinchGram");
    }
    public pure function no-thumbnail(what: LiveSource) -> string { return @tr("No thumbnail from {}", source(what)); }
    public pure function toast(what: LiveToast, name: string) -> string {
        if what == LiveToast.following { return @tr("Following {}", name); }
        if what == LiveToast.unfollowed { return @tr("Unfollowed {}", name); }
        if what == LiveToast.followed-on-telegram { return @tr("Followed on Telegram — unfollow it there"); }
        if what == LiveToast.opened-in-browser { return @tr("Opened {} in your browser", name); }
        return "";
    }
    public pure function follow(channel: LiveChannel) -> string {
        if channel.on-telegram { return @tr("Followed on Telegram"); }
        return channel.following ? @tr("Following") : @tr("Follow");
    }
}
