// Voice: voice input (docs/voice-input.md, src/speech/), a tool of the toolbox's AI category: the
// sparkle in the composer while it is on, with a strip above it while the user speaks, and its
// panel in the toolbox (ui/pages/voice-input.slint). It has no design round yet: the strip follows
// each theme's strip for replying, the panel the settings' own rows; and voice messages (src/telegram/voice.rs), from the design's fifth round ("秘密聊天与通话", B1
// the bubble, B2 the recording, B3 the microphone not allowed). Rust fills these globals; the
// shared parts take each theme's colours, and Terminal writes its own; the words are here, once
// for the three themes.
import { Conversation, VoiceNote, TranscriptProblem } from "telegram.slint";
import { Icon, Spinner } from "widgets.slint";

// Where a dictation is: the microphone is open and the words come as the user speaks (listening),
// the user is done and the last words are on their way (finishing), a small model tidies them
// (tidying), or it stopped, and why (failed). Idle: nothing shows but the microphone.
export enum VoiceState { idle, listening, finishing, tidying, failed }

// Why a dictation stopped, or could not start. no-service: no connection chosen for the main
// language's speech recognition; bad-address: its address is not one FinchGram can use; service:
// the service's own message.
export enum VoiceProblem { none, no-service, no-key, microphone-denied, no-microphone, refused-key, quota, network, service, bad-address, nothing-heard }

// What a service said when last checked: its address and its key (malformed: the key typed is not
// one).
export enum KeyCheck { none, malformed, checking, works, refused, failed }

// A main language, by the code speech services take ("zh-cn", or "auto" for any), with its name
// in itself ("" for any: the UI's words say it).
export struct VoiceLanguage {
    code: string,
    name: string,
    on: bool,
}

// A line of them, as the panel lays them out.
export struct VoiceLanguageRow {
    languages: [VoiceLanguage],
}

// A connection the user added, as the panel lists it: its id, its name, its format ("openai",
// "anthropic", "gemini", "dashscope", "doubao"), its address's host ("" when the address is not
// one), and its key's letters.
export struct VoiceConnectionRow {
    id: string,
    label: string,
    format: string,
    host: string,
    has-key: bool,
    key-hint: string,
}

// A connection an ability may take, by its id ("" for the voice messages' default, the speech
// recognition's), its name, chosen or not.
export struct VoiceChoice {
    id: string,
    label: string,
    on: bool,
}

// A line of them, as the panel lays them out.
export struct VoiceChoiceRow {
    choices: [VoiceChoice],
}

export global Voice {
    in-out property <VoiceState> state;
    // Until OpenAI has the session's settings: the microphone already listens, and what it hears
    // goes out once the session is ready.
    in-out property <bool> connecting;
    // What was heard so far, as OpenAI has it; then the tidied words, for a moment.
    in-out property <string> words;
    // How loud the microphone is, 0 … 1, for the bars.
    in-out property <float> level;
    // How long the user has been speaking.
    in-out property <int> seconds;
    in-out property <VoiceProblem> problem;
    in-out property <string> detail;            // the reason in the system's or OpenAI's words
    // Counted up by Rust each time words went into the composer: the composer takes the keyboard,
    // with the cursor after them.
    in-out property <int> insertions;
    out property <bool> busy: state == VoiceState.listening || state == VoiceState.finishing || state == VoiceState.tidying;
    out property <bool> shown: state != VoiceState.idle;
    // The microphone, pressed and let go: a click starts and a second click finishes; held while
    // speaking, letting go finishes.
    callback press();
    callback release();
    callback stop();                            // ⏎ or Done: the words go into the composer
    callback cancel();                          // Esc or ×: the words are dropped
    callback act();                             // the problem's button: the toolbox's panel, or the system's

    // The main language in use, for the strip: its name ("" for any), whether there are others to
    // switch to (a click on it takes the next one), who hears it, and whether words show while
    // the user speaks (not when the recording goes up at the end).
    in-out property <string> language-name;
    in-out property <bool> can-switch;
    in-out property <string> service;
    in-out property <bool> live: true;
    callback next-language();

    // The toolbox's switch ([voice_input] enabled): on, the sparkle shows in the composer.
    in-out property <bool> on;
    callback set-on(bool);
    // The toolbox's Voice input panel: the main languages set up (the one in use on), the ones
    // that can be added (while adding).
    in-out property <[VoiceLanguageRow]> language-rows;
    in-out property <[VoiceLanguageRow]> addable-rows;
    in-out property <bool> adding;
    in-out property <bool> can-remove;
    callback choose-language(string);
    callback start-adding();
    callback cancel-adding();
    callback add-language(string);
    callback remove-language();
    // The connections, and the one open for editing (by id, "" for none) with its fields: what is
    // typed into its boxes are their own properties, so that typing is never interrupted.
    in-out property <[VoiceConnectionRow]> connections;
    in-out property <string> open-connection;
    in-out property <string> connection-label;
    in-out property <string> connection-url;
    in-out property <string> connection-format;
    in-out property <string> connection-url-placeholder;
    in-out property <int> connection-url-problem;       // 0 none, 1 not an address, 2 a name and password, 3 plain http
    in-out property <bool> connection-has-key;
    in-out property <string> connection-key-hint;
    in-out property <bool> connection-official;         // the vendor's own address: the link to its keys shows
    in-out property <string> connection-shown;          // its name, for what the check says
    in-out property <KeyCheck> connection-check;
    in-out property <string> connection-check-detail;
    callback add-connection();
    callback toggle-connection(string);
    callback edit-connection-label(string);
    callback edit-connection-url(string);
    callback set-connection-format(string);
    callback check-connection();                        // the address typed is done: ask the service
    callback save-connection-key(string);
    callback remove-connection-key();
    callback remove-connection();
    callback open-key-page();                           // the vendor's page of API keys, in the browser
    // The main language in use's abilities, each a connection and a model: the speech recognition
    // (an OpenAI connection's way, "realtime" or "upload"; the words to know), the tidying, and
    // the voice messages' own.
    in-out property <[VoiceChoiceRow]> speech-choices;
    in-out property <string> speech-format;             // the chosen connection's format, "" for none
    in-out property <string> speech-mode;
    in-out property <string> speech-model;
    in-out property <string> speech-model-placeholder;
    in-out property <string> keywords;                  // the words to know, as typed
    in-out property <bool> tidy: true;
    in-out property <[VoiceChoiceRow]> tidy-choices;
    in-out property <string> tidy-model;
    in-out property <string> tidy-model-placeholder;
    in-out property <bool> transcribe-messages;
    in-out property <[VoiceChoiceRow]> message-choices;
    in-out property <string> messages-model;
    in-out property <string> messages-model-placeholder;
    callback choose(string, string);                    // an ability ("speech", "tidy", "messages") and a connection
    callback set-mode(string);
    callback edit-model(string, string);
    callback edit-keywords(string);
    callback set-tidy(bool);
    callback set-transcribe-messages(bool);
}

// Where the recording of a voice message is (src/telegram/voice.rs), from the design's fifth
// round (B2): the microphone held down (holding: letting go sends it, dragged left cancels it,
// dragged up locks it), locked (recording on its own: Delete, Stop, Send), stopped and listened to
// before it goes (preview: Delete, Send).
export enum RecordStage { idle, holding, locked, preview }

export global Recorder {
    in-out property <RecordStage> stage;
    in-out property <string> time;                // "0:07,4"
    // The loudness of the last moments, newest last, 0 … 1 a bar: the strip's live bars.
    in-out property <[float]> levels;
    // Dragged left far enough, while held: letting go cancels it (the pages set it).
    in-out property <bool> cancelling;
    // Stopped: its own waveform, its length, and how far it plays when listened to.
    in-out property <[float]> preview-bars;
    in-out property <string> preview-time;        // "0:14"
    in-out property <bool> preview-playing;
    in-out property <float> preview-progress;
    // The system does not let FinchGram use the microphone: the bar above the composer says so.
    in-out property <bool> denied;
    // A click, not held: the tip says to hold, for a moment.
    in-out property <bool> too-short;
    out property <bool> recording: stage == RecordStage.holding || stage == RecordStage.locked;
    out property <bool> busy: stage != RecordStage.idle;
    callback press();
    callback release();
    callback lock();
    callback stop();
    callback send();
    callback delete();
    callback play-preview();
    callback open-microphone-settings();
    callback dismiss-denied();
}

// How far the pointer must go, held on the microphone, to cancel (left) or to lock (up).
export global RecordDrag {
    out property <length> cancel: 80px;
    out property <length> lock: 60px;
}

// How loud the microphone is: five bars, the middle one tallest.
export component LevelBars {
    in property <float> level;
    in property <color> color;
    in property <length> bar: 3px;
    in property <length> gap: 2px;
    in property <length> tallest: 16px;
    in property <length> radius: 1.5px;
    width: 5 * root.bar + 4 * root.gap;
    height: root.tallest;

    for weight[index] in [0.45, 0.75, 1.0, 0.75, 0.45]: Rectangle {
        x: index * (root.bar + root.gap);
        width: root.bar;
        height: max(root.bar, root.tallest * min(1, 0.15 + root.level * weight));
        y: (root.tallest - self.height) / 2;
        border-radius: root.radius;
        background: root.color;
        animate height { duration: 90ms; }
    }
}

// The newest words, in at most `lines` lines: the older ones go out at the top.
export component WordsTail inherits Rectangle {
    in property <string> text;
    in property <color> ink;
    in property <string> font-family;
    in property <length> font-size: 13px;
    in property <int> lines: 2;
    clip: true;
    height: min(words.preferred-height, probe.preferred-height * root.lines);

    // One line's height, with the CJK fallback in it.
    probe := Text {
        visible: false;
        text: "Xg中";
        font-family: root.font-family;
        font-size: root.font-size;
    }
    words := Text {
        y: parent.height - self.height;
        width: parent.width;
        height: self.preferred-height;
        text: root.text;
        color: root.ink;
        font-family: root.font-family;
        font-size: root.font-size;
        wrap: word-wrap;
    }
}

// A solid triangle pointing right: play.
export component PlaySign {
    in property <color> color;
    in property <length> size: 14px;
    Path {
        width: root.size;
        height: root.size;
        x: (parent.width - self.width) / 2 + root.size / 10;
        y: (parent.height - self.height) / 2;
        viewbox-width: 14;
        viewbox-height: 14;
        fill: root.color;
        MoveTo { x: 2; y: 1; }
        LineTo { x: 13; y: 7; }
        LineTo { x: 2; y: 13; }
        Close { }
    }
}

// Two solid bars: pause.
export component PauseSign {
    in property <color> color;
    in property <length> bar: 4px;
    in property <length> tall: 13px;
    Rectangle {
        x: parent.width / 2 - root.bar - 2px;
        y: (parent.height - root.tall) / 2;
        width: root.bar;
        height: root.tall;
        border-radius: 1px;
        background: root.color;
    }
    Rectangle {
        x: parent.width / 2 + 2px;
        y: (parent.height - root.tall) / 2;
        width: root.bar;
        height: root.tall;
        border-radius: 1px;
        background: root.color;
    }
}

// A voice message in a chat (B1): the play button (a spinner while its file comes, Retry after it
// could not), the waveform, which is also how far it has played and takes a click to go there,
// its time ("0:04 / 0:12" while it plays), a dot until it is listened to, the speed while it
// plays, and Transcribe, whose words show under it (src/telegram/voice.rs).
export component VoiceNoteView {
    in property <string> message-id;
    in property <VoiceNote> note;
    in property <color> accent;
    in property <color> on-accent;
    in property <color> played;                 // the bars played (Broadsheet's own bubbles: its ink)
    in property <color> wave;                   // the bars not yet played (the design's wave0)
    in property <color> meta;                   // the time
    in property <color> side;
    in property <color> muted;
    in property <color> faint;
    in property <color> danger;
    in property <color> danger-soft;
    in property <string> font-family;
    in property <length> radius: 6px;
    in property <bool> duotone;
    in property <color> words-color: root.meta;      // the transcript's words
    property <bool> current: Conversation.voice-playing == root.message-id;
    property <bool> failed: root.current && Conversation.voice-failed;
    property <bool> loading: root.current && Conversation.voice-loading;
    property <bool> paused: root.current && Conversation.voice-paused;
    property <bool> playing: root.current && !root.loading && !root.failed && !root.paused;
    property <float> progress: root.current ? Conversation.voice-progress : 0;
    property <int> played-bars: Math.round(root.note.bars.length * root.progress);

    VerticalLayout {
    spacing: 6px;
    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 19px;
                background: root.failed ? root.danger-soft : root.loading ? root.side : button.has-hover ? root.accent.darker(0.1) : root.accent;
                if root.loading: Spinner {
                    size: 17px;
                    color: root.muted;
                }
                if root.failed: Icon {
                    name: "arrow-clockwise";
                    size: 17px;
                    color: root.danger;
                    duotone: false;
                }
                if root.playing: PauseSign {
                    color: root.on-accent;
                }
                if !root.loading && !root.failed && !root.playing: PlaySign {
                    color: root.on-accent;
                    size: 15px;
                }
                button := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Conversation.play-voice(root.message-id);
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            Rectangle {
                width: root.note.bars.length * 5px - 2px;
                height: 22px;
                for bar[index] in root.note.bars: Rectangle {
                    x: index * 5px;
                    width: 3px;
                    height: max(3px, 21px * bar);
                    y: (parent.height - self.height) / 2;
                    border-radius: 1.5px;
                    background: index < root.played-bars ? root.played : root.wave;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Conversation.seek-voice(root.message-id, self.mouse-x / self.width);
                    }
                }
            }
            HorizontalLayout {
                spacing: 7px;
                alignment: start;
                Text {
                    text: root.playing || root.paused ? Conversation.voice-time + " / " + root.note.duration : root.note.duration;
                    color: root.meta;
                    font-family: root.font-family;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                if !root.note.listened: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: root.accent;
                    }
                }
                if root.playing: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: speed.preferred-width + 10px;
                        height: speed.preferred-height + 2px;
                        border-radius: root.radius;
                        border-width: 1px;
                        border-color: root.meta;
                        speed := Text {
                            text: Conversation.voice-speed;
                            color: root.meta;
                            font-family: root.font-family;
                            font-size: 11px;
                            font-weight: 600;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                Conversation.next-voice-speed();
                            }
                        }
                    }
                }
                if root.failed: Text {
                    text: VoiceWords.download-failed() + " · " + VoiceWords.retry();
                    color: root.danger;
                    font-family: root.font-family;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                if root.loading: Text {
                    text: VoiceWords.loading();
                    color: root.meta;
                    font-family: root.font-family;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: chip.preferred-width + 14px;
                height: chip.preferred-height + 6px;
                border-radius: root.radius;
                background: transcribe.has-hover ? root.side.darker(0.06) : root.side;
                chip := HorizontalLayout {
                    spacing: 4px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: "text-aa";
                            size: 13px;
                            color: root.note.transcript-shown ? root.accent : root.muted;
                            duotone: root.duotone;
                        }
                    }
                    Text {
                        text: root.note.transcribing ? VoiceWords.transcribing() : VoiceWords.transcribe();
                        color: root.note.transcript-shown ? root.accent : root.muted;
                        font-family: root.font-family;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
                transcribe := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Conversation.transcribe-voice(root.message-id);
                    }
                }
            }
        }
    }
    // Its words, or why there are none.
    if root.note.transcript-shown: Text {
        text: VoiceWords.transcript(root.note);
        color: root.note.transcript-problem != TranscriptProblem.none ? root.danger : root.note.transcribing ? root.muted : root.words-color;
        font-family: root.font-family;
        font-size: 13px;
        wrap: word-wrap;
    }
    }
}

// The composer while a voice message records (B2): a red dot, the clock, the live bars and what
// letting go does (dragged left: that it cancels, the row moving after the pointer); locked, the
// same without the hint; stopped, its own play button, waveform and length. Esc deletes it, ⏎
// sends it once it is no longer held.
export component RecordRow inherits Rectangle {
    in property <color> rec;
    in property <color> rec-soft;
    in property <color> text-color;
    in property <color> muted;
    in property <color> danger;
    in property <color> accent;
    in property <color> on-accent;
    in property <color> wave;
    in property <string> font-family;
    in property <length> font-size: 12px;
    in property <length> padding-x: 12px;

    init => {
        keys.focus();
    }
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                Recorder.delete();
                return accept;
            }
            if event.text == Key.Return && Recorder.stage != RecordStage.holding {
                Recorder.send();
                return accept;
            }
            return reject;
        }
    }
    if Recorder.recording: HorizontalLayout {
        x: Recorder.cancelling ? -28px : 0px;
        width: root.width;
        padding-left: root.padding-x;
        padding-right: root.padding-x;
        spacing: 10px;
        animate x { duration: 120ms; }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 17px;
                height: 17px;
                border-radius: 8.5px;
                background: root.rec-soft;
                Rectangle {
                    width: 9px;
                    height: 9px;
                    border-radius: 4.5px;
                    background: root.rec;
                }
            }
        }
        Text {
            text: Recorder.time;
            color: root.text-color;
            font-family: root.font-family;
            font-size: root.font-size;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: Recorder.levels.length * 4px - 2px;
                height: 22px;
                for level[index] in Recorder.levels: Rectangle {
                    x: index * 4px;
                    width: 2px;
                    height: 3px + 19px * level;
                    y: (parent.height - self.height) / 2;
                    border-radius: 1px;
                    background: root.rec;
                }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: Recorder.cancelling ? "‹ " + VoiceWords.release-to-cancel() : Recorder.stage == RecordStage.locked ? "" : VoiceWords.release-to-send();
            color: Recorder.cancelling ? root.danger : root.muted;
            font-family: root.font-family;
            font-size: root.font-size;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if Recorder.stage == RecordStage.preview: HorizontalLayout {
        padding-left: root.padding-x;
        padding-right: root.padding-x;
        spacing: 10px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: listen.has-hover ? root.accent.darker(0.1) : root.accent;
                if Recorder.preview-playing: PauseSign {
                    color: root.on-accent;
                    bar: 3px;
                    tall: 10px;
                }
                if !Recorder.preview-playing: PlaySign {
                    color: root.on-accent;
                    size: 11px;
                }
                listen := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Recorder.play-preview();
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: Recorder.preview-bars.length * 4px - 2px;
                height: 22px;
                for bar[index] in Recorder.preview-bars: Rectangle {
                    x: index * 4px;
                    width: 2px;
                    height: max(3px, 18px * bar);
                    y: (parent.height - self.height) / 2;
                    border-radius: 1px;
                    background: index < Math.round(Recorder.preview-bars.length * Recorder.preview-progress) ? root.accent : root.wave;
                }
            }
        }
        Text {
            text: Recorder.preview-time;
            color: root.muted;
            font-family: root.font-family;
            font-size: root.font-size;
            vertical-alignment: center;
        }
    }
}

// Above the microphone while it is held (B2): drag up to lock.
export component LockTag inherits Rectangle {
    in property <color> panel;
    in property <color> ring: transparent;
    in property <color> ink;
    in property <length> tag-radius: 17px;
    in property <bool> duotone;
    width: 34px;
    height: column.preferred-height + 16px;
    border-radius: root.tag-radius;
    background: root.panel;
    border-width: 1px;
    border-color: root.ring;
    drop-shadow-blur: 14px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: #00000033;
    column := VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            Icon {
                name: "lock-simple";
                size: 14px;
                color: root.ink;
                duotone: root.duotone;
            }
        }
        HorizontalLayout {
            alignment: center;
            Icon {
                name: "caret-up";
                size: 12px;
                color: root.ink;
                duotone: false;
            }
        }
    }
}

// The system does not let FinchGram use the microphone (B3): above the composer, with the way to
// its settings.
export component MicDeniedBar inherits Rectangle {
    in property <color> danger;
    in property <color> danger-soft;
    in property <color> link;
    in property <color> text-color;
    in property <color> faint;
    in property <string> font-family;
    in property <length> font-size: 12px;
    in property <length> radius: 6px;
    in property <bool> duotone;
    height: row.preferred-height;
    border-radius: root.radius;
    background: root.danger-soft;
    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: "microphone-slash";
                size: 16px;
                color: root.danger;
                duotone: root.duotone;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: VoiceWords.microphone-off();
            color: root.text-color;
            font-family: root.font-family;
            font-size: root.font-size;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: VoiceWords.open-system-settings();
            color: root.link;
            font-family: root.font-family;
            font-size: root.font-size;
            font-weight: 600;
            vertical-alignment: center;
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Recorder.open-microphone-settings();
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px;
                height: 18px;
                Icon {
                    name: "x";
                    size: 14px;
                    color: root.faint;
                    duotone: false;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Recorder.dismiss-denied();
                    }
                }
            }
        }
    }
}

export global VoiceWords {
    public pure function voice-input() -> string { return @tr("Voice input"); }
    // The sparkle's tip.
    public pure function tip() -> string { return Voice.busy ? @tr("Finish voice input") : @tr("Voice input: click, or hold while you speak"); }

    // Voice messages (the design's fifth round, its words).
    public pure function record() -> string { return @tr("Record voice message"); }
    public pure function release-to-send() -> string { return @tr("Release to send · Drag left to cancel"); }
    public pure function release-to-cancel() -> string { return @tr("Release to cancel"); }
    public pure function hold-to-record() -> string { return @tr("Hold to record. Release to send."); }
    public pure function send() -> string { return @tr("Send"); }
    public pure function stop() -> string { return @tr("Stop"); }
    public pure function delete() -> string { return @tr("Delete"); }
    public pure function transcribe() -> string { return @tr("Transcribe"); }
    public pure function transcribing() -> string { return @tr("Transcribing…"); }
    // A voice message's words as they show under it, or why there are none.
    public pure function transcript(note: VoiceNote) -> string {
        if note.transcript-problem == TranscriptProblem.premium {
            return @tr("Telegram transcribes voice messages with Premium, or a few times a week without it. Your own speech service can do it too: Toolbox → AI → Voice input.");
        }
        if note.transcript-problem == TranscriptProblem.too-long { return @tr("Too long for Telegram to transcribe."); }
        if note.transcript-problem == TranscriptProblem.failed { return @tr("Could not transcribe it: {0}", note.transcript-detail); }
        if note.transcript == "" { return @tr("Transcribing…"); }
        return note.transcribing ? note.transcript + " …" : note.transcript;
    }
    public pure function not-available() -> string { return @tr("Not available yet"); }
    public pure function download-failed() -> string { return @tr("Couldn't download"); }
    public pure function retry() -> string { return @tr("Retry"); }
    public pure function loading() -> string { return @tr("Loading…"); }
    public pure function microphone-off() -> string { return @tr("Microphone access is off."); }
    public pure function open-system-settings() -> string { return @tr("Open System Settings"); }
    public pure function not-allowed() -> string { return @tr("Not allowed in this group"); }
    // "0:07", "12:30".
    public pure function time(seconds: int) -> string {
        return Math.floor(seconds / 60) + ":" + (Math.mod(seconds, 60) < 10 ? "0" : "") + Math.mod(seconds, 60);
    }
    // The strip's first line.
    public pure function title() -> string {
        if Voice.state == VoiceState.listening {
            return Voice.connecting ? @tr("Connecting to {0}…", Voice.service) : @tr("Listening · {0}", time(Voice.seconds));
        }
        if Voice.state == VoiceState.finishing { return @tr("Finishing…"); }
        if Voice.state == VoiceState.tidying { return @tr("Tidying the words…"); }
        return @tr("Voice input stopped");
    }
    // In the words' place before any came; when the words come only at the end, it says so.
    public pure function speak-now() -> string { return Voice.live ? @tr("Speak now") : @tr("Speak now: the words come when you are done"); }
    // The main language in use, in the strip and the panel: its name, or "any language".
    public pure function language-label(name: string) -> string { return name == "" ? @tr("Any language") : name; }
    public pure function keys() -> string { return @tr("⏎ done · Esc cancel"); }
    public pure function done() -> string { return @tr("Done"); }
    public pure function cancel() -> string { return @tr("Cancel"); }
    // Why it stopped.
    public pure function problem() -> string {
        if Voice.problem == VoiceProblem.no-service { return @tr("No speech recognition is set up yet: choose a connection for it in Voice input."); }
        if Voice.problem == VoiceProblem.no-key { return @tr("Voice input needs your API key for {0}.", Voice.service); }
        if Voice.problem == VoiceProblem.microphone-denied { return @tr("FinchGram may not use the microphone. Allow it in System Settings → Privacy & Security → Microphone."); }
        if Voice.problem == VoiceProblem.no-microphone { return @tr("No microphone could be opened: {0}", Voice.detail); }
        if Voice.problem == VoiceProblem.refused-key { return @tr("{0} refused the key.", Voice.service); }
        if Voice.problem == VoiceProblem.quota { return @tr("{0} says the key is out of credit or used too fast: {1}", Voice.service, Voice.detail); }
        if Voice.problem == VoiceProblem.network { return @tr("Could not reach {0}: {1}", Voice.service, Voice.detail); }
        if Voice.problem == VoiceProblem.bad-address { return @tr("The speech service's address in Voice input is not one FinchGram can use."); }
        if Voice.problem == VoiceProblem.nothing-heard { return @tr("Nothing was heard. Is the right microphone chosen in System Settings → Sound?"); }
        return @tr("{0} said: {1}", Voice.service, Voice.detail);
    }
    // The problem's button; "" for none.
    public pure function action() -> string {
        if Voice.problem == VoiceProblem.no-service { return @tr("Set up"); }
        if Voice.problem == VoiceProblem.no-key { return @tr("Add key"); }
        if Voice.problem == VoiceProblem.refused-key { return @tr("Change key"); }
        if Voice.problem == VoiceProblem.bad-address { return @tr("Change address"); }
        if Voice.problem == VoiceProblem.microphone-denied { return @tr("Open System Settings"); }
        return "";
    }

    // The toolbox's Voice input panel.
    public pure function switch-title() -> string { return @tr("Use voice input"); }
    public pure function switch-note() -> string { return @tr("Puts the sparkle in every chat's composer; when off, nothing goes to any service"); }
    public pure function main-language() -> string { return @tr("Main language"); }
    public pure function main-language-note() -> string {
        return @tr("The language you mostly speak; words of other languages mixed in are kept as you say them. Each main language picks its own connections. While you speak, a click on the language in the strip takes the next one.");
    }
    public pure function add-language() -> string { return @tr("Add"); }
    public pure function remove-language(name: string) -> string { return @tr("Remove {0}", name); }
    public pure function speech-section(name: string) -> string { return @tr("Speech recognition · {0}", name); }
    public pure function tidy-section(name: string) -> string { return @tr("Tidying · {0}", name); }
    public pure function api-format() -> string { return @tr("API format"); }
    // The connections.
    public pure function connections() -> string { return @tr("Connections"); }
    public pure function connections-note() -> string {
        return @tr("Your services, each a name, an API format, an address and a key. Each ability below takes one of them, and one connection can serve several.");
    }
    public pure function add-connection() -> string { return @tr("Add a connection"); }
    public pure function name() -> string { return @tr("Name"); }
    public pure function name-note() -> string { return @tr("What you call it, so that you know it when you choose."); }
    public pure function remove-connection() -> string { return @tr("Remove this connection and its key"); }
    public pure function no-key() -> string { return @tr("no key"); }
    // A format's name on its chip and in the list.
    public pure function format-name(format: string) -> string {
        if format == "anthropic" { return "Anthropic"; }
        if format == "gemini" { return "Gemini"; }
        if format == "dashscope" { return @tr("Alibaba Cloud Model Studio"); }
        if format == "doubao" { return @tr("Doubao speech (Volcengine)"); }
        return @tr("OpenAI-compatible");
    }
    // What a format can do, under its chips.
    public pure function format-note(format: string) -> string {
        if format == "anthropic" { return @tr("Tidying: Claude's Messages API, Anthropic's and the relays' and vendors' that speak it."); }
        if format == "gemini" { return @tr("Tidying: Google's Gemini API."); }
        if format == "dashscope" { return @tr("Speech recognition (Qwen-ASR, strong in Chinese and its dialects) and tidying (Qwen), one key for both."); }
        if format == "doubao" { return @tr("Speech recognition: Doubao's Seed-ASR, strong in Chinese. A key from Volcengine's speech console."); }
        return @tr("Speech recognition and tidying: OpenAI, and nearly every other service that speaks its API: Groq, SiliconFlow, DeepSeek, Kimi, OpenRouter, Ollama, relays, a Whisper server of your own.");
    }
    // Where a format's keys are made, as the link names it.
    public pure function vendor(format: string) -> string {
        if format == "anthropic" { return "Anthropic"; }
        if format == "gemini" { return "Google AI Studio"; }
        if format == "dashscope" { return @tr("Alibaba Cloud Model Studio"); }
        if format == "doubao" { return @tr("Volcengine"); }
        return "OpenAI";
    }
    public pure function address() -> string { return @tr("Address"); }
    public pure function address-note() -> string { return @tr("Empty for the vendor's own. For a relay or a server of your own, its base URL."); }
    public pure function address-problem(problem: int) -> string {
        if problem == 1 { return @tr("That is not an address: it starts with https://"); }
        if problem == 2 { return @tr("Leave the name and password out of the address."); }
        if problem == 3 { return @tr("Plain http goes only to this Mac or the local network: use https."); }
        return "";
    }
    public pure function key() -> string { return @tr("API key"); }
    public pure function key-note() -> string { return @tr("Your own key: the service bills it for what it does. It is kept sealed in FinchGram's database on this Mac."); }
    public pure function key-placeholder() -> string { return @tr("Paste the key"); }
    public pure function save() -> string { return @tr("Save"); }
    public pure function remove() -> string { return @tr("Remove"); }
    public pure function get-key(vendor: string) -> string { return @tr("Get a key from {0}", vendor); }
    // What the last check of the open connection said.
    public pure function check-text() -> string {
        if Voice.connection-check == KeyCheck.malformed { return @tr("That does not look like an API key."); }
        if Voice.connection-check == KeyCheck.checking { return @tr("Checking with {0}…", Voice.connection-shown); }
        if Voice.connection-check == KeyCheck.works {
            return Voice.connection-has-key ? @tr("{0} answers and takes the key.", Voice.connection-shown) : @tr("{0} answers.", Voice.connection-shown);
        }
        if Voice.connection-check == KeyCheck.refused { return @tr("{0} refused the key.", Voice.connection-shown); }
        if Voice.connection-check == KeyCheck.failed { return @tr("Could not check: {0}", Voice.connection-check-detail); }
        return "";
    }
    // Faint, a warning, or a good word: what the check deserves.
    public pure function check-tone() -> int {
        if Voice.connection-check == KeyCheck.works { return 2; }
        if Voice.connection-check == KeyCheck.malformed || Voice.connection-check == KeyCheck.refused || Voice.connection-check == KeyCheck.failed { return 1; }
        return 0;
    }
    // The abilities.
    public pure function connection() -> string { return @tr("Connection"); }
    public pure function none-can() -> string { return @tr("No connection can do this yet: add one above."); }
    public pure function same-as-speech() -> string { return @tr("Same as speech recognition"); }
    public pure function choice-label(choice: VoiceChoice) -> string { return choice.id == "" ? same-as-speech() : choice.label; }
    public pure function mode() -> string { return @tr("How it hears"); }
    public pure function mode-realtime() -> string { return @tr("As you speak"); }
    public pure function mode-upload() -> string { return @tr("When you are done"); }
    public pure function mode-note(mode: string) -> string {
        return mode == "upload"
            ? @tr("The recording goes up when you are done: what most relays and servers of your own take.")
            : @tr("Words show as you speak, through OpenAI's Realtime API.");
    }
    public pure function model() -> string { return @tr("Model"); }
    public pure function model-note(format: string) -> string {
        return format == "doubao" ? @tr("For Doubao, the resource ID of what you bought.") : @tr("Empty for the format's own.");
    }
    public pure function keywords() -> string { return @tr("Words to know"); }
    public pure function keywords-note() -> string { return @tr("Names and terms you often say, separated by commas: the service listens for them, so they come out right."); }
    public pure function keywords-placeholder() -> string { return @tr("Names, products, terms"); }
    public pure function tidy() -> string { return @tr("Tidy the words"); }
    public pure function tidy-note() -> string { return @tr("A small model takes out um, uh and repeated words, and sets the punctuation; it never translates."); }
    public pure function messages-section() -> string { return @tr("Voice messages"); }
    public pure function transcribe-messages() -> string { return @tr("Transcribe voice messages with your own service"); }
    public pure function transcribe-messages-note() -> string {
        return @tr("Transcribe under a voice message asks Telegram first, which needs Premium or one of its few free tries a week. When Telegram cannot, this sends the message to your speech service: someone else's voice, to a service of your choosing. Off unless you turn it on.");
    }
    public pure function about() -> string {
        return @tr("Press the sparkle in a chat's composer, or type /voice in Terminal, and speak; press it again, or ⏎, and the words go into the box for you to send. Your voice goes to the speech service you choose below, under your own key, and nothing else does. FinchGram keeps no recording.");
    }
}
