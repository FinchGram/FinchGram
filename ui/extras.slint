// The design's fifth round, shared by the themes: reactions (the chips under a message and the
// picker), round video messages, contact cards, the topics of a group with topics, the group's
// rules and administration in the settings panel, and the panel that shares to other chats.
// Each theme gives them its colours, corners and type; the words are here (ExtraWords), as the
// bots' are in chat.slint.
import { Icon, Spinner } from "widgets.slint";
import { Fmt } from "format.slint";
import { Conversation, Viewer, Reaction, RoundNote, ContactCard, TopicRow, Share, ShareKind, ShareRow, ChatKind } from "telegram.slint";
import { SearchInput } from "chat.slint";

// (The list separator inside is the language's: the same @tr as Words.list-separator in telegram.slint.)
export global ExtraWords {
    // Reactions.
    public pure function reaction-note(max: int) -> string {
        if max > 1 { return @tr("Up to {n} reactions per message. Double-click a message to react quickly." | "Up to {n} reactions per message. Double-click a message to react quickly." % max); }
        return @tr("One reaction per message; Premium allows three. Double-click a message to react quickly.");
    }
    public pure function react() -> string { return @tr("React"); }
    // Round video messages.
    public pure function round-label(playing: bool) -> string { return playing ? @tr("Playing · click to pause") : @tr("Video message · click to play"); }
    // Contact cards.
    public pure function registered(yes: bool) -> string { return yes ? @tr("On Telegram") : @tr("Not on Telegram yet"); }
    public pure function message() -> string { return @tr("Message"); }
    public pure function invite() -> string { return @tr("Invite"); }
    public pure function add-contact() -> string { return @tr("Add contact"); }
    public pure function added() -> string { return @tr("Added"); }
    public pure function share() -> string { return @tr("Share"); }
    public pure function invitation() -> string { return @tr("Hey, I'm using Telegram to chat. Join me! Download it here: https://telegram.org/dl"); }
    public pure function invite-copied(name: string) -> string { return @tr("Invitation copied; send it to {0}", name); }
    public pure function contact-added(name: string) -> string { return @tr("{0} is in your contacts now", name); }
    // Topics.
    public pure function topics-title(n: int) -> string { return @tr("Topics · {0}", n); }
    public pure function new-topic() -> string { return @tr("New topic"); }
    public pure function topic-name() -> string { return @tr("Topic name"); }
    public pure function all-topics() -> string { return @tr("All topics"); }
    public pure function cancel() -> string { return @tr("Cancel"); }
    public pure function create() -> string { return @tr("Create"); }
    public pure function topics-note() -> string { return @tr("Each topic has its own messages and unread count. Administrators can pin or close topics."); }
    public pure function topic-closed() -> string { return @tr("This topic was closed by an administrator. No more messages can be sent."); }
    public pure function loading-topics() -> string { return @tr("Loading topics…"); }
    // Sharing.
    public pure function share-title(kind: ShareKind) -> string { return kind == ShareKind.contact ? @tr("Share contact") : @tr("Forward to…"); }
    public pure function search-chats() -> string { return @tr("Search chats"); }
    public pure function no-chats() -> string { return @tr("No matching chats"); }
    public pure function comment-placeholder() -> string { return @tr("Add a message (optional)"); }
    public pure function send-to(n: int) -> string {
        if n == 0 { return @tr("Choose chats"); }
        return @tr("Send to {n} chat" | "Send to {n} chats" % n);
    }
    public pure function sent(n: int) -> string { return @tr("Sent to {n} chat" | "Sent to {n} chats" % n); }
    public pure function cannot-forward() -> string { return @tr("This chat does not allow forwarding."); }
    public pure function only-you() -> string { return @tr("Only you can see it"); }
    public pure function chat-sub(kind: ChatKind, members: int, online: bool) -> string {
        if kind == ChatKind.saved { return only-you(); }
        if kind == ChatKind.group { return @tr("{n} member" | "{n} members" % members); }
        if kind == ChatKind.bot { return @tr("bot"); }
        return online ? @tr("online") : "";
    }
    // Drafts.
    public pure function draft() -> string { return @tr("Draft"); }
    // Slow mode.
    public pure function mmss(seconds: int) -> string {
        return floor(seconds / 60) + ":" + (mod(seconds, 60) < 10 ? "0" : "") + mod(seconds, 60);
    }
    public pure function slow-wait-placeholder(seconds: int) -> string { return @tr("Slow mode · you can send again in {0}", mmss(seconds)); }
    public pure function slow-wait-hint(seconds: int) -> string { return @tr("Slow mode · {0} to wait", mmss(seconds)); }
    public pure function slow-hint(seconds: int) -> string { return @tr("Slow mode · one message every {0}", slow-label(seconds)); }
    public pure function slow-label(seconds: int) -> string {
        if seconds == 0 { return @tr("slow mode" => "Off"); }
        if seconds == 10 { return @tr("10 seconds"); }
        if seconds == 30 { return @tr("30 seconds"); }
        if seconds == 60 { return @tr("1 minute"); }
        if seconds == 300 { return @tr("5 minutes"); }
        if seconds == 900 { return @tr("15 minutes"); }
        if seconds == 3600 { return @tr("1 hour"); }
        return @tr("{n} second" | "{n} seconds" % seconds);
    }
    // The settings panel.
    // Telegram's refusals (src/telegram/errors.rs): "" for one without words here.
    public pure function telegram-error(code: string, n: int) -> string {
        if code == "FLOOD_WAIT" { return @tr("Too many requests. Try again in {n} second." | "Too many requests. Try again in {n} seconds." % n); }
        if code == "SLOWMODE_WAIT" { return @tr("Slow mode: you can send again in {n} second." | "Slow mode: you can send again in {n} seconds." % n); }
        if code == "CHAT_ADMIN_REQUIRED" { return @tr("Only administrators can do this."); }
        if code == "REACTION_INVALID" { return @tr("This reaction is not allowed here."); }
        if code == "TOPIC_CLOSED" { return @tr("This topic is closed."); }
        if code == "CHAT_FORWARDS_RESTRICTED" { return @tr("This chat does not allow forwarding."); }
        if code == "CHAT_SEND_PLAIN_FORBIDDEN" { return @tr("Members cannot send messages in this group."); }
        if code == "USER_BANNED_IN_CHANNEL" { return @tr("You cannot write in this group."); }
        return "";
    }
}

// The reactions to a message: a chip for each, ours lit; a click gives or takes back that one.
export component ReactionChips {
    in property <[Reaction]> reactions;
    in property <color> fill;
    in property <color> ink;
    in property <color> chosen-fill;
    in property <color> chosen-ink;
    in property <color> ring;
    in property <string> font-family;
    in property <length> radius: 12px;
    callback react(string);
    height: 24px;

    HorizontalLayout {
        alignment: start;
        spacing: 4px;
        for reaction in root.reactions: Rectangle {
            width: chip.preferred-width + 16px;
            height: 24px;
            border-radius: root.radius;
            background: reaction.chosen ? root.chosen-fill : root.fill;
            border-width: reaction.chosen ? 1px : 0;
            border-color: root.ring;
            chip := HorizontalLayout {
                alignment: center;
                spacing: 4px;
                Text {
                    text: reaction.emoji;
                    font-size: 14px;
                    vertical-alignment: center;
                }
                Text {
                    text: reaction.count;
                    color: reaction.chosen ? root.chosen-ink : root.ink;
                    font-family: root.font-family;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.react(reaction.emoji);
                }
            }
        }
    }
}

// The picker: the emoji the chat allows in a row, and how many one may give.
export component ReactionPicker inherits Rectangle {
    in property <[string]> choices;
    in property <int> max;
    in property <color> bg;
    in property <color> line;
    in property <color> soft;
    in property <color> note-color;
    in property <color> shadow: #00000029;
    in property <length> radius: 8px;
    in property <string> font-family;
    callback pick(string);
    width: body.preferred-width;
    height: body.preferred-height;
    border-radius: root.radius;
    background: root.bg;
    border-width: 1px;
    border-color: root.line;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: root.shadow;

    body := VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 6px;
        HorizontalLayout {
            alignment: start;
            spacing: 2px;
            for emoji in root.choices: Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: touch.has-hover ? root.soft : transparent;
                Text {
                    text: emoji;
                    font-size: touch.has-hover ? 23px : 20px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.pick(emoji);
                    }
                }
            }
        }
        Text {
            width: 280px;
            text: ExtraWords.reaction-note(root.max);
            color: root.note-color;
            font-family: root.font-family;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}

// A round video message: its still in a circle, the play button, its length; while it plays, the
// player's frame (Viewer.frame) and a ring in the accent.
export component RoundNoteView {
    in property <RoundNote> note;
    in property <color> line;
    in property <color> accent;
    in property <color> side;
    in property <color> faint;
    in property <string> mono;
    in property <string> font-family;
    in property <length> font-size: 12px;
    in property <length> size: 180px;
    callback clicked();
    width: root.size;
    height: body.preferred-height;

    body := VerticalLayout {
        spacing: 6px;
        alignment: start;
        circle := Rectangle {
            width: root.size;
            height: root.size;
            border-radius: root.size / 2;
            background: root.side;
            border-width: 3px;
            border-color: root.note.playing ? root.accent : root.line;
            clip: true;
            if root.note.has-picture || root.note.playing: Image {
                width: parent.width;
                height: parent.height;
                source: root.note.playing && Viewer.frame.width > 0 ? Viewer.frame : root.note.picture;
                image-fit: cover;
            }
            Rectangle {
                width: 48px;
                height: 48px;
                border-radius: 24px;
                background: #00000073;
                if !root.note.loading: Icon {
                    name: root.note.playing ? "pause" : "play";
                    size: 22px;
                    color: #ffffff;
                    duotone: false;
                }
                if root.note.loading: Spinner {
                    size: 22px;
                    color: #ffffff;
                }
            }
            Rectangle {
                y: root.size - 16px - self.height;
                width: duration.preferred-width + 14px;
                height: 18px;
                border-radius: 9px;
                background: #00000080;
                duration := Text {
                    text: root.note.duration;
                    color: #ffffff;
                    font-family: root.mono;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.clicked();
                }
            }
        }
        Text {
            width: root.size;
            text: ExtraWords.round-label(root.note.playing);
            color: root.faint;
            font-family: root.font-family;
            font-size: root.font-size;
            wrap: word-wrap;
        }
    }
}

// A contact card: who, their number, whether they are on Telegram; Message (or Invite), Add
// contact, Share.
export component ContactCardView inherits Rectangle {
    in property <ContactCard> card;
    in property <color> bg;
    in property <color> line;
    in property <color> soft;
    in property <color> soft-ink;
    in property <color> accent;
    in property <color> text-color;
    in property <color> muted;
    in property <color> faint;
    in property <length> radius: 8px;
    in property <length> av-radius: 6px;
    in property <string> font-family;
    in property <length> font-size: 13px;
    in property <length> small: 12px;
    callback message();
    callback invite();
    callback add();
    callback share();
    width: 280px;
    height: body.preferred-height;
    border-radius: root.radius;
    background: root.bg;
    border-width: 1px;
    border-color: root.line;
    clip: true;

    body := VerticalLayout {
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: root.av-radius;
                    background: root.soft;
                    Text {
                        text: root.card.initial;
                        color: root.soft-ink;
                        font-family: root.font-family;
                        font-size: 16px;
                        font-weight: 600;
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;
                Text {
                    text: root.card.name;
                    color: root.text-color;
                    font-family: root.font-family;
                    font-size: root.font-size;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: root.card.phone;
                    color: root.muted;
                    font-family: root.font-family;
                    font-size: root.small;
                }
                Text {
                    text: ExtraWords.registered(root.card.registered);
                    color: root.faint;
                    font-family: root.font-family;
                    font-size: root.small;
                }
            }
        }
        Rectangle {
            height: 1px;
            background: root.line;
        }
        HorizontalLayout {
            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                Text {
                    text: root.card.registered ? ExtraWords.message() : ExtraWords.invite();
                    color: root.accent;
                    font-family: root.font-family;
                    font-size: root.small;
                    font-weight: 600;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if root.card.registered {
                            root.message();
                        } else {
                            root.invite();
                        }
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                opacity: root.card.added ? 0.6 : 1;
                Text {
                    text: root.card.added ? ExtraWords.added() : ExtraWords.add-contact();
                    color: root.accent;
                    font-family: root.font-family;
                    font-size: root.small;
                    font-weight: 600;
                }
                TouchArea {
                    enabled: !root.card.added;
                    mouse-cursor: pointer;
                    clicked => {
                        root.add();
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                Text {
                    text: ExtraWords.share();
                    color: root.accent;
                    font-family: root.font-family;
                    font-size: root.small;
                    font-weight: 600;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.share();
                    }
                }
            }
        }
    }
}

// An on/off switch, 34 × 20, as the design's.
export component Toggle inherits Rectangle {
    in property <bool> on;
    in property <bool> enabled: true;
    in property <color> accent;
    in property <color> off;
    width: 34px;
    height: 20px;
    border-radius: 10px;
    background: root.on ? root.accent : root.off;
    opacity: root.enabled ? 1 : 0.5;
    animate background { duration: 200ms; }

    Rectangle {
        x: root.on ? 17px : 3px;
        y: 3px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: #ffffff;
        drop-shadow-blur: 2px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000033;
        animate x { duration: 200ms; }
    }
}

// The topics of a group with topics: the list the group opens on, with a new topic's form.
export component TopicList {
    in property <color> bg;
    in property <color> side;
    in property <color> soft;
    in property <color> soft-ink;
    in property <color> line;
    in property <color> accent;
    in property <color> accent-ink;
    in property <color> on-accent;
    in property <color> text-color;
    in property <color> muted;
    in property <color> faint;
    in property <color> danger;
    in property <color> selection;
    in property <color> selection-text-color: text-color;
    in property <length> radius: 6px;
    in property <length> big-radius: 8px;
    in property <string> font-family;
    in property <length> font-size: 13px;
    in property <length> small: 12px;
    property <bool> can-create: Conversation.new-topic-name != "" && !Conversation.new-topic-busy;
    height: body.preferred-height;

    body := VerticalLayout {
        alignment: start;
        HorizontalLayout {
            padding-bottom: 8px;
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                text: Conversation.topics-loading && Conversation.topic-count == 0 ? ExtraWords.loading-topics() : ExtraWords.topics-title(Conversation.topic-count).to-uppercase();
                color: root.faint;
                font-family: root.font-family;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 0.7px;
                vertical-alignment: center;
            }
            Rectangle {
                width: new-words.preferred-width;
                height: 28px;
                new-words := HorizontalLayout {
                    spacing: 5px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: "plus";
                            size: 13px;
                            color: root.accent-ink;
                            duotone: false;
                        }
                    }
                    Text {
                        text: ExtraWords.new-topic();
                        color: root.accent-ink;
                        font-family: root.font-family;
                        font-size: root.small;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Conversation.start-new-topic();
                    }
                }
            }
        }
        if Conversation.new-topic-open: Rectangle {
            height: form.preferred-height;
            border-radius: root.big-radius;
            background: root.side;
            form := VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 8px;
                Rectangle {
                    height: 32px;
                    border-radius: root.radius;
                    background: root.bg;
                    border-width: 1px;
                    border-color: name.has-focus ? root.accent : root.line;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        name := SearchInput {
                            text <=> Conversation.new-topic-name;
                            placeholder: ExtraWords.topic-name();
                            text-color: root.text-color;
                            placeholder-color: root.faint;
                            selection-color: root.selection;
                            selection-text-color: root.selection-text-color;
                            font-family: root.font-family;
                            font-size: root.font-size;
                            init => {
                                self.focus-text();
                            }
                            accepted => {
                                if root.can-create {
                                    Conversation.create-topic();
                                }
                            }
                            escape => {
                                Conversation.cancel-new-topic();
                            }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 4px;
                    for emoji[index] in Conversation.topic-icons: Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 8px;
                        border-width: Conversation.new-topic-icon == index ? 2px : 0;
                        border-color: root.accent;
                        background: icon-touch.has-hover ? root.bg : transparent;
                        Text {
                            text: emoji;
                            font-size: 17px;
                        }
                        icon-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                Conversation.new-topic-icon = index;
                            }
                        }
                    }
                }
                if Conversation.new-topic-error != "": Text {
                    text: Conversation.new-topic-error;
                    color: root.danger;
                    font-family: root.font-family;
                    font-size: root.small;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Rectangle {
                        width: cancel.preferred-width + 24px;
                        height: 32px;
                        cancel := Text {
                            text: ExtraWords.cancel();
                            color: root.muted;
                            font-family: root.font-family;
                            font-size: root.small;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                Conversation.cancel-new-topic();
                            }
                        }
                    }
                    Rectangle {
                        width: create.preferred-width + 28px;
                        height: 32px;
                        border-radius: root.radius;
                        background: root.can-create ? root.accent : root.line;
                        create := Text {
                            text: ExtraWords.create();
                            color: root.can-create ? root.on-accent : root.faint;
                            font-family: root.font-family;
                            font-size: root.small;
                            font-weight: 600;
                        }
                        if Conversation.new-topic-busy: Spinner {
                            x: 6px;
                            size: 12px;
                            color: root.faint;
                        }
                        TouchArea {
                            enabled: root.can-create;
                            mouse-cursor: pointer;
                            clicked => {
                                Conversation.create-topic();
                            }
                        }
                    }
                }
            }
        }
        if Conversation.new-topic-open: Rectangle { height: 8px; }
        for topic in Conversation.topics: Rectangle {
            height: 56px;
            border-radius: root.radius;
            background: row-touch.has-hover ? root.side : transparent;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        background: topic.icon == "" ? root.soft : topic.color.with-alpha(0.22);
                        Text {
                            text: topic.icon == "" ? "#" : topic.icon;
                            color: root.soft-ink;
                            font-family: root.font-family;
                            font-size: 17px;
                            font-weight: 600;
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: topic.title;
                            color: root.text-color;
                            font-family: root.font-family;
                            font-size: root.font-size;
                            font-weight: 600;
                            overflow: elide;
                        }
                        if topic.pinned: VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "push-pin";
                                size: 12px;
                                color: root.faint;
                                duotone: false;
                            }
                        }
                        if topic.closed: VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "lock-simple";
                                size: 12px;
                                color: root.faint;
                                duotone: false;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: Fmt.list-time(topic.time);
                            color: root.faint;
                            font-family: root.font-family;
                            font-size: 11px;
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            horizontal-stretch: 1;
                            text: topic.last;
                            color: root.muted;
                            font-family: root.font-family;
                            font-size: root.small;
                            overflow: elide;
                        }
                        if topic.unread > 0: Rectangle {
                            width: unread.preferred-width + 14px;
                            height: 18px;
                            border-radius: 9px;
                            background: root.accent;
                            unread := Text {
                                text: topic.unread;
                                color: root.on-accent;
                                font-family: root.font-family;
                                font-size: 11px;
                                font-weight: 600;
                            }
                        }
                    }
                }
            }
            row-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Conversation.open-topic(topic.id);
                }
            }
        }
        Text {
            text: ExtraWords.topics-note();
            color: root.faint;
            font-family: root.font-family;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}

// The share panel's inside: what is shared, the search, the chats to choose, words to add, Send.
// Each theme puts it in its own dialog box.
export component SharePanelBody {
    in property <color> bg;
    in property <color> side;
    in property <color> soft;
    in property <color> soft-ink;
    in property <color> line;
    in property <color> accent;
    in property <color> on-accent;
    in property <color> text-color;
    in property <color> muted;
    in property <color> faint;
    in property <color> danger;
    in property <color> selection;
    in property <color> selection-text-color: text-color;
    in property <length> radius: 6px;
    in property <length> av-radius: 6px;
    in property <string> font-family;
    in property <length> font-size: 13px;
    in property <length> small: 12px;
    in property <length> title-size: 16px;
    in property <length> list-height: 300px;
    property <bool> can-send: Share.picked > 0 && !Share.busy;
    height: body.preferred-height;

    body := VerticalLayout {
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 16px;
            padding-top: 16px;
            padding-bottom: 10px;
            spacing: 12px;
            Text {
                horizontal-stretch: 1;
                text: ExtraWords.share-title(Share.kind);
                color: root.text-color;
                font-family: root.font-family;
                font-size: root.title-size;
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle {
                width: 26px;
                height: 26px;
                Icon {
                    name: "x";
                    size: 18px;
                    color: root.faint;
                    duotone: false;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Share.close();
                    }
                }
            }
        }
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 10px;
            Rectangle {
                height: preview.preferred-height + 16px;
                border-radius: root.radius;
                background: root.side;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    preview := Text {
                        text: Share.preview;
                        color: root.muted;
                        font-family: root.font-family;
                        font-size: root.small;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 8px;
            Rectangle {
                height: 34px;
                border-radius: root.radius;
                border-width: 1px;
                border-color: search.has-focus ? root.accent : root.line;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: "magnifying-glass";
                            size: 14px;
                            color: root.faint;
                            duotone: false;
                        }
                    }
                    search := SearchInput {
                        text <=> Share.query;
                        placeholder: ExtraWords.search-chats();
                        text-color: root.text-color;
                        placeholder-color: root.faint;
                        selection-color: root.selection;
                        selection-text-color: root.selection-text-color;
                        font-family: root.font-family;
                        font-size: root.font-size;
                        init => {
                            self.focus-text();
                        }
                        edited(words) => {
                            Share.search(words);
                        }
                        escape => {
                            Share.close();
                        }
                    }
                }
            }
        }
        Flickable {
            height: min(root.list-height, list.preferred-height);
            content-height: list.preferred-height;
            list := VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: start;
                for row in Share.rows: Rectangle {
                    height: 48px;
                    border-radius: root.radius;
                    background: row-touch.has-hover ? root.side : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 34px;
                                height: 34px;
                                border-radius: root.av-radius;
                                background: root.soft;
                                clip: true;
                                if row.has-picture: Image {
                                    width: parent.width;
                                    height: parent.height;
                                    source: row.picture;
                                    image-fit: cover;
                                }
                                if !row.has-picture: Text {
                                    text: row.initial;
                                    color: root.soft-ink;
                                    font-family: root.font-family;
                                    font-size: 13px;
                                    font-weight: 600;
                                }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: row.title;
                                color: root.text-color;
                                font-family: root.font-family;
                                font-size: root.font-size;
                                font-weight: 500;
                                overflow: elide;
                            }
                            if row.sub != "": Text {
                                text: row.sub;
                                color: root.faint;
                                font-family: root.font-family;
                                font-size: root.small;
                                overflow: elide;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 18px;
                                height: 18px;
                                border-radius: 9px;
                                background: row.picked ? root.accent : transparent;
                                border-width: row.picked ? 0 : 1.5px;
                                border-color: root.faint;
                                if row.picked: Icon {
                                    name: "check";
                                    size: 12px;
                                    color: root.on-accent;
                                    duotone: false;
                                }
                            }
                        }
                    }
                    row-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Share.toggle(row.id);
                        }
                    }
                }
                if Share.rows.length == 0: Text {
                    height: 40px;
                    text: ExtraWords.no-chats();
                    color: root.faint;
                    font-family: root.font-family;
                    font-size: root.small;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle {
            height: 1px;
            background: root.line;
        }
        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 12px;
            padding-bottom: 18px;
            spacing: 8px;
            Rectangle {
                height: 34px;
                border-radius: root.radius;
                border-width: 1px;
                border-color: comment.has-focus ? root.accent : root.line;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    comment := SearchInput {
                        text <=> Share.comment;
                        placeholder: ExtraWords.comment-placeholder();
                        text-color: root.text-color;
                        placeholder-color: root.faint;
                        selection-color: root.selection;
                        selection-text-color: root.selection-text-color;
                        font-family: root.font-family;
                        font-size: root.font-size;
                        accepted => {
                            if root.can-send {
                                Share.send();
                            }
                        }
                        escape => {
                            Share.close();
                        }
                    }
                }
            }
            if Share.error != "": Text {
                text: Share.error;
                color: root.danger;
                font-family: root.font-family;
                font-size: root.small;
                wrap: word-wrap;
            }
            Rectangle {
                height: 36px;
                border-radius: root.radius;
                background: root.can-send ? root.accent : root.line;
                Text {
                    text: ExtraWords.send-to(Share.picked);
                    color: root.can-send ? root.on-accent : root.faint;
                    font-family: root.font-family;
                    font-size: root.font-size;
                    font-weight: 600;
                }
                if Share.busy: Spinner {
                    x: 10px;
                    size: 14px;
                    color: root.faint;
                }
                TouchArea {
                    enabled: root.can-send;
                    mouse-cursor: pointer;
                    clicked => {
                        Share.send();
                    }
                }
            }
        }
    }
}
