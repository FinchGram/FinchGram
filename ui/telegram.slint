// What Telegram shows: the account, logging in, the chat list and the open chat. Rust fills these
// globals from TDLib (src/telegram/); every theme reads the same ones and calls the same callbacks,
// so the three stay in step. Numbers TDLib keeps as 53-bit integers (chat and message ids) are
// strings here: a Slint int has 32 bits.

// A moment in local time, taken apart by Rust so that the pages can word it in the UI language
// (format.slint).
export enum Day { today, yesterday, this-week, this-year, earlier }
export struct Moment {
    day: Day,
    hour: int,
    minute: int,
    weekday: int,           // 1 Monday … 7 Sunday
    month: int,             // 1 … 12
    date: int,              // day of the month
    year: int,
}

export enum ChatKind { user, bot, saved, group, channel }

// What a message holds, for its row and for the chat list's preview. Its words (text or caption) are
// separate; `detail` carries what the kind needs: a file name, an emoji, a poll's question, a new
// title, the names of members added.
export enum Content {
    text, photo, video, animation, audio, voice-note, video-note, document, sticker, location, venue,
    contact, poll, dice, game, invoice, call, story, gift, unsupported,
    // Service messages: something happened in the chat. The sender is who did it.
    chat-created, title-changed, photo-changed, photo-removed, members-added, member-joined,
    member-left, member-removed, message-pinned, screenshot-taken, contact-joined, other-service,
}

// One chat in a list.
export struct ChatRow {
    id: string,
    title: string,
    initial: string,
    kind: ChatKind,
    has-message: bool,      // false for a chat without messages
    time: Moment,           // of the last message
    sender: string,         // of the last message, where the list shows it (groups); "" otherwise
    outgoing: bool,         // the last message is ours
    content: Content,
    text: string,
    detail: string,
    unread: int,
    mention: bool,          // an unread message mentions us
    muted: bool,
    pinned: bool,
    online: bool,           // a user who is online now
    verified: bool,         // Telegram's check mark (official bots and channels)
    members: int,           // of a group, subscribers of a channel; 0 when not known
    username: string,       // without the @
}

// A folder of chats: 0 is All chats, the others are the account's own Telegram folders.
export struct Folder {
    id: int,
    name: string,
    unread: int,            // unread messages in its chats
}

// A line of Workbench's chat tree: a folder's header, or one of its chats while it is expanded.
export struct TreeRow {
    header: bool,
    folder: int,            // index into Chats.folders; -1: a pinned chat, at the top in no folder
    expanded: bool,
    count: int,             // a header's number of chats
    chat: ChatRow,
}

export global Chats {
    in-out property <[Folder]> folders;
    in-out property <int> folder: 0;             // the folder shown by Broadsheet and Terminal
    in-out property <[ChatRow]> list;            // its chats, in Telegram's order
    in-out property <[TreeRow]> tree;            // Workbench: every folder, with its chats when expanded
    in-out property <[ChatRow]> channels;        // every channel, for the Channels view
    in-out property <int> unread-channels;       // how many of them have unread posts
    in-out property <[ChatRow]> official-bots;   // chats with Telegram's own bots, for the Bots view
    in-out property <[ChatRow]> bots;            // chats with every other bot
    in-out property <bool> loaded;               // TDLib has sent the chat list
    in-out property <string> query;              // the search box's words; the lists show what matches
    callback show-folder(int);                   // index into folders
    callback toggle-folder(int);                 // Workbench: expand or collapse
    callback search(string);
    // A chat's menu (a right click on it in a list), by the chat's id.
    callback toggle-mute(string);
    callback toggle-pin(string, int);            // in the list of a folder (index into folders); -1:
                                                 // wherever it is pinned, as Workbench's tree has it
    callback mark-read(string);
}

// A tab of Workbench (and what Broadsheet and Terminal remember as open).
export struct Tab {
    id: string,
    title: string,
    kind: ChatKind,
}

export enum RowKind { message, service, day, sponsored }

// A photo, video or GIF in a message: the best picture there is so far (the message's tiny preview
// until Conversation.load-picture has downloaded a sharp one), its own size for its shape, and a
// video's length.
export struct Media {
    id: string,             // the message it is in
    picture: image,
    width: int,
    height: int,
    video: bool,            // a video or a GIF: it plays
    duration: int,          // seconds
    name: string,           // a video's or GIF's file name; photos have none
}

// A sticker message's sticker: its picture (none until Conversation.load-picture has downloaded it;
// an animated sticker shows its still thumbnail) and its own size for its shape. A width of 0:
// there is no picture to show, only the emoji.
export struct Sticker {
    picture: image,
    width: int,
    height: int,
}

// One line of the open chat: a message, a service message, the day it starts, or a sponsored
// message (channels show Telegram's own; they are never hidden).
export struct MessageRow {
    kind: RowKind,
    id: string,
    outgoing: bool,
    sender: string,
    sender-initial: string,
    sender-color: int,      // 0 … 7, the same for the same sender (Terminal's names)
    content: Content,
    text: string,
    detail: string,
    time: string,           // "14:20"
    day: Moment,            // for a day row
    edited: bool,
    sending: bool,
    failed: bool,
    seen: bool,             // an outgoing message the other side has read
    button: string,         // a sponsored message's button
    media: [Media],         // its photos, videos and GIFs: one, or an album's
    sticker: Sticker,
}


// How the open chat's header describes it.
export enum Status {
    none, online, last-seen, recently, last-week, last-month, long-ago,
    bot, members, subscribers, saved,
}

export global Conversation {
    in-out property <[Tab]> tabs;
    in-out property <string> chat-id;            // the open chat, "" for none
    in-out property <string> title;
    in-out property <string> initial;
    in-out property <ChatKind> kind;
    in-out property <Status> status;
    in-out property <Moment> last-seen;          // with Status.last-seen
    in-out property <int> members;               // with Status.members and Status.subscribers
    in-out property <int> online-members;
    in-out property <string> typing;             // who is typing now, "" when nobody
    in-out property <bool> can-write;
    in-out property <bool> muted;
    in-out property <bool> pinned;
    in-out property <[MessageRow]> messages;     // oldest first
    in-out property <bool> loading;              // the first messages are on their way
    in-out property <bool> has-older;
    // Rust counts this up when the view should show the newest message: the chat was opened, or we
    // sent one.
    in-out property <int> scroll-to-end;
    // A message the view should bring into sight (the media viewer's "locate"), "" for none.
    in-out property <string> reveal;
    callback open(string);                       // chat id; Workbench opens a tab for it
    callback close(string);                      // a tab
    callback close-others();
    callback send(string);
    callback load-older();
    callback retry(string);                      // a message that failed to send
    callback open-sponsored(string);             // a sponsored message's button
    callback load-picture(string);               // a message with a photo, video or GIF is in view
    callback toggle-mute();
    callback toggle-pin();
    callback mark-read();
}

// The media viewer (the design's media-viewer.js): the open chat's photos and videos, one at a time,
// over the whole window. Rust fills it (src/telegram/viewer.rs); zoom is the page's own.
export struct ViewerItem {
    id: string,             // the message
    picture: image,
    width: int,
    height: int,
    video: bool,
    duration: int,          // seconds
    name: string,           // a video's or GIF's file name; photos have none
    sender: string,
    sender-initial: string,
    time: Moment,
    caption: string,
}

export global Viewer {
    in-out property <bool> open;
    in-out property <[ViewerItem]> items;        // the open chat's media, oldest first
    in-out property <int> index;                 // the one shown
    in-out property <int> zoom;                  // 0 … 3: fit, 150 %, 200 %, 300 %
    in-out property <bool> playing;
    in-out property <bool> loading;              // the video is downloading before it plays
    in-out property <bool> ended;                // played to its end
    in-out property <float> position;            // seconds into the video
    in-out property <int> speed;                 // 0 … 3: 1×, 1.5×, 2×, 0.5×
    in-out property <bool> muted;
    in-out property <image> frame;               // the video's picture while it plays
    in-out property <string> saved;              // a file just saved to Downloads, "" otherwise
    callback view(string, bool);                 // a message's media; true: a video starts playing
    callback close();
    callback show(int);                          // another item
    callback play-pause();
    callback seek(float);                        // 0 … 1 of the video
    callback next-speed();
    callback toggle-mute();
    callback download();                         // the one shown, to the Downloads folder
    callback locate();                           // close, and scroll the chat to its message
}

// The account logged in.
export global Account {
    in-out property <string> name;
    in-out property <string> first-name;
    in-out property <string> last-name;
    in-out property <string> username;
    in-out property <string> phone;              // "+86 138 0013 2046"
    in-out property <string> bio;
    in-out property <string> initial;
    in-out property <bool> saving;
    in-out property <bool> saved;
    in-out property <string> save-error;
    callback save(string, string, string, string);   // first name, last name, username, bio
    callback log-out();
}

// Logging in (the design's second round, "登录引导"). Rust follows TDLib's authorization state; the
// pages can go back a step on their own.
// The steps of logging in. After the password come the ways to recover a forgotten one: a code sent
// to the recovery email address, then a new password; or, without that address, resetting the
// account.
export enum LoginStep {
    phone, qr, code, password,
    recovery-code, new-password, reset-account, account-reset-requested,
    email-address, email-code, registration, premium,
}
export enum CodeDelivery { telegram, sms, call, flash-call, missed-call, fragment, email, other }

export struct Country {
    code: string,           // "CN"
    name: string,           // in its own language
    calling-code: string,   // "86"
}

export global Login {
    in-out property <LoginStep> step: LoginStep.phone;
    in-out property <bool> busy;                 // a request is on its way
    in-out property <string> error;              // TDLib's answer to the last request, "" when fine
    in-out property <Country> country;           // chosen, or guessed from where we are
    in-out property <[Country]> countries;       // the picker's list, matching its search words
    in-out property <string> phone;              // as typed
    in-out property <string> code-phone;         // where the code went, as TDLib writes it
    in-out property <CodeDelivery> delivery;
    in-out property <int> code-length: 5;
    in-out property <bool> can-resend;
    in-out property <bool> resent;
    in-out property <string> password-hint;
    in-out property <bool> has-recovery-email;   // a forgotten password can be recovered by email
    in-out property <string> recovery-email;     // where the recovery code went, partly hidden
    in-out property <Moment> reset-date;         // when a requested account reset can be completed
    in-out property <string> email-pattern;      // the address the code went to, partly hidden
    in-out property <image> qr-code;
    callback search-countries(string);
    callback choose-country(Country);
    callback submit-phone(string, string);       // calling code, number
    callback use-qr-code();
    callback use-phone-number();
    callback submit-code(string);
    callback resend-code();
    callback submit-password(string);
    callback forgot-password();
    callback submit-recovery-code(string);
    callback submit-new-password(string, string, string);   // the password, again, its hint
    callback reset-account();
    callback submit-email(string);
    callback submit-email-code(string);
    callback sign-up(string, string);            // first name, last name
    pure callback initial(string) -> string;     // "zhou" → "Z", for the new account's picture
    callback back();                             // to the phone number
}

// Settings → Privacy & security → Two-step verification (src/telegram/password.rs). What changes
// the password asks for it first (verify); a forgotten one is recovered by email or reset.
export enum PasswordStep {
    overview, verify, new-password, hint, recovery-email, recovery-email-code, turn-off, recovery-code, reset,
}

// What the overview says was just done.
export enum PasswordChange { nothing, password, hint, recovery-email }

export global PasswordSettings {
    in-out property <bool> open;                 // shown instead of Privacy & security
    in-out property <bool> loaded;               // TDLib has said how the password is
    in-out property <bool> has-password;
    in-out property <string> hint;
    in-out property <bool> has-recovery-email;
    in-out property <string> recovery-email;     // once known: TDLib gives it only for the password
    in-out property <string> code-sent-to;       // where the last recovery or confirmation code went
    in-out property <bool> reset-pending;        // a reset without the password was asked for
    in-out property <Moment> reset-date;         // when it can be completed
    in-out property <PasswordStep> step;
    in-out property <bool> busy;
    in-out property <string> error;
    in-out property <PasswordChange> done;
    callback load();
    callback choose(PasswordStep);               // from the overview: what to change
    callback verify(string);
    callback forgot();
    callback submit-recovery-code(string);
    callback request-reset();
    callback cancel-reset();
    callback submit-new-password(string, string, string);   // the password, again, its hint
    callback submit-hint(string);
    callback submit-recovery-email(string);
    callback submit-recovery-email-code(string);
    callback turn-off();
    callback cancel();                           // back to the overview
}

// Words Rust needs in the UI language when it builds rows: names Telegram does not give. Rust reads
// them, and builds the rows again when the language changes.
export global Words {
    out property <string> saved-messages: @tr("Saved Messages");
    out property <string> deleted-account: @tr("Deleted Account");
    out property <string> all-chats: @tr("All chats");
}
