// What Telegram shows: the account, logging in, the chat list and the open chat. Rust fills these
// globals from TDLib (src/telegram/); every theme reads the same ones and calls the same callbacks,
// so the three stay in step. Numbers TDLib keeps as 53-bit integers (chat and message ids) are
// strings here: a Slint int has 32 bits.

// A moment in local time, taken apart by Rust so that the pages can word it in the UI language
// (format.slint).
export enum Day { today, yesterday, this-week, this-year, earlier }
export struct Moment {
    day: Day,
    hour: int,
    minute: int,
    weekday: int,           // 1 Monday … 7 Sunday
    month: int,             // 1 … 12
    date: int,              // day of the month
    year: int,
}

export enum ChatKind { user, bot, saved, group, channel }

// What a message holds, for its row and for the chat list's preview. Its words (text or caption) are
// separate; `detail` carries what the kind needs: a file name, an emoji, a poll's question, a new
// title, the names of members added.
export enum Content {
    text, photo, video, animation, audio, voice-note, video-note, document, sticker, location, venue,
    contact, poll, dice, game, invoice, call, story, gift, unsupported,
    // Self-destructing content that is gone: it was opened once, or its time ran out.
    expired-photo, expired-video, expired-video-note, expired-voice-note,
    // Service messages: something happened in the chat. The sender is who did it.
    chat-created, title-changed, photo-changed, photo-removed, members-added, member-joined,
    member-left, member-removed, message-pinned, screenshot-taken, contact-joined, other-service,
}

// One chat in a list.
export struct ChatRow {
    id: string,
    title: string,
    initial: string,        // for its letter square, while it has no picture
    picture: image,         // its photo once downloaded, its tiny preview until then
    has-picture: bool,      // false: the letter square
    kind: ChatKind,
    has-message: bool,      // false for a chat without messages
    time: Moment,           // of the last message
    sender: string,         // of the last message, where the list shows it (groups); "" otherwise
    outgoing: bool,         // the last message is ours
    content: Content,
    text: string,
    detail: string,
    unread: int,
    mention: bool,          // an unread message mentions us
    muted: bool,
    pinned: bool,
    online: bool,           // a user who is online now
    verified: bool,         // Telegram's check mark (official bots and channels)
    members: int,           // of a group, subscribers of a channel; 0 when not known
    username: string,       // without the @
}

// A folder of chats: 0 is All chats, the others are the account's own Telegram folders.
export struct Folder {
    id: int,
    name: string,
    unread: int,            // unread messages in its chats
}

// A line of Workbench's chat tree: a folder's header, or one of its chats while it is expanded.
export struct TreeRow {
    header: bool,
    folder: int,            // index into Chats.folders; -1: a pinned chat, at the top in no folder
    expanded: bool,
    count: int,             // a header's number of chats
    chat: ChatRow,
}

// One of the account's own folders in a chat's menu: whether the chat is in it.
export struct FolderChoice {
    folder: int,            // index into Chats.folders, 1 and up
    name: string,
    inside: bool,
}

export global Chats {
    in-out property <[Folder]> folders;
    in-out property <int> folder: 0;             // the folder shown by Broadsheet and Terminal
    in-out property <[ChatRow]> list;            // its chats, in Telegram's order
    in-out property <[TreeRow]> tree;            // Workbench: every folder, with its chats when expanded
    in-out property <[ChatRow]> channels;        // every channel, for the Channels view
    in-out property <int> unread-channels;       // how many of them have unread posts
    in-out property <[ChatRow]> official-bots;   // chats with Telegram's own bots, for the Bots view
    in-out property <[ChatRow]> bots;            // chats with every other bot
    in-out property <bool> loaded;               // TDLib has sent the chat list
    in-out property <string> query;              // the search box's words; the lists show what matches
    callback show-folder(int);                   // index into folders
    callback toggle-folder(int);                 // Workbench: expand or collapse
    callback search(string);
    // A chat's menu (a right click on it in a list, or on its tab in Workbench), by the chat's id.
    callback open-menu(string);                  // it opens: fill menu-folders for the chat
    in-out property <[FolderChoice]> menu-folders;  // the account's folders, and whether the chat is in each
    callback toggle-mute(string);
    callback toggle-pin(string, int);            // in the list of a folder (index into folders); -1:
                                                 // wherever it is pinned, as Workbench's tree has it
    callback mark-read(string);
    callback toggle-in-folder(string, int);      // put the chat into a folder (index into folders), or take it out
}

// A tab of Workbench (and what Broadsheet and Terminal remember as open).
export struct Tab {
    id: string,
    title: string,
    kind: ChatKind,
    muted: bool,
}

export enum RowKind { message, service, day, sponsored }

// A photo, video or GIF in a message: the best picture there is so far (the message's tiny preview
// until Conversation.load-picture has downloaded a sharp one), its own size for its shape, and a
// video's length.
export struct Media {
    id: string,             // the message it is in
    picture: image,
    width: int,
    height: int,
    video: bool,            // a video or a GIF: it plays
    duration: int,          // seconds
    name: string,           // a video's or GIF's file name; photos have none
    secret: bool,           // sent to self-destruct: blurred, to be opened once (viewer.rs)
    uploading: bool,        // ours, on its way to Telegram: a progress ring, and × to stop it
    progress: float,        // 0 … 1 of it sent
    size: string,           // "2.1 MB", while it goes up
    moved: string,          // "0.9 MB": how much has
}

// The icon of a file in a message, by its name (the design's sixth round colours them).
export enum FileType { image, archive, pdf, other }

// Where a file in a message is: on Telegram's servers only, on its way down, on its way up (ours),
// or on disk.
export enum FileState { remote, downloading, uploading, done }

// A file in a message (a document), as the design's card: its icon, name and size; its progress
// while it moves; once on disk, a click shows it in the Finder.
export struct FileCard {
    id: string,             // the message it is in
    name: string,
    size: string,           // "1.2 MB", or "0.4 MB of 1.2 MB" while it moves
    file-type: FileType,
    state: FileState,
    progress: float,        // 0 … 1 while it moves
    moved: string,          // "0.4 MB": how much has, while it moves
}

// A sticker message's sticker: its picture (none until Conversation.load-picture has downloaded it;
// an animated sticker shows its still thumbnail) and its own size for its shape. A width of 0:
// there is no picture to show, only the emoji.
export struct Sticker {
    picture: image,
    width: int,
    height: int,
}

// A link's preview, made by Telegram's servers: the site, the page's title and a line about it.
// Instant View: Telegram has the page in its reading mode (not in FinchGram yet). No url: none.
export struct LinkPreview {
    url: string,
    site: string,
    title: string,
    about: string,
    instant-view: bool,
}

// The message a reply answers, shown above the reply's words: who wrote it and its first line (its
// content and words, as Fmt.body says them). Gone: it was deleted. Its id is where a click on it
// goes; "" for a message in another chat.
export struct ReplyQuote {
    shown: bool,
    id: string,
    sender: string,
    content: Content,
    text: string,
    detail: string,
    gone: bool,
    picture: image,
    has-picture: bool,
}

// One line of the open chat: a message, a service message, the day it starts, or a sponsored
// message (channels show Telegram's own; they are never hidden).
export struct MessageRow {
    kind: RowKind,
    id: string,
    outgoing: bool,
    sender: string,
    sender-initial: string,
    sender-picture: image,  // the sender's photo, as ChatRow.picture
    has-sender-picture: bool,
    sender-color: int,      // 0 … 7, the same for the same sender (Terminal's names)
    content: Content,
    text: string,
    detail: string,
    time: string,           // "14:20"
    day: Moment,            // for a day row
    edited: bool,
    sending: bool,
    failed: bool,
    seen: bool,             // an outgoing message the other side has read
    button: string,         // a sponsored message's button
    media: [Media],         // its photos, videos and GIFs: one, or an album's
    files: [FileCard],      // its file (a document)
    sticker: Sticker,
    rich: bool,             // its words have formatting or links: rich-text shows them
    rich-text: styled-text,
    preview: LinkPreview,
    forwarded-from: string, // who first wrote it, when it was forwarded; "" otherwise
    reply: ReplyQuote,      // the message it replies to
    selected: bool,         // chosen, while choosing messages (Actions.selecting)
}


// How the open chat's header describes it.
export enum Status {
    none, online, last-seen, recently, last-week, last-month, long-ago,
    bot, members, subscribers, saved,
}

export global Conversation {
    in-out property <[Tab]> tabs;
    in-out property <string> chat-id;            // the open chat, "" for none
    in-out property <string> title;
    in-out property <string> initial;
    in-out property <ChatKind> kind;
    in-out property <Status> status;
    in-out property <Moment> last-seen;          // with Status.last-seen
    in-out property <int> members;               // with Status.members and Status.subscribers
    in-out property <int> online-members;
    in-out property <string> typing;             // who is typing now, "" when nobody
    in-out property <bool> can-write;
    // What the chat lets us send besides words (its permissions, and ours in it).
    in-out property <bool> can-send-photos;
    in-out property <bool> can-send-videos;
    in-out property <bool> can-send-files;
    in-out property <bool> muted;
    in-out property <bool> pinned;
    in-out property <[MessageRow]> messages;     // oldest first
    in-out property <bool> loading;              // the first messages are on their way
    in-out property <bool> has-older;
    // Rust counts this up when the view should show the newest message: the chat was opened, or we
    // sent one.
    in-out property <int> scroll-to-end;
    // A message the view should bring into sight (the media viewer's "locate"), "" for none.
    in-out property <string> reveal;
    // What is being written, whichever theme shows it: Rust puts a message's words here to edit it.
    in-out property <string> draft;
    callback open(string);                       // chat id; Workbench opens a tab for it
    callback close(string);                      // a tab
    callback close-others(string);               // every tab but this one, which comes to the front
    callback close-all();                        // every tab: no chat is open
    callback send(string);
    // The user changed what is being written: Rust tells the chat that we are typing, or that we
    // stopped (the words are gone).
    callback edited(string);
    callback load-older();
    // The view is back at the end of the chat: Rust lets the rows above go again.
    callback reached-end();
    callback retry(string);                      // a message that failed to send
    callback discard(string);                    // a message that failed to send: delete it
    callback cancel-upload(string);              // a message of ours still on its way: delete it
    // A click on a message's file card: download it, stop its download, or show it in the Finder.
    callback file-action(string);
    callback open-sponsored(string);             // a sponsored message's button
    callback load-picture(string);               // a message with a photo, video or GIF is in view
    // A link in a message or its preview: the browser, or FinchGram for a chat by its username
    // (t.me, @mentions) or its user.
    callback open-link(string);
    callback toggle-mute();
    callback toggle-pin();
    callback mark-read();
}

// The media viewer (the design's media-viewer.js): the open chat's photos and videos, one at a time,
// over the whole window. Rust fills it (src/telegram/viewer.rs); zoom is the page's own.
export struct ViewerItem {
    id: string,             // the message
    picture: image,
    width: int,
    height: int,
    video: bool,
    duration: int,          // seconds
    name: string,           // a video's or GIF's file name; photos have none
    sender: string,
    sender-initial: string,
    sender-picture: image,  // the sender's photo, as ChatRow.picture
    has-sender-picture: bool,
    time: Moment,
    caption: string,
    secret: bool,           // sent to self-destruct: shown on its own until closed (viewer.rs)
}

export global Viewer {
    in-out property <bool> open;
    in-out property <[ViewerItem]> items;        // the open chat's media, oldest first
    in-out property <int> index;                 // the one shown
    in-out property <int> zoom;                  // 0 … 3: fit, 150 %, 200 %, 300 %
    in-out property <bool> playing;
    in-out property <bool> loading;              // the video is downloading before it plays
    in-out property <bool> ended;                // played to its end
    in-out property <float> position;            // seconds into the video
    in-out property <int> speed;                 // 0 … 3: 1×, 1.5×, 2×, 0.5×
    in-out property <bool> muted;
    in-out property <image> frame;               // the video's picture while it plays
    in-out property <string> saved;              // a file just saved to Downloads, "" otherwise
    in-out property <bool> can-save;             // the item shown may be saved: TDLib's word (the chat may restrict it); false until it has said
    callback view(string, bool);                 // a message's media; true: a video starts playing
    callback close();
    callback show(int);                          // another item
    callback play-pause();
    callback seek(float);                        // 0 … 1 of the video
    callback next-speed();
    callback toggle-mute();
    callback download();                         // the one shown, to the Downloads folder
    callback locate();                           // close, and scroll the chat to its message
}

// Sending photos, videos and files (the design's sixth round, "FinchGram Desktop 发送附件"): the
// paperclip's menu, the card that shows what was chosen, dropped or pasted before it goes, and the
// files dragged over the window. Rust fills this global (src/telegram/attachments.rs).

// What a file goes as: a photo or a video, as Telegram's apps send pictures and videos (made
// smaller), or a file as it is.
export enum AttachKind { photo, video, file }

// Why a file in the card cannot be sent.
export enum AttachProblem { none, too-big, too-big-premium, unreadable, not-allowed }

// What the line under the card's buttons says.
export enum AttachHint { none, keys, remove-marked, caption-long }

// A file chosen, dropped or pasted, in the card before it is sent.
export struct Attachment {
    id: int,
    kind: AttachKind,       // what it goes as
    media: bool,            // its file is a picture or a video: it has a preview and may go as one
    name: string,
    size: string,           // "2.1 MB"
    picture: image,         // a picture's or a video's preview, once there
    has-picture: bool,
    width: int,
    height: int,
    duration: int,          // a video's seconds
    file-type: FileType,
    problem: AttachProblem, // why it cannot be sent, if it cannot
}

export global Attachments {
    in-out property <bool> menu-open;            // the paperclip's menu
    in-out property <length> menu-x;             // where the paperclip is (in the window): the menu opens above it
    in-out property <length> menu-y;
    in-out property <bool> menu-keyboard;        // the keyboard is used in it: its key hints show
    in-out property <int> menu-focus;            // the item the keyboard is on: 0 photos and videos, 1 files; -1 none
    in-out property <bool> card-open;
    in-out property <[Attachment]> items;
    in-out property <int> count;                 // how many items
    in-out property <int> videos;                // how many of them are videos
    in-out property <int> albums;                // how many albums they make when more than one; else 0
    in-out property <bool> all-media;            // every item is a picture or a video: the choices show
    in-out property <bool> as-file;              // they go as files, as they are
    in-out property <bool> grouped;              // several go together, as an album
    in-out property <bool> timer-allowed;        // a private chat: photos and videos can self-destruct
    in-out property <int> timer;                 // seconds; 0: off; -1: view once
    in-out property <bool> timer-open;           // its choices are shown
    in-out property <string> caption;
    in-out property <int> caption-max;           // Telegram's limit on it
    in-out property <bool> can-send;
    in-out property <AttachHint> hint;           // under the card's buttons
    in-out property <bool> send-menu-open;       // the arrow by Send: without sound, scheduled (not yet)
    in-out property <bool> busy;                 // sending: the card closes once TDLib has the messages
    // Files dragged over the window: whether dropping them would send them, and as what.
    in-out property <bool> dropping;
    in-out property <bool> drop-allowed;
    in-out property <bool> drop-photos;          // every file dragged is a picture or a video: they go as such
    callback choose(AttachKind);                 // the open panel: photos and videos, or files
    callback add-more();                         // the open panel again, for more of the same
    callback remove(int);
    callback set-as-file(bool);
    callback set-grouped(bool);
    callback set-timer(int);
    callback caption-edited(string);
    callback send(bool);                         // true: without sound
    callback cancel();
    // ⌘V in the composer: a picture or files on the clipboard open the card. False: there were none.
    callback paste() -> bool;
}

// What can be done with a message (the design's fourth round, "FinchGram Desktop 消息操作", and its
// message-actions.js). A right click on a message gives its menu; as in Telegram's own apps, what
// cannot be done with it is left out, as TDLib says. Rust fills this global (src/telegram/actions.rs)
// and each theme draws it in its own way.
export enum MessageAction { reply, edit, copy-image, save-image, save-video, copy, copy-text, copy-link, forward, report, delete, select }

// The strip above where a message is written: replying to a message, editing one of ours, or
// forwarding messages to this chat.
export enum ComposeBar { none, reply, edit, forward }

// What was just done, said for a moment; or what could not be done: a folder that would be left
// empty, or anything else Telegram refused (failed: in Telegram's words, Actions.failure).
export enum ActionNotice { none, copied, link-copied, image-copied, saved, reported, folder-empty, failed }

// Deleting: whether the messages can go for the others too (a box to tick), and who they are.
export enum DeleteChoice { none, for-them, for-everyone }

export global Actions {
    // Counted up by Rust at each right click in the window. A message's formatted words keep clicks
    // to themselves, so the row under the pointer learns of it this way and asks for its menu.
    in-out property <int> right-clicks;

    // A message's menu, where it was clicked (in the window).
    in-out property <bool> menu-open;
    in-out property <string> menu-row;              // the row it is for, marked while it is open
    in-out property <[MessageAction]> menu-items;
    in-out property <string> menu-head;             // Terminal's heading: "Jie · 14:20"
    in-out property <length> menu-x;
    in-out property <length> menu-y;
    callback ask-menu(string, string);              // a row; the message of the photo or video clicked, or ""
    callback choose(MessageAction);
    callback close-menu();
    // The message of the photo or video under the pointer, "" for none: a right click on it gives the
    // photo's or video's own items too.
    in-out property <string> hovered-media;

    // The strip above the composer.
    in-out property <ComposeBar> bar;
    in-out property <string> bar-name;              // reply: who wrote the message; forward: who wrote them
    in-out property <int> bar-count;                // forward: how many messages
    in-out property <Content> bar-content;          // the message's first line, as Fmt.body says it
    in-out property <string> bar-text;
    in-out property <string> bar-detail;
    in-out property <image> bar-picture;
    in-out property <bool> bar-has-picture;
    in-out property <bool> hide-sender;             // forward without saying who first wrote them
    callback cancel-bar();
    callback edit-last();                           // ↑ in an empty composer: edit our last message
    // Rust counts this up when the composer should take the keyboard: a reply or an edit begins.
    in-out property <int> focus-requests;

    // Choosing messages. Rust marks the rows chosen (MessageRow.selected).
    in-out property <bool> selecting;
    in-out property <int> selected-count;
    in-out property <bool> can-forward;             // every message chosen can be forwarded, …
    in-out property <bool> can-copy;
    in-out property <bool> can-delete;
    in-out property <bool> can-report;
    in-out property <bool> report-offered;          // groups and channels can be reported
    callback toggle(string, bool);                  // a row; true: shift-click, everything up to it
    callback forward-selected();
    callback copy-selected();
    callback delete-selected();
    callback report-selected();
    callback cancel-selection();

    // Forwarding: where to.
    in-out property <bool> picker-open;
    in-out property <bool> picker-saved;            // Saved Messages matches the search
    in-out property <[ChatRow]> picker-chats;       // the chats we can write in that match it
    callback search-picker(string);
    callback pick(string);                          // a chat's id, or "saved"
    callback pick-first();                          // ⏎: the first one shown
    callback close-picker();

    // Reporting, step by step, as Telegram's servers lead it.
    in-out property <bool> report-open;
    in-out property <bool> report-first;            // the first step: there is no step back
    in-out property <string> report-title;
    in-out property <[string]> report-options;      // the reasons to choose from
    in-out property <bool> report-comment;          // the last step: words to add
    in-out property <bool> report-comment-required;
    in-out property <bool> report-busy;
    callback report-choose(int);
    callback report-back();
    callback report-submit(string);
    callback close-report();

    // Deleting.
    in-out property <bool> delete-open;
    in-out property <int> delete-count;
    in-out property <DeleteChoice> delete-choice;
    in-out property <string> delete-name;           // for-them: the other person
    in-out property <bool> revoke;                  // the box ticked: for them too
    callback confirm-delete();
    callback close-delete();

    in-out property <ActionNotice> notice;
    in-out property <string> failure;               // what Telegram said, for the failed notice
    // A row lit up for a moment: the message a reply answers, jumped to.
    in-out property <string> flash;
    callback jump(string);                          // to a message: a reply's original

    // Esc: close the topmost of the menu, a dialog, the strip and choosing. False: none was open.
    callback escape() -> bool;
}

// The account logged in.
export global Account {
    in-out property <string> name;
    in-out property <string> first-name;
    in-out property <string> last-name;
    in-out property <string> username;
    in-out property <string> phone;              // "+86 138 0013 2046"
    in-out property <string> bio;
    in-out property <string> initial;
    in-out property <image> picture;             // the account's photo, as ChatRow.picture
    in-out property <image> large-picture;       // the same in its big size, for the profile page
    in-out property <bool> has-picture;
    in-out property <bool> saving;
    in-out property <bool> saved;
    in-out property <string> save-error;
    callback save(string, string, string, string);   // first name, last name, username, bio
    callback log-out();
}

// Settings → Notifications & sounds → By chat type: whether the chats of each kind notify, those
// that do not say otherwise (a chat's own mute is in its menu). Telegram keeps this for the
// account, the same in all its apps.
export enum NotificationScope { private-chats, groups, channels }

export global NotificationScopes {
    in-out property <bool> loaded;               // TDLib has said, for all three
    in-out property <bool> private-chats: true;  // they notify
    in-out property <bool> groups: true;
    in-out property <bool> channels: true;
    callback toggle(NotificationScope);
}

// Logging in (the design's second round, "登录引导"). Rust follows TDLib's authorization state; the
// pages can go back a step on their own.
// The steps of logging in. After the password come the ways to recover a forgotten one: a code sent
// to the recovery email address, then a new password; or, without that address, resetting the
// account.
export enum LoginStep {
    phone, qr, code, password,
    recovery-code, new-password, reset-account, account-reset-requested,
    email-address, email-code, registration, premium,
}
export enum CodeDelivery { telegram, sms, call, flash-call, missed-call, fragment, email, other }

export struct Country {
    code: string,           // "CN"
    name: string,           // in its own language
    calling-code: string,   // "86"
}

export global Login {
    in-out property <LoginStep> step: LoginStep.phone;
    in-out property <bool> busy;                 // a request is on its way
    in-out property <string> error;              // TDLib's answer to the last request, "" when fine
    in-out property <Country> country;           // chosen, or guessed from where we are
    in-out property <[Country]> countries;       // the picker's list, matching its search words
    in-out property <string> phone;              // as typed
    in-out property <string> code-phone;         // where the code went, as TDLib writes it
    in-out property <CodeDelivery> delivery;
    in-out property <int> code-length: 5;
    in-out property <bool> can-resend;
    in-out property <bool> resent;
    in-out property <string> password-hint;
    in-out property <bool> has-recovery-email;   // a forgotten password can be recovered by email
    in-out property <string> recovery-email;     // where the recovery code went, partly hidden
    in-out property <Moment> reset-date;         // when a requested account reset can be completed
    in-out property <string> email-pattern;      // the address the code went to, partly hidden
    in-out property <image> qr-code;
    callback search-countries(string);
    callback choose-country(Country);
    callback submit-phone(string, string);       // calling code, number
    callback use-qr-code();
    callback use-phone-number();
    callback submit-code(string);
    callback resend-code();
    callback submit-password(string);
    callback forgot-password();
    callback submit-recovery-code(string);
    callback submit-new-password(string, string, string);   // the password, again, its hint
    callback reset-account();
    callback submit-email(string);
    callback submit-email-code(string);
    callback sign-up(string, string);            // first name, last name
    pure callback initial(string) -> string;     // "zhou" → "Z", for the new account's picture
    callback back();                             // to the phone number
}

// Settings → Privacy & security → Two-step verification (src/telegram/password.rs). What changes
// the password asks for it first (verify); a forgotten one is recovered by email or reset.
export enum PasswordStep {
    overview, verify, new-password, hint, recovery-email, recovery-email-code, turn-off, recovery-code, reset,
}

// What the overview says was just done.
export enum PasswordChange { nothing, password, hint, recovery-email }

export global PasswordSettings {
    in-out property <bool> open;                 // shown instead of Privacy & security
    in-out property <bool> loaded;               // TDLib has said how the password is
    in-out property <bool> has-password;
    in-out property <string> hint;
    in-out property <bool> has-recovery-email;
    in-out property <string> recovery-email;     // once known: TDLib gives it only for the password
    in-out property <string> code-sent-to;       // where the last recovery or confirmation code went
    in-out property <bool> reset-pending;        // a reset without the password was asked for
    in-out property <Moment> reset-date;         // when it can be completed
    in-out property <PasswordStep> step;
    in-out property <bool> busy;
    in-out property <string> error;
    in-out property <PasswordChange> done;
    callback load();
    callback choose(PasswordStep);               // from the overview: what to change
    callback verify(string);
    callback forgot();
    callback submit-recovery-code(string);
    callback request-reset();
    callback cancel-reset();
    callback submit-new-password(string, string, string);   // the password, again, its hint
    callback submit-hint(string);
    callback submit-recovery-email(string);
    callback submit-recovery-email-code(string);
    callback turn-off();
    callback cancel();                           // back to the overview
}

// Words Rust needs in the UI language when it builds rows: names Telegram does not give. Rust reads
// them, and builds the rows again when the language changes.
export global Words {
    out property <string> saved-messages: @tr("Saved Messages");
    out property <string> deleted-account: @tr("Deleted Account");
    out property <string> all-chats: @tr("All chats");
    // Between names in a list: "Jie, Mika".
    out property <string> list-separator: @tr("list separator" => ", ");
}
