// Broadsheet (the design's "1a 报纸"): a newspaper's calm. A rail with the accounts, the chat list
// with its folders as tabs, and the conversation in bubbles. The accent is the account's colour.
import { ListView } from "std-widgets.slint";
import { Drawer } from "../drawer.slint";
import { BroadsheetDrawer } from "drawer.slint";
import { InfoPanel } from "chat-info.slint";
import { ChatInfo } from "../chat-info.slint";
import { AppState, Page, Connection, Theme, Screenshot } from "../state.slint";
import {
    Chats, Conversation, Account, ChatRow, MessageRow, RowKind, ChatKind, Content, Status, Viewer, LinkPreview, ReplyQuote,
    Actions, ComposeBar, ActionNotice, Attachments, ChatOrder } from "../telegram.slint";
import { Look, AccountColors } from "../look.slint";
import { Downloads } from "../downloads.slint";
import { Fmt } from "../format.slint";
import { Icon, Logo, Paragraph, ListEdge, WindowButtonsSpace, WindowMover, Avatar } from "../widgets.slint";
import {
    ChatScroll, MessageInput, Capped, MediaTiles, StickerPicture, RichText, MessageArea, ActionWords, KeyScope, AttachWords, FileCardView, ChatMenuWords,
    SearchInput, SearchWords, ButtonGrid, BotWords,
} from "../chat.slint";
import { ExtraWords, ReactionChips, ReactionPicker, RoundNoteView, ContactCardView, TopicList, AdminPanelView } from "../extras.slint";
import { BroadsheetPalette as P } from "palette.slint";
import { BroadsheetActions } from "actions.slint";
import { BroadsheetAttachments } from "attachments.slint";
import { BroadsheetCompose } from "compose.slint";
import { Search, NewChat, NewDialog, ComposeWords } from "../compose.slint";

export enum BroadsheetView { chats, channels, bots, filters, scheduled }

component DuoIcon inherits Icon {
    duotone: true;
}

component TitleBar inherits Rectangle {
    height: 40px;
    background: P.rail;

    WindowMover { }

    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: P.accent;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        WindowButtonsSpace { }
        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 9px;
                    height: 9px;
                    border-radius: 2px;
                    background: P.accent;
                }
            }
            Text {
                text: Account.name;
                color: P.text;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                text: AccountColors.key(0);
                color: P.accent-ink;
                font-family: P.mono;
                font-size: 12px;
                vertical-alignment: center;
            }
            Text {
                text: "— FinchGram";
                color: P.faint;
                font-size: 14px;
                vertical-alignment: center;
            }
        }
        // What was just done (copied, saved, reported), said in the title bar.
        if Actions.notice != ActionNotice.none: Text {
            text: ActionWords.notice(Actions.notice);
            color: P.accent-ink;
            font-size: 14px;
            font-italic: true;
            vertical-alignment: center;
        }
        Rectangle {
            HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    DuoIcon {
                        name: P.dark ? "sun" : "moon";
                        size: 16px;
                        color: P.muted;
                    }
                }
                Text {
                    text: P.dark ? @tr("Light") : @tr("Dark");
                    color: P.muted;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    AppState.change-appearance(P.dark ? "light" : "dark");
                }
            }
        }
    }
}

// The accounts, each in its colour with its key; settings at the foot.
component Rail inherits Rectangle {
    width: 80px;
    background: P.rail;

    VerticalLayout {
        padding-top: 12px;
        padding-bottom: 14px;
        spacing: 14px;
        alignment: start;
        // The logo opens the drawer (drawer.slint): ringed while it is open, with a dot while an
        // unpinned tool has something going on.
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                Rectangle {
                    x: -2px;
                    y: -2px;
                    width: 44px;
                    height: 44px;
                    border-radius: 12px;
                    border-width: 2px;
                    border-color: Drawer.open ? P.accent : transparent;
                }
                Logo {
                    size: 40px;
                    radius: 10px;
                }
                if Drawer.logo-dot: Rectangle {
                    x: parent.width - 7px;
                    y: -3px;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: P.accent2;
                    border-width: 2px;
                    border-color: P.rail;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Drawer.toggle();
                    }
                }
            }
        }
        Text {
            text: @tr("Accounts") + " 1/10";
            color: P.faint;
            font-size: 11px;
            horizontal-alignment: center;
        }
        VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                alignment: center;
                // The account in front: its colour, ringed.
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 7px;
                    border-width: 2px;
                    border-color: P.accent;
                    Avatar {
                        size: 32px;
                        radius: 4px;
                        fill: P.accent;
                        ink: P.on-accent;
                        initial: Account.initial;
                        picture: Account.picture;
                        has-picture: Account.has-picture;
                        font-size: 14px;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            AppState.page = Page.profile;
                        }
                    }
                }
            }
            Text {
                text: AccountColors.key(0);
                color: P.accent-ink;
                font-family: P.mono;
                font-size: 10px;
                font-weight: 600;
                horizontal-alignment: center;
            }
        }
    }

    VerticalLayout {
        padding-bottom: 16px;
        spacing: 16px;
        alignment: end;
        // The tools pinned in the drawer's toolbox (drawer.slint), in its order; downloads carry a
        // dot while some are on their way.
        for tool in Drawer.pinned: HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 22px;
                height: 22px;
                DuoIcon {
                    name: tool.icon;
                    size: 22px;
                    color: P.muted;
                }
                if tool.id == "downloads" && Downloads.active-count > 0: Rectangle {
                    x: parent.width / 2 + 6px;
                    y: -2px;
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: P.accent;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Drawer.open-tool(tool.id);
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            DuoIcon {
                name: "gear-six";
                size: 22px;
                color: P.muted;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        AppState.page = Page.settings;
                    }
                }
            }
        }
    }
}

component ViewButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active;
    in property <bool> enabled: true;
    callback activated();
    height: 44px;
    border-radius: 4px;
    background: active ? P.tint : touch.has-hover && enabled ? P.hover : transparent;
    opacity: enabled ? 1 : 0.4;

    VerticalLayout {
        alignment: center;
        spacing: 2px;
        HorizontalLayout {
            alignment: center;
            DuoIcon {
                name: root.icon;
                size: 18px;
                color: root.active ? P.tint-ink : P.muted;
            }
        }
        Text {
            text: root.label;
            color: root.active ? P.tint-ink : P.muted;
            font-size: 11px;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

component Views {
    in-out property <BroadsheetView> view;

    HorizontalLayout {
        spacing: 4px;
        ViewButton {
            icon: "chats";
            label: @tr("Chats");
            active: root.view == BroadsheetView.chats;
            activated => {
                root.view = BroadsheetView.chats;
            }
        }
        ViewButton {
            icon: "megaphone";
            label: @tr("Channels");
            active: root.view == BroadsheetView.channels;
            activated => {
                root.view = BroadsheetView.channels;
            }
        }
        ViewButton {
            icon: "robot";
            label: @tr("Bots");
            active: root.view == BroadsheetView.bots;
            activated => {
                root.view = BroadsheetView.bots;
            }
        }
    }
}

// The search box above the folders: a click, or ⌘K, opens the search over everything (compose.slint).
component SearchField inherits Rectangle {
    height: 34px;
    border-radius: 4px;
    background: P.surface;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            DuoIcon {
                name: "magnifying-glass";
                size: 14px;
                color: P.faint;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: @tr("Search");
            color: P.faint;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: "⌘K";
            color: P.faint;
            font-family: P.mono;
            font-size: 11px;
            vertical-alignment: center;
        }
    }

    TouchArea {
        mouse-cursor: text;
        clicked => {
            Search.show();
        }
    }

    property <int> search-requests: AppState.search-requests;
    changed search-requests => {
        Search.show();
    }
}

component MenuEntry inherits Rectangle {
    in property <string> icon;                // "": no icon, its place kept (a choice not ticked)
    in property <string> label;
    in property <string> keys;
    in property <length> indent;              // one of a group's choices, under the group's name
    callback activated();
    height: 34px;
    border-radius: 2px;
    background: touch.has-hover ? P.hover : transparent;

    HorizontalLayout {
        padding-left: 10px + root.indent;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 17px;
                height: 17px;
                if root.icon != "": DuoIcon {
                    name: root.icon;
                    size: 17px;
                    color: P.accent;
                }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: P.text;
            font-size: 14px;
            vertical-alignment: center;
        }
        Text {
            text: root.keys;
            color: P.faint;
            font-family: P.mono;
            font-size: 11px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

component FolderTab {
    in property <int> index;
    callback menu(length, length);          // a right click, where it is in the window
    property <bool> active: index == Chats.folder;

    VerticalLayout {
        spacing: 2px;
        HorizontalLayout {
            spacing: 4px;
            Text {
                text: root.index < Chats.folders.length ? (Chats.folders[root.index].id == 0 ? @tr("All") : Chats.folders[root.index].name) : "";
                color: root.active ? P.text : P.muted;
                font-size: 14px;
                font-weight: root.active ? 600 : 400;
            }
            if root.index < Chats.folders.length && Chats.folders[root.index].unread > 0: Text {
                text: Chats.folders[root.index].unread > 99 ? "99+" : "" + Chats.folders[root.index].unread;
                color: P.accent-ink;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: bottom;
            }
        }
        Rectangle {
            height: 2px;
            background: root.active ? P.accent : transparent;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Chats.show-folder(root.index);
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

// The folders as tabs: the first four, the rest behind "More". A right click on a tab gives the
// folder's menu: every chat of it read, and the group Sort by: how every folder's chats are
// ordered.
component Folders {
    // "More" names the folder shown when it is one of those behind it.
    property <bool> more-chosen: Chats.folder >= 4;
    property <int> menu-index;              // the folder the menu is for: index into Chats.folders
    property <length> menu-x;

    function show-menu(folder: int, left: length) {
        root.menu-index = folder;
        root.menu-x = max(0px, left - root.absolute-position.x);
        folder-menu.show();
    }

    pure function name(index: int) -> string {
        if index < 0 || index >= Chats.folders.length { return ""; }
        return Chats.folders[index].id == 0 ? @tr("All chats") : Chats.folders[index].name;
    }

    HorizontalLayout {
        for folder[index] in Chats.folders: Rectangle {
            visible: index < 4;
            width: index < 4 ? tab.preferred-width + 14px : 0px;
            height: tab.preferred-height;
            tab := FolderTab {
                x: 0;
                y: 0;
                width: self.preferred-width;
                index: index;
                menu(left, top) => {
                    root.show-menu(index, left);
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        if Chats.folders.length > 4: Rectangle {
            HorizontalLayout {
                spacing: 4px;
                Text {
                    text: root.more-chosen ? Chats.folders[Chats.folder].name : @tr("More");
                    color: root.more-chosen ? P.text : P.muted;
                    font-size: 14px;
                    font-weight: root.more-chosen ? 600 : 400;
                }
                VerticalLayout {
                    alignment: center;
                    DuoIcon {
                        name: "caret-down";
                        size: 12px;
                        color: P.muted;
                    }
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    list.show();
                }
                // "More" stands for the folder shown: a right click on it is one on that folder.
                pointer-event(event) => {
                    if root.more-chosen && event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                        root.show-menu(Chats.folder, self.absolute-position.x + self.mouse-x);
                    }
                }
            }
            list := PopupWindow {
                x: 0;
                y: 26px;
                width: 180px;
                close-policy: PopupClosePolicy.close-on-click-outside;
                Rectangle {
                    border-radius: 4px;
                    background: P.panel;
                    drop-shadow-blur: 32px;
                    drop-shadow-offset-y: 12px;
                    drop-shadow-color: P.shadow;
                    VerticalLayout {
                        padding: 6px;
                        for folder[index] in Chats.folders: Rectangle {
                            property <bool> chosen: index == Chats.folder;
                            visible: index >= 4;
                            height: index >= 4 ? 34px : 0px;
                            border-radius: 2px;
                            background: self.chosen ? P.sel : entry.has-hover ? P.hover : transparent;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: folder.name;
                                    color: P.text;
                                    font-size: 14px;
                                    font-weight: index == Chats.folder ? 600 : 400;
                                    vertical-alignment: center;
                                }
                                if folder.unread > 0: Text {
                                    text: folder.unread;
                                    color: P.accent-ink;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                            entry := TouchArea {
                                clicked => {
                                    Chats.show-folder(index);
                                    list.close();
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    folder-menu := PopupWindow {
        x: root.menu-x;
        y: 26px;
        width: 210px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            border-radius: 4px;
            background: P.panel;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: P.shadow;
            VerticalLayout {
                padding: 6px;
                Text {
                    height: 26px;
                    x: 10px;
                    text: root.name(root.menu-index);
                    color: P.faint;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                MenuEntry {
                    icon: "checks";
                    label: @tr("Mark all as read");
                    activated => {
                        Chats.mark-all-read(root.menu-index);
                        folder-menu.close();
                    }
                }
                // How every folder's chats are ordered: a group of choices, the one in force ticked.
                Rectangle {
                    height: 9px;
                    Rectangle {
                        height: 1px;
                        background: P.line;
                    }
                }
                Text {
                    height: 26px;
                    x: 10px;
                    text: @tr("Sort by");
                    color: P.faint;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                MenuEntry {
                    indent: 12px;
                    icon: Chats.order == ChatOrder.latest-message ? "check" : "";
                    label: @tr("Latest message");
                    activated => {
                        Chats.change-order(ChatOrder.latest-message);
                        folder-menu.close();
                    }
                }
                MenuEntry {
                    indent: 12px;
                    icon: Chats.order == ChatOrder.name ? "check" : "";
                    label: @tr("Name");
                    activated => {
                        Chats.change-order(ChatOrder.name);
                        folder-menu.close();
                    }
                }
                MenuEntry {
                    indent: 12px;
                    icon: Chats.order == ChatOrder.unread ? "check" : "";
                    label: @tr("Unread");
                    activated => {
                        Chats.change-order(ChatOrder.unread);
                        folder-menu.close();
                    }
                }
            }
        }
    }
}

// Letter squares by kind of chat (the design's avA).
global Avatars {
    public pure function fill(kind: ChatKind) -> color {
        if kind == ChatKind.group || kind == ChatKind.bot || kind == ChatKind.saved {
            return P.tint;
        }
        if kind == ChatKind.channel {
            return P.channel;
        }
        return P.surface;
    }

    public pure function ink(kind: ChatKind) -> color {
        if kind == ChatKind.group || kind == ChatKind.bot {
            return P.tint-ink;
        }
        if kind == ChatKind.saved {
            return P.accent-ink;
        }
        if kind == ChatKind.channel {
            return P.channel-ink;
        }
        return P.text;
    }
}

component Badge inherits Rectangle {
    in property <int> count;
    in property <bool> muted;
    height: 20px;
    width: max(20px, label.preferred-width + 10px);
    border-radius: 2px;
    background: muted ? P.off : P.accent;

    label := Text {
        text: root.count > 999 ? "999+" : "" + root.count;
        color: P.on-accent;
        font-size: 12px;
        font-weight: 600;
    }
}

// Someone mentioned us in the chat.
component MentionMark inherits Rectangle {
    width: 20px;
    height: 20px;
    border-radius: 2px;
    background: P.accent;
    Text {
        text: "@";
        color: P.on-accent;
        font-size: 12px;
        font-weight: 600;
    }
}

// The chat was marked unread by hand: it has no unread messages to count.
component UnreadMark inherits Rectangle {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background: P.accent;
}

component ChatLine inherits Rectangle {
    in property <ChatRow> chat;
    callback menu(length, length);          // a right click, where it is in the window
    property <bool> open: chat.id == Conversation.chat-id;
    height: 66px;
    background: open ? P.sel : touch.has-hover ? P.hover : transparent;

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 11px;
        padding-bottom: 11px;
        spacing: 12px;
        Avatar {
            size: 44px;
            radius: 4px;
            fill: Avatars.fill(root.chat.kind);
            ink: Avatars.ink(root.chat.kind);
            initial: root.chat.initial;
            picture: root.chat.picture;
            has-picture: root.chat.has-picture;
            font-size: 18px;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            alignment: center;
            HorizontalLayout {
                spacing: 6px;
                if root.chat.pinned: VerticalLayout {
                    alignment: center;
                    DuoIcon {
                        name: "push-pin";
                        size: 14px;
                        color: P.accent;
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.chat.title;
                    color: P.text;
                    font-size: 15px;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: root.chat.has-message ? Fmt.list-time(root.chat.time) : "";
                    color: P.faint;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                spacing: 6px;
                // The last message, or the words left in the composer (src/telegram/drafts.rs).
                if root.chat.draft != "": Text {
                    text: ExtraWords.draft();
                    color: P.accent-ink;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.chat.draft != "" ? root.chat.draft : Fmt.preview(root.chat);
                    color: P.muted;
                    font-size: 14px;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if root.chat.mention: VerticalLayout {
                    alignment: center;
                    MentionMark { }
                }
                if root.chat.unread > 0: VerticalLayout {
                    alignment: center;
                    Badge {
                        count: root.chat.unread;
                        muted: root.chat.muted;
                    }
                }
                if root.chat.marked && root.chat.unread == 0: VerticalLayout {
                    alignment: center;
                    UnreadMark { }
                }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Conversation.open(root.chat.id);
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

component ChannelLine inherits Rectangle {
    in property <ChatRow> chat;
    callback menu(length, length);          // a right click, where it is in the window
    height: 76px;
    background: touch.has-hover ? P.hover : transparent;

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 11px;
        padding-bottom: 11px;
        spacing: 12px;
        Avatar {
            size: 44px;
            radius: 4px;
            fill: P.surface;
            ink: P.text;
            initial: root.chat.initial;
            picture: root.chat.picture;
            has-picture: root.chat.has-picture;
            font-size: 18px;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    horizontal-stretch: 1;
                    text: root.chat.title;
                    color: P.text;
                    font-size: 15px;
                    font-weight: 600;
                    overflow: elide;
                }
                if root.chat.unread > 0: Badge {
                    count: root.chat.unread;
                    muted: true;
                }
            }
            // The last message, or the words left in the composer (src/telegram/drafts.rs).
            HorizontalLayout {
                spacing: 6px;
                if root.chat.draft != "": Text {
                    text: ExtraWords.draft();
                    color: P.accent-ink;
                    font-size: 14px;
                    font-weight: 600;
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.chat.draft != "" ? root.chat.draft : Fmt.body(root.chat.content, root.chat.text, root.chat.detail);
                    color: P.muted;
                    font-size: 14px;
                    overflow: elide;
                }
            }
            Text {
                text: root.chat.members > 0 ? @tr("{n} subscriber" | "{n} subscribers" % root.chat.members) : "";
                color: P.faint;
                font-size: 12px;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Conversation.open(root.chat.id);
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

component BotLine inherits Rectangle {
    in property <ChatRow> chat;
    callback menu(length, length);          // a right click, where it is in the window
    height: 58px;
    background: touch.has-hover ? P.sel : transparent;

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Avatar {
                size: 40px;
                radius: 4px;
                fill: root.chat.verified ? P.tint : P.surface;
                ink: root.chat.verified ? P.tint-ink : P.text;
                initial: root.chat.initial;
                picture: root.chat.picture;
                has-picture: root.chat.has-picture;
                font-size: 16px;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                Text {
                    text: root.chat.title;
                    color: P.text;
                    font-size: 15px;
                    font-weight: 600;
                    overflow: elide;
                }
                if root.chat.verified: VerticalLayout {
                    alignment: center;
                    Icon {
                        name: "seal-check";
                        size: 14px;
                        color: P.accent;
                        duotone: false;
                    }
                }
            }
            Text {
                text: root.chat.username == "" ? Fmt.preview(root.chat) : "@" + root.chat.username + " · " + Fmt.preview(root.chat);
                color: P.muted;
                font-size: 13px;
                overflow: elide;
            }
        }
        if root.chat.unread > 0: VerticalLayout {
            alignment: center;
            Badge {
                count: root.chat.unread;
                muted: root.chat.muted;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Conversation.open(root.chat.id);
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

component SectionTitle inherits Text {
    color: P.faint;
    font-size: 12px;
    letter-spacing: 0.24px;
}

component ListColumn inherits Rectangle {
    in-out property <BroadsheetView> view;
    // What the window leaves it beside the messages and the info panel: while the panel is open
    // it yields down to 220px, without changing the width the user dragged out.
    in property <length> room: 560px;
    width: max(220px, min(560px, min(AppState.broadsheet-list-width, max(220px, root.room))));
    background: P.bg;

    // A chat's menu, from a right click on it: the chat header's menu, for any chat in the lists.
    // Its second page, Add to folder: the account's folders, those the chat is in ticked.
    property <ChatRow> menu-chat;
    property <int> menu-folder;             // where Chats.toggle-pin pins it
    property <bool> menu-folders;           // the second page is showing
    property <length> menu-x;
    property <length> menu-y;

    function show-menu(chat: ChatRow, folder: int, left: length, top: length) {
        root.menu-chat = chat;
        root.menu-folder = folder;
        root.menu-folders = false;
        Chats.open-menu(chat.id);
        root.menu-x = max(0px, left - root.absolute-position.x);
        // Within the list, whichever of the two pages is the taller.
        root.menu-y = max(0px, min(top - root.absolute-position.y, root.height - 44px - 34px * max((Chats.folders.length > 1 ? 4 : 3) + 4, Chats.menu-folders.length + 1)));
        chat-menu.show();
    }

    VerticalLayout {
        VerticalLayout {
            vertical-stretch: 0;
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 20px;
            padding-bottom: 10px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: root.view == BroadsheetView.channels ? @tr("Channels")
                        : root.view == BroadsheetView.bots ? @tr("Bots") : Account.name;
                    color: P.text;
                    font-size: 28px;
                    font-weight: 600;
                    line-height-factor: P.leading(1.2);
                    overflow: elide;
                }
                VerticalLayout {
                    alignment: center;
                    // The pencil: a new group, channel or chat, or a new contact (compose.slint).
                    if root.view == BroadsheetView.chats: Rectangle {
                        width: 20px;
                        height: 20px;
                        DuoIcon {
                            name: "note-pencil";
                            size: 20px;
                            color: P.accent;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                new-menu.show();
                            }
                        }
                        new-menu := PopupWindow {
                            x: parent.width + 4px - 200px;
                            y: 30px;
                            width: 200px;
                            close-policy: PopupClosePolicy.close-on-click-outside;
                            Rectangle {
                                border-radius: 4px;
                                background: P.panel;
                                drop-shadow-blur: 32px;
                                drop-shadow-offset-y: 12px;
                                drop-shadow-color: P.shadow;
                                VerticalLayout {
                                    padding: 6px;
                                    MenuEntry {
                                        icon: "users-three";
                                        label: ComposeWords.new-group();
                                        activated => {
                                            new-menu.close();
                                            NewChat.start(NewDialog.group);
                                        }
                                    }
                                    MenuEntry {
                                        icon: "megaphone";
                                        label: ComposeWords.new-channel();
                                        activated => {
                                            new-menu.close();
                                            NewChat.start(NewDialog.channel);
                                        }
                                    }
                                    MenuEntry {
                                        icon: "chat-circle";
                                        label: ComposeWords.new-chat();
                                        activated => {
                                            new-menu.close();
                                            NewChat.start(NewDialog.direct);
                                        }
                                    }
                                    MenuEntry {
                                        icon: "user-plus";
                                        label: ComposeWords.add-contact();
                                        activated => {
                                            new-menu.close();
                                            NewChat.start(NewDialog.contact);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.view != BroadsheetView.chats: DuoIcon {
                        name: "x";
                        size: 18px;
                        color: P.muted;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.view = BroadsheetView.chats;
                            }
                        }
                    }
                }
            }
            Text {
                text: root.view == BroadsheetView.bots ? @tr("Telegram bots") : Account.phone;
                color: P.accent-ink;
                font-size: 13px;
            }
            // The design's margins: 8px above the views and the search box, 12px above the tabs.
            VerticalLayout {
                padding-top: 8px;
                Views {
                    view <=> root.view;
                }
            }
            VerticalLayout {
                padding-top: root.view == BroadsheetView.chats ? 8px : 0px;
                SearchField {
                    visible: root.view == BroadsheetView.chats;
                    height: root.view == BroadsheetView.chats ? 34px : 0px;
                }
            }
            if root.view == BroadsheetView.chats: VerticalLayout {
                padding-top: 12px;
                Folders { }
            }
        }

        if AppState.connection != Connection.ready && AppState.connection != Connection.updating: HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 8px;
            Rectangle {
                height: 36px;
                border-radius: 4px;
                background: P.surface;
                HorizontalLayout {
                    padding-left: 12px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        DuoIcon {
                            name: AppState.connection == Connection.waiting-for-network ? "wifi-slash" : "circle-notch";
                            size: 16px;
                            color: P.accent2-ink;
                        }
                    }
                    Text {
                        text: Fmt.connection(AppState.connection);
                        color: P.accent2-ink;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Saved Messages: a fixed row above the list, found without scrolling.
        if root.view == BroadsheetView.chats && Chats.saved-messages-shown: ChatLine {
            chat: Chats.saved-messages;
            menu(left, top) => {
                root.show-menu(Chats.saved-messages, 0, left, top);
            }
        }

        if root.view == BroadsheetView.chats && Chats.loaded && Chats.list.length == 0: VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 28px;
            spacing: 8px;
            Text {
                text: Chats.folder == 0 ? @tr("No chats yet") : @tr("No chats in this folder");
                color: P.text;
                font-size: 18px;
                font-weight: 600;
            }
            Paragraph {
                text: Chats.folder == 0 ? @tr("Search for a username or phone number, or open an invite link someone sent you, to start chatting.")
                    : @tr("Chats you add to this folder in Telegram show up here.");
                color: P.muted;
                font-size: 14px;
                line-height-factor: P.leading(1.55);
            }
        }

        if root.view == BroadsheetView.chats: ListView {
            vertical-stretch: 1;
            vertical-scrollbar-policy: always-off;
            horizontal-scrollbar-policy: always-off;
            for chat in Chats.list: ChatLine {
                chat: chat;
                menu(left, top) => {
                    root.show-menu(chat, Chats.folder, left, top);
                }
            }
        }
        if root.view == BroadsheetView.channels: ListView {
            vertical-stretch: 1;
            vertical-scrollbar-policy: always-off;
            horizontal-scrollbar-policy: always-off;
            for chat in Chats.channels: ChannelLine {
                chat: chat;
                menu(left, top) => {
                    root.show-menu(chat, 0, left, top);
                }
            }
        }
        if root.view == BroadsheetView.bots: Flickable {
            vertical-stretch: 1;
            mouse-drag-pan-enabled: false;
            VerticalLayout {
                alignment: start;
                if Chats.official-bots.length > 0: HorizontalLayout {
                    padding-left: 20px;
                    padding-top: 12px;
                    padding-bottom: 4px;
                    SectionTitle {
                        text: @tr("Official bots");
                    }
                }
                for chat in Chats.official-bots: BotLine {
                    chat: chat;
                    menu(left, top) => {
                        root.show-menu(chat, 0, left, top);
                    }
                }
                if Chats.bots.length > 0: HorizontalLayout {
                    padding-left: 20px;
                    padding-top: 12px;
                    padding-bottom: 4px;
                    SectionTitle {
                        text: @tr("Other bots");
                    }
                }
                for chat in Chats.bots: BotLine {
                    chat: chat;
                    menu(left, top) => {
                        root.show-menu(chat, 0, left, top);
                    }
                }
                HorizontalLayout {
                    padding: 20px;
                    Paragraph {
                        text: @tr("Bots with a check mark are Telegram's own. Other bots see what you send them.");
                        color: P.faint;
                        font-size: 12px;
                    }
                }
            }
        }
    }

    ListEdge {
        x: parent.width - self.width;
        height: parent.height;
        list-width <=> AppState.broadsheet-list-width;
        narrowest: 240px;
        widest: 560px;
        dropped(width) => {
            AppState.change-list-width(Theme.broadsheet, width);
        }
    }

    chat-menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 230px;
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            border-radius: 4px;
            background: P.panel;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: P.shadow;
            VerticalLayout {
                padding: 6px;
                Text {
                    height: 26px;
                    x: 10px;
                    text: root.menu-chat.title;
                    color: P.faint;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if !root.menu-folders: MenuEntry {
                    icon: root.menu-chat.muted ? "bell" : "bell-slash";
                    label: root.menu-chat.muted ? @tr("Unmute") : @tr("Mute");
                    activated => {
                        Chats.toggle-mute(root.menu-chat.id);
                        chat-menu.close();
                    }
                }
                if !root.menu-folders: MenuEntry {
                    icon: "push-pin";
                    label: root.menu-chat.pinned ? @tr("Unpin") : @tr("Pin");
                    activated => {
                        Chats.toggle-pin(root.menu-chat.id, root.menu-folder);
                        chat-menu.close();
                    }
                }

                if !root.menu-folders && Chats.folders.length > 1: MenuEntry {
                    icon: "folders";
                    label: @tr("Add to folder");
                    activated => {
                        root.menu-folders = true;
                    }
                }
                if !root.menu-folders: MenuEntry {
                    icon: "copy";
                    label: @tr("Copy ID");
                    activated => {
                        Chats.copy-id(root.menu-chat.id);
                        chat-menu.close();
                    }
                }
                // Telegram's own actions on the chat (chats.rs); the ones that cannot be undone ask first.
                if !root.menu-folders && root.menu-chat.kind != ChatKind.saved: Rectangle {
                    height: 9px;
                    Rectangle {
                        height: 1px;
                        background: P.line;
                    }
                }
                if !root.menu-folders && (root.menu-chat.kind == ChatKind.user || root.menu-chat.kind == ChatKind.bot): MenuEntry {
                    icon: "prohibit";
                    label: ChatMenuWords.block(root.menu-chat.kind, root.menu-chat.blocked);
                    activated => {
                        Chats.toggle-block(root.menu-chat.id);
                        chat-menu.close();
                    }
                }
                if !root.menu-folders && root.menu-chat.reportable: MenuEntry {
                    icon: "flag";
                    label: ChatMenuWords.report();
                    activated => {
                        Chats.report(root.menu-chat.id);
                        chat-menu.close();
                    }
                }
                if !root.menu-folders && (root.menu-chat.kind == ChatKind.group || root.menu-chat.kind == ChatKind.channel): MenuEntry {
                    icon: "sign-out";
                    label: ChatMenuWords.leave(root.menu-chat.kind);
                    activated => {
                        Chats.leave(root.menu-chat.id);
                        chat-menu.close();
                    }
                }
                if !root.menu-folders && root.menu-chat.deletable && (root.menu-chat.kind == ChatKind.user || root.menu-chat.kind == ChatKind.bot): MenuEntry {
                    icon: "trash";
                    label: ChatMenuWords.delete();
                    activated => {
                        Chats.delete-chat(root.menu-chat.id);
                        chat-menu.close();
                    }
                }
                if root.menu-folders: MenuEntry {
                    icon: "caret-left";
                    label: @tr("Back");
                    activated => {
                        root.menu-folders = false;
                    }
                }
                if root.menu-folders: VerticalLayout {
                    for choice in Chats.menu-folders: MenuEntry {
                        icon: choice.inside ? "check" : "";
                        label: choice.name;
                        activated => {
                            Chats.toggle-in-folder(root.menu-chat.id, choice.folder);
                            chat-menu.close();
                        }
                    }
                }
            }
        }
    }
}

// A link's preview under a message, as the design's card: the site, the page's title, a line about
// it, and Instant View when Telegram has the page in its reading mode (greyed: not in FinchGram
// yet). A click opens the link.
component PreviewCard inherits Rectangle {
    in property <LinkPreview> preview;
    border-radius: 4px;
    background: touch.has-hover ? P.hover : P.surface;
    height: card.preferred-height;

    card := HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.preview.site;
                color: P.faint;
                font-size: 12px;
                overflow: elide;
            }
            Text {
                text: root.preview.title;
                color: P.text;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
            }
            if root.preview.about != "": Text {
                text: root.preview.about;
                color: P.muted;
                font-size: 12px;
                overflow: elide;
            }
        }
        if root.preview.instant-view: VerticalLayout {
            alignment: center;
            Rectangle {
                width: pill.preferred-width + 20px;
                height: pill.preferred-height + 8px;
                border-radius: 2px;
                background: P.tint;
                opacity: 0.5;
                pill := HorizontalLayout {
                    alignment: center;
                    spacing: 4px;
                    VerticalLayout {
                        alignment: center;
                        DuoIcon {
                            name: "lightning";
                            size: 12px;
                            color: P.tint-ink;
                        }
                    }
                    Text {
                        text: @tr("Instant View");
                        color: P.tint-ink;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Conversation.open-link(root.preview.url);
        }
    }
}

// Who first wrote a forwarded message.
component ForwardedFrom inherits HorizontalLayout {
    in property <string> name;
    spacing: 5px;
    VerticalLayout {
        alignment: center;
        DuoIcon {
            name: "arrow-bend-up-right";
            size: 14px;
            color: P.accent-ink;
        }
    }
    Text {
        text: @tr("Forwarded from {0}", root.name);
        color: P.accent-ink;
        font-size: 13px;
        font-italic: true;
        overflow: elide;
    }
}

// The message a reply answers, inside the reply's bubble: who wrote it and its first line; a click
// goes to it.
component ReplyQuoteBox inherits Rectangle {
    in property <ReplyQuote> quote;
    property <bool> reachable: !quote.gone && quote.id != "";
    height: quote-row.preferred-height;
    border-radius: 2px;
    background: #80787824;

    quote-row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 8px;
        if root.quote.has-picture: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 2px;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.quote.picture;
                    image-fit: cover;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            if root.quote.sender != "": Text {
                text: root.quote.sender;
                color: P.accent-ink;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: ActionWords.quote-line(root.quote);
                color: root.quote.gone ? P.faint : P.muted;
                font-italic: root.quote.gone;
                font-size: 14px;
                overflow: elide;
            }
        }
    }

    TouchArea {
        mouse-cursor: root.reachable ? pointer : default;
        clicked => {
            if root.reachable {
                Actions.jump(root.quote.id);
            }
        }
    }
}

// The square in front of a message while messages are being chosen; ticked when it is chosen.
component Choice inherits Rectangle {
    in property <bool> on;
    width: 20px;
    height: 20px;
    border-radius: 2px;
    background: on ? P.accent : transparent;
    border-width: on ? 0 : 1.5px;
    border-color: P.faint;

    if root.on: Icon {
        name: "check";
        size: 13px;
        color: P.on-accent;
        duotone: false;
    }
}

// A message as a bubble: theirs on the left, ours on the right in the account's tint. A sticker
// has no bubble behind it.
component Bubble {
    in property <MessageRow> message;
    property <bool> mine: message.outgoing;
    property <bool> has-tiles: message.media.length > 0;
    property <bool> has-media: has-tiles || message.files.length > 0;
    property <bool> has-sticker: message.content == Content.sticker && message.sticker.width > 0;
    height: bubble.height;

    bubble := Rectangle {
        width: min(content.preferred-width, root.width * 0.72);
        height: content.preferred-height;
        x: root.mine ? root.width - self.width : 0;
        border-radius: 4px;
        background: root.has-sticker ? transparent : root.mine ? P.tint : P.theirs;
        // The message jumped to, or with its menu open: ringed in the accent.
        border-width: Actions.flash == root.message.id || Actions.menu-row == root.message.id ? 2px : 0;
        border-color: P.accent;

        content := VerticalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 4px;
            if !root.mine && Conversation.kind == ChatKind.group: Text {
                text: root.message.sender;
                color: P.accent-ink;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }
            if root.message.forwarded-from != "": ForwardedFrom {
                name: root.message.forwarded-from;
            }
            if root.message.reply.shown: ReplyQuoteBox {
                quote: root.message.reply;
            }
            if root.has-tiles: HorizontalLayout {
                alignment: start;
                padding-top: 2px;
                padding-bottom: 2px;
                MediaTiles {
                    media: root.message.media;
                    width-limit: 380px;
                    radius: 2px;
                    gap: 3px;
                    play-size: 46px;
                    play-icon-size: 22px;
                    inset: 6px;
                    badge-radius: 2px;
                    badge-font-size: 12px;
                    duotone: true;
                    mono-font: P.mono;
                    failed: root.message.failed;
                    open(id) => {
                        Viewer.view(id, true);
                    }
                    cancel(id) => {
                        Conversation.cancel-upload(id);
                    }
                }
            }
            for file in root.message.files: HorizontalLayout {
                alignment: start;
                padding-top: 2px;
                padding-bottom: 2px;
                FileCardView {
                    file: file;
                    radius: 4px;
                    inner-radius: 2px;
                    padding-x: 10px;
                    padding-y: 8px;
                    name-size: 15px;
                    font-family: P.font;
                    text: P.text;
                    muted: P.muted;
                    line: P.line;
                    hover: P.hover;
                    accent: P.accent;
                    accent-ink: P.accent-ink;
                    on-accent: P.on-accent;
                    soft: P.tint;
                    track: P.track;
                    pdf: P.file-pdf;
                    zip: P.file-zip;
                    picture: P.file-image;
                    duotone: true;
                }
            }
            if root.has-sticker: HorizontalLayout {
                alignment: start;
                StickerPicture {
                    message-id: root.message.id;
                    sticker: root.message.sticker;
                }
            }
            if root.message.rich && !root.has-sticker: RichText {
                text: root.message.rich-text;
                default-color: root.mine ? P.tint-ink : P.text;
                default-font-size: 16px;
                link-color: P.accent-ink;
            }
            if !root.message.rich && !root.has-sticker && !root.message.round.shown && !root.message.contact.shown && (!root.has-media || root.message.text != ""): Paragraph {
                text: root.has-media ? root.message.text : Fmt.body(root.message.content, root.message.text, root.message.detail);
                color: root.mine ? P.tint-ink : root.has-media || root.message.content == Content.text ? P.text : P.muted;
                font-size: 16px;
                line-height-factor: P.leading(1.45);
            }
            if root.message.preview.url != "": VerticalLayout {
                padding-top: 4px;
                PreviewCard {
                    preview: root.message.preview;
                }
            }
            // A bot's buttons under it, as wide as the bubble (chat.slint's ButtonGrid; bots.rs).
            if root.message.buttons.length > 0: VerticalLayout {
                padding-top: 4px;
                ButtonGrid {
                    min-width: 220px;
                    rows: root.message.buttons;
                    busy-prefix: root.message.id + ":";
                    fill: root.mine ? P.panel : P.tint;
                    ink: root.mine ? P.accent-ink : P.tint-ink;
                    radius: 2px;
                    font-family: P.font;
                    font-size: 14px;
                    pressed(row, column) => {
                        Actions.press(root.message.id, row, column);
                    }
                }
            }
            // The design's fifth round, inside the bubble before the time (1a): a round video
            // message, a contact card, the reactions and their picker (extras.slint).
            if root.message.round.shown: RoundNoteView {
                note: root.message.round;
                line: P.line;
                accent: P.accent;
                side: P.surface;
                faint: root.mine ? P.accent-ink : P.faint;
                mono: P.mono;
                font-family: P.font;
                font-size: 12px;
                clicked => {
                    Conversation.play-round(root.message.id);
                }
            }
            if root.message.contact.shown: HorizontalLayout {
                alignment: start;
                padding-top: 2px;
                ContactCardView {
                    card: root.message.contact;
                    bg: P.panel;
                    line: P.line;
                    soft: P.tint;
                    soft-ink: P.tint-ink;
                    accent: P.accent-ink;
                    text-color: P.text;
                    muted: P.muted;
                    faint: P.faint;
                    radius: 4px;
                    av-radius: 2px;
                    font-family: P.font;
                    font-size: 15px;
                    small: 13px;
                    message => {
                        Conversation.contact-message(root.message.id);
                    }
                    invite => {
                        Conversation.contact-invite(root.message.id);
                    }
                    add => {
                        Conversation.contact-add(root.message.id);
                    }
                    share => {
                        Conversation.contact-share(root.message.id);
                    }
                }
            }
            // The chips sit on the bubble, a step lighter or darker than it, as the contact card
            // does (P.surface is all but the bubble's own grey).
            if root.message.reactions.length > 0: ReactionChips {
                reactions: root.message.reactions;
                fill: P.panel;
                ink: P.muted;
                chosen-fill: P.tint;
                chosen-ink: P.tint-ink;
                ring: P.accent;
                radius: 2px;
                font-family: P.font;
                react(emoji) => {
                    Conversation.react(root.message.id, emoji);
                }
            }
            if Conversation.reaction-picker == root.message.id: HorizontalLayout {
                alignment: start;
                ReactionPicker {
                    choices: Conversation.reaction-choices;
                    max: Conversation.reaction-max;
                    bg: P.panel;
                    line: P.line;
                    soft: P.tint;
                    note-color: P.faint;
                    shadow: P.shadow;
                    radius: 4px;
                    font-family: P.font;
                    pick(emoji) => {
                        Conversation.react(root.message.id, emoji);
                    }
                }
            }
            // Not sent: say so, with Retry and Delete (the design's sixth round).
            if root.message.failed: HorizontalLayout {
                alignment: start;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 4px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: "warning-circle";
                            size: 14px;
                            color: P.danger;
                            duotone: false;
                        }
                    }
                    Text {
                        text: AttachWords.not-sent();
                        color: P.danger;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: retry.preferred-width;
                    retry := Text {
                        text: AttachWords.retry();
                        color: P.accent-ink;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Conversation.retry(root.message.id);
                        }
                    }
                }
                Rectangle {
                    width: discard.preferred-width;
                    discard := Text {
                        text: AttachWords.delete();
                        color: P.danger;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Conversation.discard(root.message.id);
                        }
                    }
                }
            }
            // The time, the ticks on ours, and the smiley that opens the reactions' picker (a
            // double click reacts at once).
            HorizontalLayout {
                alignment: root.mine ? end : start;
                spacing: 4px;
                Text {
                    text: root.message.edited ? @tr("edited") + " " + root.message.time : root.message.time;
                    color: root.mine ? P.accent-ink : P.faint;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                if root.mine: VerticalLayout {
                    alignment: center;
                    DuoIcon {
                        name: root.message.sending ? "clock" : root.message.seen ? "checks" : "check";
                        size: 13px;
                        color: P.accent-ink;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 16px;
                        height: 16px;
                        DuoIcon {
                            name: "smiley";
                            size: 14px;
                            color: smile.has-hover || Conversation.reaction-picker == root.message.id ? P.accent : P.faint;
                            opacity: smile.has-hover || Conversation.reaction-picker == root.message.id ? 1 : 0.7;
                        }
                        smile := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if Conversation.reaction-picker == root.message.id {
                                    Conversation.close-reactions();
                                } else {
                                    Conversation.open-reactions(root.message.id);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

component Post inherits Capped {
    in property <MessageRow> message;
    property <bool> has-tiles: message.media.length > 0;
    property <bool> has-media: has-tiles || message.files.length > 0;
    property <bool> has-sticker: message.content == Content.sticker && message.sticker.width > 0;
    spacing: 6px;

    Rectangle { height: 6px; }
    if root.message.forwarded-from != "": ForwardedFrom {
        name: root.message.forwarded-from;
    }
    if root.message.reply.shown: ReplyQuoteBox {
        quote: root.message.reply;
    }
    if root.has-tiles: HorizontalLayout {
        alignment: start;
        padding-bottom: 4px;
        MediaTiles {
            media: root.message.media;
            width-limit: 520px;
            radius: 2px;
            gap: 3px;
            play-size: 50px;
            play-icon-size: 24px;
            badge-radius: 2px;
            badge-font-size: 12px;
            duotone: true;
            mono-font: P.mono;
            failed: root.message.failed;
            open(id) => {
                Viewer.view(id, true);
            }
            cancel(id) => {
                Conversation.cancel-upload(id);
            }
        }
    }
    for file in root.message.files: HorizontalLayout {
        alignment: start;
        padding-bottom: 4px;
        FileCardView {
                    file: file;
                    radius: 4px;
                    inner-radius: 2px;
                    padding-x: 10px;
                    padding-y: 8px;
                    name-size: 15px;
                    font-family: P.font;
                    text: P.text;
                    muted: P.muted;
                    line: P.line;
                    hover: P.hover;
                    accent: P.accent;
                    accent-ink: P.accent-ink;
                    on-accent: P.on-accent;
                    soft: P.tint;
                    track: P.track;
                    pdf: P.file-pdf;
                    zip: P.file-zip;
                    picture: P.file-image;
                    duotone: true;
                }
    }
    if root.has-sticker: HorizontalLayout {
        alignment: start;
        padding-bottom: 4px;
        StickerPicture {
            message-id: root.message.id;
            sticker: root.message.sticker;
        }
    }
    if root.message.rich && !root.has-sticker: RichText {
        text: root.message.rich-text;
        default-color: P.text;
        default-font-size: 16px;
        link-color: P.accent-ink;
    }
    if !root.message.rich && !root.has-sticker && !root.message.round.shown && !root.message.contact.shown && (!root.has-media || root.message.text != ""): Paragraph {
        text: root.has-media ? root.message.text : Fmt.body(root.message.content, root.message.text, root.message.detail);
        color: P.text;
        font-size: 16px;
        line-height-factor: P.leading(1.6);
    }
    if root.message.preview.url != "": VerticalLayout {
        padding-top: 4px;
        PreviewCard {
            preview: root.message.preview;
        }
    }
    if root.message.buttons.length > 0: VerticalLayout {
        padding-top: 4px;
        ButtonGrid {
            rows: root.message.buttons;
            busy-prefix: root.message.id + ":";
            fill: P.tint;
            ink: P.tint-ink;
            radius: 2px;
            font-family: P.font;
            font-size: 14px;
            pressed(row, column) => {
                Actions.press(root.message.id, row, column);
            }
        }
    }
    // The design's fifth round: a round video message, a contact card, the reactions and their
    // picker (extras.slint).
    if root.message.round.shown: RoundNoteView {
        note: root.message.round;
        line: P.line;
        accent: P.accent;
        side: P.surface;
        faint: P.faint;
        mono: P.mono;
        font-family: P.font;
        font-size: 12px;
        clicked => {
            Conversation.play-round(root.message.id);
        }
    }
    if root.message.contact.shown: HorizontalLayout {
        alignment: start;
        ContactCardView {
            card: root.message.contact;
            bg: P.panel;
            line: P.line;
            soft: P.tint;
            soft-ink: P.tint-ink;
            accent: P.accent-ink;
            text-color: P.text;
            muted: P.muted;
            faint: P.faint;
            radius: 4px;
            av-radius: 2px;
            font-family: P.font;
            font-size: 15px;
            small: 13px;
            message => {
                Conversation.contact-message(root.message.id);
            }
            invite => {
                Conversation.contact-invite(root.message.id);
            }
            add => {
                Conversation.contact-add(root.message.id);
            }
            share => {
                Conversation.contact-share(root.message.id);
            }
        }
    }
    if root.message.reactions.length > 0: ReactionChips {
        reactions: root.message.reactions;
        fill: P.surface;
        ink: P.muted;
        chosen-fill: P.tint;
        chosen-ink: P.tint-ink;
        ring: P.accent;
        radius: 2px;
        font-family: P.font;
        react(emoji) => {
            Conversation.react(root.message.id, emoji);
        }
    }
    if Conversation.reaction-picker == root.message.id: HorizontalLayout {
        alignment: start;
        ReactionPicker {
            choices: Conversation.reaction-choices;
            max: Conversation.reaction-max;
            bg: P.panel;
            line: P.line;
            soft: P.tint;
            note-color: P.faint;
            shadow: P.shadow;
            radius: 4px;
            font-family: P.font;
            pick(emoji) => {
                Conversation.react(root.message.id, emoji);
            }
        }
    }
    // The time, the smiley for a reaction, and Share for a post (src/telegram/share.rs).
    HorizontalLayout {
        alignment: start;
        spacing: 10px;
        Text {
            text: root.message.edited ? @tr("edited") + " " + root.message.time : root.message.time;
            color: P.faint;
            font-size: 12px;
            vertical-alignment: center;
        }
        Rectangle {
            width: 16px;
            height: 16px;
            DuoIcon {
                name: "smiley";
                size: 14px;
                color: smile.has-hover || Conversation.reaction-picker == root.message.id ? P.accent : P.faint;
                opacity: smile.has-hover || Conversation.reaction-picker == root.message.id ? 1 : 0.7;
            }
            smile := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if Conversation.reaction-picker == root.message.id {
                        Conversation.close-reactions();
                    } else {
                        Conversation.open-reactions(root.message.id);
                    }
                }
            }
        }
        if root.message.can-share: Rectangle {
            width: share-words.preferred-width;
            height: 16px;
            share-words := HorizontalLayout {
                spacing: 5px;
                VerticalLayout {
                    alignment: center;
                    DuoIcon {
                        name: "share-fat";
                        size: 13px;
                        color: share-touch.has-hover ? P.accent : P.muted;
                    }
                }
                Text {
                    text: ExtraWords.share();
                    color: share-touch.has-hover ? P.accent-ink : P.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
            share-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Conversation.share-message(root.message.id);
                }
            }
        }
    }
    Rectangle { height: 4px; }
}

component Sponsored inherits Rectangle {
    in property <MessageRow> message;
    height: card.preferred-height;
    border-radius: 4px;
    background: P.surface;

    card := VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 4px;
        Text {
            text: @tr("Sponsored · placed by Telegram · Premium users can turn these off");
            color: P.faint;
            font-size: 12px;
            overflow: elide;
        }
        Text {
            text: root.message.sender;
            color: P.text;
            font-size: 15px;
            font-weight: 600;
        }
        Paragraph {
            text: root.message.text;
            color: P.muted;
            font-size: 14px;
        }
        if root.message.button != "": HorizontalLayout {
            alignment: start;
            padding-top: 4px;
            Rectangle {
                height: 28px;
                width: action.preferred-width + 20px;
                border-radius: 2px;
                background: P.tint;
                action := Text {
                    text: root.message.button;
                    color: P.tint-ink;
                    font-size: 13px;
                    font-weight: 600;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Conversation.open-sponsored(root.message.id);
                    }
                }
            }
        }
    }
}

component Line {
    in property <MessageRow> message;
    // Conversation.reveal names this row: the list scrolls to it.
    callback reveal(length, length);
    property <bool> wanted: message.id != "" && Conversation.reveal == message.id;
    changed wanted => {
        if self.wanted {
            root.reveal(root.y, root.y + root.height);
        }
    }

    // A message's row has 3px above and below it, chosen it is lit (the design's 1a); the other
    // rows have as much room.
    VerticalLayout {
        padding-top: root.message.kind == RowKind.message ? 0 : 3px;
        padding-bottom: root.message.kind == RowKind.message ? 0 : 3px;
        if root.message.kind == RowKind.day: Text {
            height: 30px;
            text: Fmt.day-title(root.message.day);
            color: P.faint;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: bottom;
        }
        if root.message.kind == RowKind.service: Paragraph {
            text: Fmt.service(root.message.content, root.message.outgoing ? @tr("You") : root.message.sender, root.message.detail);
            color: P.faint;
            font-size: 13px;
            horizontal-alignment: center;
        }
        if root.message.kind == RowKind.sponsored: Capped {
            Sponsored {
                message: root.message;
            }
        }
        if root.message.kind == RowKind.message: Rectangle {
            height: body.preferred-height + 6px;
            area := MessageArea {
                message: root.message;
                Rectangle {
                    x: -8px;
                    width: parent.width + 16px;
                    border-radius: 2px;
                    background: root.message.selected ? P.sel : transparent;
                    animate background { duration: 250ms; }
                }
                body := HorizontalLayout {
                    y: 3px;
                    height: self.preferred-height;
                    spacing: 12px;
                    if Actions.selecting: VerticalLayout {
                        alignment: center;
                        Choice {
                            on: root.message.selected;
                        }
                    }
                    if Conversation.kind == ChatKind.channel: Post {
                        message: root.message;
                    }
                    if Conversation.kind != ChatKind.channel: Bubble {
                        message: root.message;
                    }
                }
            }
        }
    }
}

// The strip above the composer: replying to a message, editing ours, forwarding messages here.
component ComposeStrip inherits Rectangle {
    height: strip.preferred-height;
    border-radius: 4px;
    background: P.panel;
    border-width: 1px;
    border-color: #80787833;

    strip := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            DuoIcon {
                name: Actions.bar == ComposeBar.reply ? "arrow-bend-up-left" : Actions.bar == ComposeBar.edit ? "pencil-simple" : "arrow-bend-up-right";
                size: 20px;
                color: P.accent;
            }
        }
        if Actions.bar-has-picture: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 2px;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: Actions.bar-picture;
                    image-fit: cover;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: ActionWords.bar-title();
                color: P.accent-ink;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: ActionWords.bar-line();
                color: P.muted;
                font-size: 14px;
                overflow: elide;
            }
        }
        if Actions.bar == ComposeBar.forward: Rectangle {
            width: hide.preferred-width;
            hide := HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    DuoIcon {
                        name: Actions.hide-sender ? "check-square" : "square";
                        size: 18px;
                        color: Actions.hide-sender ? P.accent : P.faint;
                    }
                }
                Text {
                    text: @tr("Hide sender's name");
                    color: P.muted;
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Actions.hide-sender = !Actions.hide-sender;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 24px;
                height: 24px;
                Icon {
                    name: "x";
                    size: 16px;
                    color: P.faint;
                    duotone: false;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Actions.cancel-bar();
                    }
                }
            }
        }
    }
}

// What to do with the messages chosen, in place of the composer (the design's 1a): faded where
// they do not all allow it.
component BarAction inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> danger;
    callback activated();
    width: action.preferred-width;
    opacity: root.enabled ? 1 : 0.4;

    action := HorizontalLayout {
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            DuoIcon {
                name: root.icon;
                size: 19px;
                color: root.danger ? P.accent2-ink : P.accent;
            }
        }
        Text {
            text: root.label;
            color: root.danger ? P.accent2-ink : P.text;
            font-size: 15px;
            vertical-alignment: center;
        }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

// An icon that does something on the search line: the arrows, the cross.
component SearchButton inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    callback activated();
    width: 30px;
    height: 34px;
    opacity: root.enabled ? 1 : 0.4;

    DuoIcon {
        name: root.icon;
        size: 20px;
        color: touch.has-hover && root.enabled ? P.text : P.muted;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

// Searching in the chat: the line under the header, with the words, where the view is among the
// matches and the arrows to the next one up or down (src/telegram/search.rs). ⏎ goes up, ⇧⏎ down,
// Esc closes it.
component SearchLine inherits Rectangle {
    height: line.preferred-height;
    property <int> requests: Conversation.search-requests;
    changed requests => {
        input.focus-text();
    }

    line := HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-bottom: 12px;
        spacing: 4px;
        Rectangle {
            horizontal-stretch: 1;
            height: 34px;
            border-radius: 4px;
            background: P.surface;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    DuoIcon {
                        name: "magnifying-glass";
                        size: 14px;
                        color: P.faint;
                    }
                }
                input := SearchInput {
                    horizontal-stretch: 1;
                    placeholder: SearchWords.placeholder;
                    text-color: P.text;
                    placeholder-color: P.faint;
                    selection-color: P.input-sel;
                    font-family: P.font;
                    font-size: 14px;
                    edited(words) => {
                        Conversation.search(words);
                    }
                    accepted => {
                        Conversation.search-step(true);
                    }
                    back => {
                        Conversation.search-step(false);
                    }
                    escape => {
                        Conversation.close-search();
                    }
                }
                Text {
                    text: SearchWords.position;
                    color: P.faint;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
        }
        SearchButton {
            icon: "caret-up";
            enabled: SearchWords.can-go-up;
            activated => {
                Conversation.search-step(true);
            }
        }
        SearchButton {
            icon: "caret-down";
            enabled: SearchWords.can-go-down;
            activated => {
                Conversation.search-step(false);
            }
        }
        SearchButton {
            icon: "x";
            activated => {
                Conversation.close-search();
            }
        }
    }
}

component SelectionBar inherits Rectangle {
    height: bar.preferred-height;

    Rectangle {
        y: 0;
        height: 1px;
        background: #80787838;
    }

    KeyScope {
        width: 0;
        height: 0;
        escape => {
            Actions.cancel-selection();
        }
    }

    bar := HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 16px;
        padding-bottom: 20px;
        spacing: 18px;
        Text {
            text: ActionWords.selected();
            color: P.text;
            font-size: 17px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: @tr("Shift-click to select a range");
            color: P.faint;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
        BarAction {
            icon: "arrow-bend-up-right";
            label: @tr("Forward");
            enabled: Actions.can-forward;
            activated => {
                Actions.forward-selected();
            }
        }
        BarAction {
            icon: "copy";
            label: ActionWords.copy();
            enabled: Actions.can-copy;
            activated => {
                Actions.copy-selected();
            }
        }
        BarAction {
            icon: "trash";
            label: @tr("Delete");
            enabled: Actions.can-delete;
            danger: true;
            activated => {
                Actions.delete-selected();
            }
        }
        if Actions.report-offered: BarAction {
            icon: "flag";
            label: @tr("Report");
            enabled: Actions.can-report;
            activated => {
                Actions.report-selected();
            }
        }
        Rectangle {
            width: cancel.preferred-width;
            cancel := Text {
                text: @tr("Cancel");
                color: P.accent-ink;
                font-size: 15px;
                font-weight: 600;
                vertical-alignment: center;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Actions.cancel-selection();
                }
            }
        }
    }
}

// The chat's newest pinned message, under the header: a click goes to it (bots.rs).
component PinnedBar inherits Rectangle {
    height: 48px;
    background: P.panel;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: P.line;
    }
    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 3px;
                height: 32px;
                background: P.accent;
            }
        }
        if Conversation.pinned-message.has-picture: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 2px;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: Conversation.pinned-message.picture;
                    image-fit: cover;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: BotWords.pinned();
                color: P.accent-ink;
                font-size: 12px;
                font-weight: 600;
            }
            Text {
                text: (Conversation.pinned-message.sender == "" ? "" : Conversation.pinned-message.sender + ": ") + ActionWords.quote-line(Conversation.pinned-message);
                color: P.muted;
                font-size: 14px;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            DuoIcon {
                name: "push-pin";
                size: 18px;
                color: P.muted;
            }
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Conversation.open-pinned();
        }
    }
}

// A bot's commands that start with what is typed after "/": a click sends one (bots.rs).
component CommandList inherits Rectangle {
    height: min(300px, list.preferred-height);
    border-radius: 4px;
    background: P.panel;
    drop-shadow-blur: 30px;
    drop-shadow-offset-y: 10px;
    drop-shadow-color: P.shadow;
    clip: true;

    Flickable {
        width: parent.width;
        height: parent.height;
        mouse-drag-pan-enabled: false;
        content-width: self.width;
        content-height: list.preferred-height;
        list := VerticalLayout {
            width: parent.width;
            alignment: start;
            padding: 6px;
            for command in Conversation.commands: Rectangle {
                height: 34px;
                border-radius: 2px;
                background: command-touch.has-hover ? P.hover : transparent;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    Text {
                        text: command.command;
                        color: P.accent-ink;
                        font-family: P.mono;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: command.description;
                        color: P.muted;
                        font-size: 14px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                command-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Conversation.send-command(command.command);
                    }
                }
            }
        }
    }
}

// A topic open in a group with topics: the way back to the list, and the topic's name.
component TopicBar inherits Rectangle {
    height: 40px;
    background: P.panel;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: P.line;
    }
    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        spacing: 8px;
        Rectangle {
            width: back.preferred-width;
            back := HorizontalLayout {
                spacing: 4px;
                VerticalLayout {
                    alignment: center;
                    DuoIcon {
                        name: "caret-left";
                        size: 14px;
                        color: P.accent-ink;
                    }
                }
                Text {
                    text: ExtraWords.all-topics();
                    color: P.accent-ink;
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Conversation.back-to-topics();
                }
            }
        }
        Text {
            text: "/";
            color: P.faint;
            font-size: 14px;
            vertical-alignment: center;
        }
        if Conversation.topic-icon != "": Text {
            text: Conversation.topic-icon;
            font-size: 15px;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: Conversation.topic-title;
            color: P.text;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        if Conversation.topic-closed: VerticalLayout {
            alignment: center;
            DuoIcon {
                name: "lock-simple";
                size: 14px;
                color: P.faint;
            }
        }
    }
}

// A closed topic, in place of the composer.
component ClosedTopicNote inherits HorizontalLayout {
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 10px;
    padding-bottom: 20px;
    Rectangle {
        height: note.preferred-height + 16px;
        border-radius: 4px;
        background: P.surface;
        note := HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                DuoIcon {
                    name: "lock-simple";
                    size: 16px;
                    color: P.muted;
                }
            }
            Text {
                horizontal-stretch: 1;
                text: ExtraWords.topic-closed();
                color: P.muted;
                font-size: 14px;
                wrap: word-wrap;
                vertical-alignment: center;
            }
        }
    }
}

// The chat's settings panel, over the right of the pane: a group's rules, or what its
// administrators may change (admin.rs); nothing yet for other chats.
component SettingsPanel inherits Rectangle {
    background: P.panel;

    // Clicks on the panel stay on it: the messages under it take none.
    TouchArea { }

    Rectangle {
        x: 0;
        width: 1px;
        background: P.line;
    }
    VerticalLayout {
        HorizontalLayout {
            padding-left: 24px;
            padding-right: 20px;
            padding-top: 20px;
            padding-bottom: 12px;
            spacing: 8px;
            SectionTitle {
                horizontal-stretch: 1;
                text: ExtraWords.settings().to-uppercase();
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle {
                width: 22px;
                height: 22px;
                Icon {
                    name: "x";
                    size: 18px;
                    color: P.faint;
                    duotone: false;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Conversation.toggle-settings();
                    }
                }
            }
        }
        Flickable {
            vertical-stretch: 1;
            mouse-drag-pan-enabled: false;
            content-width: self.width;
            content-height: body.preferred-height;
            body := VerticalLayout {
                width: parent.width;
                alignment: start;
                padding-left: 24px;
                padding-right: 24px;
                padding-bottom: 20px;
                if Conversation.admin.shown: AdminPanelView {
                    side: P.surface;
                    accent: P.accent;
                    on-accent: P.on-accent;
                    text-color: P.text;
                    muted: P.muted;
                    faint: P.faint;
                    off: P.off;
                    danger: P.danger;
                    font-family: P.font;
                    font-size: 15px;
                    small: 13px;
                }
                if !Conversation.admin.shown: Text {
                    text: ExtraWords.nothing-here();
                    color: P.faint;
                    font-size: 13px;
                    wrap: word-wrap;
                }
            }
        }
    }
}

component ConversationPane inherits Rectangle {
    background: P.panel;

    if Conversation.chat-id == "": Text {
        text: @tr("Choose a chat on the left");
        color: P.faint;
        font-size: 15px;
    }

    if Conversation.chat-id != "": VerticalLayout {
        x: 0;
        width: parent.width - side.width;
        HorizontalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 16px;
            padding-bottom: 12px;
            spacing: 14px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: Conversation.title;
                    color: P.text;
                    font-size: 20px;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: Conversation.typing != "" ? @tr("typing…")
                        : Fmt.status(Conversation.status, Conversation.last-seen, Conversation.members, Conversation.online-members);
                    color: Conversation.typing != "" || Conversation.status == Status.online ? P.accent-ink : P.faint;
                    font-italic: Conversation.typing != "";
                    font-size: 13px;
                    overflow: elide;
                }
            }
            // Searching in the chat: the line under the header (SearchLine).
            VerticalLayout {
                alignment: center;
                DuoIcon {
                    name: "magnifying-glass";
                    size: 20px;
                    color: Conversation.search-open ? P.accent : search-touch.has-hover ? P.text : P.muted;
                    search-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if Conversation.search-open {
                                Conversation.close-search();
                            } else {
                                Conversation.search-open = true;
                                Conversation.search-requests += 1;
                            }
                        }
                    }
                }
            }
            // Calls are still to come.
            VerticalLayout {
                alignment: center;
                DuoIcon {
                    name: "phone";
                    size: 20px;
                    color: P.muted;
                    opacity: 0.4;
                }
            }
            // The chat's info panel (chat_info.rs; ⌘I), lit while it is open.
            VerticalLayout {
                alignment: center;
                DuoIcon {
                    name: "sidebar-simple";
                    size: 20px;
                    color: ChatInfo.open ? P.accent : info-touch.has-hover ? P.text : P.muted;
                    info-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            ChatInfo.toggle();
                        }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                more := DuoIcon {
                    name: "dots-three";
                    size: 22px;
                    color: P.muted;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            menu.show();
                        }
                    }
                }
            }
        }
        if Conversation.search-open: SearchLine { }
        if Conversation.pinned-message.shown: PinnedBar { }
        if Conversation.topic-id != "": TopicBar { }

        scroll := ChatScroll {
            vertical-stretch: 1;
            from-top: Conversation.showing-topics;
            // 10px between messages, less their rows' room (Line).
            spacing: 4px;
            margin-left: 24px;
            margin-right: 24px;
            margin-top: 4px;
            margin-bottom: 16px;
            // A group with topics opens on them (src/telegram/topics.rs).
            if Conversation.showing-topics: TopicList {
                bg: P.panel;
                side: P.surface;
                soft: P.tint;
                soft-ink: P.tint-ink;
                line: P.line;
                accent: P.accent;
                accent-ink: P.accent-ink;
                on-accent: P.on-accent;
                text-color: P.text;
                muted: P.muted;
                faint: P.faint;
                danger: P.danger;
                selection: P.input-sel;
                radius: 2px;
                big-radius: 4px;
                font-family: P.font;
                font-size: 15px;
                small: 13px;
            }
            for row in Conversation.messages: Line {
                message: row;
                reveal(top, bottom) => {
                    scroll.reveal(top, bottom);
                }
            }
            if Conversation.typing != "": Text {
                text: @tr("{0} is typing…", Conversation.typing);
                color: P.faint;
                font-size: 13px;
            }
        }

        // A bot's keyboard, and its commands matching "/…" typed, above the composer (bots.rs).
        if Conversation.can-write && !Actions.selecting && Conversation.keyboard.length > 0 && !Conversation.keyboard-hidden: HorizontalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 8px;
            ButtonGrid {
                rows: Conversation.keyboard;
                fill: P.tint;
                ink: P.tint-ink;
                radius: 2px;
                row-height: 38px;
                font-family: P.font;
                font-size: 14px;
                pressed(row, column) => {
                    Conversation.press-key(row, column);
                }
            }
        }
        if Conversation.can-write && !Actions.selecting && Conversation.commands.length > 0: HorizontalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 8px;
            CommandList { }
        }
        // A closed topic takes no messages; what Telegram refused is said above the composer.
        if Conversation.topic-closed && !Actions.selecting: ClosedTopicNote { }
        if Conversation.send-error != "" && Conversation.can-write && !Actions.selecting && !Conversation.topic-closed: HorizontalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 8px;
            Text {
                text: Conversation.send-error;
                color: P.danger;
                font-size: 13px;
                wrap: word-wrap;
            }
        }
        if Conversation.can-write && !Actions.selecting && !Conversation.showing-topics && !Conversation.topic-closed: VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 8px;
            padding-bottom: 20px;
            spacing: 10px;
            // A reply or an edit begins, a menu or dialog closed: the keyboard comes back here.
            property <int> focus-requests: Actions.focus-requests;
            changed focus-requests => {
                input.focus-text();
            }
            init => {
                input.focus-text();
            }
            HorizontalLayout {
                alignment: start;
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 2px;
                        background: P.accent;
                    }
                }
                HorizontalLayout {
                    Text {
                        text: @tr("Sending as {0}", Account.name);
                        color: P.accent-ink;
                        font-size: 12px;
                    }
                    // Slow mode: how long still to wait, or the group's pace (the design's 1a).
                    if Conversation.slow-wait > 0 || Conversation.slow-limited: Text {
                        text: " · " + (Conversation.slow-wait > 0 ? ExtraWords.slow-wait-hint(Conversation.slow-wait) : ExtraWords.slow-hint(Conversation.slow-mode));
                        color: P.accent2-ink;
                        font-size: 12px;
                    }
                }
            }
            if Actions.bar != ComposeBar.none: ComposeStrip { }
            HorizontalLayout {
                spacing: 10px;
                alignment: stretch;
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 4px;
                    background: P.surface;
                    height: input.height;
                    input := MessageInput {
                        text <=> Conversation.draft;
                        allow-empty: Actions.bar == ComposeBar.forward;
                        placeholder: Conversation.slow-wait > 0 ? ExtraWords.slow-wait-placeholder(Conversation.slow-wait)
                            : Conversation.keyboard-placeholder != "" ? Conversation.keyboard-placeholder : @tr("Write a message…");
                        text-color: P.text;
                        placeholder-color: P.faint;
                        selection-color: P.input-sel;
                        font-family: P.font;
                        font-size: 16px;
                        padding-x: 14px;
                        padding-y: 9px;
                        base-height: 40px;
                        send(words) => {
                            Conversation.send(words);
                        }
                        edited(words) => {
                            Conversation.edited(words);
                        }
                    }
                }
                // The paperclip: photos, videos and files (attachments.slint); scheduling is still
                // to come.
                VerticalLayout {
                    alignment: end;
                    padding-bottom: 2px;
                    clip := Rectangle {
                        property <bool> allowed: Conversation.can-send-photos || Conversation.can-send-videos || Conversation.can-send-files;
                        width: 36px;
                        height: 36px;
                        border-radius: 2px;
                        background: Attachments.menu-open || (clip-touch.has-hover && self.allowed) ? P.hover : transparent;
                        DuoIcon {
                            name: "paperclip";
                            size: 22px;
                            color: Attachments.menu-open ? P.accent : clip-touch.has-hover && clip.allowed ? P.text : P.muted;
                            opacity: clip.allowed ? 1 : 0.4;
                        }
                        clip-touch := TouchArea {
                            mouse-cursor: clip.allowed ? pointer : not-allowed;
                            clicked => {
                                if clip.allowed {
                                    Attachments.menu-x = self.absolute-position.x;
                                    Attachments.menu-y = self.absolute-position.y;
                                    Attachments.menu-focus = -1;
                                    Attachments.menu-keyboard = false;
                                    Attachments.menu-open = !Attachments.menu-open;
                                }
                            }
                        }
                        if clip-touch.has-hover && !Attachments.menu-open: Rectangle {
                            x: parent.width - self.width;
                            y: -self.height - 8px;
                            width: tip.preferred-width + 20px;
                            height: tip.preferred-height + 12px;
                            border-radius: 2px;
                            background: P.text;
                            drop-shadow-blur: 20px;
                            drop-shadow-offset-y: 6px;
                            drop-shadow-color: #00000033;
                            tip := Text {
                                text: clip.allowed ? AttachWords.attach() : AttachWords.cant-send();
                                color: P.bg;
                                font-size: 12px;
                            }
                        }
                    }
                }
                // The scissors: a screenshot into the card (src/screenshot/), as its shortcut
                // does; greyed where the chat takes no photos.
                VerticalLayout {
                    alignment: end;
                    padding-bottom: 2px;
                    scissors := Rectangle {
                        property <bool> allowed: Conversation.can-send-photos;
                        width: 36px;
                        height: 36px;
                        border-radius: 2px;
                        background: scissors-touch.has-hover && self.allowed ? P.hover : transparent;
                        DuoIcon {
                            name: "scissors";
                            size: 22px;
                            transform-rotation: -90deg;
                            color: scissors-touch.has-hover && scissors.allowed ? P.text : P.muted;
                            opacity: scissors.allowed ? 1 : 0.4;
                        }
                        scissors-touch := TouchArea {
                            mouse-cursor: scissors.allowed ? pointer : not-allowed;
                            clicked => {
                                if scissors.allowed {
                                    Screenshot.start();
                                }
                            }
                        }
                        if scissors-touch.has-hover: Rectangle {
                            x: parent.width - self.width;
                            y: -self.height - 8px;
                            width: scissors-tip.preferred-width;
                            height: scissors-tip.preferred-height;
                            border-radius: 2px;
                            background: P.text;
                            drop-shadow-blur: 20px;
                            drop-shadow-offset-y: 6px;
                            drop-shadow-color: #00000033;
                            scissors-tip := HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 8px;
                                Text {
                                    text: scissors.allowed ? AttachWords.screenshot() : AttachWords.screenshot-off();
                                    color: P.bg;
                                    font-size: 12px;
                                }
                                if scissors.allowed: Text {
                                    text: Screenshot.shortcut-label;
                                    color: P.bg;
                                    font-size: 12px;
                                    opacity: 0.7;
                                }
                            }
                        }
                    }
                }
                // A bot's menu button (its web app, or its commands), and the fold for its
                // keyboard (bots.rs).
                if Conversation.menu-button != "": VerticalLayout {
                    alignment: end;
                    padding-bottom: 4px;
                    Rectangle {
                        height: 32px;
                        width: menu-words.preferred-width + 20px;
                        border-radius: 2px;
                        background: menu-touch.has-hover ? P.tint.darker(0.05) : P.tint;
                        menu-words := HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                DuoIcon {
                                    name: "list-bullets";
                                    size: 16px;
                                    color: P.tint-ink;
                                }
                            }
                            Text {
                                text: Conversation.menu-button == "/" ? BotWords.menu() : Conversation.menu-button;
                                color: P.tint-ink;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        menu-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                Conversation.open-bot-menu();
                            }
                        }
                    }
                }
                if Conversation.keyboard.length > 0: VerticalLayout {
                    alignment: end;
                    padding-bottom: 2px;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 2px;
                        background: keyboard-touch.has-hover ? P.hover : transparent;
                        DuoIcon {
                            name: "keyboard";
                            size: 22px;
                            color: Conversation.keyboard-hidden ? P.muted : P.accent;
                        }
                        keyboard-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                Conversation.toggle-keyboard();
                            }
                        }
                    }
                }
                // Scheduling and voice messages are still to come.
                for name in ["clock", "microphone"]: VerticalLayout {
                    alignment: end;
                    padding-bottom: 9px;
                    DuoIcon {
                        name: name;
                        size: 22px;
                        color: P.muted;
                        opacity: 0.4;
                    }
                }
                VerticalLayout {
                    alignment: end;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 2px;
                        background: send.has-hover ? P.accent.darker(0.1) : P.accent;
                        DuoIcon {
                            name: Actions.bar == ComposeBar.edit ? "check" : "paper-plane-tilt";
                            size: 20px;
                            color: P.on-accent;
                        }
                        send := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                input.send-now();
                            }
                        }
                    }
                }
            }
        }

        if Actions.selecting: SelectionBar { }

        // A channel one only reads: muting it, in place of the composer.
        if Conversation.kind == ChatKind.channel && !Conversation.can-write && !Actions.selecting: HorizontalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 10px;
            padding-bottom: 20px;
            Rectangle {
                height: 42px;
                border-radius: 4px;
                background: P.surface;
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        DuoIcon {
                            name: "bell-simple-slash";
                            size: 19px;
                            color: P.accent-ink;
                        }
                    }
                    Text {
                        text: Conversation.muted ? @tr("Unmute") : @tr("Mute");
                        color: P.accent-ink;
                        font-size: 16px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Conversation.toggle-mute();
                    }
                }
            }
        }
    }

    // The chat's info panel, or its administration in the panel's place (admin.rs), beside the
    // messages: the design's column squeezes them, 320px wide, and slides open and shut.
    side := Rectangle {
        property <bool> shown: Conversation.chat-id != "" && (ChatInfo.open || Conversation.settings-open);
        x: parent.width - self.width;
        y: 0;
        width: shown ? 320px : 0px;
        height: parent.height;
        clip: true;
        animate width { duration: 180ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        if Conversation.settings-open: SettingsPanel {
            x: 0;
            y: 0;
            width: 320px;
            height: parent.height;
        }
        if !Conversation.settings-open && (ChatInfo.open || side.width > 0px): InfoPanel {
            x: 0;
            y: 0;
            width: 320px;
            height: parent.height;
        }
    }

    menu := PopupWindow {
        x: root.width - 254px;
        y: 50px;
        width: 230px;
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            border-radius: 4px;
            background: P.panel;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: P.shadow;
            VerticalLayout {
                padding: 6px;
                Text {
                    height: 26px;
                    x: 10px;
                    text: Conversation.title;
                    color: P.faint;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                MenuEntry {
                    icon: Conversation.muted ? "bell" : "bell-slash";
                    label: Conversation.muted ? @tr("Unmute") : @tr("Mute");
                    keys: "⌘⇧M";
                    activated => {
                        Conversation.toggle-mute();
                        menu.close();
                    }
                }
                MenuEntry {
                    icon: "push-pin";
                    label: Conversation.pinned ? @tr("Unpin") : @tr("Pin");
                    activated => {
                        Conversation.toggle-pin();
                        menu.close();
                    }
                }
                MenuEntry {
                    icon: "copy";
                    label: @tr("Copy ID");
                    activated => {
                        Conversation.copy-id();
                        menu.close();
                    }
                }
            }
        }
    }
}

export component BroadsheetWindow inherits Rectangle {
    property <BroadsheetView> view: BroadsheetView.chats;
    background: P.bg;

    VerticalLayout {
        TitleBar { }
        HorizontalLayout {
            vertical-stretch: 1;
            rail := Rail { }
            ListColumn {
                view <=> root.view;
                room: root.width - rail.width - 388px - (Conversation.chat-id != "" && (ChatInfo.open || Conversation.settings-open) ? 320px : 0px);
            }
            ConversationPane {
                horizontal-stretch: 1;
            }
        }
    }

    // The drawer, from the rail's right over the list, under the title bar.
    BroadsheetDrawer {
        x: 80px;
        y: 40px;
        width: root.width - 80px;
        height: root.height - 40px;
    }

    // A message's menu and the dialogs of its actions, over everything; the search over everything
    // and the pencil's dialogs.
    BroadsheetActions { }
    BroadsheetAttachments { }
    BroadsheetCompose { }
}
