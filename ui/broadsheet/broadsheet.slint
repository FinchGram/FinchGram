// Broadsheet (the design's "1a 报纸"): a newspaper's calm. A rail with the accounts, the chat list
// with its folders as tabs, and the conversation in bubbles. The accent is the account's colour.
import { ListView } from "std-widgets.slint";
import { AppState, Page, Connection, Theme, Screenshot } from "../state.slint";
import {
    Chats, Conversation, Account, ChatRow, MessageRow, RowKind, ChatKind, Content, Status, Viewer, LinkPreview, ReplyQuote,
    Actions, ComposeBar, ActionNotice, Attachments } from "../telegram.slint";
import { AccountColors } from "../look.slint";
import { Fmt } from "../format.slint";
import { Icon, Logo, Paragraph, ListEdge, WindowButtonsSpace, WindowMover, Avatar } from "../widgets.slint";
import {
    ChatScroll, MessageInput, Capped, MediaTiles, StickerPicture, RichText, MessageArea, ActionWords, KeyScope, AttachWords, FileCardView, ChatMenuWords
} from "../chat.slint";
import { BroadsheetPalette as P } from "palette.slint";
import { BroadsheetActions } from "actions.slint";
import { BroadsheetAttachments } from "attachments.slint";

export enum BroadsheetView { chats, channels, bots, filters, scheduled }

component DuoIcon inherits Icon {
    duotone: true;
}

component TitleBar inherits Rectangle {
    height: 40px;
    background: P.rail;

    WindowMover { }

    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: P.accent;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        WindowButtonsSpace { }
        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 9px;
                    height: 9px;
                    border-radius: 2px;
                    background: P.accent;
                }
            }
            Text {
                text: Account.name;
                color: P.text;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                text: AccountColors.key(0);
                color: P.accent-ink;
                font-family: P.mono;
                font-size: 12px;
                vertical-alignment: center;
            }
            Text {
                text: "— FinchGram";
                color: P.faint;
                font-size: 14px;
                vertical-alignment: center;
            }
        }
        // What was just done (copied, saved, reported), said in the title bar.
        if Actions.notice != ActionNotice.none: Text {
            text: ActionWords.notice(Actions.notice);
            color: P.accent-ink;
            font-size: 14px;
            font-italic: true;
            vertical-alignment: center;
        }
        Rectangle {
            HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    DuoIcon {
                        name: P.dark ? "sun" : "moon";
                        size: 16px;
                        color: P.muted;
                    }
                }
                Text {
                    text: P.dark ? @tr("Light") : @tr("Dark");
                    color: P.muted;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    AppState.change-appearance(P.dark ? "light" : "dark");
                }
            }
        }
    }
}

// The accounts, each in its colour with its key; settings at the foot.
component Rail inherits Rectangle {
    width: 80px;
    background: P.rail;

    VerticalLayout {
        padding-top: 12px;
        padding-bottom: 14px;
        spacing: 14px;
        alignment: start;
        HorizontalLayout {
            alignment: center;
            Logo {
                size: 40px;
                radius: 10px;
            }
        }
        Text {
            text: @tr("Accounts") + " 1/10";
            color: P.faint;
            font-size: 11px;
            horizontal-alignment: center;
        }
        VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                alignment: center;
                // The account in front: its colour, ringed.
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 7px;
                    border-width: 2px;
                    border-color: P.accent;
                    Avatar {
                        size: 32px;
                        radius: 4px;
                        fill: P.accent;
                        ink: P.on-accent;
                        initial: Account.initial;
                        picture: Account.picture;
                        has-picture: Account.has-picture;
                        font-size: 14px;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            AppState.page = Page.profile;
                        }
                    }
                }
            }
            Text {
                text: AccountColors.key(0);
                color: P.accent-ink;
                font-family: P.mono;
                font-size: 10px;
                font-weight: 600;
                horizontal-alignment: center;
            }
        }
    }

    VerticalLayout {
        padding-bottom: 16px;
        alignment: end;
        HorizontalLayout {
            alignment: center;
            DuoIcon {
                name: "gear-six";
                size: 22px;
                color: P.muted;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        AppState.page = Page.settings;
                    }
                }
            }
        }
    }
}

component ViewButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active;
    in property <bool> enabled: true;
    callback activated();
    height: 44px;
    border-radius: 4px;
    background: active ? P.tint : touch.has-hover && enabled ? P.hover : transparent;
    opacity: enabled ? 1 : 0.4;

    VerticalLayout {
        alignment: center;
        spacing: 2px;
        HorizontalLayout {
            alignment: center;
            DuoIcon {
                name: root.icon;
                size: 18px;
                color: root.active ? P.tint-ink : P.muted;
            }
        }
        Text {
            text: root.label;
            color: root.active ? P.tint-ink : P.muted;
            font-size: 11px;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

component Views {
    in-out property <BroadsheetView> view;

    HorizontalLayout {
        spacing: 4px;
        ViewButton {
            icon: "chats";
            label: @tr("Chats");
            active: root.view == BroadsheetView.chats;
            activated => {
                root.view = BroadsheetView.chats;
            }
        }
        ViewButton {
            icon: "megaphone";
            label: @tr("Channels");
            active: root.view == BroadsheetView.channels;
            activated => {
                root.view = BroadsheetView.channels;
            }
        }
        ViewButton {
            icon: "robot";
            label: @tr("Bots");
            active: root.view == BroadsheetView.bots;
            activated => {
                root.view = BroadsheetView.bots;
            }
        }
        // Keyword filters and scheduled messages are still to come.
        ViewButton {
            icon: "funnel-simple";
            label: @tr("Filters");
            enabled: false;
        }
        ViewButton {
            icon: "clock";
            label: @tr("Scheduled");
            enabled: false;
        }
    }
}

component SearchField inherits Rectangle {
    height: 34px;
    border-radius: 4px;
    background: P.surface;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            DuoIcon {
                name: "magnifying-glass";
                size: 14px;
                color: P.faint;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            Text {
                width: parent.width;
                visible: input.text == "";
                text: @tr("Search");
                color: P.faint;
                font-size: 14px;
                vertical-alignment: center;
            }
            input := TextInput {
                width: parent.width;
                height: parent.height;
                text: Chats.query;
                color: P.text;
                font-size: 14px;
                vertical-alignment: center;
                selection-background-color: P.tint;
                edited => {
                    Chats.search(self.text);
                }
                accepted => {
                    if Chats.list.length > 0 {
                        Conversation.open(Chats.list[0].id);
                    }
                }
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        self.text = "";
                        Chats.search("");
                        return accept;
                    }
                    return reject;
                }
            }
        }
        Text {
            text: "⌘K";
            color: P.faint;
            font-family: P.mono;
            font-size: 11px;
            vertical-alignment: center;
        }
    }

    property <int> search-requests: AppState.search-requests;
    changed search-requests => {
        root.focus-search();
    }

    public function focus-search() {
        input.focus();
        input.select-all();
    }
}

component FolderTab {
    in property <int> index;
    property <bool> active: index == Chats.folder;

    VerticalLayout {
        spacing: 2px;
        HorizontalLayout {
            spacing: 4px;
            Text {
                text: root.index < Chats.folders.length ? (Chats.folders[root.index].id == 0 ? @tr("All") : Chats.folders[root.index].name) : "";
                color: root.active ? P.text : P.muted;
                font-size: 14px;
                font-weight: root.active ? 600 : 400;
            }
            if root.index < Chats.folders.length && Chats.folders[root.index].unread > 0: Text {
                text: Chats.folders[root.index].unread > 99 ? "99+" : "" + Chats.folders[root.index].unread;
                color: P.accent-ink;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: bottom;
            }
        }
        Rectangle {
            height: 2px;
            background: root.active ? P.accent : transparent;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Chats.show-folder(root.index);
        }
    }
}

// The folders as tabs: the first four, the rest behind "More".
component Folders {
    // "More" names the folder shown when it is one of those behind it.
    property <bool> more-chosen: Chats.folder >= 4;

    HorizontalLayout {
        for folder[index] in Chats.folders: Rectangle {
            visible: index < 4;
            width: index < 4 ? tab.preferred-width + 14px : 0px;
            height: tab.preferred-height;
            tab := FolderTab {
                x: 0;
                y: 0;
                width: self.preferred-width;
                index: index;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        if Chats.folders.length > 4: Rectangle {
            HorizontalLayout {
                spacing: 4px;
                Text {
                    text: root.more-chosen ? Chats.folders[Chats.folder].name : @tr("More");
                    color: root.more-chosen ? P.text : P.muted;
                    font-size: 14px;
                    font-weight: root.more-chosen ? 600 : 400;
                }
                VerticalLayout {
                    alignment: center;
                    DuoIcon {
                        name: "caret-down";
                        size: 12px;
                        color: P.muted;
                    }
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    list.show();
                }
            }
            list := PopupWindow {
                x: 0;
                y: 26px;
                width: 180px;
                close-policy: PopupClosePolicy.close-on-click-outside;
                Rectangle {
                    border-radius: 4px;
                    background: P.panel;
                    drop-shadow-blur: 32px;
                    drop-shadow-offset-y: 12px;
                    drop-shadow-color: P.shadow;
                    VerticalLayout {
                        padding: 6px;
                        for folder[index] in Chats.folders: Rectangle {
                            property <bool> chosen: index == Chats.folder;
                            visible: index >= 4;
                            height: index >= 4 ? 34px : 0px;
                            border-radius: 2px;
                            background: self.chosen ? P.sel : entry.has-hover ? P.hover : transparent;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: folder.name;
                                    color: P.text;
                                    font-size: 14px;
                                    font-weight: index == Chats.folder ? 600 : 400;
                                    vertical-alignment: center;
                                }
                                if folder.unread > 0: Text {
                                    text: folder.unread;
                                    color: P.accent-ink;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                            entry := TouchArea {
                                clicked => {
                                    Chats.show-folder(index);
                                    list.close();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Letter squares by kind of chat (the design's avA).
global Avatars {
    public pure function fill(kind: ChatKind) -> color {
        if kind == ChatKind.group || kind == ChatKind.bot || kind == ChatKind.saved {
            return P.tint;
        }
        if kind == ChatKind.channel {
            return P.channel;
        }
        return P.surface;
    }

    public pure function ink(kind: ChatKind) -> color {
        if kind == ChatKind.group || kind == ChatKind.bot {
            return P.tint-ink;
        }
        if kind == ChatKind.saved {
            return P.accent-ink;
        }
        if kind == ChatKind.channel {
            return P.channel-ink;
        }
        return P.text;
    }
}

component Badge inherits Rectangle {
    in property <int> count;
    in property <bool> muted;
    height: 20px;
    width: max(20px, label.preferred-width + 10px);
    border-radius: 2px;
    background: muted ? P.off : P.accent;

    label := Text {
        text: root.count > 999 ? "999+" : "" + root.count;
        color: P.on-accent;
        font-size: 12px;
        font-weight: 600;
    }
}

// Someone mentioned us in the chat.
component MentionMark inherits Rectangle {
    width: 20px;
    height: 20px;
    border-radius: 2px;
    background: P.accent;
    Text {
        text: "@";
        color: P.on-accent;
        font-size: 12px;
        font-weight: 600;
    }
}

// The chat was marked unread by hand: it has no unread messages to count.
component UnreadMark inherits Rectangle {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background: P.accent;
}

component ChatLine inherits Rectangle {
    in property <ChatRow> chat;
    callback menu(length, length);          // a right click, where it is in the window
    property <bool> open: chat.id == Conversation.chat-id;
    height: 66px;
    background: open ? P.sel : touch.has-hover ? P.hover : transparent;

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 11px;
        padding-bottom: 11px;
        spacing: 12px;
        Avatar {
            size: 44px;
            radius: 4px;
            fill: Avatars.fill(root.chat.kind);
            ink: Avatars.ink(root.chat.kind);
            initial: root.chat.initial;
            picture: root.chat.picture;
            has-picture: root.chat.has-picture;
            font-size: 18px;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            alignment: center;
            HorizontalLayout {
                spacing: 6px;
                if root.chat.pinned: VerticalLayout {
                    alignment: center;
                    DuoIcon {
                        name: "push-pin";
                        size: 14px;
                        color: P.accent;
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.chat.title;
                    color: P.text;
                    font-size: 15px;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: root.chat.has-message ? Fmt.list-time(root.chat.time) : "";
                    color: P.faint;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                spacing: 6px;
                Text {
                    horizontal-stretch: 1;
                    text: Fmt.preview(root.chat);
                    color: P.muted;
                    font-size: 14px;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if root.chat.mention: VerticalLayout {
                    alignment: center;
                    MentionMark { }
                }
                if root.chat.unread > 0: VerticalLayout {
                    alignment: center;
                    Badge {
                        count: root.chat.unread;
                        muted: root.chat.muted;
                    }
                }
                if root.chat.marked && root.chat.unread == 0: VerticalLayout {
                    alignment: center;
                    UnreadMark { }
                }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Conversation.open(root.chat.id);
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

component ChannelLine inherits Rectangle {
    in property <ChatRow> chat;
    callback menu(length, length);          // a right click, where it is in the window
    height: 76px;
    background: touch.has-hover ? P.hover : transparent;

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 11px;
        padding-bottom: 11px;
        spacing: 12px;
        Avatar {
            size: 44px;
            radius: 4px;
            fill: P.surface;
            ink: P.text;
            initial: root.chat.initial;
            picture: root.chat.picture;
            has-picture: root.chat.has-picture;
            font-size: 18px;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    horizontal-stretch: 1;
                    text: root.chat.title;
                    color: P.text;
                    font-size: 15px;
                    font-weight: 600;
                    overflow: elide;
                }
                if root.chat.unread > 0: Badge {
                    count: root.chat.unread;
                    muted: true;
                }
            }
            Text {
                text: Fmt.body(root.chat.content, root.chat.text, root.chat.detail);
                color: P.muted;
                font-size: 14px;
                overflow: elide;
            }
            Text {
                text: root.chat.members > 0 ? @tr("{n} subscriber" | "{n} subscribers" % root.chat.members) : "";
                color: P.faint;
                font-size: 12px;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Conversation.open(root.chat.id);
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

component BotLine inherits Rectangle {
    in property <ChatRow> chat;
    callback menu(length, length);          // a right click, where it is in the window
    height: 58px;
    background: touch.has-hover ? P.sel : transparent;

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Avatar {
                size: 40px;
                radius: 4px;
                fill: root.chat.verified ? P.tint : P.surface;
                ink: root.chat.verified ? P.tint-ink : P.text;
                initial: root.chat.initial;
                picture: root.chat.picture;
                has-picture: root.chat.has-picture;
                font-size: 16px;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                Text {
                    text: root.chat.title;
                    color: P.text;
                    font-size: 15px;
                    font-weight: 600;
                    overflow: elide;
                }
                if root.chat.verified: VerticalLayout {
                    alignment: center;
                    Icon {
                        name: "seal-check";
                        size: 14px;
                        color: P.accent;
                        duotone: false;
                    }
                }
            }
            Text {
                text: root.chat.username == "" ? Fmt.preview(root.chat) : "@" + root.chat.username + " · " + Fmt.preview(root.chat);
                color: P.muted;
                font-size: 13px;
                overflow: elide;
            }
        }
        if root.chat.unread > 0: VerticalLayout {
            alignment: center;
            Badge {
                count: root.chat.unread;
                muted: root.chat.muted;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Conversation.open(root.chat.id);
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

component SectionTitle inherits Text {
    color: P.faint;
    font-size: 12px;
    letter-spacing: 0.24px;
}

component MenuEntry inherits Rectangle {
    in property <string> icon;                // "": no icon, its place kept (a choice not ticked)
    in property <string> label;
    in property <string> keys;
    callback activated();
    height: 34px;
    border-radius: 2px;
    background: touch.has-hover ? P.hover : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 17px;
                height: 17px;
                if root.icon != "": DuoIcon {
                    name: root.icon;
                    size: 17px;
                    color: P.accent;
                }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: P.text;
            font-size: 14px;
            vertical-alignment: center;
        }
        Text {
            text: root.keys;
            color: P.faint;
            font-family: P.mono;
            font-size: 11px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

component ListColumn inherits Rectangle {
    in-out property <BroadsheetView> view;
    width: max(240px, min(560px, AppState.broadsheet-list-width));
    background: P.bg;

    // A chat's menu, from a right click on it: the chat header's menu, for any chat in the lists.
    // Its second page, Add to folder: the account's folders, those the chat is in ticked.
    property <ChatRow> menu-chat;
    property <int> menu-folder;             // where Chats.toggle-pin pins it
    property <bool> menu-folders;           // the second page is showing
    property <length> menu-x;
    property <length> menu-y;

    function show-menu(chat: ChatRow, folder: int, left: length, top: length) {
        root.menu-chat = chat;
        root.menu-folder = folder;
        root.menu-folders = false;
        Chats.open-menu(chat.id);
        root.menu-x = max(0px, left - root.absolute-position.x);
        // Within the list, whichever of the two pages is the taller.
        root.menu-y = max(0px, min(top - root.absolute-position.y, root.height - 44px - 34px * max((Chats.folders.length > 1 ? 4 : 3) + 4, Chats.menu-folders.length + 1)));
        chat-menu.show();
    }

    public function focus-search() {
        search.focus-search();
    }

    VerticalLayout {
        VerticalLayout {
            vertical-stretch: 0;
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 20px;
            padding-bottom: 10px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: root.view == BroadsheetView.channels ? @tr("Channels")
                        : root.view == BroadsheetView.bots ? @tr("Bots") : Account.name;
                    color: P.text;
                    font-size: 28px;
                    font-weight: 600;
                    line-height-factor: P.leading(1.2);
                    overflow: elide;
                }
                VerticalLayout {
                    alignment: center;
                    if root.view == BroadsheetView.chats: DuoIcon {
                        // Writing to someone new is still to come.
                        name: "note-pencil";
                        size: 20px;
                        color: P.accent;
                        opacity: 0.4;
                    }
                    if root.view != BroadsheetView.chats: DuoIcon {
                        name: "x";
                        size: 18px;
                        color: P.muted;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.view = BroadsheetView.chats;
                            }
                        }
                    }
                }
            }
            Text {
                text: root.view == BroadsheetView.bots ? @tr("Telegram bots") : Account.phone;
                color: P.accent-ink;
                font-size: 13px;
            }
            // The design's margins: 8px above the views and the search box, 12px above the tabs.
            VerticalLayout {
                padding-top: 8px;
                Views {
                    view <=> root.view;
                }
            }
            VerticalLayout {
                padding-top: root.view == BroadsheetView.chats ? 8px : 0px;
                search := SearchField {
                    visible: root.view == BroadsheetView.chats;
                    height: root.view == BroadsheetView.chats ? 34px : 0px;
                }
            }
            if root.view == BroadsheetView.chats: VerticalLayout {
                padding-top: 12px;
                Folders { }
            }
        }

        if AppState.connection != Connection.ready && AppState.connection != Connection.updating: HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 8px;
            Rectangle {
                height: 36px;
                border-radius: 4px;
                background: P.surface;
                HorizontalLayout {
                    padding-left: 12px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        DuoIcon {
                            name: AppState.connection == Connection.waiting-for-network ? "wifi-slash" : "circle-notch";
                            size: 16px;
                            color: P.accent2-ink;
                        }
                    }
                    Text {
                        text: Fmt.connection(AppState.connection);
                        color: P.accent2-ink;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if root.view == BroadsheetView.chats && Chats.loaded && Chats.list.length == 0: VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 28px;
            spacing: 8px;
            Text {
                text: Chats.folder == 0 ? @tr("No chats yet") : @tr("No chats in this folder");
                color: P.text;
                font-size: 18px;
                font-weight: 600;
            }
            Paragraph {
                text: Chats.folder == 0 ? @tr("Search for a username or phone number, or open an invite link someone sent you, to start chatting.")
                    : @tr("Chats you add to this folder in Telegram show up here.");
                color: P.muted;
                font-size: 14px;
                line-height-factor: P.leading(1.55);
            }
        }

        if root.view == BroadsheetView.chats: ListView {
            vertical-stretch: 1;
            vertical-scrollbar-policy: always-off;
            horizontal-scrollbar-policy: always-off;
            for chat in Chats.list: ChatLine {
                chat: chat;
                menu(left, top) => {
                    root.show-menu(chat, Chats.folder, left, top);
                }
            }
        }
        if root.view == BroadsheetView.channels: ListView {
            vertical-stretch: 1;
            vertical-scrollbar-policy: always-off;
            horizontal-scrollbar-policy: always-off;
            for chat in Chats.channels: ChannelLine {
                chat: chat;
                menu(left, top) => {
                    root.show-menu(chat, 0, left, top);
                }
            }
        }
        if root.view == BroadsheetView.bots: Flickable {
            vertical-stretch: 1;
            mouse-drag-pan-enabled: false;
            VerticalLayout {
                alignment: start;
                if Chats.official-bots.length > 0: HorizontalLayout {
                    padding-left: 20px;
                    padding-top: 12px;
                    padding-bottom: 4px;
                    SectionTitle {
                        text: @tr("Official bots");
                    }
                }
                for chat in Chats.official-bots: BotLine {
                    chat: chat;
                    menu(left, top) => {
                        root.show-menu(chat, 0, left, top);
                    }
                }
                if Chats.bots.length > 0: HorizontalLayout {
                    padding-left: 20px;
                    padding-top: 12px;
                    padding-bottom: 4px;
                    SectionTitle {
                        text: @tr("Other bots");
                    }
                }
                for chat in Chats.bots: BotLine {
                    chat: chat;
                    menu(left, top) => {
                        root.show-menu(chat, 0, left, top);
                    }
                }
                HorizontalLayout {
                    padding: 20px;
                    Paragraph {
                        text: @tr("Bots with a check mark are Telegram's own. Other bots see what you send them.");
                        color: P.faint;
                        font-size: 12px;
                    }
                }
            }
        }
    }

    ListEdge {
        x: parent.width - self.width;
        height: parent.height;
        list-width <=> AppState.broadsheet-list-width;
        narrowest: 240px;
        widest: 560px;
        dropped(width) => {
            AppState.change-list-width(Theme.broadsheet, width);
        }
    }

    chat-menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 230px;
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            border-radius: 4px;
            background: P.panel;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: P.shadow;
            VerticalLayout {
                padding: 6px;
                Text {
                    height: 26px;
                    x: 10px;
                    text: root.menu-chat.title;
                    color: P.faint;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if !root.menu-folders: MenuEntry {
                    icon: root.menu-chat.muted ? "bell" : "bell-slash";
                    label: root.menu-chat.muted ? @tr("Unmute") : @tr("Mute");
                    activated => {
                        Chats.toggle-mute(root.menu-chat.id);
                        chat-menu.close();
                    }
                }
                if !root.menu-folders: MenuEntry {
                    icon: "push-pin";
                    label: root.menu-chat.pinned ? @tr("Unpin") : @tr("Pin");
                    activated => {
                        Chats.toggle-pin(root.menu-chat.id, root.menu-folder);
                        chat-menu.close();
                    }
                }
                if !root.menu-folders: MenuEntry {
                    icon: "checks";
                    label: @tr("Mark as read");
                    activated => {
                        Chats.mark-read(root.menu-chat.id);
                        chat-menu.close();
                    }
                }
                if !root.menu-folders && Chats.folders.length > 1: MenuEntry {
                    icon: "folders";
                    label: @tr("Add to folder");
                    activated => {
                        root.menu-folders = true;
                    }
                }
                // Telegram's own actions on the chat (chats.rs); the ones that cannot be undone ask first.
                if !root.menu-folders && root.menu-chat.kind != ChatKind.saved: Rectangle {
                    height: 9px;
                    Rectangle {
                        height: 1px;
                        background: P.line;
                    }
                }
                if !root.menu-folders && (root.menu-chat.kind == ChatKind.user || root.menu-chat.kind == ChatKind.bot): MenuEntry {
                    icon: "prohibit";
                    label: ChatMenuWords.block(root.menu-chat.kind, root.menu-chat.blocked);
                    activated => {
                        Chats.toggle-block(root.menu-chat.id);
                        chat-menu.close();
                    }
                }
                if !root.menu-folders && root.menu-chat.reportable: MenuEntry {
                    icon: "flag";
                    label: ChatMenuWords.report();
                    activated => {
                        Chats.report(root.menu-chat.id);
                        chat-menu.close();
                    }
                }
                if !root.menu-folders && (root.menu-chat.kind == ChatKind.group || root.menu-chat.kind == ChatKind.channel): MenuEntry {
                    icon: "sign-out";
                    label: ChatMenuWords.leave(root.menu-chat.kind);
                    activated => {
                        Chats.leave(root.menu-chat.id);
                        chat-menu.close();
                    }
                }
                if !root.menu-folders && root.menu-chat.deletable && (root.menu-chat.kind == ChatKind.user || root.menu-chat.kind == ChatKind.bot): MenuEntry {
                    icon: "trash";
                    label: ChatMenuWords.delete();
                    activated => {
                        Chats.delete-chat(root.menu-chat.id);
                        chat-menu.close();
                    }
                }
                if root.menu-folders: MenuEntry {
                    icon: "caret-left";
                    label: @tr("Back");
                    activated => {
                        root.menu-folders = false;
                    }
                }
                if root.menu-folders: VerticalLayout {
                    for choice in Chats.menu-folders: MenuEntry {
                        icon: choice.inside ? "check" : "";
                        label: choice.name;
                        activated => {
                            Chats.toggle-in-folder(root.menu-chat.id, choice.folder);
                            chat-menu.close();
                        }
                    }
                }
            }
        }
    }
}

// A link's preview under a message, as the design's card: the site, the page's title, a line about
// it, and Instant View when Telegram has the page in its reading mode (greyed: not in FinchGram
// yet). A click opens the link.
component PreviewCard inherits Rectangle {
    in property <LinkPreview> preview;
    border-radius: 4px;
    background: touch.has-hover ? P.hover : P.surface;
    height: card.preferred-height;

    card := HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.preview.site;
                color: P.faint;
                font-size: 12px;
                overflow: elide;
            }
            Text {
                text: root.preview.title;
                color: P.text;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
            }
            if root.preview.about != "": Text {
                text: root.preview.about;
                color: P.muted;
                font-size: 12px;
                overflow: elide;
            }
        }
        if root.preview.instant-view: VerticalLayout {
            alignment: center;
            Rectangle {
                width: pill.preferred-width + 20px;
                height: pill.preferred-height + 8px;
                border-radius: 2px;
                background: P.tint;
                opacity: 0.5;
                pill := HorizontalLayout {
                    alignment: center;
                    spacing: 4px;
                    VerticalLayout {
                        alignment: center;
                        DuoIcon {
                            name: "lightning";
                            size: 12px;
                            color: P.tint-ink;
                        }
                    }
                    Text {
                        text: @tr("Instant View");
                        color: P.tint-ink;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Conversation.open-link(root.preview.url);
        }
    }
}

// Who first wrote a forwarded message.
component ForwardedFrom inherits HorizontalLayout {
    in property <string> name;
    spacing: 5px;
    VerticalLayout {
        alignment: center;
        DuoIcon {
            name: "arrow-bend-up-right";
            size: 14px;
            color: P.accent-ink;
        }
    }
    Text {
        text: @tr("Forwarded from {0}", root.name);
        color: P.accent-ink;
        font-size: 13px;
        font-italic: true;
        overflow: elide;
    }
}

// The message a reply answers, inside the reply's bubble: who wrote it and its first line; a click
// goes to it.
component ReplyQuoteBox inherits Rectangle {
    in property <ReplyQuote> quote;
    property <bool> reachable: !quote.gone && quote.id != "";
    height: quote-row.preferred-height;
    border-radius: 2px;
    background: #80787824;

    quote-row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 8px;
        if root.quote.has-picture: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 2px;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.quote.picture;
                    image-fit: cover;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            if root.quote.sender != "": Text {
                text: root.quote.sender;
                color: P.accent-ink;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: ActionWords.quote-line(root.quote);
                color: root.quote.gone ? P.faint : P.muted;
                font-italic: root.quote.gone;
                font-size: 14px;
                overflow: elide;
            }
        }
    }

    TouchArea {
        mouse-cursor: root.reachable ? pointer : default;
        clicked => {
            if root.reachable {
                Actions.jump(root.quote.id);
            }
        }
    }
}

// The square in front of a message while messages are being chosen; ticked when it is chosen.
component Choice inherits Rectangle {
    in property <bool> on;
    width: 20px;
    height: 20px;
    border-radius: 2px;
    background: on ? P.accent : transparent;
    border-width: on ? 0 : 1.5px;
    border-color: P.faint;

    if root.on: Icon {
        name: "check";
        size: 13px;
        color: P.on-accent;
        duotone: false;
    }
}

// A message as a bubble: theirs on the left, ours on the right in the account's tint. A sticker
// has no bubble behind it.
component Bubble {
    in property <MessageRow> message;
    property <bool> mine: message.outgoing;
    property <bool> has-tiles: message.media.length > 0;
    property <bool> has-media: has-tiles || message.files.length > 0;
    property <bool> has-sticker: message.content == Content.sticker && message.sticker.width > 0;
    height: bubble.height;

    bubble := Rectangle {
        width: min(content.preferred-width, root.width * 0.72);
        height: content.preferred-height;
        x: root.mine ? root.width - self.width : 0;
        border-radius: 4px;
        background: root.has-sticker ? transparent : root.mine ? P.tint : P.theirs;
        // The message jumped to, or with its menu open: ringed in the accent.
        border-width: Actions.flash == root.message.id || Actions.menu-row == root.message.id ? 2px : 0;
        border-color: P.accent;

        content := VerticalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 4px;
            if !root.mine && Conversation.kind == ChatKind.group: Text {
                text: root.message.sender;
                color: P.accent-ink;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }
            if root.message.forwarded-from != "": ForwardedFrom {
                name: root.message.forwarded-from;
            }
            if root.message.reply.shown: ReplyQuoteBox {
                quote: root.message.reply;
            }
            if root.has-tiles: HorizontalLayout {
                alignment: start;
                padding-top: 2px;
                padding-bottom: 2px;
                MediaTiles {
                    media: root.message.media;
                    width-limit: 380px;
                    radius: 2px;
                    gap: 3px;
                    play-size: 46px;
                    play-icon-size: 22px;
                    inset: 6px;
                    badge-radius: 2px;
                    badge-font-size: 12px;
                    duotone: true;
                    mono-font: P.mono;
                    failed: root.message.failed;
                    open(id) => {
                        Viewer.view(id, true);
                    }
                    cancel(id) => {
                        Conversation.cancel-upload(id);
                    }
                }
            }
            for file in root.message.files: HorizontalLayout {
                alignment: start;
                padding-top: 2px;
                padding-bottom: 2px;
                FileCardView {
                    file: file;
                    radius: 4px;
                    inner-radius: 2px;
                    padding-x: 10px;
                    padding-y: 8px;
                    name-size: 15px;
                    font-family: P.font;
                    text: P.text;
                    muted: P.muted;
                    line: P.line;
                    hover: P.hover;
                    accent: P.accent;
                    accent-ink: P.accent-ink;
                    on-accent: P.on-accent;
                    soft: P.tint;
                    track: P.track;
                    pdf: P.file-pdf;
                    zip: P.file-zip;
                    picture: P.file-image;
                    duotone: true;
                }
            }
            if root.has-sticker: HorizontalLayout {
                alignment: start;
                StickerPicture {
                    message-id: root.message.id;
                    sticker: root.message.sticker;
                }
            }
            if root.message.rich && !root.has-sticker: RichText {
                text: root.message.rich-text;
                default-color: root.mine ? P.tint-ink : P.text;
                default-font-size: 16px;
                link-color: P.accent-ink;
            }
            if !root.message.rich && !root.has-sticker && (!root.has-media || root.message.text != ""): Paragraph {
                text: root.has-media ? root.message.text : Fmt.body(root.message.content, root.message.text, root.message.detail);
                color: root.mine ? P.tint-ink : root.has-media || root.message.content == Content.text ? P.text : P.muted;
                font-size: 16px;
                line-height-factor: P.leading(1.45);
            }
            if root.message.preview.url != "": VerticalLayout {
                padding-top: 4px;
                PreviewCard {
                    preview: root.message.preview;
                }
            }
            // Not sent: say so, with Retry and Delete (the design's sixth round).
            if root.message.failed: HorizontalLayout {
                alignment: start;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 4px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: "warning-circle";
                            size: 14px;
                            color: P.danger;
                            duotone: false;
                        }
                    }
                    Text {
                        text: AttachWords.not-sent();
                        color: P.danger;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: retry.preferred-width;
                    retry := Text {
                        text: AttachWords.retry();
                        color: P.accent-ink;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Conversation.retry(root.message.id);
                        }
                    }
                }
                Rectangle {
                    width: discard.preferred-width;
                    discard := Text {
                        text: AttachWords.delete();
                        color: P.danger;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Conversation.discard(root.message.id);
                        }
                    }
                }
            }
            HorizontalLayout {
                alignment: root.mine ? end : start;
                spacing: 4px;
                Text {
                    text: root.message.edited ? @tr("edited") + " " + root.message.time : root.message.time;
                    color: root.mine ? P.accent-ink : P.faint;
                    font-size: 12px;
                }
                if root.mine: VerticalLayout {
                    alignment: center;
                    DuoIcon {
                        name: root.message.sending ? "clock" : root.message.seen ? "checks" : "check";
                        size: 13px;
                        color: P.accent-ink;
                    }
                }
            }
        }
    }
}

component Post inherits Capped {
    in property <MessageRow> message;
    property <bool> has-tiles: message.media.length > 0;
    property <bool> has-media: has-tiles || message.files.length > 0;
    property <bool> has-sticker: message.content == Content.sticker && message.sticker.width > 0;
    spacing: 6px;

    Rectangle { height: 6px; }
    if root.message.forwarded-from != "": ForwardedFrom {
        name: root.message.forwarded-from;
    }
    if root.message.reply.shown: ReplyQuoteBox {
        quote: root.message.reply;
    }
    if root.has-tiles: HorizontalLayout {
        alignment: start;
        padding-bottom: 4px;
        MediaTiles {
            media: root.message.media;
            width-limit: 520px;
            radius: 2px;
            gap: 3px;
            play-size: 50px;
            play-icon-size: 24px;
            badge-radius: 2px;
            badge-font-size: 12px;
            duotone: true;
            mono-font: P.mono;
            failed: root.message.failed;
            open(id) => {
                Viewer.view(id, true);
            }
            cancel(id) => {
                Conversation.cancel-upload(id);
            }
        }
    }
    for file in root.message.files: HorizontalLayout {
        alignment: start;
        padding-bottom: 4px;
        FileCardView {
                    file: file;
                    radius: 4px;
                    inner-radius: 2px;
                    padding-x: 10px;
                    padding-y: 8px;
                    name-size: 15px;
                    font-family: P.font;
                    text: P.text;
                    muted: P.muted;
                    line: P.line;
                    hover: P.hover;
                    accent: P.accent;
                    accent-ink: P.accent-ink;
                    on-accent: P.on-accent;
                    soft: P.tint;
                    track: P.track;
                    pdf: P.file-pdf;
                    zip: P.file-zip;
                    picture: P.file-image;
                    duotone: true;
                }
    }
    if root.has-sticker: HorizontalLayout {
        alignment: start;
        padding-bottom: 4px;
        StickerPicture {
            message-id: root.message.id;
            sticker: root.message.sticker;
        }
    }
    if root.message.rich && !root.has-sticker: RichText {
        text: root.message.rich-text;
        default-color: P.text;
        default-font-size: 16px;
        link-color: P.accent-ink;
    }
    if !root.message.rich && !root.has-sticker && (!root.has-media || root.message.text != ""): Paragraph {
        text: root.has-media ? root.message.text : Fmt.body(root.message.content, root.message.text, root.message.detail);
        color: P.text;
        font-size: 16px;
        line-height-factor: P.leading(1.6);
    }
    if root.message.preview.url != "": VerticalLayout {
        padding-top: 4px;
        PreviewCard {
            preview: root.message.preview;
        }
    }
    Text {
        text: root.message.edited ? @tr("edited") + " " + root.message.time : root.message.time;
        color: P.faint;
        font-size: 12px;
    }
    Rectangle { height: 4px; }
}

component Sponsored inherits Rectangle {
    in property <MessageRow> message;
    height: card.preferred-height;
    border-radius: 4px;
    background: P.surface;

    card := VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 4px;
        Text {
            text: @tr("Sponsored · placed by Telegram · Premium users can turn these off");
            color: P.faint;
            font-size: 12px;
            overflow: elide;
        }
        Text {
            text: root.message.sender;
            color: P.text;
            font-size: 15px;
            font-weight: 600;
        }
        Paragraph {
            text: root.message.text;
            color: P.muted;
            font-size: 14px;
        }
        if root.message.button != "": HorizontalLayout {
            alignment: start;
            padding-top: 4px;
            Rectangle {
                height: 28px;
                width: action.preferred-width + 20px;
                border-radius: 2px;
                background: P.tint;
                action := Text {
                    text: root.message.button;
                    color: P.tint-ink;
                    font-size: 13px;
                    font-weight: 600;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Conversation.open-sponsored(root.message.id);
                    }
                }
            }
        }
    }
}

component Line {
    in property <MessageRow> message;
    // Conversation.reveal names this row: the list scrolls to it.
    callback reveal(length, length);
    property <bool> wanted: message.id != "" && Conversation.reveal == message.id;
    changed wanted => {
        if self.wanted {
            root.reveal(root.y, root.y + root.height);
        }
    }

    // A message's row has 3px above and below it, chosen it is lit (the design's 1a); the other
    // rows have as much room.
    VerticalLayout {
        padding-top: root.message.kind == RowKind.message ? 0 : 3px;
        padding-bottom: root.message.kind == RowKind.message ? 0 : 3px;
        if root.message.kind == RowKind.day: Text {
            height: 30px;
            text: Fmt.day-title(root.message.day);
            color: P.faint;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: bottom;
        }
        if root.message.kind == RowKind.service: Paragraph {
            text: Fmt.service(root.message.content, root.message.outgoing ? @tr("You") : root.message.sender, root.message.detail);
            color: P.faint;
            font-size: 13px;
            horizontal-alignment: center;
        }
        if root.message.kind == RowKind.sponsored: Capped {
            Sponsored {
                message: root.message;
            }
        }
        if root.message.kind == RowKind.message: Rectangle {
            height: body.preferred-height + 6px;
            area := MessageArea {
                message: root.message;
                Rectangle {
                    x: -8px;
                    width: parent.width + 16px;
                    border-radius: 2px;
                    background: root.message.selected ? P.sel : transparent;
                    animate background { duration: 250ms; }
                }
                body := HorizontalLayout {
                    y: 3px;
                    height: self.preferred-height;
                    spacing: 12px;
                    if Actions.selecting: VerticalLayout {
                        alignment: center;
                        Choice {
                            on: root.message.selected;
                        }
                    }
                    if Conversation.kind == ChatKind.channel: Post {
                        message: root.message;
                    }
                    if Conversation.kind != ChatKind.channel: Bubble {
                        message: root.message;
                    }
                }
            }
        }
    }
}

// The strip above the composer: replying to a message, editing ours, forwarding messages here.
component ComposeStrip inherits Rectangle {
    height: strip.preferred-height;
    border-radius: 4px;
    background: P.panel;
    border-width: 1px;
    border-color: #80787833;

    strip := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            DuoIcon {
                name: Actions.bar == ComposeBar.reply ? "arrow-bend-up-left" : Actions.bar == ComposeBar.edit ? "pencil-simple" : "arrow-bend-up-right";
                size: 20px;
                color: P.accent;
            }
        }
        if Actions.bar-has-picture: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 2px;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: Actions.bar-picture;
                    image-fit: cover;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: ActionWords.bar-title();
                color: P.accent-ink;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: ActionWords.bar-line();
                color: P.muted;
                font-size: 14px;
                overflow: elide;
            }
        }
        if Actions.bar == ComposeBar.forward: Rectangle {
            width: hide.preferred-width;
            hide := HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    DuoIcon {
                        name: Actions.hide-sender ? "check-square" : "square";
                        size: 18px;
                        color: Actions.hide-sender ? P.accent : P.faint;
                    }
                }
                Text {
                    text: @tr("Hide sender's name");
                    color: P.muted;
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Actions.hide-sender = !Actions.hide-sender;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 24px;
                height: 24px;
                Icon {
                    name: "x";
                    size: 16px;
                    color: P.faint;
                    duotone: false;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Actions.cancel-bar();
                    }
                }
            }
        }
    }
}

// What to do with the messages chosen, in place of the composer (the design's 1a): faded where
// they do not all allow it.
component BarAction inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> danger;
    callback activated();
    width: action.preferred-width;
    opacity: root.enabled ? 1 : 0.4;

    action := HorizontalLayout {
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            DuoIcon {
                name: root.icon;
                size: 19px;
                color: root.danger ? P.accent2-ink : P.accent;
            }
        }
        Text {
            text: root.label;
            color: root.danger ? P.accent2-ink : P.text;
            font-size: 15px;
            vertical-alignment: center;
        }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

component SelectionBar inherits Rectangle {
    height: bar.preferred-height;

    Rectangle {
        y: 0;
        height: 1px;
        background: #80787838;
    }

    KeyScope {
        width: 0;
        height: 0;
        escape => {
            Actions.cancel-selection();
        }
    }

    bar := HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 16px;
        padding-bottom: 20px;
        spacing: 18px;
        Text {
            text: ActionWords.selected();
            color: P.text;
            font-size: 17px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: @tr("Shift-click to select a range");
            color: P.faint;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
        BarAction {
            icon: "arrow-bend-up-right";
            label: @tr("Forward");
            enabled: Actions.can-forward;
            activated => {
                Actions.forward-selected();
            }
        }
        BarAction {
            icon: "copy";
            label: ActionWords.copy();
            enabled: Actions.can-copy;
            activated => {
                Actions.copy-selected();
            }
        }
        BarAction {
            icon: "trash";
            label: @tr("Delete");
            enabled: Actions.can-delete;
            danger: true;
            activated => {
                Actions.delete-selected();
            }
        }
        if Actions.report-offered: BarAction {
            icon: "flag";
            label: @tr("Report");
            enabled: Actions.can-report;
            activated => {
                Actions.report-selected();
            }
        }
        Rectangle {
            width: cancel.preferred-width;
            cancel := Text {
                text: @tr("Cancel");
                color: P.accent-ink;
                font-size: 15px;
                font-weight: 600;
                vertical-alignment: center;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Actions.cancel-selection();
                }
            }
        }
    }
}

component ConversationPane inherits Rectangle {
    background: P.panel;

    if Conversation.chat-id == "": Text {
        text: @tr("Choose a chat on the left");
        color: P.faint;
        font-size: 15px;
    }

    if Conversation.chat-id != "": VerticalLayout {
        HorizontalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 16px;
            padding-bottom: 12px;
            spacing: 14px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: Conversation.title;
                    color: P.text;
                    font-size: 20px;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: Conversation.typing != "" ? @tr("typing…")
                        : Fmt.status(Conversation.status, Conversation.last-seen, Conversation.members, Conversation.online-members);
                    color: Conversation.typing != "" || Conversation.status == Status.online ? P.accent-ink : P.faint;
                    font-italic: Conversation.typing != "";
                    font-size: 13px;
                    overflow: elide;
                }
            }
            // Searching, calls and the chat's settings panel are still to come.
            for name in ["magnifying-glass", "phone", "sidebar-simple"]: VerticalLayout {
                alignment: center;
                DuoIcon {
                    name: name;
                    size: 20px;
                    color: P.muted;
                    opacity: 0.4;
                }
            }
            VerticalLayout {
                alignment: center;
                more := DuoIcon {
                    name: "dots-three";
                    size: 22px;
                    color: P.muted;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            menu.show();
                        }
                    }
                }
            }
        }

        scroll := ChatScroll {
            vertical-stretch: 1;
            // 10px between messages, less their rows' room (Line).
            spacing: 4px;
            margin-left: 24px;
            margin-right: 24px;
            margin-top: 4px;
            margin-bottom: 16px;
            for row in Conversation.messages: Line {
                message: row;
                reveal(top, bottom) => {
                    scroll.reveal(top, bottom);
                }
            }
            if Conversation.typing != "": Text {
                text: @tr("{0} is typing…", Conversation.typing);
                color: P.faint;
                font-size: 13px;
            }
        }

        if Conversation.can-write && !Actions.selecting: VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 8px;
            padding-bottom: 20px;
            spacing: 10px;
            // A reply or an edit begins, a menu or dialog closed: the keyboard comes back here.
            property <int> focus-requests: Actions.focus-requests;
            changed focus-requests => {
                input.focus-text();
            }
            init => {
                input.focus-text();
            }
            HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 2px;
                        background: P.accent;
                    }
                }
                Text {
                    text: @tr("Sending as {0}", Account.name);
                    color: P.accent-ink;
                    font-size: 12px;
                }
            }
            if Actions.bar != ComposeBar.none: ComposeStrip { }
            HorizontalLayout {
                spacing: 10px;
                alignment: stretch;
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 4px;
                    background: P.surface;
                    height: input.height;
                    input := MessageInput {
                        text <=> Conversation.draft;
                        allow-empty: Actions.bar == ComposeBar.forward;
                        placeholder: @tr("Write a message…");
                        text-color: P.text;
                        placeholder-color: P.faint;
                        selection-color: P.tint;
                        font-family: P.font;
                        font-size: 16px;
                        padding-x: 14px;
                        padding-y: 9px;
                        base-height: 40px;
                        send(words) => {
                            Conversation.send(words);
                        }
                        edited(words) => {
                            Conversation.edited(words);
                        }
                    }
                }
                // The paperclip: photos, videos and files (attachments.slint); scheduling is still
                // to come.
                VerticalLayout {
                    alignment: end;
                    padding-bottom: 2px;
                    clip := Rectangle {
                        property <bool> allowed: Conversation.can-send-photos || Conversation.can-send-videos || Conversation.can-send-files;
                        width: 36px;
                        height: 36px;
                        border-radius: 2px;
                        background: Attachments.menu-open || (clip-touch.has-hover && self.allowed) ? P.hover : transparent;
                        DuoIcon {
                            name: "paperclip";
                            size: 22px;
                            color: Attachments.menu-open ? P.accent : clip-touch.has-hover && clip.allowed ? P.text : P.muted;
                            opacity: clip.allowed ? 1 : 0.4;
                        }
                        clip-touch := TouchArea {
                            mouse-cursor: clip.allowed ? pointer : not-allowed;
                            clicked => {
                                if clip.allowed {
                                    Attachments.menu-x = self.absolute-position.x;
                                    Attachments.menu-y = self.absolute-position.y;
                                    Attachments.menu-focus = -1;
                                    Attachments.menu-keyboard = false;
                                    Attachments.menu-open = !Attachments.menu-open;
                                }
                            }
                        }
                        if clip-touch.has-hover && !Attachments.menu-open: Rectangle {
                            x: parent.width - self.width;
                            y: -self.height - 8px;
                            width: tip.preferred-width + 20px;
                            height: tip.preferred-height + 12px;
                            border-radius: 2px;
                            background: P.text;
                            drop-shadow-blur: 20px;
                            drop-shadow-offset-y: 6px;
                            drop-shadow-color: #00000033;
                            tip := Text {
                                text: clip.allowed ? AttachWords.attach() : AttachWords.cant-send();
                                color: P.bg;
                                font-size: 12px;
                            }
                        }
                    }
                }
                // The scissors: a screenshot into the card (src/screenshot/), as its shortcut
                // does; greyed where the chat takes no photos.
                VerticalLayout {
                    alignment: end;
                    padding-bottom: 2px;
                    scissors := Rectangle {
                        property <bool> allowed: Conversation.can-send-photos;
                        width: 36px;
                        height: 36px;
                        border-radius: 2px;
                        background: scissors-touch.has-hover && self.allowed ? P.hover : transparent;
                        DuoIcon {
                            name: "scissors";
                            size: 22px;
                            transform-rotation: -90deg;
                            color: scissors-touch.has-hover && scissors.allowed ? P.text : P.muted;
                            opacity: scissors.allowed ? 1 : 0.4;
                        }
                        scissors-touch := TouchArea {
                            mouse-cursor: scissors.allowed ? pointer : not-allowed;
                            clicked => {
                                if scissors.allowed {
                                    Screenshot.start();
                                }
                            }
                        }
                        if scissors-touch.has-hover: Rectangle {
                            x: parent.width - self.width;
                            y: -self.height - 8px;
                            width: scissors-tip.preferred-width;
                            height: scissors-tip.preferred-height;
                            border-radius: 2px;
                            background: P.text;
                            drop-shadow-blur: 20px;
                            drop-shadow-offset-y: 6px;
                            drop-shadow-color: #00000033;
                            scissors-tip := HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 8px;
                                Text {
                                    text: scissors.allowed ? AttachWords.screenshot() : AttachWords.screenshot-off();
                                    color: P.bg;
                                    font-size: 12px;
                                }
                                if scissors.allowed: Text {
                                    text: Screenshot.shortcut-label;
                                    color: P.bg;
                                    font-size: 12px;
                                    opacity: 0.7;
                                }
                            }
                        }
                    }
                }
                VerticalLayout {
                    alignment: end;
                    padding-bottom: 9px;
                    DuoIcon {
                        name: "clock";
                        size: 22px;
                        color: P.muted;
                        opacity: 0.4;
                    }
                }
                VerticalLayout {
                    alignment: end;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 2px;
                        background: send.has-hover ? P.accent.darker(0.1) : P.accent;
                        DuoIcon {
                            name: Actions.bar == ComposeBar.edit ? "check" : "paper-plane-tilt";
                            size: 20px;
                            color: P.on-accent;
                        }
                        send := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                input.send-now();
                            }
                        }
                    }
                }
            }
        }

        if Actions.selecting: SelectionBar { }

        // A channel one only reads: muting it, in place of the composer.
        if Conversation.kind == ChatKind.channel && !Conversation.can-write && !Actions.selecting: HorizontalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 10px;
            padding-bottom: 20px;
            Rectangle {
                height: 42px;
                border-radius: 4px;
                background: P.surface;
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        DuoIcon {
                            name: "bell-simple-slash";
                            size: 19px;
                            color: P.accent-ink;
                        }
                    }
                    Text {
                        text: Conversation.muted ? @tr("Unmute") : @tr("Mute");
                        color: P.accent-ink;
                        font-size: 16px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Conversation.toggle-mute();
                    }
                }
            }
        }
    }

    menu := PopupWindow {
        x: root.width - 254px;
        y: 50px;
        width: 230px;
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            border-radius: 4px;
            background: P.panel;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: P.shadow;
            VerticalLayout {
                padding: 6px;
                Text {
                    height: 26px;
                    x: 10px;
                    text: Conversation.title;
                    color: P.faint;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                MenuEntry {
                    icon: Conversation.muted ? "bell" : "bell-slash";
                    label: Conversation.muted ? @tr("Unmute") : @tr("Mute");
                    keys: "⌘⇧M";
                    activated => {
                        Conversation.toggle-mute();
                        menu.close();
                    }
                }
                MenuEntry {
                    icon: "push-pin";
                    label: Conversation.pinned ? @tr("Unpin") : @tr("Pin");
                    activated => {
                        Conversation.toggle-pin();
                        menu.close();
                    }
                }
                MenuEntry {
                    icon: "checks";
                    label: @tr("Mark as read");
                    keys: "⌘⇧R";
                    activated => {
                        Conversation.mark-read();
                        menu.close();
                    }
                }
            }
        }
    }
}

export component BroadsheetWindow inherits Rectangle {
    property <BroadsheetView> view: BroadsheetView.chats;
    background: P.bg;

    // ⌘K, from the menu bar (app.slint).
    public function focus-search() {
        root.view = BroadsheetView.chats;
        list.focus-search();
    }

    VerticalLayout {
        TitleBar { }
        HorizontalLayout {
            vertical-stretch: 1;
            Rail { }
            list := ListColumn {
                view <=> root.view;
            }
            ConversationPane {
                horizontal-stretch: 1;
            }
        }
    }

    // A message's menu and the dialogs of its actions, over everything.
    BroadsheetActions { }
    BroadsheetAttachments { }
}
