// Broadsheet's message actions over the window (the design's fourth round, 1a): a message's menu,
// where it was right-clicked, and the dialogs for forwarding, reporting and deleting.
import { Actions, MessageAction, ChatRow, ChatKind, Status, DeleteChoice, Moment } from "../telegram.slint";
import { Fmt } from "../format.slint";
import { Icon, Spinner } from "../widgets.slint";
import { ActionWords, MenuPlace, KeyScope, SearchInput, CommentInput } from "../chat.slint";
import { BroadsheetPalette as P } from "palette.slint";

component DuoIcon inherits Icon {
    duotone: true;
}

// What a chat to forward to says under its name: its members, its subscribers, online.
global PickerLine {
    property <Moment> never;
    public pure function of(chat: ChatRow) -> string {
        if chat.kind == ChatKind.group && chat.members > 0 {
            return Fmt.status(Status.members, never, chat.members, 0);
        }
        if chat.kind == ChatKind.channel && chat.members > 0 {
            return Fmt.status(Status.subscribers, never, chat.members, 0);
        }
        return chat.online ? Fmt.status(Status.online, never, 0, 0) : "";
    }
}

// A dialog's box over the darkened window; a click beside it closes it.
component Dialog inherits Rectangle {
    in property <length> box-width;
    in property <length> box-height;
    callback close();
    background: #00000052;

    TouchArea {
        clicked => {
            root.close();
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.box-width;
        height: root.box-height;
        border-radius: 4px;
        background: P.panel;
        drop-shadow-blur: 60px;
        drop-shadow-offset-y: 24px;
        drop-shadow-color: #0000004d;
        clip: true;

        // Clicks inside stay inside.
        TouchArea { }
        @children
    }
}

component CloseButton inherits Rectangle {
    callback clicked();
    width: 22px;
    height: 22px;
    Icon {
        name: "x";
        size: 18px;
        color: P.faint;
        duotone: false;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component ListLine inherits Rectangle {
    callback clicked();
    border-radius: 2px;
    background: touch.has-hover ? P.hover : transparent;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    @children
}

// A word button of a dialog, or its main action, filled.
component DialogButton inherits Rectangle {
    in property <string> label;
    in property <bool> filled;
    in property <color> fill: P.accent;
    in property <bool> enabled: true;
    callback clicked();
    width: words.preferred-width + (root.filled ? 32px : 0);
    height: words.preferred-height + 16px;
    border-radius: 2px;
    background: root.filled ? root.fill : transparent;
    opacity: root.enabled ? 1 : 0.45;
    words := Text {
        text: root.label;
        color: root.filled ? (root.fill == P.accent ? P.on-accent : #ffffff) : P.accent-ink;
        font-size: 15px;
        font-weight: 600;
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component ForwardPicker inherits Dialog {
    box-width: 400px;
    box-height: 540px;
    close => {
        Actions.close-picker();
    }

    VerticalLayout {
        HorizontalLayout {
            padding-left: 22px;
            padding-right: 22px;
            padding-top: 20px;
            padding-bottom: 12px;
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                text: @tr("Choose recipient…");
                color: P.text;
                font-size: 20px;
                font-weight: 600;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                CloseButton {
                    clicked => {
                        Actions.close-picker();
                    }
                }
            }
        }
        HorizontalLayout {
            padding-left: 22px;
            padding-right: 22px;
            padding-bottom: 10px;
            Rectangle {
                height: 36px;
                border-radius: 4px;
                background: P.surface;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        DuoIcon {
                            name: "magnifying-glass";
                            size: 16px;
                            color: P.faint;
                        }
                    }
                    SearchInput {
                        horizontal-stretch: 1;
                        placeholder: @tr("Search");
                        text-color: P.text;
                        placeholder-color: P.faint;
                        selection-color: P.tint;
                        font-family: P.font;
                        font-size: 15px;
                        edited(words) => {
                            Actions.search-picker(words);
                        }
                        accepted => {
                            Actions.pick-first();
                        }
                        escape => {
                            Actions.close-picker();
                        }
                    }
                }
            }
        }
        Flickable {
            vertical-stretch: 1;
            mouse-drag-pan-enabled: false;
            content-width: self.width;
            content-height: chats.preferred-height;
            chats := VerticalLayout {
                width: parent.width;
                alignment: start;
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 4px;
                padding-bottom: 14px;
                if Actions.picker-saved: ListLine {
                    height: 56px;
                    clicked => {
                        Actions.pick("saved");
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: 4px;
                                background: P.accent;
                                DuoIcon {
                                    name: "bookmark-simple";
                                    size: 20px;
                                    color: P.on-accent;
                                }
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: @tr("Saved Messages");
                            color: P.text;
                            font-size: 16px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
                if Actions.picker-chats.length > 0: HorizontalLayout {
                    padding-left: 10px;
                    padding-top: 12px;
                    padding-bottom: 4px;
                    Text {
                        text: @tr("Recent");
                        color: P.faint;
                        font-size: 12px;
                        letter-spacing: 0.24px;
                    }
                }
                for chat in Actions.picker-chats: ListLine {
                    height: 56px;
                    clicked => {
                        Actions.pick(chat.id);
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: 4px;
                                background: P.surface;
                                Text {
                                    text: chat.initial;
                                    color: P.accent-ink;
                                    font-size: 16px;
                                    font-weight: 600;
                                }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 1px;
                            Text {
                                text: chat.title;
                                color: P.text;
                                font-size: 16px;
                                font-weight: 600;
                                overflow: elide;
                            }
                            if PickerLine.of(chat) != "": Text {
                                text: PickerLine.of(chat);
                                color: P.faint;
                                font-size: 13px;
                                overflow: elide;
                            }
                        }
                    }
                }
                if !Actions.picker-saved && Actions.picker-chats.length == 0: HorizontalLayout {
                    padding-left: 10px;
                    padding-top: 16px;
                    padding-bottom: 16px;
                    Text {
                        text: @tr("No chats found");
                        color: P.faint;
                        font-size: 14px;
                    }
                }
            }
        }
    }
}

component ReportDialog inherits Dialog {
    box-width: 420px;
    box-height: min(580px, body.preferred-height);
    close => {
        Actions.close-report();
    }

    if !Actions.report-comment: KeyScope {
        width: 0;
        height: 0;
        escape => {
            Actions.close-report();
        }
    }

    body := VerticalLayout {
        HorizontalLayout {
            padding-left: 22px;
            padding-right: 22px;
            padding-top: 20px;
            padding-bottom: 10px;
            spacing: 10px;
            if !Actions.report-first: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 22px;
                    height: 22px;
                    DuoIcon {
                        name: "arrow-left";
                        size: 20px;
                        color: P.accent;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Actions.report-back();
                        }
                    }
                }
            }
            Text {
                horizontal-stretch: 1;
                text: ActionWords.report-title();
                color: P.text;
                font-size: 20px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
            VerticalLayout {
                alignment: center;
                CloseButton {
                    clicked => {
                        Actions.close-report();
                    }
                }
            }
        }

        if !Actions.report-comment: Flickable {
            height: min(500px, reasons.preferred-height);
            mouse-drag-pan-enabled: false;
            content-width: self.width;
            content-height: reasons.preferred-height;
            reasons := VerticalLayout {
                width: parent.width;
                alignment: start;
                padding-left: 12px;
                padding-right: 12px;
                padding-bottom: 14px;
                if Actions.report-busy && Actions.report-options.length == 0: HorizontalLayout {
                    alignment: center;
                    padding: 16px;
                    Spinner {
                        size: 18px;
                        color: P.faint;
                    }
                }
                for reason[index] in Actions.report-options: ListLine {
                    height: 44px;
                    clicked => {
                        if !Actions.report-busy {
                            Actions.report-choose(index);
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: #80787824;
                    }
                    HorizontalLayout {
                        width: parent.width;
                        height: parent.height;
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            horizontal-stretch: 1;
                            text: reason;
                            color: P.text;
                            font-size: 16px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }

        if Actions.report-comment: VerticalLayout {
            padding-left: 22px;
            padding-right: 22px;
            padding-top: 4px;
            padding-bottom: 20px;
            spacing: 12px;
            Rectangle {
                height: 130px;
                border-radius: 4px;
                background: P.surface;
                comment := CommentInput {
                    placeholder: Actions.report-comment-required ? @tr("Add a comment") : @tr("Add a comment (optional)");
                    text-color: P.text;
                    placeholder-color: P.faint;
                    selection-color: P.tint;
                    font-family: P.font;
                    font-size: 16px;
                    line-height-factor: P.leading(1.45);
                    submit => {
                        if !Actions.report-busy && (!Actions.report-comment-required || self.text != "") {
                            Actions.report-submit(self.text);
                        }
                    }
                    escape => {
                        Actions.close-report();
                    }
                }
            }
            HorizontalLayout {
                spacing: 14px;
                Text {
                    horizontal-stretch: 1;
                    text: comment.text.character-count + " / 1024";
                    color: P.faint;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                DialogButton {
                    label: @tr("Cancel");
                    clicked => {
                        Actions.close-report();
                    }
                }
                DialogButton {
                    label: @tr("Report");
                    filled: true;
                    enabled: !Actions.report-busy && (!Actions.report-comment-required || comment.text != "");
                    clicked => {
                        Actions.report-submit(comment.text);
                    }
                }
            }
        }
    }
}

component DeleteDialog inherits Dialog {
    box-width: 380px;
    box-height: body.preferred-height;
    close => {
        Actions.close-delete();
    }

    KeyScope {
        width: 0;
        height: 0;
        escape => {
            Actions.close-delete();
        }
        enter => {
            Actions.confirm-delete();
        }
    }

    body := VerticalLayout {
        padding-left: 22px;
        padding-right: 22px;
        padding-top: 22px;
        padding-bottom: 18px;
        spacing: 18px;
        Text {
            text: ActionWords.delete-title();
            color: P.text;
            font-size: 20px;
            font-weight: 600;
            wrap: word-wrap;
        }
        if Actions.delete-choice != DeleteChoice.none: Rectangle {
            height: 22px;
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 2px;
                        background: Actions.revoke ? P.accent : transparent;
                        border-width: Actions.revoke ? 0 : 1.5px;
                        border-color: P.faint;
                        if Actions.revoke: Icon {
                            name: "check";
                            size: 13px;
                            color: P.on-accent;
                            duotone: false;
                        }
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: ActionWords.delete-choice();
                    color: P.text;
                    font-size: 16px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Actions.revoke = !Actions.revoke;
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 16px;
            DialogButton {
                label: @tr("Cancel");
                clicked => {
                    Actions.close-delete();
                }
            }
            DialogButton {
                label: @tr("Delete");
                filled: true;
                fill: P.accent2-ink;
                clicked => {
                    Actions.confirm-delete();
                }
            }
        }
    }
}

// An item of a message's menu.
component ActionEntry inherits Rectangle {
    in property <MessageAction> action;
    property <bool> danger: action == MessageAction.delete;
    height: 36px;
    border-radius: 2px;
    background: touch.has-hover ? P.hover : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            DuoIcon {
                name: ActionWords.icon(root.action);
                size: 17px;
                color: root.danger ? P.accent2-ink : P.accent;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: ActionWords.label(root.action);
            color: root.danger ? P.accent2-ink : P.text;
            font-size: 14px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Actions.choose(root.action);
        }
    }
}

export component BroadsheetActions inherits Rectangle {
    // A message's menu, where it was clicked; a click anywhere else closes it.
    if Actions.menu-open: TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                Actions.close-menu();
            }
        }
    }
    if Actions.menu-open: Rectangle {
        x: MenuPlace.x(Actions.menu-x, self.width, root.width);
        y: MenuPlace.y(Actions.menu-y, self.height, root.height);
        width: 220px;
        height: entries.preferred-height;
        border-radius: 4px;
        background: P.panel;
        drop-shadow-blur: 32px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: P.shadow;

        KeyScope {
            width: 0;
            height: 0;
            escape => {
                Actions.close-menu();
            }
        }
        entries := VerticalLayout {
            padding: 6px;
            for item in Actions.menu-items: ActionEntry {
                action: item;
            }
        }
    }

    if Actions.picker-open: ForwardPicker { }
    if Actions.report-open: ReportDialog { }
    if Actions.delete-open: DeleteDialog { }
}
