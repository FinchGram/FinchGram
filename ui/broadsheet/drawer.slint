// The drawer, Broadsheet (the design's sixth round, 1a): a newspaper's section index slid out
// from the rail over the list, 320px wide, under a scrim. A: the accounts; B: the toolbox, each
// tool with a dotted leader to its switch; C: the settings and the profile, pressed at the foot.
// The state and the words are in ui/drawer.slint; src/drawer.rs fills and acts.
import { Drawer, DrawerWords, ToolRow } from "../drawer.slint";
import { AppState, Page } from "../state.slint";
import { Account } from "../telegram.slint";
import { Downloads } from "../downloads.slint";
import { Icon } from "../widgets.slint";
import { BroadsheetPalette as P } from "palette.slint";

component DuoIcon inherits Icon {
    duotone: true;
}

component Letter inherits Text {
    width: 14px;
    color: P.accent-ink;
    font-size: 13px;
    font-weight: 600;
}

// A tool of the toolbox: its icon at the margin (the accent while pinned), its name with what
// goes on, the leader to its switch, and a line about it. The name opens it.
component ToolLine inherits Rectangle {
    in property <ToolRow> tool;
    property <bool> live: !tool.grey;
    property <bool> active: tool.id == "downloads" && Downloads.active-count > 0;
    height: lines.preferred-height;
    opacity: live ? 1 : 0.42;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: P.line;
        opacity: 0.5;
    }
    DuoIcon {
        x: 0;
        y: 6px;
        name: root.tool.icon;
        size: 17px;
        color: root.tool.pinned ? P.accent : P.muted;
    }
    lines := VerticalLayout {
        padding-left: 24px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 1px;
        HorizontalLayout {
            spacing: 6px;
            Rectangle {
                horizontal-stretch: 1;
                height: name.preferred-height;
                HorizontalLayout {
                    spacing: 6px;
                    name := Text {
                        text: root.tool.name;
                        color: open-touch.has-hover && root.live ? P.accent-ink : P.text;
                        font-size: 15px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    if root.active: Text {
                        text: "● " + DrawerWords.downloading(Downloads.active-count);
                        color: P.accent2-ink;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        Rectangle {
                            x: 0;
                            y: parent.height / 2;
                            height: 1px;
                            width: parent.width;
                            background: P.faint;
                            opacity: 0.45;
                        }
                    }
                }
                open-touch := TouchArea {
                    enabled: root.live;
                    mouse-cursor: pointer;
                    clicked => {
                        Drawer.open-tool(root.tool.id);
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 34px;
                    height: 20px;
                    border-radius: 2px;
                    background: root.tool.pinned ? P.accent : P.off;
                    animate background { duration: 200ms; }
                    Rectangle {
                        x: root.tool.pinned ? 17px : 3px;
                        y: 3px;
                        width: 14px;
                        height: 14px;
                        border-radius: 1px;
                        background: #ffffff;
                        animate x { duration: 200ms; }
                    }
                    TouchArea {
                        enabled: root.live;
                        mouse-cursor: pointer;
                        clicked => {
                            Drawer.pin(root.tool.id, !root.tool.pinned);
                        }
                    }
                }
            }
        }
        Text {
            text: root.tool.line;
            color: P.muted;
            font-size: 13px;
            overflow: elide;
        }
    }
}

// A link at the foot: the settings, the AI settings (still to come), the profile.
component FootLink inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> enabled: true;
    callback activated();
    width: line.preferred-width;
    height: line.preferred-height;
    opacity: enabled ? 1 : 0.42;

    line := HorizontalLayout {
        spacing: 5px;
        VerticalLayout {
            alignment: center;
            DuoIcon {
                name: root.icon;
                size: 17px;
                color: P.muted;
            }
        }
        Text {
            text: root.label;
            color: touch.has-hover && root.enabled ? P.accent-ink : P.text;
            font-size: 15px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

export component BroadsheetDrawer inherits Rectangle {
    property <bool> open: Drawer.open;
    visible: Drawer.open || slide.x > -320px;
    changed open => {
        if self.open {
            keys.focus();
        }
    }

    Rectangle {
        background: P.dark ? #00000073 : #1b1f242e;
        opacity: Drawer.open ? 1 : 0;
        animate opacity { duration: 200ms; }
        TouchArea {
            clicked => {
                Drawer.close();
            }
        }
    }

    slide := Rectangle {
        x: Drawer.open ? 0px : -320px;
        y: 0;
        width: 320px;
        height: parent.height;
        background: P.panel;
        drop-shadow-blur: 24px;
        drop-shadow-offset-x: 8px;
        drop-shadow-color: P.shadow;
        animate x { duration: 240ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

        TouchArea { }
        keys := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape {
                    Drawer.close();
                    return accept;
                }
                return reject;
            }
        }

        VerticalLayout {
            // The title over a thick and a thin rule.
            VerticalLayout {
                vertical-stretch: 0;
                padding-left: 22px;
                padding-right: 22px;
                padding-top: 16px;
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        horizontal-stretch: 1;
                        text: DrawerWords.index();
                        color: P.text;
                        font-size: 28px;
                        font-weight: 600;
                    }
                    Text {
                        text: DrawerWords.esc-closes();
                        color: close.has-hover ? P.accent-ink : P.faint;
                        font-size: 12px;
                        vertical-alignment: bottom;
                        close := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                Drawer.close();
                            }
                        }
                    }
                }
                Rectangle { height: 8px; }
                Rectangle { height: 3px; background: P.text; }
                Rectangle { height: 2px; }
                Rectangle { height: 1px; background: P.text; }
            }
            Flickable {
                vertical-stretch: 1;
                content-height: body.preferred-height;
                body := VerticalLayout {
                    width: parent.width;
                    alignment: start;
                    padding-left: 22px;
                    padding-right: 22px;
                    padding-bottom: 10px;
                    // A · the accounts: the one in front, and adding another, still to come.
                    Rectangle {
                        height: a.preferred-height;
                        a := HorizontalLayout {
                            padding-top: 10px;
                            padding-bottom: 5px;
                            spacing: 10px;
                            Letter { text: "A"; vertical-alignment: bottom; }
                            Text {
                                horizontal-stretch: 1;
                                text: DrawerWords.accounts();
                                color: P.text;
                                font-size: 17px;
                                font-weight: 600;
                                vertical-alignment: bottom;
                            }
                            Text {
                                text: "1/10";
                                color: P.faint;
                                font-size: 12px;
                                vertical-alignment: bottom;
                            }
                        }
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: P.line;
                        }
                    }
                    HorizontalLayout {
                        height: 28px;
                        spacing: 6px;
                        Rectangle {
                            width: 24px;
                            Rectangle {
                                x: 0;
                                width: 8px;
                                height: 8px;
                                border-radius: 2px;
                                background: P.accent;
                                border-width: 2px;
                                border-color: P.panel;
                                Rectangle {
                                    x: -3px;
                                    y: -3px;
                                    width: 14px;
                                    height: 14px;
                                    border-radius: 3px;
                                    border-width: 1px;
                                    border-color: P.accent;
                                }
                            }
                        }
                        Text {
                            text: Account.name;
                            color: P.text;
                            font-size: 15px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: Account.phone != "" ? Account.phone : "@" + Account.username;
                            color: P.faint;
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: DrawerWords.current();
                            color: P.accent-ink;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        height: 24px;
                        spacing: 6px;
                        opacity: 0.42;
                        Text {
                            width: 24px;
                            text: "＋";
                            color: P.text;
                            font-size: 15px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: DrawerWords.add-account();
                            color: P.text;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            Rectangle {
                                y: parent.height / 2;
                                height: 1px;
                                width: parent.width;
                                background: P.faint;
                                opacity: 0.45;
                            }
                        }
                        Text {
                            text: DrawerWords.not-yet();
                            color: P.faint;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                    // B · the toolbox.
                    Rectangle {
                        height: b.preferred-height;
                        b := HorizontalLayout {
                            padding-top: 12px;
                            padding-bottom: 4px;
                            spacing: 10px;
                            Letter { text: "B"; vertical-alignment: bottom; }
                            Text {
                                horizontal-stretch: 1;
                                text: DrawerWords.toolbox();
                                color: P.text;
                                font-size: 17px;
                                font-weight: 600;
                                vertical-alignment: bottom;
                            }
                            Text {
                                text: DrawerWords.pin-to-bar();
                                color: P.faint;
                                font-size: 12px;
                                vertical-alignment: bottom;
                            }
                        }
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: P.line;
                        }
                    }
                    for tool in Drawer.tools: ToolLine {
                        tool: tool;
                    }
                }
            }
            // C · the settings, the AI settings (still to come), the profile: at the foot, not
            // scrolling with the rest.
            Rectangle {
                height: foot.preferred-height;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: P.line;
                }
                foot := HorizontalLayout {
                    padding-left: 22px;
                    padding-right: 22px;
                    padding-top: 10px;
                    padding-bottom: 14px;
                    spacing: 14px;
                    Letter { text: "C"; vertical-alignment: center; }
                    FootLink {
                        icon: "gear-six";
                        label: DrawerWords.settings();
                        activated => {
                            Drawer.close();
                            AppState.page = Page.settings;
                        }
                    }
                    FootLink {
                        icon: "sparkle";
                        label: DrawerWords.ai-settings();
                        enabled: false;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    FootLink {
                        icon: "user-circle";
                        label: DrawerWords.profile();
                        activated => {
                            Drawer.close();
                            AppState.page = Page.profile;
                        }
                    }
                }
            }
        }
    }
}
