// Broadsheet's attachments (the design's sixth round, "FinchGram Desktop 发送附件", 1a): the
// paperclip's menu over the composer, the card before sending, and the drop zone over the window.
// The same as Workbench's, in Broadsheet's shapes: duotone icons, small radii, the panel colour.
import { AppState } from "../state.slint";
import {
    Attachments, Attachment, AttachKind, AttachProblem, AttachHint, Conversation, ChatKind, Actions, FileType,
} from "../telegram.slint";
import { Fmt } from "../format.slint";
import { Icon, Switch } from "../widgets.slint";
import { AttachWords, MessageInput } from "../chat.slint";
import { BroadsheetPalette as P } from "palette.slint";

component DuoIcon inherits Icon {
    duotone: true;
}

// A small floating label (the design's tooltip).
export component Tip inherits Rectangle {
    in property <string> text;
    width: words.preferred-width + 20px;
    height: words.preferred-height + 12px;
    border-radius: 2px;
    background: P.text;
    drop-shadow-blur: 20px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: #00000033;
    words := Text {
        text: root.text;
        color: P.bg;
        font-size: 12px;
    }
}

component Badge inherits Rectangle {
    in property <string> text;
    width: words.preferred-width + 10px;
    height: words.preferred-height + 2px;
    border-radius: 3px;
    border-width: 1px;
    border-color: P.line;
    words := Text {
        text: root.text;
        color: P.muted;
        font-size: 10px;
        font-weight: 600;
    }
}

component AttachItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <string> badge;
    in property <bool> focused;
    callback activated();
    height: 34px;
    border-radius: 2px;
    background: root.focused ? P.sel : touch.has-hover && root.enabled ? P.hover : transparent;
    border-width: root.focused ? 1.5px : 0;
    border-color: P.accent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            DuoIcon {
                name: root.icon;
                size: 17px;
                color: P.accent;
                opacity: root.enabled ? 1 : 0.45;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: P.text;
            font-size: 14px;
            vertical-alignment: center;
            opacity: root.enabled ? 1 : 0.45;
        }
        if root.badge != "": VerticalLayout {
            alignment: center;
            Badge { text: root.badge; }
        }
    }
    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : not-allowed;
        clicked => {
            if root.enabled {
                root.activated();
            }
        }
    }
    if touch.has-hover && !root.enabled && root.badge == "": Tip {
        x: -self.width - 10px;
        y: (parent.height - self.height) / 2;
        text: AttachWords.not-allowed();
    }
}

component AttachMenu inherits Rectangle {
    property <bool> group: Conversation.kind == ChatKind.group;
    property <bool> media: Conversation.can-send-photos || Conversation.can-send-videos;
    property <bool> files: Conversation.can-send-files;
    width: 220px;
    height: entries.preferred-height;
    border-radius: 4px;
    background: P.panel;
    drop-shadow-blur: 32px;
    drop-shadow-offset-y: 12px;
    drop-shadow-color: P.shadow;

    function close() {
        Attachments.menu-open = false;
        Attachments.menu-keyboard = false;
        Attachments.menu-focus = -1;
        Actions.focus-requests += 1;
    }
    function pick(kind: AttachKind) {
        root.close();
        Attachments.choose(kind);
    }
    function move(down: bool) {
        Attachments.menu-keyboard = true;
        if Attachments.menu-focus < 0 {
            Attachments.menu-focus = root.media ? 0 : 1;
        } else if down && Attachments.menu-focus == 0 && root.files {
            Attachments.menu-focus = 1;
        } else if !down && Attachments.menu-focus == 1 && root.media {
            Attachments.menu-focus = 0;
        }
    }

    FocusScope {
        width: 0;
        height: 0;
        init => {
            self.focus();
        }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.close();
                return accept;
            }
            if event.text == Key.DownArrow {
                root.move(true);
                return accept;
            }
            if event.text == Key.UpArrow {
                root.move(false);
                return accept;
            }
            if event.text == Key.Return {
                if Attachments.menu-focus == 0 && root.media {
                    root.pick(AttachKind.photo);
                } else if Attachments.menu-focus == 1 && root.files {
                    root.pick(AttachKind.file);
                }
                return accept;
            }
            return reject;
        }
    }

    entries := VerticalLayout {
        padding: 6px;
        AttachItem {
            icon: "image";
            label: AttachWords.photo-or-video();
            enabled: root.media;
            focused: Attachments.menu-focus == 0;
            activated => {
                root.pick(AttachKind.photo);
            }
        }
        AttachItem {
            icon: "file";
            label: AttachWords.file();
            enabled: root.files;
            focused: Attachments.menu-focus == 1;
            activated => {
                root.pick(AttachKind.file);
            }
        }
        if root.group: AttachItem {
            icon: "chart-bar";
            label: AttachWords.poll();
            enabled: false;
            badge: AttachWords.not-available();
        }
        if Attachments.menu-keyboard: Rectangle {
            height: hint.preferred-height + 10px;
            Rectangle {
                x: 4px;
                width: parent.width - 8px;
                height: 1px;
                background: P.line;
            }
            hint := Text {
                x: 10px;
                y: 7px;
                text: AttachWords.menu-keys();
                color: P.faint;
                font-size: 11px;
            }
        }
    }
}

component GridTile inherits Rectangle {
    in property <Attachment> item;
    border-radius: 3px;
    clip: true;
    background: P.surface;
    border-width: root.item.problem != AttachProblem.none ? 2px : 0;
    border-color: P.danger;

    if root.item.has-picture: Image {
        width: parent.width;
        height: parent.height;
        source: root.item.picture;
        image-fit: cover;
    }
    if root.item.kind == AttachKind.video && root.item.duration > 0: Rectangle {
        x: 4px;
        y: parent.height - self.height - 4px;
        width: length.preferred-width + 10px;
        height: length.preferred-height + 2px;
        border-radius: 3px;
        background: #0000008c;
        length := Text {
            text: Fmt.duration(root.item.duration);
            color: #ffffff;
            font-family: P.mono;
            font-size: 10px;
        }
    }
    Rectangle {
        x: parent.width - self.width - 4px;
        y: 4px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: remove-touch.has-hover ? P.danger : #0000008c;
        border-width: remove-touch.has-hover ? 2px : 0;
        border-color: #ffffff;
        Icon {
            name: "x";
            size: 11px;
            color: #ffffff;
            duotone: false;
        }
        remove-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                Attachments.remove(root.item.id);
            }
        }
    }
    if remove-touch.has-hover: Tip {
        x: parent.width - self.width;
        y: -self.height - 4px;
        text: AttachWords.remove();
    }
}

component AddTile inherits Rectangle {
    border-radius: 3px;
    border-width: 1.5px;
    border-color: touch.has-hover ? P.accent : P.line;
    background: touch.has-hover ? P.tint : transparent;
    DuoIcon {
        name: "plus";
        size: 22px;
        color: touch.has-hover ? P.accent : P.faint;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Attachments.add-more();
        }
    }
    if touch.has-hover: Tip {
        x: (parent.width - self.width) / 2;
        y: parent.height + 6px;
        text: AttachWords.add-more();
    }
}

component FileLine inherits Rectangle {
    in property <Attachment> item;
    property <bool> wrong: item.problem != AttachProblem.none;
    height: line.preferred-height;
    border-radius: 2px;
    background: root.wrong ? P.danger-soft : touch.has-hover ? P.hover : transparent;

    line := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 2px;
                clip: true;
                background: root.item.has-picture ? P.surface
                    : root.item.file-type == FileType.pdf ? P.file-pdf
                    : root.item.file-type == FileType.archive ? P.file-zip
                    : root.item.file-type == FileType.image ? P.file-image : P.accent;
                if root.item.has-picture: Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.item.picture;
                    image-fit: cover;
                }
                if !root.item.has-picture: DuoIcon {
                    name: AttachWords.file-icon(root.item.file-type);
                    size: 20px;
                    color: P.on-accent;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: root.item.name;
                color: root.wrong ? P.danger : P.text;
                font-size: 15px;
                font-weight: 500;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                if root.wrong: VerticalLayout {
                    alignment: center;
                    Icon {
                        name: "warning-circle";
                        size: 13px;
                        color: P.danger;
                        duotone: false;
                    }
                }
                Text {
                    text: root.wrong ? AttachWords.problem(root.item.problem) : root.item.size;
                    color: root.wrong ? P.danger : P.muted;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 2px;
                background: remove-touch.has-hover ? P.rail : transparent;
                Icon {
                    name: "x";
                    size: 14px;
                    color: remove-touch.has-hover ? P.text : P.faint;
                    duotone: false;
                }
                remove-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Attachments.remove(root.item.id);
                    }
                }
            }
        }
    }
    touch := TouchArea { }
}

component Segment inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback clicked();
    width: words.preferred-width + 20px;
    height: words.preferred-height + 8px;
    border-radius: 2px;
    background: root.on ? P.panel : transparent;
    border-width: root.on ? 1px : 0;
    border-color: P.line;
    words := Text {
        text: root.label;
        color: root.on ? P.text : P.muted;
        font-size: 13px;
        font-weight: root.on ? 600 : 400;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component CardButton inherits Rectangle {
    in property <string> label;
    in property <bool> filled;
    in property <bool> enabled: true;
    callback clicked();
    width: words.preferred-width + 32px;
    height: words.preferred-height + 16px;
    border-radius: 2px;
    background: root.filled ? P.accent : touch.has-hover ? P.hover : transparent;
    opacity: root.enabled ? 1 : 0.45;
    words := Text {
        text: root.label;
        color: root.filled ? P.on-accent : P.accent-ink;
        font-size: 15px;
        font-weight: 600;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component TimerChoice inherits Rectangle {
    in property <int> seconds;
    property <bool> on: Attachments.timer == seconds;
    height: 28px;
    border-radius: 2px;
    background: root.on ? P.accent : P.hover;
    Text {
        text: AttachWords.timer-label(root.seconds);
        color: root.on ? P.on-accent : P.text;
        font-size: 13px;
        font-weight: root.on ? 600 : 400;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Attachments.set-timer(root.seconds);
            Attachments.timer-open = false;
        }
    }
}

component SendCard inherits Rectangle {
    background: #00000052;
    property <int> count: Attachments.count;
    property <bool> as-files: Attachments.as-file || !Attachments.all-media;
    property <int> cols: count <= 4 ? 4 : 5;
    property <length> grid-width: 460px - 44px;
    property <length> cell: (grid-width - 6px * (cols - 1)) / cols;
    property <bool> labelled: Attachments.albums > 1;
    property <length> label-height: labelled ? 22px : 0;
    property <int> per-album: 10;
    property <int> album-rows: Math.ceil(per-album / cols);
    pure function tile-x(index: int) -> length {
        return Math.mod(index, cols) * (cell + 6px);
    }
    pure function tile-y(index: int) -> length {
        return Math.floor(index / per-album) * (album-rows * (cell + 6px) + label-height + (labelled ? 6px : 0))
            + label-height + Math.floor(Math.mod(index, per-album) / cols) * (cell + 6px);
    }
    property <length> grid-height: tile-y(count) + cell;

    TouchArea { }

    card := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 460px;
        height: min(parent.height - 32px, body.preferred-height);
        border-radius: 4px;
        background: P.panel;
        drop-shadow-blur: 60px;
        drop-shadow-offset-y: 24px;
        drop-shadow-color: #0000004d;
        TouchArea {
            clicked => {
                Attachments.timer-open = false;
                Attachments.send-menu-open = false;
            }
        }

        body := VerticalLayout {
            padding: 22px;
            spacing: 12px;
            Text {
                text: AttachWords.title(root.count, Attachments.videos, root.as-files);
                color: P.text;
                font-size: 19px;
                font-weight: 600;
            }
            if Attachments.albums > 1: HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    DuoIcon {
                        name: "squares-four";
                        size: 15px;
                        color: P.muted;
                    }
                }
                Text {
                    text: AttachWords.albums(Attachments.albums);
                    color: P.muted;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }

            if !root.as-files && root.count == 1: Rectangle {
                height: Attachments.items[0].kind == AttachKind.video ? 236px : 260px;
                border-radius: 3px;
                clip: true;
                background: P.surface;
                border-width: Attachments.items[0].problem != AttachProblem.none ? 2px : 0;
                border-color: P.danger;
                if Attachments.items[0].has-picture: Image {
                    width: parent.width;
                    height: parent.height;
                    source: Attachments.items[0].picture;
                    image-fit: cover;
                }
                if Attachments.items[0].kind == AttachKind.video: Rectangle {
                    x: 8px;
                    y: 8px;
                    width: length.preferred-width + 14px;
                    height: length.preferred-height + 4px;
                    border-radius: 4px;
                    background: #0000008c;
                    length := HorizontalLayout {
                        spacing: 4px;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "play";
                                size: 10px;
                                color: #ffffff;
                                duotone: false;
                            }
                        }
                        Text {
                            text: Fmt.duration(Attachments.items[0].duration);
                            color: #ffffff;
                            font-family: P.mono;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle {
                    x: 8px;
                    y: parent.height - self.height - 8px;
                    width: min(parent.width - 16px, meta.preferred-width + 14px);
                    height: meta.preferred-height + 4px;
                    border-radius: 4px;
                    background: #00000080;
                    meta := Text {
                        width: parent.width - 14px;
                        text: Attachments.items[0].name + " · " + Attachments.items[0].size;
                        color: #ffffff;
                        font-family: P.mono;
                        font-size: 11px;
                        overflow: elide;
                    }
                }
                if Attachments.items[0].problem != AttachProblem.none: Rectangle {
                    x: parent.width - self.width - 8px;
                    y: 8px;
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    background: P.danger;
                    Icon {
                        name: "warning";
                        size: 15px;
                        color: #ffffff;
                        duotone: false;
                    }
                }
            }

            if !root.as-files && root.count > 1: Rectangle {
                height: root.grid-height;
                for album in Attachments.albums: Text {
                    visible: root.labelled;
                    x: 0;
                    y: album * (root.album-rows * (root.cell + 6px) + root.label-height + 6px);
                    text: AttachWords.album(album + 1, min(root.per-album, root.count - album * root.per-album));
                    color: P.faint;
                    font-size: 13px;
                }
                for item[index] in Attachments.items: GridTile {
                    x: root.tile-x(index);
                    y: root.tile-y(index);
                    width: root.cell;
                    height: root.cell;
                    item: item;
                }
                AddTile {
                    x: root.tile-x(root.count);
                    y: root.tile-y(root.count);
                    width: root.cell;
                    height: root.cell;
                }
            }

            if root.as-files: VerticalLayout {
                spacing: 4px;
                for item in Attachments.items: FileLine {
                    item: item;
                }
            }

            if !root.as-files: VerticalLayout {
                spacing: 4px;
                for item in Attachments.items: HorizontalLayout {
                    spacing: 6px;
                    visible: item.problem != AttachProblem.none;
                    height: item.problem != AttachProblem.none ? problem.preferred-height : 0;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: "warning-circle";
                            size: 15px;
                            color: P.danger;
                            duotone: false;
                        }
                    }
                    problem := Text {
                        text: item.name + " · " + AttachWords.problem(item.problem);
                        color: P.danger;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            caption-box := Rectangle {
                border-radius: 2px;
                background: P.field;
                border-width: caption.has-focus ? 2px : 1px;
                border-color: caption.has-focus ? P.accent : P.line;
                height: caption.height;
                caption := MessageInput {
                    text <=> Attachments.caption;
                    allow-empty: true;
                    placeholder: AttachWords.caption-placeholder();
                    text-color: P.text;
                    placeholder-color: P.faint;
                    selection-color: P.input-sel;
                    font-family: P.font;
                    font-size: 15px;
                    base-height: 40px;
                    tallest: 90px;
                    padding-x: 11px;
                    padding-y: 9px;
                    init => {
                        self.focus-text();
                    }
                    send(words) => {
                        Attachments.caption = words;
                        Attachments.caption-edited(words);
                        if Attachments.can-send {
                            Attachments.send(false);
                        }
                    }
                    edited(words) => {
                        Attachments.caption-edited(words);
                    }
                }
                property <int> left: Attachments.caption-max - Attachments.caption.character-count;
                if caption-box.left <= 50: Text {
                    x: parent.width - self.width - 9px;
                    y: parent.height - self.height - 7px;
                    text: caption-box.left < 0 ? "−" + (-caption-box.left) : caption-box.left;
                    color: caption-box.left < 0 ? P.danger : P.faint;
                    font-size: 11px;
                    font-weight: 600;
                }
            }

            if Attachments.all-media: HorizontalLayout {
                spacing: 12px;
                alignment: start;
                Rectangle {
                    width: segments.preferred-width + 4px;
                    height: segments.preferred-height + 4px;
                    border-radius: 4px;
                    background: P.hover;
                    segments := HorizontalLayout {
                        x: 2px;
                        y: 2px;
                        spacing: 2px;
                        Segment {
                            label: Attachments.videos == root.count ? AttachWords.as-video() : AttachWords.as-photo();
                            on: !Attachments.as-file;
                            clicked => {
                                Attachments.set-as-file(false);
                            }
                        }
                        Segment {
                            label: AttachWords.as-file();
                            on: Attachments.as-file;
                            clicked => {
                                Attachments.set-as-file(true);
                            }
                        }
                    }
                }
                if root.count > 1: HorizontalLayout {
                    spacing: 7px;
                    VerticalLayout {
                        alignment: center;
                        Switch {
                            on: Attachments.grouped;
                            accent: P.accent;
                            off-color: P.track;
                            as-text: false;
                            track-width: 28px;
                            track-height: 16px;
                            knob-size: 12px;
                            track-radius: 8px;
                            knob-radius: 6px;
                            toggled => {
                                Attachments.set-grouped(!Attachments.grouped);
                            }
                        }
                    }
                    Text {
                        text: AttachWords.group-items();
                        color: P.text;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
            }
            if Attachments.all-media && !Attachments.as-file: HorizontalLayout {
                spacing: 8px;
                alignment: start;
                if Attachments.timer-allowed: timer-button := Rectangle {
                    property <bool> set: Attachments.timer != 0;
                    width: timer-row.preferred-width + 16px;
                    height: 28px;
                    border-radius: 2px;
                    background: self.set ? P.enc-soft : Attachments.timer-open ? P.hover : transparent;
                    border-width: self.set || Attachments.timer-open ? 0 : 1px;
                    border-color: P.line;
                    timer-row := HorizontalLayout {
                        spacing: 5px;
                        VerticalLayout {
                            alignment: center;
                            DuoIcon {
                                name: "timer";
                                size: 16px;
                                color: timer-button.set ? P.enc : Attachments.timer-open ? P.accent : P.muted;
                            }
                        }
                        if timer-button.set: Text {
                            text: AttachWords.timer-label(Attachments.timer);
                            color: P.enc;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    timer-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Attachments.timer-open = !Attachments.timer-open;
                            Attachments.send-menu-open = false;
                        }
                    }
                    if timer-touch.has-hover && !Attachments.timer-open: Tip {
                        x: 0;
                        y: -self.height - 8px;
                        text: AttachWords.timer();
                    }
                    if Attachments.timer-open: Rectangle {
                        x: 0;
                        y: -self.height - 8px;
                        width: 256px;
                        height: choices.preferred-height;
                        border-radius: 4px;
                        background: P.panel;
                        drop-shadow-blur: 32px;
                        drop-shadow-offset-y: 12px;
                        drop-shadow-color: P.shadow;
                        TouchArea { }
                        choices := VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            Text {
                                text: AttachWords.timer();
                                color: P.text;
                                font-size: 15px;
                                font-weight: 600;
                            }
                            Text {
                                text: AttachWords.timer-sub();
                                color: P.muted;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                            Rectangle {
                                height: 3 * 28px + 2 * 4px;
                                for seconds[index] in [0, -1, 3, 5, 10, 15, 30, 45, 60]: TimerChoice {
                                    x: Math.mod(index, 3) * ((parent.width - 8px) / 3 + 4px);
                                    y: Math.floor(index / 3) * 32px;
                                    width: (parent.width - 8px) / 3;
                                    seconds: seconds;
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    width: spoiler.preferred-width + 16px;
                    height: 28px;
                    spoiler := HorizontalLayout {
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            DuoIcon {
                                name: "eye-slash";
                                size: 16px;
                                color: P.muted;
                                opacity: 0.5;
                            }
                        }
                        Text {
                            text: AttachWords.spoiler();
                            color: P.muted;
                            font-size: 13px;
                            vertical-alignment: center;
                            opacity: 0.5;
                        }
                        VerticalLayout {
                            alignment: center;
                            Badge { text: AttachWords.not-available(); }
                        }
                    }
                    TouchArea {
                        mouse-cursor: not-allowed;
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                padding-top: 2px;
                Text {
                    horizontal-stretch: 1;
                    text: AttachWords.hint(Attachments.hint);
                    color: Attachments.hint == AttachHint.keys ? P.faint : P.danger;
                    font-size: 12px;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
                VerticalLayout {
                    alignment: center;
                    CardButton {
                        label: AttachWords.cancel();
                        clicked => {
                            Attachments.cancel();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: send.width + caret.width;
                        height: send.height;
                        send := Rectangle {
                            x: 0;
                            width: send-words.preferred-width + 32px;
                            height: send-words.preferred-height + 16px;
                            border-top-left-radius: 2px;
                            border-bottom-left-radius: 2px;
                            background: P.accent;
                            opacity: Attachments.can-send ? 1 : 0.45;
                            send-words := Text {
                                text: AttachWords.send();
                                color: P.on-accent;
                                font-size: 15px;
                                font-weight: 600;
                            }
                            TouchArea {
                                enabled: Attachments.can-send;
                                mouse-cursor: pointer;
                                clicked => {
                                    Attachments.send(false);
                                }
                            }
                        }
                        caret := Rectangle {
                            x: send.width;
                            width: 26px;
                            height: send.height;
                            border-top-right-radius: 2px;
                            border-bottom-right-radius: 2px;
                            background: P.accent;
                            opacity: Attachments.can-send ? 1 : 0.45;
                            Rectangle {
                                x: 0;
                                width: 1px;
                                height: parent.height;
                                background: P.dark ? #0000004d : #ffffff66;
                            }
                            Icon {
                                name: "caret-down";
                                size: 12px;
                                color: P.on-accent;
                                duotone: false;
                            }
                            caret-touch := TouchArea {
                                enabled: Attachments.can-send;
                                mouse-cursor: pointer;
                                clicked => {
                                    Attachments.send-menu-open = !Attachments.send-menu-open;
                                    Attachments.timer-open = false;
                                }
                            }
                            if caret-touch.has-hover && !Attachments.send-menu-open: Tip {
                                x: parent.width - self.width;
                                y: -self.height - 8px;
                                text: AttachWords.more-send();
                            }
                        }
                        if Attachments.send-menu-open: Rectangle {
                            x: parent.width - self.width;
                            y: -self.height - 6px;
                            width: 280px;
                            height: send-menu.preferred-height;
                            border-radius: 4px;
                            background: P.panel;
                            drop-shadow-blur: 32px;
                            drop-shadow-offset-y: 12px;
                            drop-shadow-color: P.shadow;
                            TouchArea { }
                            send-menu := VerticalLayout {
                                padding: 6px;
                                AttachItem {
                                    icon: "bell-slash";
                                    label: AttachWords.silent();
                                    activated => {
                                        Attachments.send-menu-open = false;
                                        Attachments.send(true);
                                    }
                                }
                                AttachItem {
                                    icon: "calendar-blank";
                                    label: AttachWords.schedule();
                                    enabled: false;
                                    badge: AttachWords.not-available();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

component DropZone inherits Rectangle {
    background: P.bg.transparentize(P.dark ? 0.08 : 0.1);
    property <bool> allowed: Attachments.drop-allowed;
    property <bool> photos: Attachments.drop-photos;
    Rectangle {
        x: 16px;
        y: 16px;
        width: parent.width - 32px;
        height: parent.height - 32px;
        border-radius: 4px;
        border-width: 2px;
        border-color: root.allowed ? P.accent : P.danger;
        background: root.allowed ? P.tint : P.danger-soft;
        VerticalLayout {
            alignment: center;
            spacing: 8px;
            HorizontalLayout {
                alignment: center;
                DuoIcon {
                    name: !root.allowed ? "prohibit" : root.photos ? "image" : "file";
                    size: 34px;
                    color: root.allowed ? P.accent-ink : P.danger;
                }
            }
            Text {
                text: !root.allowed ? AttachWords.not-allowed() : root.photos ? AttachWords.drop-photos() : AttachWords.drop-files();
                color: root.allowed ? P.accent-ink : P.danger;
                font-size: 19px;
                font-weight: 600;
                horizontal-alignment: center;
            }
            if root.allowed: Text {
                text: root.photos ? AttachWords.compressed() : AttachWords.original();
                color: P.muted;
                font-size: 13px;
                horizontal-alignment: center;
            }
        }
    }
}

export component BroadsheetAttachments inherits Rectangle {
    if Attachments.menu-open: TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                Attachments.menu-open = false;
                Attachments.menu-keyboard = false;
                Attachments.menu-focus = -1;
            }
        }
    }
    if Attachments.menu-open: AttachMenu {
        x: max(8px, min(Attachments.menu-x + 40px - self.width, root.width - self.width - 8px));
        y: max(8px, Attachments.menu-y - self.height - 6px);
    }
    if Attachments.card-open: SendCard { }
    if Attachments.dropping: DropZone { }
}
