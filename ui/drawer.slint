// The drawer (the design's sixth round): everything beyond the chats in one place, slid out from
// the activity bar's logo in Workbench and the rail's in Broadsheet, a pane under /tools and
// /accounts in Terminal. Three parts: the accounts, the toolbox (every tool, with a switch that
// pins it to the bar: the bars show only what the user pinned, one list for the three themes,
// settings.toml), and the settings and the profile. What is drawn here is the state and the words;
// the themes draw it (ui/<theme>/drawer.slint), src/drawer.rs fills and acts.
import { Downloads } from "downloads.slint";

// A tool of the toolbox.
export struct ToolRow {
    id: string,             // "downloads", "screenshot", "live", "jellyfin", "hiding", "scheduled"
    name: string,
    line: string,           // what it is, in a few words
    icon: string,           // its Phosphor icon
    sigil: string,          // Terminal's mark for it: ↓, ✂, …
    pinned: bool,
    grey: bool,             // still to come: faded, and its switch does nothing
}

export global Drawer {
    in-out property <bool> open;
    in-out property <[ToolRow]> tools;             // every tool, in the toolbox's order
    in-out property <[ToolRow]> pinned;            // those pinned, in that order: the bars
    in-out property <bool> downloads-pinned;
    in-out property <bool> accounts-shown;         // Terminal: the pane shows the accounts, else the toolbox
    // An unpinned tool has something going on (downloads on their way), or another account has
    // unread messages: a dot on the logo. A pinned tool's dot sits on its own icon.
    out property <bool> logo-dot: !downloads-pinned && Downloads.active-count > 0;
    callback toggle();
    callback close();
    callback pin(string, bool);                    // a tool, and whether it is pinned now
    callback open-tool(string);                    // a tool opens (and the drawer shuts)
}

export global DrawerWords {
    public pure function accounts() -> string { return @tr("Accounts"); }
    public pure function toolbox() -> string { return @tr("Toolbox"); }
    public pure function pin-to-bar() -> string { return @tr("Pin to the bar"); }
    public pure function pinned-count(n: int) -> string { return @tr("{n} pinned" | "{n} pinned" % n); }
    public pure function add-account() -> string { return @tr("Add account"); }
    public pure function current-account() -> string { return @tr("Current account"); }
    public pure function current() -> string { return @tr("the account in front" => "Current"); }
    public pure function settings() -> string { return @tr("Settings"); }
    public pure function ai-settings() -> string { return @tr("AI settings"); }
    public pure function profile() -> string { return @tr("My profile"); }
    public pure function index() -> string { return @tr("Broadsheet's drawer" => "Section index"); }
    public pure function esc-closes() -> string { return @tr("Esc closes"); }
    public pure function not-yet() -> string { return @tr("Not available in this version"); }
    // Terminal's pane.
    public pure function pin-legend() -> string { return @tr("[x] = pinned to the bottom bar · click a name to open"); }
    public pure function bottom-bar() -> string { return @tr("Bottom bar"); }
    public pure function accounts-legend() -> string { return @tr("click a row to switch · ⌃1–⌃0"); }
    // The tools.
    public pure function downloads() -> string { return @tr("Downloads"); }
    public pure function downloads-line() -> string { return @tr("Files from your WebDAV servers"); }
    public pure function downloading(n: int) -> string { return @tr("{n} on its way" | "{n} on their way" % n); }
    public pure function screenshot() -> string { return @tr("Screenshot"); }
    public pure function screenshot-line() -> string { return @tr("Capture the screen, mark it up, send it"); }
    public pure function live() -> string { return @tr("Live"); }
    public pure function live-line() -> string { return @tr("Watch live streams"); }
    public pure function jellyfin() -> string { return "Jellyfin"; }
    public pure function jellyfin-line() -> string { return @tr("Your own media server"); }
    public pure function hiding() -> string { return @tr("Keyword hiding"); }
    public pure function hiding-line() -> string { return @tr("Hide messages by keyword, on this Mac only"); }
    public pure function scheduled() -> string { return @tr("Scheduled messages"); }
    public pure function scheduled-line() -> string { return @tr("Messages set to go out later"); }
}
