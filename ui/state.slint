// Application-wide state: the global every page and the Rust side can reach. What Telegram shows
// (the account, logging in, chats, messages) is in telegram.slint.

// How far FinchGram is with Telegram (src/telegram/).
export enum TelegramState {
    starting,               // finchgram-tdlib is starting, or TDLib is opening its database
    missing-api-id,         // this build was made without an api_id (README)
    wait-phone-number,
    wait-code,
    wait-password,
    wait-other-device,      // logging in with a QR code, confirmed on a device that is logged in
    wait-email-address,
    wait-email-code,
    wait-registration,      // the phone number has no account yet
    wait-premium-purchase,
    ready,
    logging-out,
    closing,
    failed,                 // AppState.telegram-error says why
}

// Where the self-updater is (src/update.rs).
export enum UpdateState { idle, checking, up-to-date, available, installing, failed }

// TDLib's connection to Telegram's servers.
export enum Connection { waiting-for-network, connecting-to-proxy, connecting, updating, ready }

// The three themes of the design ("FinchGram Desktop 视觉方向"). Each has a chat window of its own
// (ui/workbench/, ui/broadsheet/, ui/terminal/); the other pages are shared and take the theme's
// colours, type and shapes from Look (look.slint). Workbench is the default.
export enum Theme { workbench, broadsheet, terminal }

// What fills the window. Until Telegram is ready, "chats" shows the login pages instead.
export enum Page { chats, settings, profile }

// The categories of the settings page, in the design's order. Those without a setting FinchGram
// has yet are shown greyed out.
export enum SettingsSection { general, notifications, privacy, chats, folders, finch, appearance, language, data, advanced, about }

// The settings of Settings → Notifications & sounds that are FinchGram's own (src/settings.rs).
export enum NotificationSetting { desktop-notifications, message-previews, notification-sounds, flash-taskbar, count-muted-chats }

// A UI language the app ships (src/i18n.rs).
export struct Language {
    code: string,           // a folder name under lang/, or "en"
    native: string,         // its name in itself
    english: string,        // its name in English
}

// What FinchGram shows outside its window, in the system's own places: the menu of its icon in the
// menu bar (src/platform/), and notifications (src/telegram/notifications.rs).
export global PlatformWords {
    out property <string> open: @tr("Open FinchGram");
    out property <string> quit: @tr("Quit FinchGram");
    // A notification that does not show its message.
    out property <string> new-message: @tr("New message");
}

// The screenshot tool (the design's seventh round, "FinchGram Desktop 截图"; src/screenshot/): the
// scissors in the composer and its shortcut take a picture of the screen through an overlay with
// annotations, into the card before sending. Settings → General → Screenshots.
export global Screenshot {
    in-out property <string> shortcut-label: "⌘⇧A";   // the shortcut, as macOS writes keys
    in-out property <bool> recording;                  // the shortcut's field is taking a new one
    in-out property <bool> custom-shortcut;            // it is not the default: Reset applies
    in-out property <bool> hide-own-window;            // FinchGram's window hides while the screen is captured
    in-out property <bool> background;                 // the shortcut works in the background too (not yet)
    in-out property <bool> permission-card;            // Screen Recording is off for FinchGram: the card shows
    callback start();                                  // the scissors, or the shortcut
    callback record-shortcut(string, bool, bool, bool, bool);  // a key pressed in the field: key, ⌘, ⌃, ⌥, ⇧
    callback reset-shortcut();
    callback set-hide-own-window(bool);
    callback open-system-settings();
    callback dismiss-permission();
}

export global AppState {
    // Active UI language, a folder name under lang/ ("en" is the source language and has none).
    in-out property <string> language: "en";
    in-out property <string> language-name: "English";     // the active one's name in itself
    in-out property <[Language]> languages;
    // The theme in use's light or dark: "system", "light" or "dark". Each theme keeps its own
    // (src/settings.rs): Workbench and Broadsheet follow the system, Terminal is dark, until chosen.
    in-out property <string> appearance: "system";
    in-out property <Theme> theme: Theme.workbench;
    // How wide each theme's chat list is (settings.toml): the user drags its edge (ListEdge).
    in-out property <length> workbench-list-width: 244px;
    in-out property <length> broadsheet-list-width: 300px;
    in-out property <length> terminal-list-width: 268px;
    in-out property <Page> page: Page.chats;
    in-out property <SettingsSection> settings-section: SettingsSection.appearance;
    // This build, e.g. "0.1.0".
    in-out property <string> app-version;

    // Telegram, through finchgram-tdlib. Set by Rust (src/telegram/).
    in-out property <TelegramState> telegram-state: TelegramState.starting;
    in-out property <string> telegram-error;
    in-out property <Connection> connection: Connection.connecting;
    in-out property <string> tdlib-version;             // "1.8.67", once finchgram-tdlib has answered

    // Self-update (src/update.rs). Rust asks GitHub Releases once a day and on request.
    in-out property <UpdateState> update-state: UpdateState.idle;
    in-out property <string> update-version;            // the newer version, once one is available
    in-out property <string> update-notes;              // its release notes
    in-out property <float> update-progress;            // 0..1 while downloading
    in-out property <string> update-downloaded;         // "12.4 MB" so far, while downloading
    in-out property <string> update-total;              // "63.8 MB", the whole download
    in-out property <string> update-error;              // why the last check or install failed
    in-out property <bool> check-for-updates-daily: true;  // the setting
    callback check-for-updates();
    callback install-update();                          // download, install, restart

    // Settings → General. Launching at login is the system's list of login items (src/platform/);
    // what is not available on this system is greyed out.
    in-out property <bool> launch-at-login;
    in-out property <bool> launch-at-login-available;   // macOS 13 and later
    in-out property <bool> show-in-menu-bar;            // FinchGram's icon in the menu bar
    in-out property <bool> menu-bar-available;          // macOS
    in-out property <bool> quit-on-close;               // closing the window quits FinchGram
    in-out property <bool> keeps-running-available;     // macOS: closing the window can leave it running
    in-out property <bool> send-with-enter: true;       // else ⌘⏎ sends and ⏎ starts a new line

    // Settings → Notifications & sounds: what FinchGram does when a message arrives
    // (src/telegram/notifications.rs). The notifications are the system's, which asks the user
    // once whether FinchGram may show them.
    in-out property <bool> desktop-notifications: true; // a notification for each new message
    in-out property <bool> message-previews: true;      // it shows the message, else only that one came
    in-out property <bool> notification-sounds;         // it plays the system's sound
    in-out property <bool> flash-taskbar: true;         // the Dock icon bounces while FinchGram is not in front
    in-out property <bool> count-muted-chats;           // the unread count on the Dock icon counts muted chats

    // Settings: each saves itself (src/settings.rs).
    callback change-language(string);
    callback change-appearance(string);
    callback change-theme(Theme);
    callback change-check-for-updates-daily(bool);
    callback change-list-width(Theme, length);          // a drag of a list's edge ended there
    callback show-window();                             // closed, FinchGram keeps running (macOS): open it again
    callback change-launch-at-login(bool);
    callback check-launch-at-login();                   // the list may have changed in System Settings
    callback change-show-in-menu-bar(bool);
    callback change-quit-on-close(bool);
    callback change-send-with-enter(bool);
    callback change-notification-setting(NotificationSetting, bool);

    // Our own pages (GitHub) and Telegram's terms of service; anything else is refused by Rust.
    callback open-url(string);

    // The themes draw their own title bar: pressing on its empty part moves the window, a double
    // click zooms it (src/main.rs, through winit).
    callback move-window();
    callback zoom-window();

    // ⌘K: counted up by the menu; the chat window in front puts the cursor in its search box.
    in-out property <int> search-requests;
}
