// Terminal (the design's "1b 终端"): monospace and keyboard first. The chat list marks each chat
// with a sign (# group, » channel, @ person, * saved, ~ bot, ^ pinned); the chat reads as a log;
// one command line writes messages and runs commands ("/mute", "/pin", …).
import { ListView } from "std-widgets.slint";
import { AppState, Page, Connection, Theme, Screenshot } from "../state.slint";
import {
    Chats, Conversation, Account, ChatRow, MessageRow, RowKind, ChatKind, Content, Viewer, Actions, ComposeBar, ActionNotice, Attachments, AttachKind, FileState,
    Unread, UnreadGroup, UnreadLine } from "../telegram.slint";
import { AccountColors } from "../look.slint";
import { Fmt } from "../format.slint";
import { Mark, Paragraph, ListEdge, WindowButtonsSpace, WindowMover } from "../widgets.slint";
import { ChatScroll, MessageInput, RichText, MessageArea, ActionWords, KeyScope, AttachWords, ChatMenuWords } from "../chat.slint";
import { TerminalPalette as P } from "palette.slint";
import { Signs } from "signs.slint";
import { TerminalActions } from "actions.slint";
import { TerminalAttachments } from "attachments.slint";

export enum TerminalView { chats, channels, bots, rules, scheduled }

component T inherits Text {
    font-family: P.font;
    font-size: 13px;
    color: P.text;
    vertical-alignment: center;
}

// A word in brackets that does something: "[dark]", "[⋯]".
component Action {
    in property <string> label;
    in property <color> color: P.muted;
    in property <bool> enabled: true;
    callback activated();
    opacity: enabled ? 1 : 0.4;

    T {
        text: "[" + root.label + "]";
        color: touch.has-hover && root.enabled ? P.accent : root.color;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

component TitleBar inherits Rectangle {
    height: 34px;
    background: P.side;

    WindowMover { }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: P.line;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        WindowButtonsSpace { }
        VerticalLayout {
            alignment: center;
            Mark {
                width: 16px;
                height: 14px;
                color: P.accent;
            }
        }
        T {
            horizontal-stretch: 1;
            text: "FinchGram — " + Account.name;
            color: P.muted;
            overflow: elide;
        }
        // What was just done (copied, saved, reported).
        if Actions.notice != ActionNotice.none: T {
            text: "» " + ActionWords.notice(Actions.notice);
            color: P.accent2;
        }
        Action {
            label: P.dark ? @tr("light") : @tr("dark");
            activated => {
                AppState.change-appearance(P.dark ? "light" : "dark");
            }
        }
    }
}

component SideTab {
    in property <string> label;
    in property <bool> active;
    in property <bool> enabled: true;
    callback activated();
    opacity: enabled ? 1 : 0.4;

    T {
        text: root.label;
        color: root.active ? P.accent : P.faint;
        font-weight: root.active ? 600 : 400;
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

component ChatLine inherits Rectangle {
    in property <ChatRow> chat;
    callback menu(length, length);          // a right click, where it is in the window
    property <bool> open: chat.id == Conversation.chat-id;
    height: 29px;
    background: open ? P.sel : touch.has-hover ? P.sel.transparentize(0.5) : transparent;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        T {
            width: 10px;
            text: root.open ? "▸" : "";
            color: P.accent;
        }
        T {
            width: 14px;
            text: Signs.of(root.chat.kind, root.chat.pinned);
            color: P.faint;
        }
        T {
            horizontal-stretch: 1;
            text: root.chat.title;
            color: root.open ? P.text : P.muted;
            overflow: elide;
        }
        T {
            text: root.chat.unread > 0 ? (root.chat.mention ? root.chat.unread + " @" : "" + root.chat.unread) : root.chat.marked ? "•" : "";
            color: root.chat.muted ? P.faint : P.accent2;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Conversation.open(root.chat.id);
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

// The folders as tabs, "1:All 2:Work …": the first four (three after the Unread tab), the rest
// behind "more". Before them, while chats have unread messages, the Unread tab with their count
// (the design's round 2): chosen, the list holds those chats and the Unread page comes to the front.
// Each tab is as tall as its word: a Rectangle has no height of its own, and a tab without one is
// drawn but takes no clicks.
component Folders {
    property <bool> has-unread: Unread.groups.length > 0;
    // Next to the Unread tab, as many folders as the column has room for (the list's edge widens it).
    property <int> slots: !has-unread ? 4 : root.width >= 360px ? 3 : root.width >= 300px ? 2 : 1;
    property <bool> folder-shown: !Chats.unread-shown;

    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        if root.has-unread: Rectangle {
            width: unread-label.preferred-width;
            height: unread-label.preferred-height;
            unread-label := T {
                x: 0;
                font-size: 12px;
                text: "0:" + @tr("Unread") + " " + Fmt.count(Unread.total);
                color: Chats.unread-shown ? P.accent : P.faint;
                font-weight: Chats.unread-shown ? 600 : 400;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Chats.show-unread();
                }
            }
        }
        for folder[index] in Chats.folders: Rectangle {
            property <bool> chosen: index == Chats.folder && root.folder-shown;
            visible: index < root.slots;
            width: index < root.slots ? label.preferred-width : 0px;
            height: label.preferred-height;
            label := T {
                x: 0;
                font-size: 12px;
                text: (index + 1) + ":" + (folder.id == 0 ? @tr("All") : folder.name);
                color: parent.chosen ? P.accent : P.faint;
                font-weight: parent.chosen ? 600 : 400;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Chats.show-folder(index);
                }
            }
        }
        if Chats.folders.length > root.slots: Rectangle {
            property <bool> chosen: Chats.folder >= root.slots && root.folder-shown;
            width: more.preferred-width;
            height: more.preferred-height;
            more := T {
                x: 0;
                font-size: 12px;
                text: (parent.chosen ? (Chats.folder + 1) + ":" + Chats.folders[Chats.folder].name : @tr("more")) + " ▾";
                color: parent.chosen ? P.accent : P.faint;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    list.show();
                }
            }
            list := PopupWindow {
                x: 0;
                y: 20px;
                width: 180px;
                close-policy: PopupClosePolicy.close-on-click-outside;
                Rectangle {
                    border-radius: 4px;
                    background: P.bg;
                    border-width: 1px;
                    border-color: P.line;
                    drop-shadow-blur: 30px;
                    drop-shadow-offset-y: 12px;
                    drop-shadow-color: P.shadow;
                    VerticalLayout {
                        padding-top: 4px;
                        padding-bottom: 4px;
                        for folder[index] in Chats.folders: Rectangle {
                            property <bool> chosen: index == Chats.folder && root.folder-shown;
                            visible: index >= root.slots;
                            height: index >= root.slots ? 28px : 0px;
                            background: self.chosen ? P.sel : entry.has-hover ? P.sel.transparentize(0.5) : transparent;
                            T {
                                x: 12px;
                                text: (index + 1) + ":" + folder.name;
                                color: parent.chosen ? P.accent : P.text;
                            }
                            entry := TouchArea {
                                clicked => {
                                    Chats.show-folder(index);
                                    list.close();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

component MenuEntry inherits Rectangle {
    in property <string> label;
    in property <string> command;
    callback activated();
    height: 26px;
    background: touch.has-hover ? P.sel : transparent;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        T {
            horizontal-stretch: 1;
            text: root.label;
        }
        T {
            text: root.command;
            color: P.accent;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

component Side inherits Rectangle {
    in-out property <TerminalView> view;
    width: max(220px, min(560px, AppState.terminal-list-width));
    background: P.side;

    // A chat's menu, from a right click on it: the chat header's menu, for any chat in the lists.
    // Its second page, Add to folder: the account's folders, those the chat is in ticked.
    property <ChatRow> menu-chat;
    property <int> menu-folder;             // where Chats.toggle-pin pins it
    property <bool> menu-folders;           // the second page is showing
    property <length> menu-x;
    property <length> menu-y;

    function show-menu(chat: ChatRow, folder: int, left: length, top: length) {
        root.menu-chat = chat;
        root.menu-folder = folder;
        root.menu-folders = false;
        Chats.open-menu(chat.id);
        root.menu-x = max(0px, left - root.absolute-position.x);
        // Within the list, whichever of the two pages is the taller.
        root.menu-y = max(0px, min(top - root.absolute-position.y, root.height - 38px - 26px * max((Chats.folders.length > 1 ? 4 : 3) + 4, Chats.menu-folders.length + 1)));
        chat-menu.show();
    }

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: P.line;
    }

    VerticalLayout {
        VerticalLayout {
            vertical-stretch: 0;
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 14px;
            // The same room above the folders as below them: the list's rows have 6px of their own.
            padding-bottom: 4px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                SideTab {
                    label: "CHATS";
                    active: root.view == TerminalView.chats;
                    activated => {
                        root.view = TerminalView.chats;
                    }
                }
                SideTab {
                    label: "CHAN";
                    active: root.view == TerminalView.channels;
                    activated => {
                        root.view = TerminalView.channels;
                    }
                }
                SideTab {
                    label: "BOTS";
                    active: root.view == TerminalView.bots;
                    activated => {
                        root.view = TerminalView.bots;
                    }
                }
                // Keyword rules and scheduled messages are still to come.
                SideTab {
                    label: "RULES";
                    enabled: false;
                }
                SideTab {
                    label: "SCHED";
                    enabled: false;
                }
            }
            if root.view == TerminalView.chats: Folders { }
        }

        if AppState.connection != Connection.ready && AppState.connection != Connection.updating: HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 8px;
            T {
                text: "-- " + Fmt.connection(AppState.connection) + " --";
                color: P.accent2;
            }
        }

        if root.view == TerminalView.chats && Chats.loaded && Chats.list.length == 0: VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 10px;
            T {
                text: Chats.folder == 0 ? "-- " + @tr("No chats yet") + " --" : "-- " + @tr("No chats in this folder") + " --";
                color: P.faint;
            }
        }

        if root.view == TerminalView.chats: ListView {
            vertical-stretch: 1;
            vertical-scrollbar-policy: always-off;
            horizontal-scrollbar-policy: always-off;
            for chat in Chats.list: ChatLine {
                chat: chat;
                menu(left, top) => {
                    root.show-menu(chat, Chats.folder, left, top);
                }
            }
        }
        if root.view == TerminalView.channels: ListView {
            vertical-stretch: 1;
            vertical-scrollbar-policy: always-off;
            horizontal-scrollbar-policy: always-off;
            for chat in Chats.channels: ChatLine {
                chat: chat;
                menu(left, top) => {
                    root.show-menu(chat, 0, left, top);
                }
            }
        }
        if root.view == TerminalView.bots: Flickable {
            vertical-stretch: 1;
            mouse-drag-pan-enabled: false;
            VerticalLayout {
                alignment: start;
                if Chats.official-bots.length > 0: T {
                    height: 26px;
                    x: 16px;
                    text: "── " + @tr("Official bots") + " ──";
                    color: P.faint;
                }
                for chat in Chats.official-bots: ChatLine {
                    chat: chat;
                    menu(left, top) => {
                        root.show-menu(chat, 0, left, top);
                    }
                }
                if Chats.bots.length > 0: T {
                    height: 26px;
                    x: 16px;
                    text: "── " + @tr("Other bots") + " ──";
                    color: P.faint;
                }
                for chat in Chats.bots: ChatLine {
                    chat: chat;
                    menu(left, top) => {
                        root.show-menu(chat, 0, left, top);
                    }
                }
            }
        }

        // The account, at the foot.
        Rectangle {
            vertical-stretch: 0;
            height: account.preferred-height;
            Rectangle {
                height: 1px;
                y: 0;
                background: P.line;
            }
            account := VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 2px;
                            background: P.account;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        T {
                            text: @tr("Current account");
                            color: P.faint;
                            font-size: 11px;
                        }
                        T {
                            text: Account.phone == "" ? Account.name : Account.name + " · " + Account.phone;
                            overflow: elide;
                        }
                    }
                    // The profile and the settings, as the other themes have them at the foot.
                    VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            alignment: end;
                            Action {
                                label: @tr("profile");
                                color: P.accent;
                                activated => {
                                    AppState.page = Page.profile;
                                }
                            }
                        }
                        HorizontalLayout {
                            alignment: end;
                            Action {
                                label: @tr("settings");
                                color: P.accent;
                                activated => {
                                    AppState.page = Page.settings;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    ListEdge {
        x: parent.width - self.width;
        height: parent.height;
        list-width <=> AppState.terminal-list-width;
        narrowest: 220px;
        widest: 560px;
        dropped(width) => {
            AppState.change-list-width(Theme.terminal, width);
        }
    }

    chat-menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 250px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            border-radius: 4px;
            background: P.side;
            border-width: 1px;
            border-color: P.line;
            drop-shadow-blur: 30px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: P.shadow;
            VerticalLayout {
                padding-top: 4px;
                padding-bottom: 4px;
                T {
                    height: 24px;
                    x: 12px;
                    text: "── " + Signs.of(root.menu-chat.kind, false) + root.menu-chat.title + " ──";
                    color: P.faint;
                    overflow: elide;
                }
                if !root.menu-folders: MenuEntry {
                    label: root.menu-chat.muted ? @tr("Unmute") : @tr("Mute");
                    activated => {
                        Chats.toggle-mute(root.menu-chat.id);
                        chat-menu.close();
                    }
                }
                if !root.menu-folders: MenuEntry {
                    label: root.menu-chat.pinned ? @tr("Unpin") : @tr("Pin");
                    activated => {
                        Chats.toggle-pin(root.menu-chat.id, root.menu-folder);
                        chat-menu.close();
                    }
                }
                if !root.menu-folders: MenuEntry {
                    label: @tr("Mark as read");
                    activated => {
                        Chats.mark-read(root.menu-chat.id);
                        chat-menu.close();
                    }
                }
                if !root.menu-folders && Chats.folders.length > 1: MenuEntry {
                    label: @tr("Add to folder");
                    activated => {
                        root.menu-folders = true;
                    }
                }
                // Telegram's own actions on the chat (chats.rs); the ones that cannot be undone ask first.
                if !root.menu-folders && root.menu-chat.kind != ChatKind.saved: Rectangle {
                    height: 7px;
                    Rectangle {
                        height: 1px;
                        background: P.line;
                    }
                }
                if !root.menu-folders && (root.menu-chat.kind == ChatKind.user || root.menu-chat.kind == ChatKind.bot): MenuEntry {
                    label: ChatMenuWords.block(root.menu-chat.kind, root.menu-chat.blocked);
                    activated => {
                        Chats.toggle-block(root.menu-chat.id);
                        chat-menu.close();
                    }
                }
                if !root.menu-folders && root.menu-chat.reportable: MenuEntry {
                    label: ChatMenuWords.report();
                    activated => {
                        Chats.report(root.menu-chat.id);
                        chat-menu.close();
                    }
                }
                if !root.menu-folders && (root.menu-chat.kind == ChatKind.group || root.menu-chat.kind == ChatKind.channel): MenuEntry {
                    label: ChatMenuWords.leave(root.menu-chat.kind);
                    activated => {
                        Chats.leave(root.menu-chat.id);
                        chat-menu.close();
                    }
                }
                if !root.menu-folders && root.menu-chat.deletable && (root.menu-chat.kind == ChatKind.user || root.menu-chat.kind == ChatKind.bot): MenuEntry {
                    label: ChatMenuWords.delete();
                    activated => {
                        Chats.delete-chat(root.menu-chat.id);
                        chat-menu.close();
                    }
                }
                if root.menu-folders: MenuEntry {
                    label: @tr("Back");
                    activated => {
                        root.menu-folders = false;
                    }
                }
                if root.menu-folders: VerticalLayout {
                    for choice in Chats.menu-folders: MenuEntry {
                        label: (choice.inside ? "[x] " : "[ ] ") + choice.name;
                        activated => {
                            Chats.toggle-in-folder(root.menu-chat.id, choice.folder);
                            chat-menu.close();
                        }
                    }
                }
            }
        }
    }
}

// One line of the log: time, sender, words. While messages are being chosen, "[x]" in front.
component LogLine {
    in property <MessageRow> message;
    property <bool> has-media: message.media.length > 0 || message.files.length > 0;
    property <bool> reachable: !message.reply.gone && message.reply.id != "";
    height: lines.preferred-height;

    lines := HorizontalLayout {
        spacing: 8px;
        if Actions.selecting: T {
            width: 24px;
            text: root.message.selected ? "[x]" : "[ ]";
            color: root.message.selected ? P.accent : P.faint;
            vertical-alignment: top;
            line-height-factor: P.leading(1.6);
        }
        T {
            width: 44px;
            text: root.message.time;
            color: P.faint;
            vertical-alignment: top;
            line-height-factor: P.leading(1.6);
        }
        T {
            width: 64px;
            text: root.message.outgoing ? Account.first-name : root.message.sender;
            color: P.sender(root.message.sender-color, root.message.outgoing);
            overflow: elide;
            vertical-alignment: top;
            line-height-factor: P.leading(1.6);
        }
        VerticalLayout {
            horizontal-stretch: 1;
            if root.message.forwarded-from != "": T {
                text: "↪ " + @tr("Forwarded from {0}", root.message.forwarded-from);
                color: P.muted;
                vertical-alignment: top;
                line-height-factor: P.leading(1.6);
                overflow: elide;
            }
            // The message it replies to: "↱ Jie: I'm lubing my 65% today"; a click goes to it.
            if root.message.reply.shown: Rectangle {
                height: quote.preferred-height;
                quote := HorizontalLayout {
                    alignment: start;
                    T {
                        text: "↱ ";
                        color: P.faint;
                        line-height-factor: P.leading(1.6);
                    }
                    if root.message.reply.sender != "": T {
                        text: root.message.reply.sender + ": ";
                        color: P.accent;
                        line-height-factor: P.leading(1.6);
                    }
                    T {
                        horizontal-stretch: 1;
                        text: ActionWords.quote-line(root.message.reply);
                        color: P.faint;
                        font-italic: root.message.reply.gone;
                        line-height-factor: P.leading(1.6);
                        overflow: elide;
                    }
                }
                TouchArea {
                    mouse-cursor: root.reachable ? pointer : default;
                    clicked => {
                        if root.reachable {
                            Actions.jump(root.message.reply.id);
                        }
                    }
                }
            }
            if root.message.rich: RichText {
                text: root.message.rich-text;
                default-color: P.text;
                default-font-family: P.font;
                default-font-size: 13px;
                link-color: P.accent;
            }
            if root.message.rich && (root.message.edited || root.message.sending): T {
                text: (root.message.edited ? @tr("(edited)") : "") + (root.message.sending ? " …" : "");
                color: P.faint;
            }
            if !root.message.rich && (!root.has-media || root.message.text != ""): Paragraph {
                text: (root.has-media ? root.message.text : Fmt.body(root.message.content, root.message.text, root.message.detail))
                    + (root.message.edited ? " " + @tr("(edited)") : "")
                    + (root.message.sending ? " …" : "");
                color: root.has-media || root.message.content == Content.text ? P.text : P.muted;
                font-family: P.font;
                font-size: 13px;
                line-height-factor: P.leading(1.6);
            }
            // Its photos and videos, a line each: "↳ [vid 0:42] clip.mp4"; on its way up, with
            // its progress and "[x]" to stop it.
            for item in root.message.media: Rectangle {
                height: tag.preferred-height;
                tag := T {
                    x: 0;
                    text: "↳ [" + (item.video ? "vid " + Fmt.duration(item.duration) : "img") + (item.secret ? " · " + @tr("Tap to view") : "") + "]"
                        + (item.name == "" ? "" : " " + item.name)
                        + (item.uploading && !root.message.failed ? "  " + AttachWords.bar(item.progress) + " " + Math.round(item.progress * 100) + "%  [x]" : "");
                    color: root.message.failed ? P.faint : item.uploading ? P.muted : P.accent;
                    overflow: elide;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if item.uploading && !root.message.failed {
                            Conversation.cancel-upload(item.id);
                        } else {
                            Viewer.view(item.id, true);
                        }
                    }
                    // A right click on it is for this photo or video (Actions.hovered-media).
                    changed has-hover => {
                        if self.has-hover {
                            Actions.hovered-media = item.id;
                        } else if Actions.hovered-media == item.id {
                            Actions.hovered-media = "";
                        }
                    }
                }
            }
            // A link's preview, as the design's line: "↳ [⚡IV] title · author".
            if root.message.preview.url != "": Rectangle {
                height: preview-line.preferred-height;
                preview-line := T {
                    x: 0;
                    width: parent.width;
                    text: "↳ [" + (root.message.preview.instant-view ? "⚡IV" : "link") + "] " + root.message.preview.title
                        + " · " + (root.message.preview.about != "" ? root.message.preview.about : root.message.preview.site);
                    color: P.accent;
                    overflow: elide;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Conversation.open-link(root.message.preview.url);
                    }
                }
            }
            // Its file: "↳ [pdf] October screenings.pdf  1.2 MB  [▼ download]".
            for file in root.message.files: file-line := Rectangle {
                height: line.preferred-height;
                property <bool> moving: file.state == FileState.uploading || file.state == FileState.downloading;
                line := T {
                    x: 0;
                    text: "↳ [" + AttachWords.file-sign(file.file-type) + "] " + file.name + "  "
                        + (file-line.moving ? AttachWords.progress(file.moved, file.size) + "  " + AttachWords.bar(file.progress) + "  [x]"
                            : file.size + (file.state == FileState.remote ? "  [▼ " + AttachWords.download().to-lowercase() + "]"
                                : file-touch.has-hover ? "  [" + AttachWords.show-in-finder().to-lowercase() + "]" : ""));
                    color: root.message.failed ? P.faint : P.accent;
                    overflow: elide;
                }
                file-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Conversation.file-action(file.id);
                    }
                }
            }
            // Not sent: "↳ ✗ not sent [retry] [delete]".
            if root.message.failed: HorizontalLayout {
                alignment: start;
                spacing: 8px;
                T {
                    text: "↳ ✗ " + AttachWords.not-sent().to-lowercase();
                    color: P.accent3;
                }
                Rectangle {
                    width: retry.preferred-width;
                    retry := T {
                        text: "[" + AttachWords.retry().to-lowercase() + "]";
                        color: retry-touch.has-hover ? P.accent : P.accent3;
                    }
                    retry-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Conversation.retry(root.message.id);
                        }
                    }
                }
                Rectangle {
                    width: discard.preferred-width;
                    discard := T {
                        text: "[" + AttachWords.delete().to-lowercase() + "]";
                        color: discard-touch.has-hover ? P.accent : P.accent3;
                    }
                    discard-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Conversation.discard(root.message.id);
                        }
                    }
                }
            }
        }
    }
}

component Line {
    in property <MessageRow> message;
    // Conversation.reveal names this row: the list scrolls to it.
    callback reveal(length, length);
    property <bool> wanted: message.id != "" && Conversation.reveal == message.id;
    changed wanted => {
        if self.wanted {
            root.reveal(root.y, root.y + root.height);
        }
    }

    VerticalLayout {
        if root.message.kind == RowKind.day: T {
            height: 30px;
            text: "── " + Fmt.day-title(root.message.day) + " ──";
            color: P.faint;
            vertical-alignment: bottom;
        }
        if root.message.kind == RowKind.service: Paragraph {
            text: root.message.time + "  -- " + Fmt.service(root.message.content, root.message.outgoing ? @tr("You") : root.message.sender, root.message.detail) + " --";
            color: P.faint;
            font-family: P.font;
            font-size: 13px;
        }
        if root.message.kind == RowKind.sponsored: Rectangle {
            height: ad.preferred-height;
            ad := Paragraph {
                width: parent.width;
                text: root.message.time + "  [" + @tr("sponsored") + "] " + root.message.sender + " · " + root.message.text
                    + (root.message.button == "" ? "" : "  [" + root.message.button + " ↗]");
                color: P.muted;
                font-family: P.font;
                font-size: 13px;
                line-height-factor: P.leading(1.6);
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Conversation.open-sponsored(root.message.id);
                }
            }
        }
        // A message's row: lit while chosen or while its menu is open, ringed when jumped to.
        if root.message.kind == RowKind.message: Rectangle {
            height: log.preferred-height;
            area := MessageArea {
                message: root.message;
                Rectangle {
                    x: -6px;
                    width: parent.width + 12px;
                    border-radius: 2px;
                    background: root.message.selected || Actions.menu-row == root.message.id ? P.sel : transparent;
                    border-width: Actions.flash == root.message.id ? 1px : 0;
                    border-color: P.accent;
                    animate background { duration: 250ms; }
                }
                log := LogLine {
                    x: 0;
                    width: parent.width;
                    message: root.message;
                }
            }
        }
    }
}

component Pane inherits Rectangle {
    background: P.bg;

    VerticalLayout {
        Rectangle {
            height: 34px;
            background: P.pane-head;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;
                T {
                    text: Signs.of(Conversation.kind, false) + Conversation.title;
                    color: P.accent;
                    font-weight: 600;
                    overflow: elide;
                }
                T {
                    horizontal-stretch: 1;
                    text: Conversation.typing != "" ? @tr("typing…")
                        : Fmt.status(Conversation.status, Conversation.last-seen, Conversation.members, Conversation.online-members);
                    color: P.faint;
                    overflow: elide;
                }
                // Searching and the chat's settings are still to come.
                Action {
                    label: @tr("search");
                    enabled: false;
                }
                Action {
                    label: @tr("chat settings");
                    enabled: false;
                }
                Action {
                    label: "⋯";
                    activated => {
                        menu.show();
                    }
                }
            }
            menu := PopupWindow {
                x: parent.width - 262px;
                y: 34px;
                width: 250px;
                close-policy: PopupClosePolicy.close-on-click-outside;
                Rectangle {
                    border-radius: 4px;
                    background: P.side;
                    border-width: 1px;
                    border-color: P.line;
                    drop-shadow-blur: 30px;
                    drop-shadow-offset-y: 12px;
                    drop-shadow-color: P.shadow;
                    VerticalLayout {
                        padding-top: 4px;
                        padding-bottom: 4px;
                        T {
                            height: 24px;
                            x: 12px;
                            text: "── " + Signs.of(Conversation.kind, false) + Conversation.title + " ──";
                            color: P.faint;
                            overflow: elide;
                        }
                        MenuEntry {
                            label: Conversation.muted ? @tr("Unmute") : @tr("Mute");
                            command: "/mute";
                            activated => {
                                Conversation.toggle-mute();
                                menu.close();
                            }
                        }
                        MenuEntry {
                            label: Conversation.pinned ? @tr("Unpin") : @tr("Pin");
                            command: "/pin";
                            activated => {
                                Conversation.toggle-pin();
                                menu.close();
                            }
                        }
                        MenuEntry {
                            label: @tr("Mark as read");
                            command: "/read";
                            activated => {
                                Conversation.mark-read();
                                menu.close();
                            }
                        }
                    }
                }
            }
        }

        scroll := ChatScroll {
            vertical-stretch: 1;
            spacing: 3px;
            margin-left: 16px;
            margin-right: 16px;
            margin-top: 10px;
            margin-bottom: 14px;
            for row in Conversation.messages: Line {
                message: row;
                reveal(top, bottom) => {
                    scroll.reveal(top, bottom);
                }
            }
            if Conversation.typing != "": T {
                text: "…… " + @tr("{0} is typing…", Conversation.typing);
                color: P.faint;
            }
        }
    }
}

// The commands of the command line.
export struct Command {
    command: string,
    description: string,
}

// What to do with the messages chosen, in place of the command line (the design's 1b): "[Forward]",
// in the faint colour where they do not all allow it.
component BarAction {
    in property <string> label;
    in property <bool> enabled: true;
    in property <color> color: P.text;
    callback activated();

    T {
        text: "[" + root.label + "]";
        color: !root.enabled ? P.faint : touch.has-hover ? P.accent : root.color;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

component SelectionLine inherits Rectangle {
    background: P.cmd;

    Rectangle {
        height: 1px;
        y: 0;
        background: P.line;
    }

    KeyScope {
        width: 0;
        height: 0;
        escape => {
            Actions.cancel-selection();
        }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        T {
            text: "── " + ActionWords.selected() + " ──";
            color: P.accent;
        }
        BarAction {
            label: @tr("Forward");
            enabled: Actions.can-forward;
            activated => {
                Actions.forward-selected();
            }
        }
        BarAction {
            label: ActionWords.copy();
            enabled: Actions.can-copy;
            activated => {
                Actions.copy-selected();
            }
        }
        BarAction {
            label: @tr("Delete");
            enabled: Actions.can-delete;
            color: P.accent3;
            activated => {
                Actions.delete-selected();
            }
        }
        if Actions.report-offered: BarAction {
            label: @tr("Report");
            enabled: Actions.can-report;
            activated => {
                Actions.report-selected();
            }
        }
        BarAction {
            label: @tr("Cancel");
            color: P.muted;
            activated => {
                Actions.cancel-selection();
            }
        }
        T {
            horizontal-stretch: 1;
            text: @tr("Shift-click to select a range");
            color: P.faint;
            horizontal-alignment: right;
            overflow: elide;
        }
    }
}

component CommandLine inherits Rectangle {
    // The strip above the prompt: replying, editing, forwarding (the design's 1b).
    property <bool> strip: Actions.bar != ComposeBar.none && !Actions.selecting && Conversation.chat-id != "";
    height: root.strip ? 74px : 46px;
    background: P.cmd;
    // A reply or an edit begins, a menu or dialog closed: the keyboard comes back here.
    property <int> focus-requests: Actions.focus-requests;
    changed focus-requests => {
        input.focus-text();
    }
    property <[Command]> commands: [
        { command: "/photo", description: AttachWords.photo-or-video() },
        { command: "/file", description: AttachWords.file() },
        { command: "/mute", description: @tr("Mute or unmute this chat") },
        { command: "/pin", description: @tr("Pin or unpin this chat") },
        { command: "/read", description: @tr("Mark this chat as read") },
    ];
    property <string> typed: input.text;

    public function focus-line() {
        input.focus-text();
    }

    function run(line: string) {
        if line.starts-with("/photo") {
            Attachments.choose(AttachKind.photo);
        } else if line.starts-with("/file") {
            Attachments.choose(AttachKind.file);
        } else if line.starts-with("/mute") {
            Conversation.toggle-mute();
        } else if line.starts-with("/pin") {
            Conversation.toggle-pin();
        } else if line.starts-with("/read") {
            Conversation.mark-read();
        } else if !line.starts-with("/") {
            Conversation.send(line);
        }
    }

    Rectangle {
        height: 1px;
        y: 0;
        background: P.line;
    }

    if root.strip: HorizontalLayout {
        y: 0;
        height: 28px;
        padding-top: 7px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;
        T {
            text: (Actions.bar == ComposeBar.reply ? "↱ " : Actions.bar == ComposeBar.edit ? "✎ " : "↪ ") + ActionWords.bar-title();
            color: P.accent;
        }
        T {
            horizontal-stretch: 1;
            text: "── " + ActionWords.bar-line();
            color: P.muted;
            overflow: elide;
        }
        if Actions.bar == ComposeBar.forward: Rectangle {
            width: hide.preferred-width;
            hide := HorizontalLayout {
                T {
                    text: Actions.hide-sender ? "[x]" : "[ ]";
                    color: P.accent;
                }
                T {
                    text: " " + @tr("Hide sender's name");
                    color: P.muted;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Actions.hide-sender = !Actions.hide-sender;
                }
            }
        }
        Action {
            label: "esc";
            color: P.faint;
            activated => {
                Actions.cancel-bar();
            }
        }
    }

    HorizontalLayout {
        y: root.strip ? 28px : 0;
        height: 46px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;
        T {
            text: Account.first-name + " ❯";
            color: P.accent;
        }
        T {
            text: Conversation.chat-id == "" ? "" : "→ " + Signs.of(Conversation.kind, false) + Conversation.title;
            color: P.faint;
            max-width: 220px;
            overflow: elide;
        }
        // "[+]": photos, videos and files (attachments.slint).
        if Conversation.chat-id != "" && Conversation.can-write: VerticalLayout {
            alignment: center;
            plus := Rectangle {
                property <bool> allowed: Conversation.can-send-photos || Conversation.can-send-videos || Conversation.can-send-files;
                width: plus-word.preferred-width;
                height: plus-word.preferred-height;
                plus-word := T {
                    text: Attachments.menu-open ? "[+ ▴]" : "[+]";
                    color: !plus.allowed ? P.faint : Attachments.menu-open ? P.accent : plus-touch.has-hover ? P.text : P.faint;
                    opacity: plus.allowed ? 1 : 0.4;
                }
                plus-touch := TouchArea {
                    mouse-cursor: plus.allowed ? pointer : not-allowed;
                    clicked => {
                        if plus.allowed {
                            Attachments.menu-x = self.absolute-position.x;
                            Attachments.menu-y = self.absolute-position.y;
                            Attachments.menu-focus = -1;
                            Attachments.menu-keyboard = false;
                            Attachments.menu-open = !Attachments.menu-open;
                        }
                    }
                }
            }
        }
        // "[✂]": a screenshot into the card (src/screenshot/), as its shortcut does; greyed where
        // the chat takes no photos.
        if Conversation.chat-id != "" && Conversation.can-write: VerticalLayout {
            alignment: center;
            scissors := Rectangle {
                property <bool> allowed: Conversation.can-send-photos;
                width: scissors-word.preferred-width;
                height: scissors-word.preferred-height;
                scissors-word := T {
                    text: "[✂]";
                    color: !scissors.allowed ? P.faint : scissors-touch.has-hover ? P.text : P.faint;
                    opacity: scissors.allowed ? 1 : 0.4;
                }
                scissors-touch := TouchArea {
                    mouse-cursor: scissors.allowed ? pointer : not-allowed;
                    clicked => {
                        if scissors.allowed {
                            Screenshot.start();
                        }
                    }
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            input := MessageInput {
                text <=> Conversation.draft;
                allow-empty: Actions.bar == ComposeBar.forward;
                enabled: Conversation.chat-id != "" && !Actions.selecting;
                placeholder: Conversation.can-write ? @tr("Write a message, or / for commands") : @tr("/ for commands");
                text-color: P.text;
                placeholder-color: P.faint;
                selection-color: P.sel;
                font-family: P.font;
                font-size: 13px;
                padding-x: 0px;
                padding-y: 4px;
                base-height: 26px;
                tallest: 90px;
                send(words) => {
                    root.run(words);
                }
                // A command is no message: writing one is no typing.
                edited(words) => {
                    if !words.starts-with("/") {
                        Conversation.edited(words);
                    }
                }
            }
        }
        T {
            text: (AppState.send-with-enter ? "⏎ " : "⌘⏎ ") + (Actions.bar == ComposeBar.edit ? @tr("save") : @tr("send"));
            color: P.faint;
        }
    }

    if Actions.selecting: SelectionLine { }

    // What "/…" can be, above the line.
    if root.typed.starts-with("/"): Rectangle {
        x: 16px;
        y: -self.height - 6px;
        width: 420px;
        height: suggestions.preferred-height;
        border-radius: 4px;
        background: P.side;
        border-width: 1px;
        border-color: P.line;
        drop-shadow-blur: 30px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: P.shadow;
        suggestions := VerticalLayout {
            padding-top: 6px;
            padding-bottom: 6px;
            for command in root.commands: Rectangle {
                visible: command.command.starts-with(root.typed) || root.typed == "/";
                height: self.visible ? 26px : 0px;
                background: pick.has-hover ? P.sel : transparent;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    T {
                        width: 140px;
                        text: command.command;
                        color: P.accent;
                    }
                    T {
                        horizontal-stretch: 1;
                        text: command.description;
                        color: P.muted;
                        overflow: elide;
                    }
                }
                pick := TouchArea {
                    clicked => {
                        root.run(command.command);
                        input.text = "";
                    }
                }
            }
        }
    }
}

// A word in brackets that does something on the Unread page: "[Mark as read]".
component Bracketed inherits Rectangle {
    in property <string> label;
    callback clicked;
    width: word.preferred-width;
    word := T {
        x: 0;
        text: "[" + root.label + "]";
        color: P.accent;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// One of a chat's newest unread messages on the Unread page: when, who, what; a click opens the
// chat there.
component UnreadRow inherits Rectangle {
    in property <ChatRow> chat;
    in property <UnreadLine> line;
    property <bool> service: Fmt.is-service(line.content);
    property <string> label: !service && line.content != Content.text ? "[" + Fmt.content(line.content, line.detail) + "] " : "";
    height: 22px;
    background: touch.has-hover ? P.sel.transparentize(0.5) : transparent;

    HorizontalLayout {
        padding-left: 24px;
        spacing: 10px;
        T {
            width: 44px;
            text: Fmt.clock(root.line.time);
            color: P.faint;
        }
        T {
            width: 80px;
            text: root.line.sender;
            color: root.line.mention ? P.accent2 : P.muted;
            overflow: elide;
        }
        T {
            horizontal-stretch: 1;
            text: root.label + (root.service ? Fmt.service(root.line.content, root.line.sender, root.line.detail) : root.line.text);
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Unread.open-message(root.chat.id, root.line.id);
        }
    }
}

// A chat on the Unread page: its head, a rule to the right, then its lines.
component UnreadSection {
    in property <UnreadGroup> group;

    VerticalLayout {
        HorizontalLayout {
            height: 22px;
            spacing: 8px;
            T {
                text: Signs.of(root.group.chat.kind, false);
                color: P.faint;
            }
            T {
                text: root.group.chat.title;
                font-weight: 600;
                max-width: 360px;
                overflow: elide;
            }
            if root.group.chat.unread > 0: T {
                text: root.group.chat.unread;
                color: root.group.chat.muted ? P.faint : P.accent2;
            }
            if root.group.chat.mention: T {
                text: "@";
                color: P.accent2;
            }
            if root.group.chat.muted: T {
                text: "⊘";
                color: P.faint;
            }
            if root.group.chat.marked && root.group.chat.unread == 0: T {
                text: "•";
                color: P.accent2;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Rectangle { height: 1px; background: P.line; }
            }
            if root.group.loading: T {
                text: "[⠋]";
                color: P.faint;
            }
            if !root.group.loading: Bracketed {
                label: @tr("Mark as read");
                clicked => {
                    Unread.mark-read(root.group.chat.id);
                }
            }
        }
        for line in root.group.lines: UnreadRow {
            chat: root.group.chat;
            line: line;
        }
        // The lines' places while they are on their way.
        if root.group.loading: VerticalLayout {
            padding-left: 18px;
            for bar in ["░░░░░  ░░░░░░░  ░░░░░░░░░░░░░░░░░░░░░░░░░░░░", "░░░░░  ░░░░░░░░░░  ░░░░░░░░░░░░░░░░░░", "░░░░░  ░░░░░░  ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░"]: T {
                height: 22px;
                text: bar;
                color: P.line;
                overflow: clip;
            }
        }
        // The chat has more unread messages than the lines: it shows them.
        if root.group.more > 0: Rectangle {
            height: 22px;
            HorizontalLayout {
                padding-left: 18px;
                spacing: 8px;
                alignment: start;
                T {
                    text: "…";
                    color: P.faint;
                }
                T {
                    text: @tr("{n} more — open the chat to see them" | "{n} more — open the chat to see them" % root.group.more);
                    color: P.accent;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Unread.open-chat(root.group.chat.id);
                }
            }
        }
    }
}

// The Unread page (the design's round 2, 2b): the chats with unread messages as a log, each with its
// newest unread messages, one line each; lines on their way are ░ bars. An index, not a reader:
// nothing here is marked read; a line opens the chat at its message. Rust fills the Unread global
// (src/telegram/unread.rs).
component TerminalUnread inherits Rectangle {
    background: P.bg;

    VerticalLayout {
        Rectangle {
            height: 34px;
            background: P.pane-head;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;
                T {
                    text: @tr("Unread");
                    color: P.accent;
                    font-weight: 600;
                }
                if Unread.total > 0: T {
                    text: Fmt.count(Unread.total);
                    color: P.accent2;
                }
                Rectangle { horizontal-stretch: 1; }
                if Unread.total > 0: Bracketed {
                    label: @tr("Mark all as read");
                    clicked => {
                        Unread.mark-all-read();
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: P.line;
            }
        }
        if Unread.groups.length > 0: Flickable {
            vertical-stretch: 1;
            mouse-drag-pan-enabled: false;
            VerticalLayout {
                alignment: start;
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 12px;
                padding-bottom: 16px;
                spacing: 16px;
                for group in Unread.groups: UnreadSection {
                    group: group;
                }
            }
        }
        if Unread.groups.length == 0: Rectangle {
            vertical-stretch: 1;
            T {
                text: "-- " + @tr("You're all caught up") + " --";
                color: P.faint;
            }
        }
    }
}

component StatusBar inherits Rectangle {
    height: 26px;
    background: P.accent;
    callback command-line();

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 18px;
        T {
            text: "FinchGram";
            color: P.on-accent;
            font-size: 12px;
            font-weight: 600;
        }
        Rectangle { horizontal-stretch: 1; }
        T {
            text: AppState.connection == Connection.ready ? @tr("connected") : "[" + Fmt.connection(AppState.connection) + "]";
            color: P.on-accent;
            font-size: 12px;
        }
        Rectangle {
            width: cmd.preferred-width;
            cmd := T {
                x: 0;
                text: "[⌘K " + @tr("command") + "]";
                color: P.on-accent;
                font-size: 12px;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.command-line();
                }
            }
        }
    }
}

export component TerminalWindow inherits Rectangle {
    property <TerminalView> view: TerminalView.chats;
    background: P.bg;

    // ⌘K, from the menu bar (app.slint): the command line.
    property <int> search-requests: AppState.search-requests;
    changed search-requests => {
        root.focus-search();
    }

    public function focus-search() {
        line.focus-line();
    }

    VerticalLayout {
        TitleBar { }
        HorizontalLayout {
            vertical-stretch: 1;
            Side {
                view <=> root.view;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                if Conversation.chat-id != "": Pane {
                    vertical-stretch: 1;
                }
                if Conversation.chat-id == "" && Unread.shown: TerminalUnread {
                    vertical-stretch: 1;
                }
                if Conversation.chat-id == "" && !Unread.shown: Rectangle {
                    vertical-stretch: 1;
                    T {
                        text: "-- " + @tr("Choose a chat on the left") + " --";
                        color: P.faint;
                    }
                }
                line := CommandLine { }
            }
        }
        StatusBar {
            command-line => {
                line.focus-line();
            }
        }
    }

    // A message's menu and the dialogs of its actions, over everything.
    TerminalActions { }
    TerminalAttachments { }
}
