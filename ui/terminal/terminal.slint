// Terminal (the design's "1b 终端"): monospace and keyboard first. The chat list marks each chat
// with its kind's icon, the other themes' (a person, a group, a channel's megaphone, a robot, a
// bookmark; a pin before a pinned one); the chat reads as a log; one command line writes messages
// and runs commands ("/mute", "/pin", …).
import { ListView } from "std-widgets.slint";
import { Toolbox, ToolboxWords } from "../toolbox.slint";
import { TerminalToolbox } from "toolbox.slint";
import { InfoPanel } from "chat-info.slint";
import { ChatInfo } from "../chat-info.slint";
import { AppState, Page, Connection, Theme, Screenshot } from "../state.slint";
import {
    Chats, Conversation, Account, ChatRow, MessageRow, RowKind, ChatKind, Content, Viewer, Actions, ComposeBar, ActionNotice, Attachments, AttachKind, FileState, ChatOrder } from "../telegram.slint";
import { Fmt } from "../format.slint";
import { Mark, Icon, Paragraph, ListEdge, WindowButtonsSpace, WindowMover } from "../widgets.slint";
import { ChatScroll, MessageInput, RichText, MessageArea, ActionWords, KeyScope, AttachWords, ChatMenuWords, SearchInput, SearchWords, ButtonGrid, BotWords } from "../chat.slint";
import { ExtraWords, ReactionChips, ReactionPicker, RoundNoteView, ContactCardView, TopicList } from "../extras.slint";
import { Look } from "../look.slint";
import { Downloads } from "../downloads.slint";
import { TerminalPalette as P } from "palette.slint";
import { Sign } from "signs.slint";
import { TerminalActions } from "actions.slint";
import { TerminalAttachments } from "attachments.slint";
import { TerminalCompose } from "compose.slint";
import { Search, NewChat, NewDialog, ComposeWords } from "../compose.slint";

export enum TerminalView { chats, channels, bots, rules, scheduled }

component T inherits Text {
    font-family: P.font;
    font-size: 13px;
    color: P.text;
    vertical-alignment: center;
}

// A word in brackets that does something: "[dark]", "[⋯]".
component Action {
    in property <string> label;
    in property <color> color: P.muted;
    in property <bool> enabled: true;
    callback activated();
    opacity: enabled ? 1 : 0.4;

    T {
        text: "[" + root.label + "]";
        color: touch.has-hover && root.enabled ? P.accent : root.color;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

// An icon in brackets that does something: the foot's profile and settings. (No bundled font has
// a gear glyph, so the other themes' icons, between two bracket characters.) Disabled, it is a
// mark only: a closed topic's lock, the microphone that is still to come.
component IconAction {
    in property <string> icon;
    in property <color> color: P.muted;
    in property <color> hover: P.text;          // its ink under the pointer
    in property <bool> enabled: true;
    callback activated();
    property <color> ink: touch.has-hover && root.enabled ? root.hover : root.color;

    HorizontalLayout {
        T {
            text: "[";
            color: root.ink;
        }
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                size: 12px;
                color: root.ink;
            }
        }
        T {
            text: "]";
            color: root.ink;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.activated();
        }
    }
}

component TitleBar inherits Rectangle {
    height: 34px;
    background: P.side;

    WindowMover { }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: P.line;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        WindowButtonsSpace { }
        // The mark opens the toolbox (/tools), with a dot while an unpinned tool has something
        // going on.
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 28px;
                height: 24px;
                border-radius: 4px;
                background: mark-touch.has-hover || Toolbox.open ? P.sel : transparent;
                Mark {
                    x: 6px;
                    y: 5px;
                    width: 16px;
                    height: 14px;
                    color: P.accent;
                }
                if Toolbox.logo-dot: Rectangle {
                    x: parent.width - 9px;
                    y: 2px;
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: P.accent2;
                }
                mark-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Toolbox.toggle();
                    }
                }
            }
        }
        T {
            horizontal-stretch: 1;
            text: "FinchGram — " + Account.name;
            color: P.muted;
            overflow: elide;
        }
        // What was just done (copied, saved, reported).
        if Actions.notice != ActionNotice.none: T {
            text: "» " + ActionWords.notice(Actions.notice);
            color: P.accent2;
        }
        Action {
            label: P.dark ? @tr("light") : @tr("dark");
            activated => {
                AppState.change-appearance(P.dark ? "light" : "dark");
            }
        }
    }
}

component SideTab {
    in property <string> label;
    in property <bool> active;
    in property <bool> enabled: true;
    callback activated();
    opacity: enabled ? 1 : 0.4;

    T {
        text: root.label;
        color: root.active ? P.accent : P.faint;
        font-weight: root.active ? 600 : 400;
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

component ChatLine inherits Rectangle {
    in property <ChatRow> chat;
    callback menu(length, length);          // a right click, where it is in the window
    property <bool> open: chat.id == Conversation.chat-id;
    height: 29px;
    background: open ? P.sel : touch.has-hover ? P.sel.transparentize(0.5) : transparent;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        T {
            width: 10px;
            text: root.open ? "▸" : "";
            color: P.accent;
        }
        // The pin, or its room, then the kind's sign: two columns, so the titles line up.
        Rectangle {
            width: 12px;
            if root.chat.pinned: Icon {
                name: "push-pin";
                size: 12px;
                color: P.faint;
                y: (parent.height - self.height) / 2;
            }
        }
        Sign {
            kind: root.chat.kind;
        }
        T {
            horizontal-stretch: 1;
            // Beside a draft, the title gives way last: all of it, or 100px of a long one. (A
            // layout shrinks its items by their stretch, and the draft's line has one too.)
            min-width: root.chat.draft != "" ? min(self.preferred-width, 100px) : 0px;
            text: root.chat.title;
            color: root.open ? P.text : P.muted;
            overflow: elide;
        }
        // Words left in its composer (src/telegram/drafts.rs), after a pencil: the other themes'
        // lists show them in the last message's place, which this list has not. (No bundled font
        // has ✎, so the icon.) At most two fifths of the list (Side's width; the row's own would
        // loop through the bots' Flickable).
        if root.chat.draft != "": HorizontalLayout {
            horizontal-stretch: 1;
            max-width: max(220px, min(560px, AppState.terminal-list-width)) * 0.4;
            spacing: 5px;
            VerticalLayout {
                alignment: center;
                Icon {
                    name: "pencil-simple";
                    size: 12px;
                    color: P.accent2;
                }
            }
            T {
                text: root.chat.draft;
                color: P.accent2;
                overflow: elide;
            }
        }
        T {
            text: root.chat.unread > 0 ? (root.chat.mention ? root.chat.unread + " @" : "" + root.chat.unread) : root.chat.marked ? "•" : "";
            color: root.chat.muted ? P.faint : P.accent2;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Conversation.open(root.chat.id);
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

component MenuEntry inherits Rectangle {
    in property <string> label;
    in property <string> command;
    in property <length> indent;              // one of a group's choices, under the group's name
    callback activated();
    height: 26px;
    background: touch.has-hover ? P.sel : transparent;

    HorizontalLayout {
        padding-left: 12px + root.indent;
        padding-right: 12px;
        spacing: 8px;
        T {
            horizontal-stretch: 1;
            text: root.label;
        }
        T {
            text: root.command;
            color: P.accent;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

// The folders as tabs, "1:All 2:Work …": the first four, the rest behind "more". Each tab is as
// tall as its word: a Rectangle has no height of its own, and a tab without one is drawn but takes
// no clicks. A right click on a tab gives the folder's menu: every chat of it read, and the group
// Sort by: how every folder's chats are ordered.
component Folders {
    property <int> menu-index;              // the folder the menu is for: index into Chats.folders
    property <length> menu-x;

    function show-menu(folder: int, left: length) {
        root.menu-index = folder;
        root.menu-x = max(0px, left - root.absolute-position.x);
        folder-menu.show();
    }

    pure function chosen(order: ChatOrder) -> string {
        return Chats.order == order ? "[x] " : "[ ] ";
    }

    pure function name(index: int) -> string {
        if index < 0 || index >= Chats.folders.length { return ""; }
        return (index + 1) + ":" + (Chats.folders[index].id == 0 ? @tr("All") : Chats.folders[index].name);
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        for folder[index] in Chats.folders: Rectangle {
            property <bool> chosen: index == Chats.folder;
            visible: index < 4;
            width: index < 4 ? label.preferred-width : 0px;
            height: label.preferred-height;
            label := T {
                x: 0;
                font-size: 12px;
                text: (index + 1) + ":" + (folder.id == 0 ? @tr("All") : folder.name);
                color: parent.chosen ? P.accent : P.faint;
                font-weight: parent.chosen ? 600 : 400;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Chats.show-folder(index);
                }
                pointer-event(event) => {
                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                        root.show-menu(index, self.absolute-position.x + self.mouse-x);
                    }
                }
            }
        }
        if Chats.folders.length > 4: Rectangle {
            property <bool> chosen: Chats.folder >= 4;
            width: more.preferred-width;
            height: more.preferred-height;
            more := T {
                x: 0;
                font-size: 12px;
                text: (parent.chosen ? (Chats.folder + 1) + ":" + Chats.folders[Chats.folder].name : @tr("more")) + " ▾";
                color: parent.chosen ? P.accent : P.faint;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    list.show();
                }
                // "more" stands for the folder shown: a right click on it is one on that folder.
                pointer-event(event) => {
                    if parent.chosen && event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                        root.show-menu(Chats.folder, self.absolute-position.x + self.mouse-x);
                    }
                }
            }
            list := PopupWindow {
                x: 0;
                y: 20px;
                width: 180px;
                close-policy: PopupClosePolicy.close-on-click-outside;
                Rectangle {
                    border-radius: 4px;
                    background: P.bg;
                    border-width: 1px;
                    border-color: P.line;
                    drop-shadow-blur: 30px;
                    drop-shadow-offset-y: 12px;
                    drop-shadow-color: P.shadow;
                    VerticalLayout {
                        padding-top: 4px;
                        padding-bottom: 4px;
                        for folder[index] in Chats.folders: Rectangle {
                            property <bool> chosen: index == Chats.folder;
                            visible: index >= 4;
                            height: index >= 4 ? 28px : 0px;
                            background: self.chosen ? P.sel : entry.has-hover ? P.sel.transparentize(0.5) : transparent;
                            T {
                                x: 12px;
                                text: (index + 1) + ":" + folder.name;
                                color: parent.chosen ? P.accent : P.text;
                            }
                            entry := TouchArea {
                                clicked => {
                                    Chats.show-folder(index);
                                    list.close();
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    folder-menu := PopupWindow {
        x: root.menu-x;
        y: 20px;
        width: 230px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            border-radius: 4px;
            background: P.side;
            border-width: 1px;
            border-color: P.line;
            drop-shadow-blur: 30px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: P.shadow;
            VerticalLayout {
                padding-top: 4px;
                padding-bottom: 4px;
                HorizontalLayout {
                    height: 24px;
                    x: 12px;
                    spacing: 5px;
                    T {
                        text: "──";
                        color: P.faint;
                    }
                    T {
                        horizontal-stretch: 1;
                        text: root.name(root.menu-index) + " ──";
                        color: P.faint;
                        overflow: elide;
                    }
                }
                MenuEntry {
                    label: @tr("Mark all as read");
                    // The command line's /readall is for the folder shown.
                    command: root.menu-index == Chats.folder ? "/readall" : "";
                    activated => {
                        Chats.mark-all-read(root.menu-index);
                        folder-menu.close();
                    }
                }
                // How every folder's chats are ordered: a group of choices, the one in force ticked.
                Rectangle {
                    height: 7px;
                    Rectangle {
                        height: 1px;
                        background: P.line;
                    }
                }
                HorizontalLayout {
                    height: 24px;
                    x: 12px;
                    T {
                        text: @tr("Sort by");
                        color: P.faint;
                    }
                }
                MenuEntry {
                    indent: 12px;
                    label: root.chosen(ChatOrder.latest-message) + @tr("Latest message");
                    activated => {
                        Chats.change-order(ChatOrder.latest-message);
                        folder-menu.close();
                    }
                }
                MenuEntry {
                    indent: 12px;
                    label: root.chosen(ChatOrder.name) + @tr("Name");
                    activated => {
                        Chats.change-order(ChatOrder.name);
                        folder-menu.close();
                    }
                }
                MenuEntry {
                    indent: 12px;
                    label: root.chosen(ChatOrder.unread) + @tr("Unread");
                    activated => {
                        Chats.change-order(ChatOrder.unread);
                        folder-menu.close();
                    }
                }
            }
        }
    }
}

component Side inherits Rectangle {
    in-out property <TerminalView> view;
    // What the window leaves it beside the messages and the info panel: while the panel is open
    // it yields down to 220px, without changing the width the user dragged out.
    in property <length> room: 560px;
    width: max(220px, min(560px, min(AppState.terminal-list-width, max(220px, root.room))));
    background: P.side;

    // A chat's menu, from a right click on it: the chat header's menu, for any chat in the lists.
    // Its second page, Add to folder: the account's folders, those the chat is in ticked.
    property <ChatRow> menu-chat;
    property <int> menu-folder;             // where Chats.toggle-pin pins it
    property <bool> menu-folders;           // the second page is showing
    property <length> menu-x;
    property <length> menu-y;

    function show-menu(chat: ChatRow, folder: int, left: length, top: length) {
        root.menu-chat = chat;
        root.menu-folder = folder;
        root.menu-folders = false;
        Chats.open-menu(chat.id);
        root.menu-x = max(0px, left - root.absolute-position.x);
        // Within the list, whichever of the two pages is the taller.
        root.menu-y = max(0px, min(top - root.absolute-position.y, root.height - 38px - 26px * max((Chats.folders.length > 1 ? 4 : 3) + 4, Chats.menu-folders.length + 1)));
        chat-menu.show();
    }

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: P.line;
    }

    VerticalLayout {
        VerticalLayout {
            vertical-stretch: 0;
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 14px;
            // The same room above the folders as below them: the list's rows have 6px of their own.
            padding-bottom: 4px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                SideTab {
                    label: "CHATS";
                    active: root.view == TerminalView.chats;
                    activated => {
                        root.view = TerminalView.chats;
                    }
                }
                SideTab {
                    label: "CHAN";
                    active: root.view == TerminalView.channels;
                    activated => {
                        root.view = TerminalView.channels;
                    }
                }
                SideTab {
                    label: "BOTS";
                    active: root.view == TerminalView.bots;
                    activated => {
                        root.view = TerminalView.bots;
                    }
                }
            }
            // The search over everything ("? search / @username", also /search) and the pencil's
            // menu as "[+ new]" (compose.slint).
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    horizontal-stretch: 1;
                    height: 26px;
                    border-radius: 3px;
                    background: P.bg;
                    border-width: 1px;
                    border-color: search-touch.has-hover ? P.accent.transparentize(0.4) : P.line;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;
                        T {
                            text: "?";
                            color: P.accent;
                        }
                        T {
                            horizontal-stretch: 1;
                            text: ComposeWords.terminal-box();
                            color: P.faint;
                            overflow: elide;
                        }
                    }
                    search-touch := TouchArea {
                        mouse-cursor: text;
                        clicked => {
                            Search.show();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    new-word := Rectangle {
                        width: new-label.preferred-width;
                        height: new-label.preferred-height;
                        new-label := T {
                            text: "[+ " + @tr("terminal" => "new") + "]";
                            color: new-touch.has-hover ? P.text : P.accent;
                        }
                        new-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                new-menu.show();
                            }
                        }
                        new-menu := PopupWindow {
                            x: parent.width - 170px;
                            y: parent.height + 4px;
                            width: 170px;
                            close-policy: PopupClosePolicy.close-on-click-outside;
                            Rectangle {
                                border-radius: 3px;
                                background: P.bg;
                                border-width: 1px;
                                border-color: P.line;
                                drop-shadow-blur: 30px;
                                drop-shadow-offset-y: 12px;
                                drop-shadow-color: P.shadow;
                                VerticalLayout {
                                    padding-top: 4px;
                                    padding-bottom: 4px;
                                    MenuEntry {
                                        label: ComposeWords.new-group();
                                        command: "/group";
                                        activated => {
                                            new-menu.close();
                                            NewChat.start(NewDialog.group);
                                        }
                                    }
                                    MenuEntry {
                                        label: ComposeWords.new-channel();
                                        command: "/channel";
                                        activated => {
                                            new-menu.close();
                                            NewChat.start(NewDialog.channel);
                                        }
                                    }
                                    MenuEntry {
                                        label: ComposeWords.new-chat();
                                        command: "/dm";
                                        activated => {
                                            new-menu.close();
                                            NewChat.start(NewDialog.direct);
                                        }
                                    }
                                    MenuEntry {
                                        label: ComposeWords.add-contact();
                                        command: "/contact";
                                        activated => {
                                            new-menu.close();
                                            NewChat.start(NewDialog.contact);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if root.view == TerminalView.chats: Folders { }
        }

        if AppState.connection != Connection.ready && AppState.connection != Connection.updating: HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 8px;
            T {
                text: "-- " + Fmt.connection(AppState.connection) + " --";
                color: P.accent2;
            }
        }

        // Saved Messages: a fixed row above the list, found without scrolling.
        if root.view == TerminalView.chats && Chats.saved-messages-shown: ChatLine {
            chat: Chats.saved-messages;
            menu(left, top) => {
                root.show-menu(Chats.saved-messages, 0, left, top);
            }
        }

        if root.view == TerminalView.chats && Chats.loaded && Chats.list.length == 0: VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 10px;
            T {
                text: Chats.folder == 0 ? "-- " + @tr("No chats yet") + " --" : "-- " + @tr("No chats in this folder") + " --";
                color: P.faint;
            }
        }

        if root.view == TerminalView.chats: ListView {
            vertical-stretch: 1;
            vertical-scrollbar-policy: always-off;
            horizontal-scrollbar-policy: always-off;
            for chat in Chats.list: ChatLine {
                chat: chat;
                menu(left, top) => {
                    root.show-menu(chat, Chats.folder, left, top);
                }
            }
        }
        if root.view == TerminalView.channels: ListView {
            vertical-stretch: 1;
            vertical-scrollbar-policy: always-off;
            horizontal-scrollbar-policy: always-off;
            for chat in Chats.channels: ChatLine {
                chat: chat;
                menu(left, top) => {
                    root.show-menu(chat, 0, left, top);
                }
            }
        }
        if root.view == TerminalView.bots: Flickable {
            vertical-stretch: 1;
            mouse-drag-pan-enabled: false;
            VerticalLayout {
                alignment: start;
                if Chats.official-bots.length > 0: T {
                    height: 26px;
                    x: 16px;
                    text: "── " + @tr("Official bots") + " ──";
                    color: P.faint;
                }
                for chat in Chats.official-bots: ChatLine {
                    chat: chat;
                    menu(left, top) => {
                        root.show-menu(chat, 0, left, top);
                    }
                }
                if Chats.bots.length > 0: T {
                    height: 26px;
                    x: 16px;
                    text: "── " + @tr("Other bots") + " ──";
                    color: P.faint;
                }
                for chat in Chats.bots: ChatLine {
                    chat: chat;
                    menu(left, top) => {
                        root.show-menu(chat, 0, left, top);
                    }
                }
            }
        }

        // The account, at the foot: one line, as tall as the command line beside it.
        Rectangle {
            vertical-stretch: 0;
            height: P.foot-height;
            Rectangle {
                height: 1px;
                y: 0;
                background: P.line;
            }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;
                T {
                    horizontal-stretch: 1;
                    text: Account.phone == "" ? Account.name : Account.name + " · " + Account.phone;
                    overflow: elide;
                }
                // The profile, where the other themes have it: the icon in brackets. (The settings
                // are in the toolbox, /settings and the menu bar: the maintainer took the gear off
                // the bars on 2026-10-23.)
                IconAction {
                    icon: "user";
                    color: P.accent;
                    activated => {
                        AppState.page = Page.profile;
                    }
                }
            }
        }
    }

    ListEdge {
        x: parent.width - self.width;
        height: parent.height;
        list-width <=> AppState.terminal-list-width;
        narrowest: 220px;
        widest: 560px;
        dropped(width) => {
            AppState.change-list-width(Theme.terminal, width);
        }
    }

    chat-menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 250px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            border-radius: 4px;
            background: P.side;
            border-width: 1px;
            border-color: P.line;
            drop-shadow-blur: 30px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: P.shadow;
            VerticalLayout {
                padding-top: 4px;
                padding-bottom: 4px;
                HorizontalLayout {
                    height: 24px;
                    x: 12px;
                    spacing: 5px;
                    T {
                        text: "──";
                        color: P.faint;
                    }
                    Sign {
                        kind: root.menu-chat.kind;
                    }
                    T {
                        horizontal-stretch: 1;
                        text: root.menu-chat.title + " ──";
                        color: P.faint;
                        overflow: elide;
                    }
                }
                if !root.menu-folders: MenuEntry {
                    label: root.menu-chat.muted ? @tr("Unmute") : @tr("Mute");
                    activated => {
                        Chats.toggle-mute(root.menu-chat.id);
                        chat-menu.close();
                    }
                }
                if !root.menu-folders: MenuEntry {
                    label: root.menu-chat.pinned ? @tr("Unpin") : @tr("Pin");
                    activated => {
                        Chats.toggle-pin(root.menu-chat.id, root.menu-folder);
                        chat-menu.close();
                    }
                }

                if !root.menu-folders && Chats.folders.length > 1: MenuEntry {
                    label: @tr("Add to folder");
                    activated => {
                        root.menu-folders = true;
                    }
                }
                if !root.menu-folders: MenuEntry {
                    label: @tr("Copy ID");
                    activated => {
                        Chats.copy-id(root.menu-chat.id);
                        chat-menu.close();
                    }
                }
                // Telegram's own actions on the chat (chats.rs); the ones that cannot be undone ask first.
                if !root.menu-folders && root.menu-chat.kind != ChatKind.saved: Rectangle {
                    height: 7px;
                    Rectangle {
                        height: 1px;
                        background: P.line;
                    }
                }
                if !root.menu-folders && (root.menu-chat.kind == ChatKind.user || root.menu-chat.kind == ChatKind.bot): MenuEntry {
                    label: ChatMenuWords.block(root.menu-chat.kind, root.menu-chat.blocked);
                    activated => {
                        Chats.toggle-block(root.menu-chat.id);
                        chat-menu.close();
                    }
                }
                if !root.menu-folders && root.menu-chat.reportable: MenuEntry {
                    label: ChatMenuWords.report();
                    activated => {
                        Chats.report(root.menu-chat.id);
                        chat-menu.close();
                    }
                }
                if !root.menu-folders && (root.menu-chat.kind == ChatKind.group || root.menu-chat.kind == ChatKind.channel): MenuEntry {
                    label: ChatMenuWords.leave(root.menu-chat.kind);
                    activated => {
                        Chats.leave(root.menu-chat.id);
                        chat-menu.close();
                    }
                }
                if !root.menu-folders && root.menu-chat.deletable && (root.menu-chat.kind == ChatKind.user || root.menu-chat.kind == ChatKind.bot): MenuEntry {
                    label: ChatMenuWords.delete();
                    activated => {
                        Chats.delete-chat(root.menu-chat.id);
                        chat-menu.close();
                    }
                }
                if root.menu-folders: MenuEntry {
                    label: @tr("Back");
                    activated => {
                        root.menu-folders = false;
                    }
                }
                if root.menu-folders: VerticalLayout {
                    for choice in Chats.menu-folders: MenuEntry {
                        label: (choice.inside ? "[x] " : "[ ] ") + choice.name;
                        activated => {
                            Chats.toggle-in-folder(root.menu-chat.id, choice.folder);
                            chat-menu.close();
                        }
                    }
                }
            }
        }
    }
}

// One line of the log: time, sender, words. While messages are being chosen, "[x]" in front.
component LogLine {
    in property <MessageRow> message;
    property <bool> has-media: message.media.length > 0 || message.files.length > 0;
    property <bool> reachable: !message.reply.gone && message.reply.id != "";
    height: lines.preferred-height;

    lines := HorizontalLayout {
        spacing: 8px;
        if Actions.selecting: T {
            width: 24px;
            text: root.message.selected ? "[x]" : "[ ]";
            color: root.message.selected ? P.accent : P.faint;
            vertical-alignment: top;
            line-height-factor: P.leading(1.6);
        }
        T {
            width: 44px;
            text: root.message.time;
            color: P.faint;
            vertical-alignment: top;
            line-height-factor: P.leading(1.6);
        }
        T {
            width: 64px;
            text: root.message.outgoing ? Account.first-name : root.message.sender;
            color: P.sender(root.message.sender-color, root.message.outgoing);
            overflow: elide;
            vertical-alignment: top;
            line-height-factor: P.leading(1.6);
        }
        VerticalLayout {
            horizontal-stretch: 1;
            if root.message.forwarded-from != "": T {
                text: "↪ " + @tr("Forwarded from {0}", root.message.forwarded-from);
                color: P.muted;
                vertical-alignment: top;
                line-height-factor: P.leading(1.6);
                overflow: elide;
            }
            // The message it replies to: "↱ Jie: I'm lubing my 65% today"; a click goes to it.
            if root.message.reply.shown: Rectangle {
                height: quote.preferred-height;
                quote := HorizontalLayout {
                    alignment: start;
                    T {
                        text: "↱ ";
                        color: P.faint;
                        line-height-factor: P.leading(1.6);
                    }
                    if root.message.reply.sender != "": T {
                        text: root.message.reply.sender + ": ";
                        color: P.accent;
                        line-height-factor: P.leading(1.6);
                    }
                    T {
                        horizontal-stretch: 1;
                        text: ActionWords.quote-line(root.message.reply);
                        color: P.faint;
                        font-italic: root.message.reply.gone;
                        line-height-factor: P.leading(1.6);
                        overflow: elide;
                    }
                }
                TouchArea {
                    mouse-cursor: root.reachable ? pointer : default;
                    clicked => {
                        if root.reachable {
                            Actions.jump(root.message.reply.id);
                        }
                    }
                }
            }
            if root.message.rich: RichText {
                text: root.message.rich-text;
                default-color: P.text;
                default-font-family: P.font;
                default-font-size: 13px;
                link-color: P.accent;
            }
            if root.message.rich && (root.message.edited || root.message.sending): T {
                text: (root.message.edited ? @tr("(edited)") : "") + (root.message.sending ? " …" : "");
                color: P.faint;
            }
            if !root.message.rich && !root.message.round.shown && !root.message.contact.shown && (!root.has-media || root.message.text != ""): Paragraph {
                text: (root.has-media ? root.message.text : Fmt.body(root.message.content, root.message.text, root.message.detail))
                    + (root.message.edited ? " " + @tr("(edited)") : "")
                    + (root.message.sending ? " …" : "");
                color: root.has-media || root.message.content == Content.text ? P.text : P.muted;
                font-family: P.font;
                font-size: 13px;
                line-height-factor: P.leading(1.6);
            }
            // Its photos and videos, a line each: "↳ [vid 0:42] clip.mp4"; on its way up, with
            // its progress and "[x]" to stop it.
            for item in root.message.media: Rectangle {
                height: tag.preferred-height;
                tag := T {
                    x: 0;
                    text: "↳ [" + (item.video ? "vid " + Fmt.duration(item.duration) : "img") + (item.secret ? " · " + @tr("Tap to view") : "") + "]"
                        + (item.name == "" ? "" : " " + item.name)
                        + (item.uploading && !root.message.failed ? "  " + AttachWords.bar(item.progress) + " " + Math.round(item.progress * 100) + "%  [x]" : "");
                    color: root.message.failed ? P.faint : item.uploading ? P.muted : P.accent;
                    overflow: elide;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if item.uploading && !root.message.failed {
                            Conversation.cancel-upload(item.id);
                        } else {
                            Viewer.view(item.id, true);
                        }
                    }
                    // A right click on it is for this photo or video (Actions.hovered-media).
                    changed has-hover => {
                        if self.has-hover {
                            Actions.hovered-media = item.id;
                        } else if Actions.hovered-media == item.id {
                            Actions.hovered-media = "";
                        }
                    }
                }
            }
            // A link's preview, as the design's line: "↳ [⚡IV] title · author".
            if root.message.preview.url != "": Rectangle {
                height: preview-line.preferred-height;
                preview-line := T {
                    x: 0;
                    width: parent.width;
                    text: "↳ [" + (root.message.preview.instant-view ? "⚡IV" : "link") + "] " + root.message.preview.title
                        + " · " + (root.message.preview.about != "" ? root.message.preview.about : root.message.preview.site);
                    color: P.accent;
                    overflow: elide;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Conversation.open-link(root.message.preview.url);
                    }
                }
            }
            // A bot's buttons: cells sharing the line, row by row (chat.slint's ButtonGrid; bots.rs).
            if root.message.buttons.length > 0: VerticalLayout {
                padding-top: 2px;
                ButtonGrid {
                    max-width: 480px;
                    rows: root.message.buttons;
                    busy-prefix: root.message.id + ":";
                    fill: P.sel;
                    ink: P.accent;
                    radius: 2px;
                    row-height: 26px;
                    font-family: P.font;
                    font-size: 12px;
                    pressed(row, column) => {
                        Actions.press(root.message.id, row, column);
                    }
                }
            }
            // Its file: "↳ [pdf] October screenings.pdf  1.2 MB  [▼ download]".
            for file in root.message.files: file-line := Rectangle {
                height: line.preferred-height;
                property <bool> moving: file.state == FileState.uploading || file.state == FileState.downloading;
                line := T {
                    x: 0;
                    text: "↳ [" + AttachWords.file-sign(file.file-type) + "] " + file.name + "  "
                        + (file-line.moving ? AttachWords.progress(file.moved, file.size) + "  " + AttachWords.bar(file.progress) + "  [x]"
                            : file.size + (file.state == FileState.remote ? "  [▼ " + AttachWords.download().to-lowercase() + "]"
                                : file-touch.has-hover ? "  [" + AttachWords.show-in-finder().to-lowercase() + "]" : ""));
                    color: root.message.failed ? P.faint : P.accent;
                    overflow: elide;
                }
                file-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Conversation.file-action(file.id);
                    }
                }
            }
            // The design's fifth round (extras.slint): a round video message, a contact card, the
            // reactions and their picker, each on a line of its own under the words.
            if root.message.round.shown: HorizontalLayout {
                alignment: start;
                padding-top: 4px;
                RoundNoteView {
                    note: root.message.round;
                    size: 160px;
                    line: P.line;
                    accent: P.accent;
                    side: P.side;
                    faint: P.faint;
                    mono: P.font;
                    font-family: P.font;
                    clicked => {
                        Conversation.play-round(root.message.id);
                    }
                }
            }
            if root.message.contact.shown: HorizontalLayout {
                alignment: start;
                padding-top: 4px;
                ContactCardView {
                    card: root.message.contact;
                    bg: P.side;
                    line: P.line;
                    soft: P.sel;
                    soft-ink: P.accent;
                    accent: P.accent;
                    text-color: P.text;
                    muted: P.muted;
                    faint: P.faint;
                    radius: 3px;
                    av-radius: 3px;
                    font-family: P.font;
                    font-size: 13px;
                    small: 12px;
                    message => {
                        Conversation.contact-message(root.message.id);
                    }
                    invite => {
                        Conversation.contact-invite(root.message.id);
                    }
                    add => {
                        Conversation.contact-add(root.message.id);
                    }
                    share => {
                        Conversation.contact-share(root.message.id);
                    }
                }
            }
            if root.message.reactions.length > 0: VerticalLayout {
                padding-top: 4px;
                ReactionChips {
                    reactions: root.message.reactions;
                    fill: P.sel;
                    ink: P.muted;
                    chosen-fill: P.sel;
                    chosen-ink: P.accent;
                    ring: P.accent;
                    radius: 2px;
                    font-family: P.font;
                    react(emoji) => {
                        Conversation.react(root.message.id, emoji);
                    }
                }
            }
            if Conversation.reaction-picker == root.message.id: HorizontalLayout {
                alignment: start;
                padding-top: 4px;
                ReactionPicker {
                    choices: Conversation.reaction-choices;
                    max: Conversation.reaction-max;
                    bg: P.side;
                    line: P.line;
                    soft: P.bg;
                    note-color: P.faint;
                    shadow: P.shadow;
                    radius: 3px;
                    font-family: P.font;
                    pick(emoji) => {
                        Conversation.react(root.message.id, emoji);
                    }
                }
            }
            // Not sent: "↳ ✗ not sent [retry] [delete]".
            if root.message.failed: HorizontalLayout {
                alignment: start;
                spacing: 8px;
                T {
                    text: "↳ ✗ " + AttachWords.not-sent().to-lowercase();
                    color: P.accent3;
                }
                Rectangle {
                    width: retry.preferred-width;
                    retry := T {
                        text: "[" + AttachWords.retry().to-lowercase() + "]";
                        color: retry-touch.has-hover ? P.accent : P.accent3;
                    }
                    retry-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Conversation.retry(root.message.id);
                        }
                    }
                }
                Rectangle {
                    width: discard.preferred-width;
                    discard := T {
                        text: "[" + AttachWords.delete().to-lowercase() + "]";
                        color: discard-touch.has-hover ? P.accent : P.accent3;
                    }
                    discard-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Conversation.discard(root.message.id);
                        }
                    }
                }
            }
        }
        // At the end of the first line: "[share]" under a channel's post (src/telegram/share.rs),
        // and the smiley that opens the reactions' picker (a double click reacts at once:
        // MessageArea). 2px down: the line has the log's leading, these have none.
        if Conversation.kind == ChatKind.channel && root.message.can-share: VerticalLayout {
            horizontal-stretch: 0;
            alignment: start;
            padding-top: 2px;
            Action {
                label: ExtraWords.share().to-lowercase();
                color: P.faint;
                activated => {
                    Conversation.share-message(root.message.id);
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: start;
            padding-top: 2px;
            IconAction {
                icon: "smiley";
                color: Conversation.reaction-picker == root.message.id ? P.accent : P.faint;
                hover: P.accent;
                activated => {
                    if Conversation.reaction-picker == root.message.id {
                        Conversation.close-reactions();
                    } else {
                        Conversation.open-reactions(root.message.id);
                    }
                }
            }
        }
    }
}

component Line {
    in property <MessageRow> message;
    // Conversation.reveal names this row: the list scrolls to it.
    callback reveal(length, length);
    property <bool> wanted: message.id != "" && Conversation.reveal == message.id;
    changed wanted => {
        if self.wanted {
            root.reveal(root.y, root.y + root.height);
        }
    }

    VerticalLayout {
        if root.message.kind == RowKind.day: T {
            height: 30px;
            text: "── " + Fmt.day-title(root.message.day) + " ──";
            color: P.faint;
            vertical-alignment: bottom;
        }
        if root.message.kind == RowKind.service: Paragraph {
            text: root.message.time + "  -- " + Fmt.service(root.message.content, root.message.outgoing ? @tr("You") : root.message.sender, root.message.detail) + " --";
            color: P.faint;
            font-family: P.font;
            font-size: 13px;
        }
        if root.message.kind == RowKind.sponsored: Rectangle {
            height: ad.preferred-height;
            ad := Paragraph {
                width: parent.width;
                text: root.message.time + "  [" + @tr("sponsored") + "] " + root.message.sender + " · " + root.message.text
                    + (root.message.button == "" ? "" : "  [" + root.message.button + " ↗]");
                color: P.muted;
                font-family: P.font;
                font-size: 13px;
                line-height-factor: P.leading(1.6);
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Conversation.open-sponsored(root.message.id);
                }
            }
        }
        // A message's row: lit while chosen or while its menu is open, ringed when jumped to.
        if root.message.kind == RowKind.message: Rectangle {
            height: log.preferred-height;
            area := MessageArea {
                message: root.message;
                Rectangle {
                    x: -6px;
                    width: parent.width + 12px;
                    border-radius: 2px;
                    background: root.message.selected || Actions.menu-row == root.message.id ? P.sel : transparent;
                    border-width: Actions.flash == root.message.id ? 1px : 0;
                    border-color: P.accent;
                    animate background { duration: 250ms; }
                }
                log := LogLine {
                    x: 0;
                    width: parent.width;
                    message: root.message;
                }
            }
        }
    }
}

// Searching in the chat: the line under the pane head, "search ❯ words  3 / 14 [↑] [↓] [esc]"
// (src/telegram/search.rs). ⏎ goes to the next match up the chat, ⇧⏎ down, esc closes it.
component SearchLine inherits Rectangle {
    height: 30px;
    background: P.pane-head;
    property <int> requests: Conversation.search-requests;
    changed requests => {
        input.focus-text();
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;
        T {
            text: @tr("search") + " ❯";
            color: P.accent;
        }
        input := SearchInput {
            horizontal-stretch: 1;
            placeholder: SearchWords.placeholder;
            text-color: P.text;
            placeholder-color: P.faint;
            selection-color: P.accent;
            selection-text-color: P.on-accent;
            font-family: P.font;
            font-size: 13px;
            edited(words) => {
                Conversation.search(words);
            }
            accepted => {
                Conversation.search-step(true);
            }
            back => {
                Conversation.search-step(false);
            }
            escape => {
                Conversation.close-search();
            }
        }
        T {
            text: SearchWords.position;
            color: P.faint;
        }
        Action {
            label: "↑";
            enabled: SearchWords.can-go-up;
            activated => {
                Conversation.search-step(true);
            }
        }
        Action {
            label: "↓";
            enabled: SearchWords.can-go-down;
            activated => {
                Conversation.search-step(false);
            }
        }
        Action {
            label: "esc";
            color: P.faint;
            activated => {
                Conversation.close-search();
            }
        }
    }
}

// The chat's newest pinned message, as a line under the pane head: a click goes to it (bots.rs).
component PinnedLine inherits Rectangle {
    height: 28px;
    background: P.pane-head;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: P.line;
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        T {
            text: "[" + BotWords.pinned().to-lowercase() + "]";
            color: P.accent2;
        }
        T {
            horizontal-stretch: 1;
            text: (Conversation.pinned-message.sender == "" ? "" : Conversation.pinned-message.sender + ": ") + ActionWords.quote-line(Conversation.pinned-message);
            color: P.muted;
            overflow: elide;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Conversation.open-pinned();
        }
    }
}

// A topic open in a group with topics (src/telegram/topics.rs), as a line under the pane head:
// "[← all topics] / 📷 Gear talk", a lock after a closed one.
component TopicLine inherits Rectangle {
    height: 28px;
    background: P.pane-head;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: P.line;
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        Action {
            label: "← " + ExtraWords.all-topics().to-lowercase();
            color: P.accent;
            activated => {
                Conversation.back-to-topics();
            }
        }
        T {
            text: "/";
            color: P.faint;
        }
        if Conversation.topic-icon != "": T {
            text: Conversation.topic-icon;
        }
        T {
            text: Conversation.topic-title;
            font-weight: 600;
            overflow: elide;
        }
        if Conversation.topic-closed: IconAction {
            icon: "lock-simple";
            color: P.faint;
            enabled: false;
        }
        Rectangle { horizontal-stretch: 1; }
    }
}

component Pane inherits Rectangle {
    background: P.bg;

    VerticalLayout {
        x: 0;
        width: parent.width - side.width;
        Rectangle {
            height: 34px;
            background: P.pane-head;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;
                HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 5px;
                    Sign {
                        kind: Conversation.kind;
                        color: P.accent;
                    }
                    T {
                        text: Conversation.title;
                        color: P.accent;
                        font-weight: 600;
                        overflow: elide;
                    }
                }
                T {
                    horizontal-stretch: 1;
                    text: Conversation.typing != "" ? @tr("typing…")
                        : Fmt.status(Conversation.status, Conversation.last-seen, Conversation.members, Conversation.online-members);
                    color: P.faint;
                    overflow: elide;
                }
                // Searching in the chat: the line under the head (SearchLine).
                Action {
                    label: @tr("search");
                    color: Conversation.search-open ? P.accent : P.muted;
                    activated => {
                        if Conversation.search-open {
                            Conversation.close-search();
                        } else {
                            Conversation.search-open = true;
                            Conversation.search-requests += 1;
                        }
                    }
                }
                // The chat's info panel (chat_info.rs; ⌘I), lit while it is open.
                Action {
                    label: @tr("chat info");
                    enabled: Conversation.chat-id != "";
                    color: ChatInfo.open ? P.accent : P.muted;
                    activated => {
                        ChatInfo.toggle();
                    }
                }
                Action {
                    label: "⋯";
                    activated => {
                        menu.show();
                    }
                }
            }
            menu := PopupWindow {
                x: parent.width - 262px;
                y: 34px;
                width: 250px;
                close-policy: PopupClosePolicy.close-on-click-outside;
                Rectangle {
                    border-radius: 4px;
                    background: P.side;
                    border-width: 1px;
                    border-color: P.line;
                    drop-shadow-blur: 30px;
                    drop-shadow-offset-y: 12px;
                    drop-shadow-color: P.shadow;
                    VerticalLayout {
                        padding-top: 4px;
                        padding-bottom: 4px;
                        HorizontalLayout {
                            height: 24px;
                            x: 12px;
                            spacing: 5px;
                            T {
                                text: "──";
                                color: P.faint;
                            }
                            Sign {
                                kind: Conversation.kind;
                            }
                            T {
                                horizontal-stretch: 1;
                                text: Conversation.title + " ──";
                                color: P.faint;
                                overflow: elide;
                            }
                        }
                        MenuEntry {
                            label: Conversation.muted ? @tr("Unmute") : @tr("Mute");
                            command: "/mute";
                            activated => {
                                Conversation.toggle-mute();
                                menu.close();
                            }
                        }
                        MenuEntry {
                            label: Conversation.pinned ? @tr("Unpin") : @tr("Pin");
                            command: "/pin";
                            activated => {
                                Conversation.toggle-pin();
                                menu.close();
                            }
                        }
                        MenuEntry {
                            label: @tr("Copy ID");
                            command: "/id";
                            activated => {
                                Conversation.copy-id();
                                menu.close();
                            }
                        }
                    }
                }
            }
        }
        if Conversation.search-open: SearchLine { }
        if Conversation.pinned-message.shown: PinnedLine { }
        if Conversation.topic-id != "": TopicLine { }

        scroll := ChatScroll {
            vertical-stretch: 1;
            from-top: Conversation.showing-topics;
            spacing: 3px;
            margin-left: 16px;
            margin-right: 16px;
            margin-top: 10px;
            margin-bottom: 14px;
            // A group with topics opens on them (src/telegram/topics.rs).
            if Conversation.showing-topics: TopicList {
                bg: P.bg;
                side: P.side;
                soft: P.sel;
                soft-ink: P.accent;
                line: P.line;
                accent: P.accent;
                accent-ink: P.accent;
                on-accent: P.on-accent;
                text-color: P.text;
                muted: P.muted;
                faint: P.faint;
                danger: P.accent3;
                // Translucent: the list's input paints selected words in the text colour, which a
                // solid accent would hide (the command line's gets P.on-accent instead).
                selection: P.accent.transparentize(0.65);
                radius: 2px;
                big-radius: 3px;
                font-family: P.font;
                font-size: 13px;
                small: 12px;
            }
            for row in Conversation.messages: Line {
                message: row;
                reveal(top, bottom) => {
                    scroll.reveal(top, bottom);
                }
            }
            if Conversation.typing != "": T {
                text: "…… " + @tr("{0} is typing…", Conversation.typing);
                color: P.faint;
            }
        }
        // A bot's keyboard, above the command line (bots.rs).
        if Conversation.can-write && !Actions.selecting && Conversation.keyboard.length > 0 && !Conversation.keyboard-hidden: HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 10px;
            ButtonGrid {
                rows: Conversation.keyboard;
                fill: P.sel;
                ink: P.accent;
                radius: 2px;
                row-height: 28px;
                font-family: P.font;
                font-size: 12px;
                pressed(row, column) => {
                    Conversation.press-key(row, column);
                }
            }
        }
    }

    // The chat's info panel (or the management page in its place, manage.rs) beside the
    // messages: the design's column squeezes them, 320px wide, and slides open and shut.
    side := Rectangle {
        property <bool> shown: Conversation.chat-id != "" && ChatInfo.open;
        x: parent.width - self.width;
        y: 0;
        width: shown ? 320px : 0px;
        height: parent.height;
        clip: true;
        animate width { duration: 180ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        if ChatInfo.open || side.width > 0px: InfoPanel {
            x: 0;
            y: 0;
            width: 320px;
            height: parent.height;
        }
    }
}

// The commands of the command line.
export struct Command {
    command: string,
    description: string,
}

// What to do with the messages chosen, in place of the command line (the design's 1b): "[Forward]",
// in the faint colour where they do not all allow it.
component BarAction {
    in property <string> label;
    in property <bool> enabled: true;
    in property <color> color: P.text;
    callback activated();

    T {
        text: "[" + root.label + "]";
        color: !root.enabled ? P.faint : touch.has-hover ? P.accent : root.color;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

component SelectionLine inherits Rectangle {
    background: P.cmd;

    Rectangle {
        height: 1px;
        y: 0;
        background: P.line;
    }

    KeyScope {
        width: 0;
        height: 0;
        escape => {
            Actions.cancel-selection();
        }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        T {
            text: "── " + ActionWords.selected() + " ──";
            color: P.accent;
        }
        BarAction {
            label: @tr("Forward");
            enabled: Actions.can-forward;
            activated => {
                Actions.forward-selected();
            }
        }
        BarAction {
            label: ActionWords.copy();
            enabled: Actions.can-copy;
            activated => {
                Actions.copy-selected();
            }
        }
        BarAction {
            label: @tr("Delete");
            enabled: Actions.can-delete;
            color: P.accent3;
            activated => {
                Actions.delete-selected();
            }
        }
        if Actions.report-offered: BarAction {
            label: @tr("Report");
            enabled: Actions.can-report;
            activated => {
                Actions.report-selected();
            }
        }
        BarAction {
            label: @tr("Cancel");
            color: P.muted;
            activated => {
                Actions.cancel-selection();
            }
        }
        T {
            horizontal-stretch: 1;
            text: @tr("Shift-click to select a range");
            color: P.faint;
            horizontal-alignment: right;
            overflow: elide;
        }
    }
}

component CommandLine inherits Rectangle {
    // The strip above the prompt: replying, editing, forwarding (the design's 1b); under it, what
    // Telegram refused (Conversation.send-error), while there is something.
    property <bool> strip: Actions.bar != ComposeBar.none && !Actions.selecting && Conversation.chat-id != "";
    property <bool> refused: Conversation.send-error != "" && !Actions.selecting && Conversation.chat-id != "";
    property <length> above: (root.strip ? 28px : 0px) + (root.refused ? 28px : 0px);
    height: P.foot-height + root.above;
    background: P.cmd;
    // A reply or an edit begins, a menu or dialog closed: the keyboard comes back here.
    // A chat one only reads (a channel, mostly), or a closed topic: no words to write, so no input
    // and no cursor; a channel has muting in their place, as the other themes' composer does, a
    // closed topic the words saying so (src/telegram/topics.rs).
    property <bool> read-only: Conversation.chat-id != "" && (!Conversation.can-write || Conversation.topic-closed);
    // Where words can go: not while a group's topics are listed.
    property <bool> writable: Conversation.chat-id != "" && Conversation.can-write && !Conversation.topic-closed && !Conversation.showing-topics;
    property <int> focus-requests: Actions.focus-requests;
    changed focus-requests => {
        if !root.read-only {
            input.focus-text();
        }
    }
    property <[Command]> commands: [
        { command: "/photo", description: AttachWords.photo-or-video() },
        { command: "/file", description: AttachWords.file() },
        { command: "/mute", description: @tr("Mute or unmute this chat") },
        { command: "/pin", description: @tr("Pin or unpin this chat") },
        { command: "/readall", description: @tr("Mark every chat in this folder as read") },
        { command: "/id", description: @tr("Copy this chat's ID") },
        { command: "/search", description: @tr("Search chats, contacts, @usernames and messages") },
        { command: "/group", description: ComposeWords.new-group() },
        { command: "/channel", description: ComposeWords.new-channel() },
        { command: "/dm", description: ComposeWords.new-chat() },
        { command: "/contact", description: ComposeWords.add-contact() },
        { command: "/tools", description: ToolboxWords.title() },
        { command: "/accounts", description: ToolboxWords.accounts() },
        { command: "/settings", description: ToolboxWords.settings() },
        { command: "/ai", description: ToolboxWords.ai-settings() + " · " + ToolboxWords.not-yet() },
        { command: "/me", description: ToolboxWords.profile() },
    ];
    property <string> typed: input.text;

    public function focus-line() {
        if !root.read-only {
            input.focus-text();
        }
    }

    function run(line: string) {
        if line.starts-with("/photo") {
            Attachments.choose(AttachKind.photo);
        } else if line.starts-with("/file") {
            Attachments.choose(AttachKind.file);
        } else if line.starts-with("/mute") {
            Conversation.toggle-mute();
        } else if line.starts-with("/pin") {
            Conversation.toggle-pin();
        } else if line.starts-with("/readall") {
            Chats.mark-all-read(Chats.folder);
        } else if line.starts-with("/id") {
            Conversation.copy-id();
        } else if line.starts-with("/search") {
            // "/search keeb": the search over everything, with the words.
            Search.show-with(line);
        } else if line.starts-with("/group") {
            NewChat.start(NewDialog.group);
        } else if line.starts-with("/channel") {
            NewChat.start(NewDialog.channel);
        } else if line.starts-with("/dm") {
            NewChat.start(NewDialog.direct);
        } else if line.starts-with("/contact") {
            NewChat.start(NewDialog.contact);
        } else if line.starts-with("/tools") {
            // The toolbox in the pane's place (toolbox.slint): "/tools 传输" at a category; the
            // same command again closes it. Words that name no category leave it as it is.
            Toolbox.command(line);
        } else if line.starts-with("/accounts") {
            Toolbox.command("accounts");
        } else if line.starts-with("/ai") {
            // The AI settings are not in this version: the list of commands says so.
        } else if line.starts-with("/settings") {
            AppState.page = Page.settings;
        } else if line.starts-with("/me") {
            AppState.page = Page.profile;
        } else if !line.starts-with("/") {
            // Slow mode still holds (the hint says for how long): the words stay on the line.
            if Conversation.slow-wait > 0 {
                input.text = line;
            } else {
                Conversation.send(line);
            }
        } else if Conversation.can-write {
            // A bot's command, or any other "/words": sent as they are, as Telegram's apps do.
            Conversation.send-command(line);
        }
    }

    Rectangle {
        height: 1px;
        y: 0;
        background: P.line;
    }

    if root.strip: HorizontalLayout {
        y: 0;
        height: 28px;
        padding-top: 7px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;
        T {
            text: (Actions.bar == ComposeBar.reply ? "↱ " : Actions.bar == ComposeBar.edit ? "✎ " : "↪ ") + ActionWords.bar-title();
            color: P.accent;
        }
        T {
            horizontal-stretch: 1;
            text: "── " + ActionWords.bar-line();
            color: P.muted;
            overflow: elide;
        }
        if Actions.bar == ComposeBar.forward: Rectangle {
            width: hide.preferred-width;
            hide := HorizontalLayout {
                T {
                    text: Actions.hide-sender ? "[x]" : "[ ]";
                    color: P.accent;
                }
                T {
                    text: " " + @tr("Hide sender's name");
                    color: P.muted;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Actions.hide-sender = !Actions.hide-sender;
                }
            }
        }
        Action {
            label: "esc";
            color: P.faint;
            activated => {
                Actions.cancel-bar();
            }
        }
    }

    // What Telegram refused, in its words (src/telegram/errors.rs), above the prompt.
    if root.refused: HorizontalLayout {
        y: root.strip ? 28px : 0;
        height: 28px;
        padding-top: 7px;
        padding-left: 16px;
        padding-right: 16px;
        T {
            text: Conversation.send-error;
            color: P.accent3;
            overflow: elide;
        }
    }

    HorizontalLayout {
        y: root.above;
        height: P.foot-height;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;
        // The prompt is the name alone: the chat's name is in the pane head already.
        T {
            text: Account.first-name + " ❯";
            color: P.accent;
        }
        if root.read-only && Conversation.kind == ChatKind.channel: Action {
            label: Conversation.muted ? @tr("unmute") : @tr("mute");
            color: P.accent;
            activated => {
                Conversation.toggle-mute();
            }
        }
        // "[+]": photos, videos and files (attachments.slint).
        if root.writable: VerticalLayout {
            alignment: center;
            plus := Rectangle {
                property <bool> allowed: Conversation.can-send-photos || Conversation.can-send-videos || Conversation.can-send-files;
                width: plus-word.preferred-width;
                height: plus-word.preferred-height;
                plus-word := T {
                    text: Attachments.menu-open ? "[+ ▴]" : "[+]";
                    color: !plus.allowed ? P.faint : Attachments.menu-open ? P.accent : plus-touch.has-hover ? P.text : P.faint;
                    opacity: plus.allowed ? 1 : 0.4;
                }
                plus-touch := TouchArea {
                    mouse-cursor: plus.allowed ? pointer : not-allowed;
                    clicked => {
                        if plus.allowed {
                            Attachments.menu-x = self.absolute-position.x;
                            Attachments.menu-y = self.absolute-position.y;
                            Attachments.menu-focus = -1;
                            Attachments.menu-keyboard = false;
                            Attachments.menu-open = !Attachments.menu-open;
                        }
                    }
                }
            }
        }
        // "[✂]": a screenshot into the card (src/screenshot/), as its shortcut does; greyed where
        // the chat takes no photos.
        if root.writable: VerticalLayout {
            alignment: center;
            scissors := Rectangle {
                property <bool> allowed: Conversation.can-send-photos;
                width: scissors-word.preferred-width;
                height: scissors-word.preferred-height;
                scissors-word := T {
                    text: "[✂]";
                    color: !scissors.allowed ? P.faint : scissors-touch.has-hover ? P.text : P.faint;
                    opacity: scissors.allowed ? 1 : 0.4;
                }
                scissors-touch := TouchArea {
                    mouse-cursor: scissors.allowed ? pointer : not-allowed;
                    clicked => {
                        if scissors.allowed {
                            Screenshot.start();
                        }
                    }
                }
            }
        }
        // "[mic]": voice messages are still to come (docs/voice-input.md), so greyed.
        if root.writable: VerticalLayout {
            alignment: center;
            IconAction {
                icon: "microphone";
                color: P.faint;
                opacity: 0.4;
                enabled: false;
            }
        }
        // A bot's menu button, and the fold for its keyboard (bots.rs).
        if root.writable && Conversation.menu-button != "": VerticalLayout {
            alignment: center;
            Action {
                label: Conversation.menu-button == "/" ? BotWords.menu().to-lowercase() : Conversation.menu-button;
                color: P.accent;
                activated => {
                    Conversation.open-bot-menu();
                }
            }
        }
        if root.writable && Conversation.keyboard.length > 0: VerticalLayout {
            alignment: center;
            IconAction {
                icon: "keyboard";
                color: Conversation.keyboard-hidden ? P.faint : P.accent;
                activated => {
                    Conversation.toggle-keyboard();
                }
            }
        }
        // A closed topic: the words saying so, in the input's place.
        if Conversation.chat-id != "" && Conversation.topic-closed: T {
            horizontal-stretch: 1;
            text: ExtraWords.topic-closed();
            color: P.muted;
            overflow: elide;
        }
        VerticalLayout {
            horizontal-stretch: Conversation.chat-id != "" && Conversation.topic-closed ? 0 : 1;
            alignment: center;
            input := MessageInput {
                // Out of sight where there is nothing to write; its room keeps the line's shape.
                visible: !root.read-only;
                text <=> Conversation.draft;
                allow-empty: Actions.bar == ComposeBar.forward;
                // Nothing goes while a group's topics are listed.
                enabled: Conversation.chat-id != "" && !Actions.selecting && !root.read-only && !Conversation.showing-topics;
                // Slow mode holding: how long still, in the placeholder (src/telegram/admin.rs).
                placeholder: Conversation.slow-wait > 0 ? ExtraWords.slow-wait-placeholder(Conversation.slow-wait)
                    : Conversation.keyboard-placeholder != "" ? Conversation.keyboard-placeholder : @tr("Write a message, or / for commands");
                text-color: P.text;
                placeholder-color: P.faint;
                // The accent: on macOS the cursor is painted in the selection's colour (chat.slint),
                // and in P.sel it could not be seen.
                selection-color: P.accent;
                selection-text-color: P.on-accent;
                font-family: P.font;
                font-size: 13px;
                padding-x: 0px;
                padding-y: 4px;
                base-height: 26px;
                tallest: 90px;
                send(words) => {
                    root.run(words);
                }
                // A command is no message: writing one is no typing; the bot's commands that
                // start so are offered among the line's own.
                edited(words) => {
                    if words.starts-with("/") {
                        Conversation.command-typed(words);
                    } else {
                        Conversation.edited(words);
                    }
                }
            }
        }
        // Slow mode's wait, or its rule, in the hint's place.
        if !root.read-only && !Conversation.showing-topics: T {
            text: Conversation.slow-wait > 0 ? ExtraWords.slow-wait-hint(Conversation.slow-wait)
                : Conversation.slow-limited ? ExtraWords.slow-hint(Conversation.slow-mode)
                : (AppState.send-with-enter ? "⏎ " : "⌘⏎ ") + (Actions.bar == ComposeBar.edit ? @tr("save") : @tr("send"));
            color: Conversation.slow-wait > 0 ? P.accent2 : P.faint;
        }
    }

    if Actions.selecting: SelectionLine { }

    // What "/…" can be, above the line.
    if root.typed.starts-with("/"): Rectangle {
        x: 16px;
        y: -self.height - 6px;
        width: 420px;
        height: suggestions.preferred-height;
        border-radius: 4px;
        background: P.side;
        border-width: 1px;
        border-color: P.line;
        drop-shadow-blur: 30px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: P.shadow;
        suggestions := VerticalLayout {
            padding-top: 6px;
            padding-bottom: 6px;
            for command in root.commands: Rectangle {
                visible: command.command.starts-with(root.typed) || root.typed == "/";
                height: self.visible ? 26px : 0px;
                background: pick.has-hover ? P.sel : transparent;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    T {
                        width: 140px;
                        text: command.command;
                        color: P.accent;
                    }
                    T {
                        horizontal-stretch: 1;
                        text: command.description;
                        color: P.muted;
                        overflow: elide;
                    }
                }
                pick := TouchArea {
                    clicked => {
                        root.run(command.command);
                        input.text = "";
                    }
                }
            }
            // The chat's bot's own (src/telegram/bots.rs), already sifted by what is typed.
            for command in Conversation.commands: Rectangle {
                height: 26px;
                background: pick-bot.has-hover ? P.sel : transparent;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    T {
                        width: 140px;
                        text: command.command;
                        color: P.accent2;
                        overflow: elide;
                    }
                    T {
                        horizontal-stretch: 1;
                        text: command.description;
                        color: P.muted;
                        overflow: elide;
                    }
                }
                pick-bot := TouchArea {
                    clicked => {
                        Conversation.send-command(command.command);
                        input.text = "";
                    }
                }
            }
        }
    }
}

component StatusBar inherits Rectangle {
    height: 26px;
    background: P.accent;
    callback search();

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 18px;
        T {
            text: "FinchGram";
            color: P.on-accent;
            font-size: 12px;
            font-weight: 600;
        }
        Rectangle { horizontal-stretch: 1; }
        T {
            text: AppState.connection == Connection.ready ? @tr("connected") : "[" + Fmt.connection(AppState.connection) + "]";
            color: P.on-accent;
            font-size: 12px;
        }
        // The tools pinned in the toolbox (toolbox.slint): their mark and name, or how many
        // downloads are on their way.
        for tool in Toolbox.pinned: Rectangle {
            width: pinned-label.preferred-width;
            pinned-label := T {
                x: 0;
                text: "[" + tool.sigil + " " + (tool.id == "downloads" && Downloads.active-count > 0 ? ToolboxWords.downloading(Downloads.active-count) : tool.name) + "]";
                color: P.on-accent;
                font-size: 12px;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Toolbox.open-tool(tool.id);
                }
            }
        }
        Rectangle {
            width: hint.preferred-width;
            hint := T {
                x: 0;
                text: "[⌘K " + @tr("terminal" => "cmd") + "]";
                color: P.on-accent;
                font-size: 12px;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.search();
                }
            }
        }
    }
}

export component TerminalWindow inherits Rectangle {
    property <TerminalView> view: TerminalView.chats;
    background: P.bg;

    // ⌘K, from the menu bar (app.slint): the command line, which has /search (the design's 1b).
    property <int> search-requests: AppState.search-requests;
    changed search-requests => {
        line.focus-line();
    }

    VerticalLayout {
        TitleBar { }
        HorizontalLayout {
            vertical-stretch: 1;
            Side {
                view <=> root.view;
                room: root.width - 388px - (Conversation.chat-id != "" && ChatInfo.open ? 320px : 0px);
            }
            VerticalLayout {
                horizontal-stretch: 1;
                // The pane, or the toolbox in its place under /tools (toolbox.slint).
                Rectangle {
                    vertical-stretch: 1;
                    if Conversation.chat-id != "": Pane { }
                    if Conversation.chat-id == "": Rectangle {
                        T {
                            text: "-- " + @tr("Choose a chat on the left") + " --";
                            color: P.faint;
                        }
                    }
                    if Toolbox.open: TerminalToolbox { }
                }
                line := CommandLine { }
            }
        }
        StatusBar {
            search => {
                line.focus-line();
            }
        }
    }

    // A message's menu and the dialogs of its actions, over everything; the search over everything
    // and the pencil's dialogs.
    TerminalActions { }
    TerminalAttachments { }
    TerminalCompose { }
}
