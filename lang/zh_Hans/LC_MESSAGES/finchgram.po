msgid "Starting…"
msgstr "正在启动…"

msgid "This build has no Telegram API ID."
msgstr "这个版本没有 Telegram API ID。"

msgid "Ready to log in with a phone number."
msgstr "可以用手机号登录了。"

msgid "Waiting for the login code."
msgstr "等待输入登录验证码。"

msgid "Waiting for the password."
msgstr "等待输入密码。"

msgid "Confirm the login on a device that is logged in."
msgstr "请在已登录的设备上确认登录。"

msgid "Waiting for the email address."
msgstr "等待输入邮箱地址。"

msgid "This phone number has no Telegram account yet."
msgstr "这个手机号还没有 Telegram 账号。"

msgid "Telegram asks for Premium to log in."
msgstr "Telegram 要求开通 Premium 才能登录。"

msgid "Logged in."
msgstr "已登录。"

msgid "Logging out…"
msgstr "正在退出登录…"

msgid "Closing…"
msgstr "正在关闭…"

msgid "Something went wrong."
msgstr "出错了。"

msgid "Waiting for network…"
msgstr "等待网络…"

msgid "Connecting to proxy…"
msgstr "正在连接代理…"

msgid "Connecting…"
msgstr "正在连接…"

msgid "Updating…"
msgstr "正在更新…"

msgid "Connected"
msgstr "已连接"

msgid "Help"
msgstr "帮助"

msgid "Update to {}…"
msgstr "更新到 {}…"

msgid "Check for Updates…"
msgstr "检查更新…"

msgid "Checking…"
msgstr "正在检查…"

msgid "This is the latest version."
msgstr "已是最新版本。"

msgid "Version {} is available."
msgstr "有新版本 {}。"

msgid "Downloading… {}%"
msgstr "下载中… {}%"

msgid "Installing…"
msgstr "安装中…"

msgid "Update failed: {}"
msgstr "更新失败：{}"

