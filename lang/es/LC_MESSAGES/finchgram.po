#: ui/pages/live-parts.slint:256
msgctxt "terminal"
msgid "[unmute]"
msgstr "[activar sonido]"

#: ui/pages/live-parts.slint:256
msgctxt "terminal"
msgid "[mute]"
msgstr "[silenciar]"

#: ui/pages/live-parts.slint:257
msgctxt "terminal"
msgid "[live]"
msgstr "[directos]"

#: ui/pages/live-parts.slint:258
msgid "Back to Live"
msgstr "Volver a Directos"

#: ui/pages/live-parts.slint:259
msgid "Stop and close"
msgstr "Detener y cerrar"

#: ui/pages/live-parts.slint:262
msgid "Open a link"
msgstr "Abrir un enlace"

#: ui/pages/live-parts.slint:264
msgid "Play or follow a stream that isn’t in the directory. Nothing is submitted — what you open stays on this Mac."
msgstr "Reproduce o sigue un directo que no está en el directorio. No se envía nada al directorio: lo que abres se queda en este Mac."

#: ui/pages/live-parts.slint:267
msgid "FinchGram can open:"
msgstr "FinchGram puede abrir:"

#: ui/pages/live-parts.slint:269
msgid "Channel pages"
msgstr "Páginas de canales"

#: ui/pages/live-parts.slint:270
msgid "Direct streams"
msgstr "Flujos directos"

#: ui/pages/live-parts.slint:271
msgid "It recognizes the link as you type. For a server, it asks the server what it is."
msgstr "El enlace se reconoce mientras escribes. Si es un servidor, FinchGram le pregunta qué es."

#: ui/pages/live-parts.slint:272
msgid "Asking {} what it is…"
msgstr "Preguntando a {} qué es…"

#: ui/pages/live-parts.slint:273
msgid "Plays in FinchGram (sound only)"
msgstr "Se reproduce en FinchGram (solo sonido)"

#: ui/pages/live-parts.slint:275
msgid "Plays on {}. FinchGram opens it in your browser."
msgstr "Se reproduce en {}. FinchGram lo abre en tu navegador."

#: ui/pages/live-parts.slint:278
msgid "This looks private — a sending address, or a link with a key in it. Keep it to yourself; FinchGram doesn’t open those here."
msgstr "Esto parece privado: una dirección de envío o un enlace con una clave. No lo compartas; FinchGram no abre eso aquí."

#: ui/pages/live-parts.slint:281
msgid "Nothing FinchGram can play. If the page has its own player, open it in your browser."
msgstr "Nada que FinchGram pueda reproducir. Si la página tiene su propio reproductor, ábrela en tu navegador."

#: ui/pages/live-parts.slint:284
msgid "The server didn’t answer: {}"
msgstr "El servidor no respondió: {}"

#: ui/pages/live-parts.slint:284
msgid "The server didn’t answer."
msgstr "El servidor no respondió."

#: ui/pages/live-parts.slint:287
msgid "Saved connections"
msgstr "Conexiones guardadas"

#: ui/pages/live-parts.slint:289
msgid "Where you broadcast to, and private servers you watch from. Keys and passwords stay sealed in FinchGram’s database and are shown only when you ask."
msgstr "Adónde emites y los servidores privados desde los que ves. Las claves y contraseñas se guardan selladas en la base de datos de FinchGram y solo se muestran cuando lo pides."

#: ui/pages/live-parts.slint:291
msgid "Submit a stream"
msgstr "Proponer un directo"

#: ui/pages/live-parts.slint:292
msgid "Suggest a public channel for the directory everyone using FinchGram sees."
msgstr "Propón un canal público para el directorio que ven todos los que usan FinchGram."

#: ui/pages/live-parts.slint:295
msgid "FinchGram asks Telegram whether it’s live"
msgstr "FinchGram pregunta a Telegram si está en directo"

#: ui/pages/live-parts.slint:302
msgid "OBS sends the stream; FinchGram gives it the destination."
msgstr "OBS envía la transmisión; FinchGram le da el destino."

#: ui/pages/live-parts.slint:303
msgid "From FinchGram"
msgstr "Desde FinchGram"

#: ui/pages/live-parts.slint:304
msgid "Use OBS"
msgstr "Usar OBS"

#: ui/pages/live-parts.slint:307
msgid "OBS does the capture, scenes and encoding. FinchGram hands it the destination and shows how the stream is doing, from OBS’s own numbers."
msgstr "OBS se encarga de la captura, las escenas y la codificación. FinchGram le pasa el destino y muestra cómo va la transmisión, con las propias cifras de OBS."

#: ui/pages/live-parts.slint:309
msgid "Connected to OBS"
msgstr "Conectado a OBS"

#: ui/pages/live-parts.slint:310
msgid "Send the destination"
msgstr "Enviar el destino"

#: ui/pages/live-parts.slint:311
msgid "Start streaming"
msgstr "Empezar a emitir"

#: ui/pages/live-parts.slint:312
msgid "Or type it into OBS › Settings › Stream yourself:"
msgstr "O escríbelo tú mismo en OBS › Ajustes › Emisión:"

#: ui/pages/live-parts.slint:313
msgid "Destination"
msgstr "Destino"

#: ui/pages/live-parts.slint:314
msgid "New destination…"
msgstr "Nuevo destino…"

#: ui/pages/live-parts.slint:315
msgid "Live story · RTMPS"
msgstr "Historia en directo · RTMPS"

#: ui/pages/live-parts.slint:316
msgid "Channel live stream · RTMPS"
msgstr "Transmisión en directo del canal · RTMPS"

#: ui/pages/live-parts.slint:318
msgid "Resolution, bitrate and sound are set in OBS. FinchGram only gives the destination; the stream starts when you start it in OBS."
msgstr "La resolución, la tasa de bits y el sonido se configuran en OBS. FinchGram solo da el destino; la transmisión empieza cuando la inicias en OBS."

#: ui/pages/live.slint:1024
msgid "Content in Live"
msgstr "Contenido en Directos"

#: ui/pages/live.slint:1026 ui/pages/settings.slint:965
msgid "Live sorts what it lists into four classes. Only the first two can appear in this version; what you can change here is whether mature-rated streams show."
msgstr "Lo que aparece en Directos se divide en cuatro clases. En esta versión solo pueden aparecer las dos primeras; lo que puedes cambiar aquí es si se muestran los directos para mayores de 18."

#: ui/pages/live.slint:1028 ui/pages/settings.slint:970
msgid "Mature-rated: hidden"
msgstr "Para mayores de 18: ocultos"

#: ui/pages/live.slint:1029
msgid "Default. They don’t appear in Discover, search or suggestions."
msgstr "Predeterminado. No aparecen en «Descubrir», en la búsqueda ni en las sugerencias."

#: ui/pages/live.slint:1030 ui/pages/settings.slint:978
msgid "Mature-rated: shown, marked “Mature”"
msgstr "Para mayores de 18: visibles, marcados «+18»"

#: ui/pages/live.slint:1031 ui/pages/settings.slint:979
msgid "They appear with a Mature tag; opening one asks first."
msgstr "Aparecen con la etiqueta «+18»; al abrir uno, se pregunta antes."

#: ui/pages/live.slint:1033
msgid "I’m 18 or older — a self-declaration, accepted only where the law doesn’t require verification"
msgstr "Tengo 18 años o más: una declaración propia, aceptada solo donde la ley no exige verificación"

#: ui/pages/live.slint:1035 ui/pages/settings.slint:998
msgid "General — listed and shown by default."
msgstr "Para todos los públicos: se lista y se muestra por defecto."

#: ui/pages/live.slint:1037 ui/pages/settings.slint:999
msgid "Mature-rated (strong language, violence, gambling, horror — rated by the source) — listed, hidden until shown here."
msgstr "Para mayores de 18 (lenguaje fuerte, violencia, apuestas, terror; según la clasificación de la fuente): se listan, pero quedan ocultos hasta que los muestres aquí."

#: ui/pages/live.slint:1040 ui/pages/settings.slint:1000
msgid "Sexually explicit — not in the directory in this version. Whether and how to list it is a pending policy decision, not a setting."
msgstr "Sexualmente explícito: no está en el directorio en esta versión. Si se incluye y cómo es una decisión de política pendiente, no un ajuste."

#: ui/pages/live.slint:1043 ui/pages/settings.slint:1001
msgid "Prohibited (illegal content, including non-consensual or underage material) — never indexed, shown or played."
msgstr "Prohibido (contenido ilegal, incluido material no consentido o con menores): nunca se indexa, se muestra ni se reproduce."

#: ui/pages/live.slint:1045
msgid "Settings › Live › Content"
msgstr "Ajustes › Directos › Contenido"

#: ui/pages/settings.slint:962
msgid "Content"
msgstr "Contenido"

#: ui/pages/settings.slint:971
msgid "Default. They don't appear in Discover, search or suggestions."
msgstr "Predeterminado. No aparecen en «Descubrir», en la búsqueda ni en las sugerencias."

#: ui/pages/settings.slint:987
msgid "I'm 18 or older — a self-declaration, accepted only where the law doesn't require verification"
msgstr "Tengo 18 años o más: una declaración propia, aceptada solo donde la ley no exige verificación"

#: ui/pages/settings.slint:1025
msgid "Languages"
msgstr "Idiomas"

#: ui/pages/settings.slint:1028
msgid "Recommended puts live streams in these languages first. None is chosen until you choose."
msgstr "«Recomendados» pone primero los directos en estos idiomas. No hay ninguno elegido hasta que tú elijas."

