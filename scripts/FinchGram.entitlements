<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app's entitlements, signed into it by scripts/bundle.sh. -->
<plist version="1.0">
<dict>
    <!-- Voice messages (src/telegram/voice.rs) and voice input (src/speech/): under the hardened
         runtime, an app without this hears silence from the microphone, and macOS never asks the
         user. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
